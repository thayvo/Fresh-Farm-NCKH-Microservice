          "content": {
            "size": -1,
            "mimeType": "text/html; charset=utf-8",
            "text": "<!DOCTYPE html>\n<html lang=\"vi\">\r\n<head>\r\n    <meta charset=\"utf-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Trang Chủ - FreshFarm</title>\r\n\r\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\" />\r\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css\" rel=\"stylesheet\" />\r\n    <link href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\" rel=\"stylesheet\" />\r\n\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n<link href=\"https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\" />\r\n<style>\r\n    :root {\r\n        --primary-green: #28a745;\r\n        --secondary-green: #1f8f3a;\r\n        --text-color: #333;\r\n        --border-color: #e0e0e0;\r\n        --danger-color: #dc3545;\r\n        --secondary-yellow: #ffb524;\r\n        --text-green: #28a745;\r\n        --marketplace-font: \"Be Vietnam Pro\", \"Segoe UI\", Roboto, sans-serif;\r\n    }\r\n\r\n    .promo-bar {\r\n        background: linear-gradient(90deg, #18a85f 0%, #0b8f4d 100%);\r\n        color: #fff;\r\n        font-size: .875rem;\r\n    }\r\n\r\n    .promo-inner {\r\n        min-height: 28px;\r\n    }\r\n\r\n    .promo-links {\r\n        white-space: nowrap;\r\n    }\r\n\r\n    .promo-links a {\r\n        color: #fff;\r\n        text-decoration: none;\r\n        opacity: .95;\r\n    }\r\n\r\n    .promo-links a:hover {\r\n        opacity: 1;\r\n        text-decoration: underline;\r\n    }\r\n\r\n    .promo-links i {\r\n        margin-right: .2rem;\r\n    }\r\n\r\n    .promo-account-dropdown {\r\n        position: relative;\r\n        display: inline-flex;\r\n        align-items: center;\r\n    }\r\n\r\n    .promo-account-trigger {\r\n        display: inline-flex;\r\n        align-items: center;\r\n        gap: 6px;\r\n        color: #fff;\r\n        text-decoration: none;\r\n        opacity: .95;\r\n        padding: 2px 0;\r\n    }\r\n\r\n    .promo-account-trigger:hover {\r\n        color: #fff;\r\n        opacity: 1;\r\n        text-decoration: none;\r\n    }\r\n\r\n    .promo-account-menu {\r\n        position: absolute;\r\n        top: calc(100% + 8px);\r\n        right: 0;\r\n        min-width: 210px;\r\n        background: #fff;\r\n        border-radius: 8px;\r\n        box-shadow: 0 8px 24px rgba(0, 0, 0, .18);\r\n        border: 1px solid #e5e7eb;\r\n        padding: 6px 0;\r\n        opacity: 0;\r\n        visibility: hidden;\r\n        transform: translateY(8px);\r\n        transition: all .2s ease;\r\n        z-index: 30;\r\n    }\r\n\r\n    .promo-account-menu::before {\r\n        content: \"\";\r\n        position: absolute;\r\n        top: -7px;\r\n        right: 18px;\r\n        width: 12px;\r\n        height: 12px;\r\n        background: #fff;\r\n        border-top: 1px solid #e5e7eb;\r\n        border-left: 1px solid #e5e7eb;\r\n        transform: rotate(45deg);\r\n    }\r\n\r\n    .promo-account-dropdown:hover .promo-account-menu {\r\n        opacity: 1;\r\n        visibility: visible;\r\n        transform: translateY(0);\r\n    }\r\n\r\n    .promo-account-item {\r\n        display: flex;\r\n        width: 100%;\r\n        border: 0;\r\n        background: transparent;\r\n        color: #111827 !important;\r\n        text-decoration: none !important;\r\n        padding: 10px 14px;\r\n        font-size: .98rem;\r\n        line-height: 1.25;\r\n        text-align: left;\r\n        white-space: nowrap;\r\n        cursor: pointer;\r\n    }\r\n\r\n    .promo-account-item:hover {\r\n        background: #f3f4f6;\r\n        color: #0f172a !important;\r\n    }\r\n\r\n    .promo-account-btn {\r\n        font: inherit;\r\n    }\r\n\r\n    .header-main-shell {\r\n        background: #fff;\r\n        padding: 14px 0 12px;\r\n    }\r\n\r\n    .header-main-wrap {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 18px;\r\n        flex-wrap: wrap;\r\n    }\r\n\r\n    .header-brand-wrap {\r\n        flex: 0 0 auto;\r\n        min-width: 230px;\r\n    }\r\n\r\n    .brand-logo-wrap {\r\n        width: 54px;\r\n        height: 54px;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n    }\r\n\r\n    .brand-logo {\r\n        width: 54px;\r\n        height: 54px;\r\n        border-radius: 12px;\r\n        background: linear-gradient(135deg, #12b76a 0%, #28a745 100%);\r\n        color: #fff;\r\n        font-weight: 800;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        letter-spacing: .02em;\r\n        box-shadow: 0 8px 20px rgba(40, 167, 69, .25);\r\n    }\r\n\r\n    .brand-logo-image {\r\n        width: 54px;\r\n        height: 54px;\r\n        object-fit: contain;\r\n        display: block;\r\n    }\r\n\r\n    .brand-text {\r\n        color: #111827;\r\n        font-weight: 800;\r\n        letter-spacing: .03em;\r\n        line-height: 1.1;\r\n    }\r\n\r\n    .brand-sub {\r\n        color: #6b7280;\r\n        font-size: .78rem;\r\n        letter-spacing: .02em;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .brand-slogan-image {\r\n        display: block;\r\n        max-width: 190px;\r\n        width: 100%;\r\n        height: auto;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .brand-slogan-image-footer {\r\n        max-width: 170px;\r\n    }\r\n\r\n    .social-icon-image {\r\n        width: 22px;\r\n        height: 22px;\r\n        object-fit: contain;\r\n        display: block;\r\n    }\r\n\r\n    .header-search-wrap {\r\n        flex: 1 1 540px;\r\n        min-width: 320px;\r\n    }\r\n\r\n    .header-search-form {\r\n        display: flex;\r\n        align-items: stretch;\r\n        border: 2px solid var(--primary-green);\r\n        border-radius: 8px;\r\n        overflow: hidden;\r\n        background: #fff;\r\n    }\r\n\r\n    .header-search-input {\r\n        border: 0 !important;\r\n        border-radius: 0 !important;\r\n        box-shadow: none !important;\r\n        padding: .7rem .9rem;\r\n        font-size: 1.03rem;\r\n    }\r\n\r\n    .header-search-btn {\r\n        border-radius: 0;\r\n        min-width: 60px;\r\n        border: 0;\r\n        font-size: 1.1rem;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        background-color: var(--primary-green);\r\n        color: #fff;\r\n    }\r\n\r\n    .header-search-btn:hover {\r\n        background-color: var(--secondary-green);\r\n        color: #fff;\r\n    }\r\n\r\n    .header-search-keywords {\r\n        display: flex;\r\n        flex-wrap: wrap;\r\n        gap: 10px 14px;\r\n        margin-top: 8px;\r\n        padding-left: 2px;\r\n    }\r\n\r\n    .header-search-keywords a {\r\n        color: #6b7280;\r\n        text-decoration: none;\r\n        font-size: .88rem;\r\n        transition: color .2s ease;\r\n    }\r\n\r\n    .header-search-keywords a:hover {\r\n        color: var(--primary-green);\r\n    }\r\n\r\n    .header-actions-wrap {\r\n        flex: 0 0 auto;\r\n        margin-left: auto;\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 10px;\r\n        position: relative;\r\n    }\r\n\r\n    .header-cart-link {\r\n        color: #334155;\r\n        text-decoration: none;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        gap: 8px;\r\n        font-weight: 700;\r\n        line-height: 1;\r\n        padding: 2px 0;\r\n        position: relative;\r\n    }\r\n\r\n    .header-cart-link i {\r\n        font-size: 1.7rem;\r\n    }\r\n\r\n    .header-cart-link:hover {\r\n        color: var(--primary-green);\r\n    }\r\n\r\n    .header-cart-badge {\r\n        position: absolute;\r\n        top: -10px;\r\n        right: -14px;\r\n        min-width: 22px;\r\n        height: 22px;\r\n        padding: 0 6px;\r\n        border-radius: 999px;\r\n        background: #fff;\r\n        color: #ee4d2d;\r\n        border: 2px solid #ee4d2d;\r\n        font-size: .78rem;\r\n        font-weight: 700;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        line-height: 1;\r\n    }\r\n\r\n    .header-cart-dropdown {\r\n        position: relative;\r\n    }\r\n\r\n    .header-cart-panel {\r\n        position: absolute;\r\n        top: calc(100% + 14px);\r\n        right: 0;\r\n        width: 380px;\r\n        background: #fff;\r\n        border: 1px solid #e5e7eb;\r\n        border-radius: 10px;\r\n        box-shadow: 0 12px 28px rgba(0, 0, 0, .2);\r\n        opacity: 0;\r\n        visibility: hidden;\r\n        transform: translateY(8px);\r\n        transition: all .2s ease;\r\n        z-index: 30;\r\n        overflow: hidden;\r\n    }\r\n\r\n    .header-cart-panel::before {\r\n        content: \"\";\r\n        position: absolute;\r\n        top: -8px;\r\n        right: 26px;\r\n        width: 14px;\r\n        height: 14px;\r\n        background: #fff;\r\n        border-top: 1px solid #e5e7eb;\r\n        border-left: 1px solid #e5e7eb;\r\n        transform: rotate(45deg);\r\n    }\r\n\r\n    .header-cart-dropdown:hover .header-cart-panel,\r\n    .header-cart-dropdown:focus-within .header-cart-panel {\r\n        opacity: 1;\r\n        visibility: visible;\r\n        transform: translateY(0);\r\n    }\r\n\r\n    .header-cart-title {\r\n        padding: 12px 14px;\r\n        font-size: .98rem;\r\n        color: #9ca3af;\r\n        border-bottom: 1px solid #f1f5f9;\r\n    }\r\n\r\n    .header-cart-empty {\r\n        padding: 16px 14px 18px;\r\n        color: #64748b;\r\n        font-size: .95rem;\r\n    }\r\n\r\n    .header-cart-list {\r\n        max-height: 320px;\r\n        overflow-y: auto;\r\n    }\r\n\r\n    .header-cart-item {\r\n        display: grid;\r\n        grid-template-columns: 54px minmax(0, 1fr) auto;\r\n        align-items: center;\r\n        gap: 10px;\r\n        padding: 10px 14px;\r\n        text-decoration: none;\r\n        color: #111827;\r\n        border-bottom: 1px solid #f8fafc;\r\n    }\r\n\r\n    .header-cart-item:hover {\r\n        background: #f8fafc;\r\n        color: #111827;\r\n    }\r\n\r\n    .header-cart-thumb {\r\n        width: 54px;\r\n        height: 54px;\r\n        object-fit: cover;\r\n        border: 1px solid #e5e7eb;\r\n        border-radius: 4px;\r\n        background: #fff;\r\n    }\r\n\r\n    .header-cart-name-wrap {\r\n        min-width: 0;\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 2px;\r\n    }\r\n\r\n    .header-cart-name {\r\n        white-space: nowrap;\r\n        overflow: hidden;\r\n        text-overflow: ellipsis;\r\n        font-size: 1.02rem;\r\n    }\r\n\r\n    .header-cart-qty {\r\n        color: #64748b;\r\n        font-size: .82rem;\r\n    }\r\n\r\n    .header-cart-price {\r\n        color: #ee4d2d;\r\n        font-weight: 600;\r\n        font-size: .98rem;\r\n        margin-left: 8px;\r\n        white-space: nowrap;\r\n    }\r\n\r\n    .header-cart-footer {\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: space-between;\r\n        gap: 8px;\r\n        padding: 10px 14px;\r\n        background: #fff;\r\n    }\r\n\r\n    .header-cart-meta {\r\n        color: #374151;\r\n        font-size: .95rem;\r\n    }\r\n\r\n    .header-cart-view-btn {\r\n        border: 0;\r\n        border-radius: 6px;\r\n        background: #ee4d2d;\r\n        color: #fff;\r\n        text-decoration: none;\r\n        font-weight: 600;\r\n        padding: 8px 14px;\r\n        white-space: nowrap;\r\n    }\r\n\r\n    .header-cart-view-btn:hover {\r\n        background: #d94425;\r\n        color: #fff;\r\n    }\r\n\r\n    .header-action-link {\r\n        border: 0;\r\n        background: transparent;\r\n        color: #334155;\r\n        text-decoration: none;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        gap: 6px;\r\n        font-weight: 600;\r\n        padding: 0;\r\n        line-height: 1;\r\n    }\r\n\r\n    .header-action-link i {\r\n        font-size: 1.3rem;\r\n    }\r\n\r\n    .header-action-link:hover {\r\n        color: var(--primary-green);\r\n    }\r\n\r\n    .header-action-btn:focus-visible {\r\n        outline: 2px solid var(--primary-green);\r\n        outline-offset: 2px;\r\n    }\r\n\r\n    .header-hello {\r\n        font-size: .85rem;\r\n        color: #6b7280;\r\n        margin-right: 2px;\r\n    }\r\n\r\n    .btn-search {\r\n        background-color: var(--primary-green);\r\n        border-color: var(--primary-green);\r\n        color: #fff;\r\n    }\r\n\r\n    .btn-search:hover {\r\n        background-color: var(--secondary-green);\r\n        border-color: var(--secondary-green);\r\n        color: #fff;\r\n    }\r\n\r\n    .navbar-main {\r\n        background: #fff;\r\n        border-top: 1px solid #ebedf0;\r\n        border-bottom: 1px solid #ebedf0;\r\n    }\r\n\r\n    .navbar-main .nav-link {\r\n        position: relative;\r\n        color: #333;\r\n        transition: color .3s ease, text-shadow .3s ease;\r\n        font-weight: 500;\r\n    }\r\n\r\n    .navbar-main .nav-link::after {\r\n        content: \"\";\r\n        position: absolute;\r\n        left: 0;\r\n        bottom: 0;\r\n        width: 0%;\r\n        height: 2px;\r\n        background-color: var(--text-green);\r\n        transition: width .3s ease;\r\n    }\r\n\r\n    .navbar-main .nav-link:hover {\r\n        color: #000;\r\n        text-shadow: 0 0 1px rgba(0, 0, 0, .35);\r\n    }\r\n\r\n    .navbar-main .nav-link:hover::after,\r\n    .navbar-main .nav-link.active::after {\r\n        width: 100%;\r\n    }\r\n\r\n    .navbar-main .nav-link.active {\n        color: var(--primary-green);\n    }\n\n    .floating-chat-widget {\n        position: fixed;\n        right: 22px;\n        bottom: 22px;\n        z-index: 1080;\n        display: flex;\n        flex-direction: column;\n        align-items: flex-end;\n        gap: 12px;\n    }\n\n    .floating-chat-launcher {\n        position: relative;\n        display: inline-flex;\n        align-items: center;\n        gap: 12px;\n        border: 0;\n        border-radius: 999px;\n        background: linear-gradient(135deg, #16a34a, #15803d);\n        color: #fff;\n        padding: 14px 18px;\n        box-shadow: 0 18px 48px rgba(21, 128, 61, .32);\n        min-width: 0;\n    }\n\n    .floating-chat-launcher:hover {\n        background: linear-gradient(135deg, #15803d, #166534);\n    }\n\n    .floating-chat-launcher-icon {\n        width: 44px;\n        height: 44px;\n        border-radius: 50%;\n        background: rgba(255, 255, 255, .18);\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        font-size: 1.2rem;\n        flex: 0 0 auto;\n    }\n\n    .floating-chat-launcher-copy {\n        display: grid;\n        text-align: left;\n        line-height: 1.2;\n    }\n\n    .floating-chat-launcher-copy strong {\n        font-size: .98rem;\n        font-weight: 800;\n    }\n\n    .floating-chat-launcher-copy span {\n        font-size: .8rem;\n        opacity: .92;\n    }\n\n    .floating-chat-launcher-badge {\n        position: absolute;\n        top: -8px;\n        right: -4px;\n        min-width: 24px;\n        height: 24px;\n        padding: 0 7px;\n        border-radius: 999px;\n        background: #ef4444;\n        color: #fff;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        font-size: .78rem;\n        font-weight: 800;\n        border: 2px solid #fff;\n    }\n\n    .floating-chat-panel {\n        width: min(920px, calc(100vw - 32px));\n        height: min(620px, calc(100vh - 120px));\n        background: rgba(255, 255, 255, .98);\n        border: 1px solid rgba(226, 232, 240, .95);\n        border-radius: 26px;\n        box-shadow: 0 28px 80px rgba(15, 23, 42, .22);\n        overflow: hidden;\n        display: none;\n        backdrop-filter: blur(18px);\n    }\n\n    .floating-chat-widget.is-open .floating-chat-panel {\n        display: flex;\n        flex-direction: column;\n    }\n\n    .floating-chat-panel-header {\n        display: flex;\n        align-items: flex-start;\n        justify-content: space-between;\n        gap: 16px;\n        padding: 18px 22px;\n        background: linear-gradient(135deg, rgba(22, 163, 74, .14), rgba(255, 255, 255, .96));\n        border-bottom: 1px solid rgba(226, 232, 240, .95);\n    }\n\n    .floating-chat-panel-title {\n        font-size: 1.12rem;\n        font-weight: 800;\n        color: #0f172a;\n    }\n\n    .floating-chat-panel-subtitle {\n        color: #64748b;\n        font-size: .9rem;\n        margin-top: 4px;\n    }\n\n    .floating-chat-panel-actions {\n        display: inline-flex;\n        gap: 8px;\n    }\n\n    .floating-chat-icon-btn {\n        width: 40px;\n        height: 40px;\n        border: 1px solid rgba(203, 213, 225, .9);\n        border-radius: 12px;\n        background: #fff;\n        color: #0f172a;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .floating-chat-icon-btn:hover {\n        border-color: #16a34a;\n        color: #16a34a;\n        background: #f0fdf4;\n    }\n\n    .floating-chat-panel-body {\n        display: grid;\n        grid-template-columns: 300px minmax(0, 1fr);\n        min-height: 0;\n        flex: 1 1 auto;\n    }\n\n    .floating-chat-sidebar {\n        border-right: 1px solid rgba(226, 232, 240, .95);\n        background: #f8fafc;\n        display: flex;\n        flex-direction: column;\n        min-height: 0;\n    }\n\n    .floating-chat-sidebar-toolbar {\n        display: grid;\n        gap: 12px;\n        padding: 18px 18px 14px;\n    }\n\n    .floating-chat-search {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        border: 1px solid rgba(203, 213, 225, .95);\n        border-radius: 14px;\n        padding: 0 12px;\n        background: #fff;\n    }\n\n    .floating-chat-search i {\n        color: #94a3b8;\n    }\n\n    .floating-chat-search input {\n        border: 0;\n        outline: none;\n        width: 100%;\n        padding: 11px 0;\n        background: transparent;\n        color: #0f172a;\n    }\n\n    .floating-chat-filters {\n        display: inline-flex;\n        gap: 8px;\n        flex-wrap: wrap;\n    }\n\n    .floating-chat-filters button {\n        border: 1px solid rgba(203, 213, 225, .95);\n        border-radius: 999px;\n        background: #fff;\n        color: #475569;\n        padding: 8px 12px;\n        font-size: .82rem;\n        font-weight: 700;\n    }\n\n    .floating-chat-filters button.is-active {\n        border-color: #16a34a;\n        background: #dcfce7;\n        color: #166534;\n    }\n\n    .floating-chat-conversation-list {\n        flex: 1 1 auto;\n        min-height: 0;\n        overflow-y: auto;\n        padding: 0 8px 12px;\n    }\n\n    .floating-chat-list-state {\n        color: #64748b;\n        text-align: center;\n        padding: 36px 16px;\n        font-size: .92rem;\n    }\n\n    .floating-chat-conversation-item {\n        width: 100%;\n        border: 0;\n        background: transparent;\n        display: grid;\n        grid-template-columns: auto minmax(0, 1fr);\n        gap: 12px;\n        padding: 12px;\n        border-radius: 18px;\n        text-align: left;\n        margin-bottom: 4px;\n    }\n\n    .floating-chat-conversation-item:hover,\n    .floating-chat-conversation-item.is-active {\n        background: #fff;\n        box-shadow: 0 12px 30px rgba(15, 23, 42, .08);\n    }\n\n    .floating-chat-conversation-avatar,\n    .floating-chat-thread-avatar {\n        width: 46px;\n        height: 46px;\n        border-radius: 16px;\n        object-fit: cover;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        background: #dcfce7;\n        color: #166534;\n        font-weight: 800;\n        flex: 0 0 auto;\n    }\n\n    .floating-chat-conversation-main {\n        min-width: 0;\n        display: grid;\n        gap: 4px;\n    }\n\n    .floating-chat-conversation-head,\n    .floating-chat-conversation-meta {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 8px;\n    }\n\n    .floating-chat-conversation-name {\n        font-weight: 800;\n        color: #0f172a;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n    }\n\n    .floating-chat-conversation-time {\n        color: #94a3b8;\n        font-size: .78rem;\n        flex: 0 0 auto;\n    }\n\n    .floating-chat-conversation-preview,\n    .floating-chat-conversation-address {\n        color: #64748b;\n        font-size: .84rem;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n    }\n\n    .floating-chat-pill {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        border-radius: 999px;\n        padding: 4px 8px;\n        font-size: .74rem;\n        font-weight: 800;\n    }\n\n    .floating-chat-pill.unread {\n        background: #fee2e2;\n        color: #b91c1c;\n    }\n\n    .floating-chat-pill.closed {\n        background: #e2e8f0;\n        color: #475569;\n    }\n\n    .floating-chat-detail {\n        min-height: 0;\n        display: flex;\n        flex-direction: column;\n        background: linear-gradient(180deg, #ffffff, #f8fafc);\n    }\n\n    .floating-chat-detail-empty,\n    .floating-chat-guest-state {\n        margin: auto;\n        max-width: 420px;\n        text-align: center;\n        padding: 28px;\n        color: #475569;\n    }\n\n    .floating-chat-empty-icon {\n        width: 72px;\n        height: 72px;\n        border-radius: 24px;\n        margin: 0 auto 18px;\n        background: linear-gradient(135deg, rgba(22, 163, 74, .14), rgba(249, 115, 22, .12));\n        color: #16a34a;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        font-size: 2rem;\n    }\n\n    .floating-chat-detail-empty h3,\n    .floating-chat-guest-state h3 {\n        color: #0f172a;\n        font-size: 1.15rem;\n        font-weight: 800;\n        margin-bottom: 10px;\n    }\n\n    .floating-chat-empty-action {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        margin-top: 16px;\n        border-radius: 999px;\n        padding: 11px 18px;\n        background: #16a34a;\n        color: #fff;\n        text-decoration: none;\n        font-weight: 800;\n    }\n\n    .floating-chat-empty-action:hover {\n        background: #15803d;\n        color: #fff;\n    }\n\n    .floating-chat-thread {\n        display: flex;\n        flex-direction: column;\n        min-height: 0;\n        flex: 1 1 auto;\n    }\n\n    .floating-chat-thread-header {\n        display: flex;\n        align-items: flex-start;\n        justify-content: space-between;\n        gap: 14px;\n        padding: 18px 22px 16px;\n        border-bottom: 1px solid rgba(226, 232, 240, .95);\n    }\n\n    .floating-chat-thread-shop {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        min-width: 0;\n    }\n\n    .floating-chat-thread-name {\n        color: #0f172a;\n        font-size: 1rem;\n        font-weight: 800;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n    }\n\n    .floating-chat-thread-meta {\n        color: #64748b;\n        font-size: .86rem;\n        margin-top: 4px;\n    }\n\n    .floating-chat-thread-status {\n        border-radius: 999px;\n        padding: 8px 12px;\n        background: #dcfce7;\n        color: #166534;\n        font-size: .78rem;\n        font-weight: 800;\n        white-space: nowrap;\n    }\n\n    .floating-chat-thread-status.is-closed {\n        background: #e2e8f0;\n        color: #475569;\n    }\n\n    .floating-chat-thread-messages {\n        flex: 1 1 auto;\n        min-height: 0;\n        overflow-y: auto;\n        padding: 20px 22px;\n        display: grid;\n        gap: 12px;\n        align-content: flex-start;\n    }\n\n    .floating-chat-message-row {\n        display: flex;\n    }\n\n    .floating-chat-message-row.from-buyer {\n        justify-content: flex-end;\n    }\n\n    .floating-chat-message-row.from-seller {\n        justify-content: flex-start;\n    }\n\n    .floating-chat-message-bubble {\n        max-width: min(78%, 420px);\n        border-radius: 18px;\n        padding: 12px 14px;\n        box-shadow: 0 12px 24px rgba(15, 23, 42, .05);\n    }\n\n    .floating-chat-message-row.from-buyer .floating-chat-message-bubble {\n        background: linear-gradient(135deg, #16a34a, #15803d);\n        color: #fff;\n        border-bottom-right-radius: 6px;\n    }\n\n    .floating-chat-message-row.from-seller .floating-chat-message-bubble {\n        background: #fff;\n        color: #0f172a;\n        border: 1px solid rgba(226, 232, 240, .95);\n        border-bottom-left-radius: 6px;\n    }\n\n    .floating-chat-message-row.system .floating-chat-message-bubble {\n        margin: 0 auto;\n        background: #eef2ff;\n        color: #4338ca;\n        border: 1px solid #c7d2fe;\n    }\n\n    .floating-chat-message-reply {\n        margin-bottom: 8px;\n        border-radius: 12px;\n        padding: 8px 10px;\n        background: rgba(255, 255, 255, .16);\n        font-size: .78rem;\n        line-height: 1.45;\n    }\n\n    .floating-chat-message-row.from-seller .floating-chat-message-reply,\n    .floating-chat-message-row.system .floating-chat-message-reply {\n        background: #f8fafc;\n    }\n\n    .floating-chat-message-content {\n        white-space: pre-wrap;\n        line-height: 1.55;\n        font-size: .92rem;\n    }\n\n    .floating-chat-message-meta {\n        margin-top: 7px;\n        font-size: .72rem;\n        opacity: .85;\n        text-align: right;\n    }\n\n    .floating-chat-message-row.from-seller .floating-chat-message-meta,\n    .floating-chat-message-row.system .floating-chat-message-meta {\n        text-align: left;\n        color: #64748b;\n        opacity: 1;\n    }\n\n    .floating-chat-message-state {\n        text-align: center;\n        color: #64748b;\n        padding: 22px 16px;\n        font-size: .92rem;\n    }\n\n    .floating-chat-typing {\n        padding: 0 22px 10px;\n        color: #16a34a;\n        font-size: .82rem;\n        font-weight: 700;\n    }\n\n    .floating-chat-thread-composer {\n        border-top: 1px solid rgba(226, 232, 240, .95);\n        padding: 16px 22px 18px;\n        background: rgba(255, 255, 255, .96);\n    }\n\n    .floating-chat-thread-composer textarea {\n        width: 100%;\n        resize: none;\n        border: 1px solid rgba(203, 213, 225, .95);\n        border-radius: 16px;\n        padding: 12px 14px;\n        outline: none;\n        min-height: 92px;\n    }\n\n    .floating-chat-thread-composer textarea:focus {\n        border-color: #16a34a;\n        box-shadow: 0 0 0 3px rgba(22, 163, 74, .12);\n    }\n\n    .floating-chat-thread-composer textarea:disabled {\n        background: #f8fafc;\n        color: #94a3b8;\n    }\n\n    .floating-chat-thread-composer-actions {\n        margin-top: 12px;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 12px;\n        flex-wrap: wrap;\n    }\n\n    .floating-chat-compose-hint {\n        color: #64748b;\n        font-size: .79rem;\n        line-height: 1.45;\n        max-width: 70%;\n    }\n\n    .floating-chat-send-btn {\n        border: 0;\n        border-radius: 999px;\n        background: linear-gradient(135deg, #16a34a, #15803d);\n        color: #fff;\n        padding: 11px 18px;\n        font-weight: 800;\n        min-width: 98px;\n    }\n\n    .floating-chat-send-btn:disabled {\n        background: #cbd5e1;\n        color: #fff;\n    }\n\n    .floating-chat-send-btn:hover:not(:disabled) {\n        background: linear-gradient(135deg, #15803d, #166534);\n    }\n\n    @media all and (max-width: 1199.98px) {\n        .header-main-wrap {\n            gap: 14px;\n        }\n\r\n        .header-brand-wrap {\r\n            min-width: 200px;\r\n        }\r\n    }\r\n\r\n    @media all and (max-width: 991.98px) {\r\n        .header-main-wrap {\r\n            align-items: flex-start;\r\n        }\r\n\r\n        .header-brand-wrap {\r\n            flex: 0 0 100%;\r\n            min-width: 0;\r\n        }\r\n\r\n        .header-search-wrap {\r\n            flex: 1 1 100%;\r\n            min-width: 0;\r\n        }\r\n    }\r\n\r\n    @media all and (max-width: 767.98px) {\n        .header-cart-link span {\n            display: none !important;\n        }\n\n        .header-cart-link i {\n            font-size: 1.4rem;\n        }\n\n        .header-cart-panel {\n            width: min(92vw, 360px);\n            right: -8px;\n        }\n\n        .floating-chat-widget {\n            right: 14px;\n            bottom: 14px;\n            left: 14px;\n            align-items: stretch;\n        }\n\n        .floating-chat-launcher {\n            width: auto;\n            justify-content: center;\n        }\n\n        .floating-chat-panel {\n            width: 100%;\n            height: min(78vh, 720px);\n        }\n\n        .floating-chat-panel-body {\n            grid-template-columns: 1fr;\n        }\n\n        .floating-chat-sidebar {\n            border-right: 0;\n            border-bottom: 1px solid rgba(226, 232, 240, .95);\n            max-height: 250px;\n        }\n\n        .floating-chat-thread-header,\n        .floating-chat-thread-composer,\n        .floating-chat-thread-messages,\n        .floating-chat-panel-header {\n            padding-left: 16px;\n            padding-right: 16px;\n        }\n\n        .floating-chat-compose-hint {\n            max-width: 100%;\n        }\n    }\n</style>\n\r\n    <style>\r\n        body {\r\n            font-family: var(--marketplace-font);\r\n            background-color: #f8f9fa;\r\n            color: var(--text-color);\r\n        }\r\n\r\n        #bannerCarousel .carousel-inner img {\r\n            border-radius: .5rem;\r\n            max-height: 420px;\r\n            object-fit: cover;\r\n        }\r\n\r\n        .carousel-control-prev,\r\n        .carousel-control-next {\r\n            width: 58px;\r\n            height: 58px;\r\n            border-radius: 50%;\r\n            transition: all .4s linear;\r\n            position: absolute;\r\n            top: 50%;\r\n        }\r\n\r\n        .carousel-control-prev {\r\n            left: 5%;\r\n            transform: translate(0, -50%);\r\n        }\r\n\r\n        .carousel-control-next {\r\n            right: 5%;\r\n            transform: translate(0, -50%);\r\n        }\r\n\r\n        .carousel-control-prev:hover,\r\n        .carousel-control-next:hover {\r\n            background-color: var(--primary-green);\r\n            border: 1px solid #fff;\r\n        }\r\n\r\n        .category-container {\r\n            padding-inline: 52px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .category-scroll-wrapper {\r\n            scroll-behavior: smooth;\r\n            overflow-x: auto;\r\n            overflow-y: hidden;\r\n            gap: 16px;\r\n            padding-block: 6px;\r\n            scrollbar-width: none;\r\n            -ms-overflow-style: none;\r\n        }\r\n\r\n        .category-scroll-wrapper::-webkit-scrollbar {\r\n            display: none;\r\n        }\r\n\r\n        .category-item {\r\n            flex: 0 0 auto;\r\n            width: clamp(184px, 18vw, 220px);\r\n            height: 132px;\r\n            transition: box-shadow .3s ease;\r\n        }\r\n\r\n        .category-item img {\r\n            object-fit: cover;\r\n            transition: transform .4s ease;\r\n        }\r\n\r\n        .category-item:hover img {\r\n            transform: scale(1.1);\r\n        }\r\n\r\n        .category-name {\r\n            font-size: 1.05rem;\r\n            line-height: 1.3;\r\n            text-shadow: 2px 2px 5px rgba(0, 0, 0, .9);\r\n            max-width: 170px;\r\n            white-space: normal;\r\n            overflow: hidden;\r\n            text-overflow: ellipsis;\r\n            display: -webkit-box;\r\n            -webkit-line-clamp: 2;\r\n            -webkit-box-orient: vertical;\r\n        }\r\n\r\n        .scroll-btn {\r\n            width: 40px;\r\n            height: 40px;\r\n            top: 50%;\r\n            transform: translateY(-50%);\r\n            transition: all .2s ease-in-out;\r\n            background-color: #fff;\r\n            color: var(--primary-green);\r\n        }\r\n\r\n        .scroll-btn:hover {\r\n            background-color: var(--primary-green) !important;\r\n            color: #fff;\r\n            border-color: var(--primary-green) !important;\r\n        }\r\n\r\n        .scroll-btn.btn-prev {\r\n            left: 8px;\r\n        }\r\n\r\n        .scroll-btn.btn-next {\r\n            right: 8px;\r\n        }\r\n\r\n        .product-card {\r\n            transition: transform .2s ease, box-shadow .2s ease;\r\n            position: relative;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .product-image-wrapper {\r\n            position: relative;\r\n            width: 100%;\r\n            padding-bottom: 100%;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .product-image {\r\n            position: absolute;\r\n            inset: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n            object-position: center;\r\n            transition: transform .4s ease;\r\n        }\r\n\r\n        .product-card:hover .product-image {\r\n            transform: scale(1.1);\r\n        }\r\n\r\n        .product-overlay {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            background-color: rgba(0, 0, 0, .5);\r\n            color: #fff;\r\n            display: flex;\r\n            flex-direction: column;\r\n            justify-content: center;\r\n            align-items: center;\r\n            text-align: center;\r\n            padding: 1rem;\r\n            opacity: 0;\r\n            visibility: hidden;\r\n            transition: opacity .4s ease, visibility .4s ease;\r\n        }\r\n\r\n        .product-card:hover .product-overlay {\r\n            opacity: 1;\r\n            visibility: visible;\r\n        }\r\n\r\n        .product-card:hover .card-body {\r\n            opacity: 0;\r\n            transition: opacity .3s ease;\r\n        }\r\n\r\n        .product-overlay .view-details {\r\n            color: #fff;\r\n            text-decoration: none;\r\n            transition: opacity .2s;\r\n        }\r\n\r\n        .product-overlay .view-details:hover {\r\n            opacity: .8;\r\n        }\r\n\r\n        .mySwiper-suggest .swiper-button-prev,\r\n        .mySwiper-suggest .swiper-button-next {\r\n            background-color: rgba(255, 255, 255, .9);\r\n            color: var(--primary-green);\r\n            width: 40px;\r\n            height: 40px;\r\n            border-radius: 50%;\r\n            box-shadow: 0 0 6px rgba(0, 0, 0, .15);\r\n        }\r\n\r\n        .mySwiper-suggest .swiper-button-prev::after,\r\n        .mySwiper-suggest .swiper-button-next::after {\r\n            font-size: 16px;\r\n        }\r\n\r\n        .suggestion-fallback-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\r\n            gap: 16px;\r\n        }\r\n\r\n        .empty-state {\r\n            border: 1px dashed #ced4da;\r\n            border-radius: 14px;\r\n            background: #fff;\r\n            color: #6c757d;\r\n            padding: 2rem;\r\n            text-align: center;\r\n        }\r\n\r\n        .popup-overlay {\r\n            position: fixed;\r\n            top: 0;\r\n            left: 0;\r\n            right: 0;\r\n            bottom: 0;\r\n            background: rgba(0, 0, 0, .6);\r\n            backdrop-filter: blur(4px);\r\n            display: none;\r\n            align-items: center;\r\n            justify-content: center;\r\n            z-index: 9999;\r\n            opacity: 0;\r\n            pointer-events: none;\r\n        }\r\n\r\n        .popup-overlay.show {\r\n            display: flex;\r\n            pointer-events: auto;\r\n            animation: fadeIn .3s ease-out forwards;\r\n        }\r\n\r\n        @keyframes fadeIn {\r\n            to {\r\n                opacity: 1;\r\n            }\r\n        }\r\n\r\n        .popup-container {\r\n            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);\r\n            border-radius: 20px;\r\n            box-shadow: 0 20px 60px rgba(0, 0, 0, .3);\r\n            max-width: 500px;\r\n            width: 90%;\r\n            max-height: 90vh;\r\n            overflow: hidden;\r\n            transform: scale(.9) translateY(-20px);\r\n        }\r\n\r\n        .popup-overlay.show .popup-container {\r\n            animation: popupEnter .4s cubic-bezier(.34, 1.56, .64, 1) forwards;\r\n        }\r\n\r\n        @keyframes popupEnter {\r\n            to {\r\n                transform: scale(1) translateY(0);\r\n            }\r\n        }\r\n\r\n        .popup-header {\r\n            background: linear-gradient(135deg, var(--primary-green) 0%, #20c997 100%);\r\n            color: #fff;\r\n            padding: 30px 25px 25px;\r\n            position: relative;\r\n            text-align: center;\r\n        }\r\n\r\n        .popup-header::before {\r\n            content: \"\";\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            right: 0;\r\n            bottom: 0;\r\n            background: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 320'><path fill='rgba(255,255,255,0.1)' d='M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,138.7C960,139,1056,117,1152,101.3C1248,85,1344,75,1392,69.3L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z'></path></svg>\") no-repeat bottom;\r\n            background-size: cover;\r\n            opacity: .3;\r\n        }\r\n\r\n        .welcome-icon {\r\n            width: 70px;\r\n            height: 70px;\r\n            background: rgba(255, 255, 255, .2);\r\n            border-radius: 50%;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin: 0 auto 15px;\r\n            font-size: 35px;\r\n            position: relative;\r\n            animation: bounce 2s infinite;\r\n        }\r\n\r\n        @keyframes bounce {\r\n            0%, 100% {\r\n                transform: translateY(0);\r\n            }\r\n\r\n            50% {\r\n                transform: translateY(-10px);\r\n            }\r\n        }\r\n\r\n        .popup-title {\r\n            font-size: 26px;\r\n            font-weight: 700;\r\n            margin: 0;\r\n            position: relative;\r\n        }\r\n\r\n        .popup-subtitle {\r\n            font-size: 14px;\r\n            opacity: .95;\r\n            margin-top: 8px;\r\n            position: relative;\r\n        }\r\n\r\n        .btn-close-popup {\r\n            position: absolute;\r\n            top: 15px;\r\n            right: 15px;\r\n            background: rgba(255, 255, 255, .2);\r\n            border: none;\r\n            width: 35px;\r\n            height: 35px;\r\n            border-radius: 50%;\r\n            color: #fff;\r\n            cursor: pointer;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            transition: all .3s ease;\r\n            z-index: 1;\r\n        }\r\n\r\n        .btn-close-popup:hover {\r\n            background: rgba(255, 255, 255, .3);\r\n            transform: rotate(90deg);\r\n        }\r\n\r\n        .popup-body {\r\n            padding: 25px;\r\n            max-height: 400px;\r\n            overflow-y: auto;\r\n        }\r\n\r\n        .popup-body::-webkit-scrollbar {\r\n            width: 6px;\r\n        }\r\n\r\n        .popup-body::-webkit-scrollbar-thumb {\r\n            background: var(--primary-green);\r\n            border-radius: 3px;\r\n        }\r\n\r\n        .coupon-card {\r\n            background: #fff;\r\n            border: 2px dashed var(--primary-green);\r\n            border-radius: 12px;\r\n            padding: 20px;\r\n            margin-bottom: 15px;\r\n            position: relative;\r\n            overflow: hidden;\r\n            transition: all .3s ease;\r\n            animation: slideIn .5s ease-out backwards;\r\n        }\r\n\r\n        .coupon-card:nth-child(1) {\r\n            animation-delay: .1s;\r\n        }\r\n\r\n        .coupon-card:nth-child(2) {\r\n            animation-delay: .2s;\r\n        }\r\n\r\n        @keyframes slideIn {\r\n            from {\r\n                opacity: 0;\r\n                transform: translateX(-30px);\r\n            }\r\n\r\n            to {\r\n                opacity: 1;\r\n                transform: translateX(0);\r\n            }\r\n        }\r\n\r\n        .coupon-card:hover {\r\n            transform: translateY(-3px);\r\n            box-shadow: 0 8px 25px rgba(40, 167, 69, .15);\r\n        }\r\n\r\n        .coupon-card::before {\r\n            content: \"\";\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 6px;\r\n            height: 100%;\r\n            background: linear-gradient(180deg, var(--primary-green) 0%, #20c997 100%);\r\n        }\r\n\r\n        .coupon-header {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            margin-bottom: 12px;\r\n        }\r\n\r\n        .coupon-code {\r\n            background: linear-gradient(135deg, var(--primary-green) 0%, #20c997 100%);\r\n            color: #fff;\r\n            padding: 8px 16px;\r\n            border-radius: 8px;\r\n            font-weight: 700;\r\n            font-size: 18px;\r\n            letter-spacing: 1px;\r\n            display: inline-flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n            box-shadow: 0 4px 12px rgba(40, 167, 69, .3);\r\n        }\r\n\r\n        .coupon-badge {\r\n            background: #ffc107;\r\n            color: #000;\r\n            padding: 4px 12px;\r\n            border-radius: 20px;\r\n            font-size: 12px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .coupon-body {\r\n            padding-left: 10px;\r\n        }\r\n\r\n        .coupon-description {\r\n            color: #6c757d;\r\n            font-size: 14px;\r\n            margin-bottom: 10px;\r\n            line-height: 1.6;\r\n        }\r\n\r\n        .coupon-info {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 6px;\r\n        }\r\n\r\n        .info-item {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n            font-size: 13px;\r\n            color: #495057;\r\n        }\r\n\r\n        .info-item i {\r\n            color: var(--primary-green);\r\n            font-size: 14px;\r\n        }\r\n\r\n        .expiry-warning {\r\n            background: #fff3cd;\r\n            border-left: 4px solid #ffc107;\r\n            padding: 10px;\r\n            border-radius: 6px;\r\n            margin-top: 10px;\r\n            font-size: 13px;\r\n            color: #856404;\r\n        }\r\n\r\n        .popup-footer {\r\n            padding: 20px 25px;\r\n            background: #f8f9fa;\r\n            text-align: center;\r\n            border-top: 1px solid #e9ecef;\r\n        }\r\n\r\n        .btn-continue {\r\n            background: linear-gradient(135deg, var(--primary-green) 0%, #20c997 100%);\r\n            color: #fff;\r\n            border: none;\r\n            padding: 12px 40px;\r\n            border-radius: 25px;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            transition: all .3s ease;\r\n            box-shadow: 0 4px 15px rgba(40, 167, 69, .3);\r\n        }\r\n\r\n        .btn-continue:hover {\r\n            transform: translateY(-2px);\r\n            box-shadow: 0 6px 20px rgba(40, 167, 69, .4);\r\n        }\r\n\r\n        .footer-link {\r\n            color: #ccc;\r\n            text-decoration: none;\r\n            display: block;\r\n            margin-bottom: .4rem;\r\n            transition: color .2s;\r\n        }\r\n\r\n        .footer-link:hover {\r\n            color: var(--primary-green);\r\n        }\r\n\r\n        .social-icon {\r\n            color: #ccc;\r\n            font-size: 1.3rem;\r\n            transition: color .3s, transform .3s;\r\n        }\r\n\r\n        .social-icon:hover {\r\n            color: var(--primary-green);\r\n            transform: translateY(-2px);\r\n        }\r\n\r\n        @media (max-width: 1199.98px) {\r\n            .header-main-wrap {\r\n                gap: 14px;\r\n            }\r\n\r\n            .header-brand-wrap {\r\n                min-width: 200px;\r\n            }\r\n\r\n            .header-search-wrap {\r\n                min-width: 260px;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 991.98px) {\r\n            .header-main-wrap {\r\n                align-items: flex-start;\r\n            }\r\n\r\n            .header-brand-wrap {\r\n                flex: 0 0 100%;\r\n                min-width: 0;\r\n            }\r\n\r\n            .header-search-wrap {\r\n                flex: 1 1 100%;\r\n                min-width: 0;\r\n            }\r\n\r\n            .header-actions-wrap {\r\n                margin-left: 0;\r\n                justify-content: flex-end;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 767.98px) {\r\n            .header-cart-link span {\r\n                display: none !important;\r\n            }\r\n\r\n            .header-cart-link i {\r\n                font-size: 1.4rem;\r\n            }\r\n\r\n            .header-cart-panel {\r\n                width: min(92vw, 360px);\r\n                right: -8px;\r\n            }\r\n\r\n            .header-cart-name {\r\n                font-size: .95rem;\r\n            }\r\n\r\n            .header-cart-price {\r\n                font-size: .92rem;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 576px) {\r\n            .popup-container {\r\n                width: 95%;\r\n                margin: 10px;\r\n            }\r\n\r\n            .popup-header {\r\n                padding: 25px 20px 20px;\r\n            }\r\n\r\n            .popup-title {\r\n                font-size: 22px;\r\n            }\r\n\r\n            .coupon-code {\r\n                font-size: 16px;\r\n                padding: 6px 12px;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    \n<div class=\"promo-bar py-2 d-none d-lg-block\">\n    <div class=\"container promo-inner d-flex align-items-center justify-content-between\">\n        <div class=\"promo-links d-flex align-items-center gap-2\">\n            <a href=\"/account/become-seller\">Kênh Người Bán</a>\n            <span>|</span>\n            <a href=\"/account/become-seller\">Trở thành Người bán FreshFarm</a>\n        </div>\n\r\n        <div class=\"promo-links d-flex align-items-center gap-2\">\n            <a href=\"/account/signin?returnUrl=%2Faccount%2Fnotifications\"><i class=\"bi bi-bell\"></i> Thông báo</a>\n            <a href=\"#buyerChatWidget\" data-floating-buyer-chat-toggle><i class=\"bi bi-question-circle\"></i> Hỗ trợ</a>\n                <span>|</span>\r\n                <a href=\"/account/signup?returnUrl=%2F\">Đăng ký</a>\r\n                <span>|</span>\r\n                <a href=\"/account/signin?returnUrl=%2F\">Đăng nhập</a>\r\n        </div>\r\n    </div>\n</div>\n\n\n    <div id=\"floatingBuyerChat\"\n         class=\"floating-chat-widget\"\n         data-is-authenticated=\"false\"\n         data-is-buyer-eligible=\"false\"\n         data-sign-in-url=\"/account/signin?returnUrl=%2F\"\n         data-summaries-url=\"/bff/support-chat/summaries\"\n         data-conversation-by-seller-url-template=\"/bff/support-chat/sellers/__SELLER_ID__/conversation\"\n         data-messages-url-template=\"/bff/support-chat/conversations/__CONVERSATION_ID__/messages\"\n         data-send-message-url-template=\"/bff/support-chat/conversations/__CONVERSATION_ID__/messages\"\n         data-mark-read-url-template=\"/bff/support-chat/conversations/__CONVERSATION_ID__/mark-read\"\n         data-hub-url=\"/hubs/support-chat\"\n         data-discover-shops-url=\"/shops\">\n        <button type=\"button\"\n                class=\"floating-chat-launcher\"\n                data-floating-chat-launcher\n                aria-expanded=\"false\"\n                aria-controls=\"floatingChatPanel\">\n            <span class=\"floating-chat-launcher-icon\"><i class=\"bi bi-chat-dots-fill\"></i></span>\n            <span class=\"floating-chat-launcher-copy\">\n                <strong>Chat với shop</strong>\n                <span data-floating-chat-launcher-subtitle>Hỗ trợ mua hàng</span>\n            </span>\n            <span class=\"floating-chat-launcher-badge d-none\" data-floating-chat-launcher-badge>0</span>\n        </button>\n\n        <section id=\"floatingChatPanel\"\n                 class=\"floating-chat-panel\"\n                 aria-hidden=\"true\">\n            <header class=\"floating-chat-panel-header\">\n                <div>\n                    <div class=\"floating-chat-panel-title\">Hỗ trợ & chat với shop</div>\n                    <div class=\"floating-chat-panel-subtitle\" data-floating-chat-panel-subtitle>Danh sách shop bạn đã trò chuyện gần đây.</div>\n                </div>\n                <div class=\"floating-chat-panel-actions\">\n                    <button type=\"button\" class=\"floating-chat-icon-btn\" data-floating-chat-refresh title=\"Tải lại danh sách chat\">\n                        <i class=\"bi bi-arrow-clockwise\"></i>\n                    </button>\n                    <button type=\"button\" class=\"floating-chat-icon-btn\" data-floating-chat-close title=\"Thu gọn\">\n                        <i class=\"bi bi-dash-lg\"></i>\n                    </button>\n                </div>\n            </header>\n\n            <div class=\"floating-chat-panel-body\">\n                <aside class=\"floating-chat-sidebar\">\n                    <div class=\"floating-chat-sidebar-toolbar\">\n                        <label class=\"floating-chat-search\">\n                            <i class=\"bi bi-search\"></i>\n                            <input type=\"search\" placeholder=\"Tìm shop đã chat\" data-floating-chat-search />\n                        </label>\n                        <div class=\"floating-chat-filters\">\n                            <button type=\"button\" class=\"is-active\" data-floating-chat-filter=\"all\">Tất cả</button>\n                            <button type=\"button\" data-floating-chat-filter=\"unread\">Chưa đọc</button>\n                        </div>\n                    </div>\n                    <div class=\"floating-chat-conversation-list\" data-floating-chat-conversation-list>\n                        <div class=\"floating-chat-list-state\">Đang tải lịch sử chat...</div>\n                    </div>\n                </aside>\n\n                <section class=\"floating-chat-detail\">\n                    <div class=\"floating-chat-detail-empty\" data-floating-chat-empty-state>\n                        <div class=\"floating-chat-empty-icon\"><i class=\"bi bi-shop-window\"></i></div>\n                        <h3>Bắt đầu từ một shop cụ thể</h3>\n                        <p>Widget này sẽ hiện các shop bạn đã chat. Khi cần mở cuộc trò chuyện mới, bạn chỉ cần vào trang shop và bấm nhắn tin như hiện tại.</p>\n                        <a class=\"floating-chat-empty-action\" href=\"/shops\">Khám phá shop đang mở bán</a>\n                    </div>\n\n                    <div class=\"floating-chat-thread d-none\" data-floating-chat-thread>\n                        <div class=\"floating-chat-thread-header\">\n                            <div class=\"floating-chat-thread-shop\">\n                                <div class=\"floating-chat-thread-avatar\" data-floating-chat-thread-avatar>F</div>\n                                <div>\n                                    <div class=\"floating-chat-thread-name\" data-floating-chat-thread-name>FreshFarm Seller</div>\n                                    <div class=\"floating-chat-thread-meta\" data-floating-chat-thread-meta>Đang tải thông tin hội thoại...</div>\n                                </div>\n                            </div>\n                            <div class=\"floating-chat-thread-status\" data-floating-chat-thread-status>Đang mở</div>\n                        </div>\n\n                        <div class=\"floating-chat-thread-messages\" data-floating-chat-thread-messages></div>\n                        <div class=\"floating-chat-typing d-none\" data-floating-chat-typing>Shop đang nhập tin nhắn...</div>\n\n                        <div class=\"floating-chat-thread-composer\">\n                            <textarea rows=\"2\"\n                                      placeholder=\"Nhập tin nhắn cho shop...\"\n                                      data-floating-chat-input></textarea>\n                            <div class=\"floating-chat-thread-composer-actions\">\n                                <div class=\"floating-chat-compose-hint\" data-floating-chat-compose-hint>Realtime khi mở đúng hội thoại, badge sẽ tự cập nhật theo polling.</div>\n                                <button type=\"button\" class=\"floating-chat-send-btn\" data-floating-chat-send>Gửi</button>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"floating-chat-guest-state d-none\" data-floating-chat-guest-state>\n                        <div class=\"floating-chat-empty-icon\"><i class=\"bi bi-person-lock\"></i></div>\n                        <h3>Đăng nhập để xem chat với shop</h3>\n                        <p>Sau khi đăng nhập bằng tài khoản mua hàng, widget sẽ hiển thị các shop bạn đã nhắn và cho phép trả lời ngay tại đây.</p>\n                        <a class=\"floating-chat-empty-action\" href=\"/account/signin?returnUrl=%2F\">Đăng nhập ngay</a>\n                    </div>\n                </section>\n            </div>\n        </section>\n\n        <form id=\"floatingBuyerChatAntiForgeryForm\" class=\"d-none\" method=\"post\">\n            \n        <input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"CfDJ8OECdWR6yZhKoCAz44aO18v4t7oZp4zR4j5kRqdNigThcdr4v4kROxmmd0HW06KgmDjSAzHHhJjXr21Qv75A8cqNmrDCPggHvCwxWuzqyU808QSU5WTQi8J8U5Yfo3-TuVqD8fFtP6IvU8RmX5gfEbs\" /></form>\n    </div>\n    <script src=\"/js/floating-buyer-chat.js?v=PyVdCRcd0P_JJGzVo1LI5ttTP6gfxmyXTX6LTUrXFWI\"></script>\n\n\r\n    \r\n<header class=\"header-main-shell border-bottom\">\r\n    <div class=\"container\">\r\n        <div class=\"header-main-wrap\">\r\n            <div class=\"header-brand-wrap\">\r\n                <a href=\"/\" class=\"text-decoration-none d-flex align-items-center gap-2\">\r\n                    <span class=\"brand-logo-wrap\">\r\n                        <img src=\"/uploads/web/logo.PNG\"\r\n                             alt=\"Logo FreshFarm\"\r\n                             class=\"brand-logo-image\"\r\n                             data-fallback-toggle-target=\"headerLogoFallback\" />\r\n                        <span id=\"headerLogoFallback\" class=\"brand-logo d-none\">FF</span>\r\n                    </span>\r\n                    <span>\r\n                        <span class=\"d-block brand-text\">FRESHFARM</span>\r\n                        <img src=\"/uploads/web/slogan.PNG\"\r\n                             alt=\"Nông sản sạch mỗi ngày\"\r\n                             class=\"brand-slogan-image\"\r\n                             data-fallback-toggle-target=\"headerSloganFallback\" />\r\n                        <span id=\"headerSloganFallback\"\r\n                              class=\"brand-sub d-none\"\r\n                              data-fallback-remove-class=\"d-none\"\r\n                              data-fallback-add-class=\"d-inline\">Nông sản sạch mỗi ngày</span>\r\n                    </span>\r\n                </a>\r\n            </div>\r\n\r\n            <div class=\"header-search-wrap\">\r\n                <form id=\"headerSearchForm\" class=\"header-search-form\" autocomplete=\"off\" method=\"get\" action=\"/search\">\r\n                    <input id=\"headerSearchInput\"\r\n                           name=\"q\"\r\n                           class=\"form-control header-search-input\"\r\n                           type=\"search\"\r\n                           placeholder=\"Tìm kiếm nông sản, trái cây, rau sạch...\"\r\n                           value=\"\" />\r\n                    <button class=\"btn btn-search header-search-btn\" type=\"submit\">\r\n                        <i class=\"bi bi-search\"></i>\r\n                    </button>\r\n                </form>\r\n                <div class=\"header-search-keywords d-none d-md-flex\">\r\n                    <a href=\"#\" data-header-keyword=\"Rau sạch\">Rau sạch</a>\r\n                    <a href=\"#\" data-header-keyword=\"Trái cây\">Trái cây</a>\r\n