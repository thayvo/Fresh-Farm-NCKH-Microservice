gn-items-center justify-content-center z-3\" id=\"btnNext\"><i class=\"bi bi-chevron-right\"></i></button>\r\n        </div>\r\n    </section>\r\n\r\n    <section id=\"section-suggest\" class=\"container my-5\">\r\n        <h2 class=\"text-center fw-bold mb-4\">Gợi Ý Hôm Nay</h2>\r\n        <div class=\"swiper mySwiper-suggest\">\r\n            <div id=\"suggestionWrapper\" class=\"swiper-wrapper\"></div>\r\n            <div class=\"swiper-button-prev\"></div>\r\n            <div class=\"swiper-button-next\"></div>\r\n        </div>\r\n        <div id=\"suggestionEmpty\" class=\"empty-state d-none mt-3\">Chưa có sản phẩm gợi ý.</div>\r\n    </section>\r\n\r\n    <section id=\"section-featured\" class=\"container my-5\">\r\n        <div class=\"d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2\">\r\n            <h2 class=\"fw-bold mb-0\">Sản phẩm nổi bật</h2>\r\n            <a href=\"#section-featured\" class=\"btn btn-outline-success fw-semibold\">Xem thêm <i class=\"bi bi-arrow-right\"></i></a>\r\n        </div>\r\n\r\n        <div id=\"featuredGrid\" class=\"row g-4\"></div>\r\n        <div id=\"featuredEmpty\" class=\"empty-state d-none\">Không có sản phẩm để hiển thị.</div>\r\n    </section>\r\n\r\n    <div class=\"popup-overlay\" id=\"welcomePopup\">\r\n        <div class=\"popup-container\">\r\n            <div class=\"popup-header\">\r\n                <button class=\"btn-close-popup\" type=\"button\" data-popup-close=\"welcome\"><i class=\"bi bi-x-lg\"></i></button>\n                <div class=\"welcome-icon\">🎉</div>\r\n                <h2 class=\"popup-title\">Chào mừng bạn trở lại!</h2>\r\n                <p class=\"popup-subtitle\">Bạn có 2 ưu đãi đặc biệt đang chờ</p>\r\n            </div>\r\n            <div class=\"popup-body\">\r\n                <div class=\"coupon-card\">\r\n                    <div class=\"coupon-header\">\r\n                        <div class=\"coupon-code\"><i class=\"bi bi-ticket-perforated-fill\"></i> FRESH10</div>\r\n                        <span class=\"coupon-badge\">Giảm %</span>\r\n                    </div>\r\n                    <div class=\"coupon-body\">\r\n                        <p class=\"coupon-description\">Giảm 10% cho đơn từ 300.000₫.</p>\r\n                        <div class=\"coupon-info\">\r\n                            <div class=\"info-item\">\r\n                                <i class=\"bi bi-calendar-check\"></i>\r\n                                <span>Hết hạn: 31/12/2026</span>\r\n                            </div>\r\n                            <div class=\"info-item\">\r\n                                <i class=\"bi bi-cart-check\"></i>\r\n                                <span>Đơn tối thiểu: 300.000₫</span>\r\n                            </div>\r\n                            <div class=\"info-item\">\r\n                                <i class=\"bi bi-tag\"></i>\r\n                                <span>Giảm: 10%</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"expiry-warning\">\r\n                            <i class=\"bi bi-clock\"></i> Còn 6 ngày để sử dụng\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"coupon-card\">\r\n                    <div class=\"coupon-header\">\r\n                        <div class=\"coupon-code\"><i class=\"bi bi-ticket-perforated-fill\"></i> SHIPFREE</div>\r\n                        <span class=\"coupon-badge\">Giảm ngay</span>\r\n                    </div>\r\n                    <div class=\"coupon-body\">\r\n                        <p class=\"coupon-description\">Miễn phí vận chuyển toàn quốc, không giới hạn đơn tối thiểu.</p>\r\n                        <div class=\"coupon-info\">\r\n                            <div class=\"info-item\">\r\n                                <i class=\"bi bi-calendar-check\"></i>\r\n                                <span>Hết hạn: 31/12/2026</span>\r\n                            </div>\r\n                            <div class=\"info-item\">\r\n                                <i class=\"bi bi-infinity\"></i>\r\n                                <span>Không giới hạn đơn tối thiểu</span>\r\n                            </div>\r\n                            <div class=\"info-item\">\r\n                                <i class=\"bi bi-tag\"></i>\r\n                                <span>Giảm: 100% phí vận chuyển</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"popup-footer\">\r\n                <button class=\"btn-continue\" type=\"button\" data-popup-close=\"welcome\"><i class=\"bi bi-bag-heart me-2\"></i>Bắt đầu mua sắm</button>\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    \r\n<footer class=\"bg-dark text-white pt-5 pb-4\">\r\n    <div class=\"container text-center text-md-start\">\r\n        <div class=\"row gy-4\">\r\n            <div class=\"col-md-4\">\r\n                <div class=\"d-flex align-items-center mb-3 gap-2\">\r\n                    <span class=\"brand-logo-wrap\">\r\n                        <img src=\"/uploads/web/logo.PNG\"\r\n                             alt=\"Logo FreshFarm\"\r\n                             class=\"brand-logo-image\"\r\n                             data-fallback-toggle-target=\"footerLogoFallback\" />\r\n                        <span id=\"footerLogoFallback\" class=\"brand-logo d-none\">FF</span>\r\n                    </span>\r\n                    <div>\r\n                        <div class=\"fw-bold\">FreshFarm</div>\r\n                        <img src=\"/uploads/web/slogan.PNG\"\r\n                             alt=\"Nông sản sạch mỗi ngày\"\r\n                             class=\"brand-slogan-image brand-slogan-image-footer\"\r\n                             data-fallback-toggle-target=\"footerSloganFallback\" />