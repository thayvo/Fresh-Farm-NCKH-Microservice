{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SessionStore": {
    "Provider": "Memory",
    "RedisConnectionString": "",
    "InstanceName": "FreshFarm:",
    "ConnectTimeoutMilliseconds": 5000,
    "AbortOnConnectFail": false,
    "Ssl": false
  },
  "SessionAwareRecommendation": {
    "maxCandidates": 200,
    "searchKeywordBoost": 18,
    "recentClickedProductBoost": 32,
    "recentClickedSellerBoost": 9,
    "recentClickedCategoryBoost": 7,
    "topPositionBoostFactor": 0.85,
    "midPositionBoostFactor": 1.1,
    "ctrWeight": 0.12,
    "addToCartWeight": 0.08,
    "purchaseWeight": 0.35,
    "revenueWeight": 0.45,
    "objectiveScoreScale": 62,
    "objectiveMetricsLookbackDays": 7,
    "negativeFeedbackLookbackDays": 14,
    "negativeFeedbackPenaltyScale": 24,
    "inStockBoost": 20,
    "outOfStockPenalty": 35,
    "nearbyShopBoost": 14,
    "nearbyShopRadiusKm": 12,
    "warnIfSlowerThanMilliseconds": 50
  },
  "RecommendationExperiment": {
    "sessionRerankTrafficPercent": 20
  },
  "BackgroundJobs": {
    "SessionAwareRerankTuning": {
      "enabled": true,
      "startupDelaySeconds": 180,
      "intervalHours": 24,
      "lookbackDays": 7,
      "minimumImpressions": 100,
      "maxAdjustmentRatio": 0.1,
      "smoothingRunCount": 3,
      "retainedConfigVersionCount": 3,
      "rollbackCtrDropRatio": 0.1,
      "topPositionBoostFactorMin": 0.5,
      "topPositionBoostFactorMax": 1.0,
      "midPositionBoostFactorMin": 1.0,
      "midPositionBoostFactorMax": 2.0,
      "requestTimeoutSeconds": 5,
      "configOverridePath": "App_Data/session-aware-rerank-tuning.json"
    },
    "MultiObjectiveRecommendationRollout": {
      "enabled": true,
      "startupDelaySeconds": 300,
      "intervalMinutes": 60,
      "lookbackHours": 6,
      "minimumImpressions": 200,
      "minimumGuardrailAgeHours": 3,
      "smoothingWindowHours": 3,
      "initialTrafficPercent": 20,
      "rampSteps": [ 20, 50, 100 ],
      "stableWindowCountForRamp": 3,
      "stableHoursForRamp": 24,
      "stableHoursForLock": 48,
      "retainedConfigVersionCount": 3,
      "ctrDropRevenueAdjustRatio": 0.1,
      "purchaseRateDropRollbackRatio": 0.05,
      "revenueWeightAdjustmentRatio": 0.1,
      "requestTimeoutSeconds": 5
    }
  },
  "IdleSession": {
    "Enabled": true,
    "WarningAfterMinutes": 19,
    "AutoLogoutAfterWarningMinutes": 1,
    "AuthenticationLifetimeMinutes": 120,
    "ServerSessionIdleTimeoutMinutes": 120
  },
  "Security": {
    "GoogleRecaptcha": {
      "SiteKey": "",
      "SecretKey": "",
      "VerificationEndpoint": "https://www.google.com/recaptcha/api/siteverify",
      "SignUpAction": "signup",
      "MinimumScore": 0.5
    }
  }
}
