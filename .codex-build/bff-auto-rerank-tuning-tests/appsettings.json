{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SessionStore": {
    "Provider": "Memory",
    "RedisConnectionString": "",
    "InstanceName": "FreshFarm:",
    "ConnectTimeoutMilliseconds": 5000,
    "AbortOnConnectFail": false,
    "Ssl": false
  },
  "SessionAwareRecommendation": {
    "maxCandidates": 200,
    "searchKeywordBoost": 18,
    "recentClickedProductBoost": 32,
    "recentClickedSellerBoost": 9,
    "recentClickedCategoryBoost": 7,
    "topPositionBoostFactor": 0.85,
    "midPositionBoostFactor": 1.1,
    "inStockBoost": 20,
    "outOfStockPenalty": 35,
    "nearbyShopBoost": 14,
    "nearbyShopRadiusKm": 12,
    "warnIfSlowerThanMilliseconds": 50
  },
  "BackgroundJobs": {
    "SessionAwareRerankTuning": {
      "enabled": true,
      "startupDelaySeconds": 180,
      "intervalHours": 24,
      "lookbackDays": 7,
      "minimumImpressions": 100,
      "maxAdjustmentRatio": 0.1,
      "topPositionBoostFactorMin": 0.5,
      "topPositionBoostFactorMax": 1.0,
      "midPositionBoostFactorMin": 1.0,
      "midPositionBoostFactorMax": 2.0,
      "requestTimeoutSeconds": 5,
      "configOverridePath": "App_Data/session-aware-rerank-tuning.json"
    }
  },
  "IdleSession": {
    "Enabled": true,
    "WarningAfterMinutes": 19,
    "AutoLogoutAfterWarningMinutes": 1,
    "AuthenticationLifetimeMinutes": 120,
    "ServerSessionIdleTimeoutMinutes": 120
  },
  "Security": {
    "GoogleRecaptcha": {
      "SiteKey": "",
      "SecretKey": "",
      "VerificationEndpoint": "https://www.google.com/recaptcha/api/siteverify",
      "SignUpAction": "signup",
      "MinimumScore": 0.5
    }
  }
}
