{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SessionStore": {
    "Provider": "Memory",
    "RedisConnectionString": "",
    "InstanceName": "FreshFarm:",
    "ConnectTimeoutMilliseconds": 5000,
    "AbortOnConnectFail": false,
    "Ssl": false
  },
  "IdleSession": {
    "Enabled": true,
    "WarningAfterMinutes": 10,
    "AutoLogoutAfterWarningMinutes": 2,
    "AuthenticationLifetimeMinutes": 120,
    "ServerSessionIdleTimeoutMinutes": 120
  }
}
