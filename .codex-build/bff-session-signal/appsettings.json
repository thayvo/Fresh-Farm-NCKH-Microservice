{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SessionStore": {
    "Provider": "Memory",
    "RedisConnectionString": "",
    "InstanceName": "FreshFarm:",
    "ConnectTimeoutMilliseconds": 5000,
    "AbortOnConnectFail": false,
    "Ssl": false
  },
  "IdleSession": {
    "Enabled": true,
    "WarningAfterMinutes": 19,
    "AutoLogoutAfterWarningMinutes": 1,
    "AuthenticationLifetimeMinutes": 120,
    "ServerSessionIdleTimeoutMinutes": 120
  },
  "Security": {
    "GoogleRecaptcha": {
      "SiteKey": "",
      "SecretKey": "",
      "VerificationEndpoint": "https://www.google.com/recaptcha/api/siteverify",
      "SignUpAction": "signup",
      "MinimumScore": 0.5
    }
  }
}
