{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataProtection": {
    "CertificateThumbprint": ""
  },
  "GeoIp": {
    "BaseUrl": "https://ipwho.is/",
    "TimeoutSeconds": 2,
    "CacheHours": 6
  },
  "Services": {
    "Ordering": {
      "BaseUrl": "https://localhost:7018",
      "InternalServiceKey": "freshfarm-dev-internal-key"
    }
  },
  "InternalBff": {
    "HeaderName": "X-FreshFarm-Internal-Key",
    "SharedKey": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "EnableSsl": true,
    "FromEmail": "",
    "FromName": "FreshFarm"
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30,
    "ResetUrlBase": ""
  },
  "EmailVerification": {
    "TokenLifetimeMinutes": 60,
    "VerifyUrlBase": ""
  },
  "AllowedHosts": "*"
}
