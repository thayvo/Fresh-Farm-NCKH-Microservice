@{
    Layout = null;
    var keyword = ViewData["SearchKeyword"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Khám phá shop - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    @await Html.PartialAsync("_MarketplaceChromeStyles")
    <style>
        :root { --ff-green:#16a34a; --ff-orange:#f97316; --ff-border:#e5e7eb; --ff-soft:#f8fafc; }
        body { font-family:var(--marketplace-font); background:linear-gradient(180deg,#f8fafc 0%,#ffffff 45%,#f8fafc 100%); color:#0f172a; }
        .page-shell { padding:28px 0 48px; }
        .hero { background:linear-gradient(135deg,rgba(22,163,74,.12),rgba(249,115,22,.08)); border:1px solid #dbeafe; border-radius:24px; padding:24px; margin-bottom:18px; }
        .hero h1 { font-size:clamp(1.8rem,3vw,2.6rem); font-weight:900; margin-bottom:10px; }
        .hero p { color:#475569; max-width:760px; margin-bottom:0; }
        .toolbar { display:flex; gap:12px; flex-wrap:wrap; align-items:center; justify-content:space-between; margin-bottom:16px; }
        .search-box { display:flex; gap:10px; width:min(100%,560px); }
        .search-box input { border-radius:14px; border:1px solid var(--ff-border); padding:12px 14px; }
        .btn-discover { border:0; border-radius:14px; padding:12px 16px; background:var(--ff-orange); color:#fff; font-weight:800; }
        .summary { color:#64748b; font-size:.95rem; }
        .shop-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
        .shop-card { background:#fff; border:1px solid var(--ff-border); border-radius:20px; padding:18px; box-shadow:0 18px 40px rgba(15,23,42,.05); }
        .shop-head { display:grid; grid-template-columns:auto 1fr; gap:12px; align-items:center; margin-bottom:12px; }
        .shop-avatar,.shop-fallback { width:60px; height:60px; border-radius:18px; object-fit:cover; display:grid; place-items:center; background:#dcfce7; color:#166534; font-weight:900; }
        .shop-name { font-size:1.08rem; font-weight:900; margin-bottom:3px; }
        .shop-user { color:#64748b; font-size:.9rem; }
        .shop-meta { display:grid; gap:8px; color:#475569; font-size:.93rem; margin-bottom:14px; }
        .shop-link { display:inline-flex; align-items:center; justify-content:center; width:100%; border-radius:12px; padding:11px 14px; text-decoration:none; font-weight:800; color:#166534; border:1px solid #bbf7d0; background:#f0fdf4; }
        .shop-link:hover { color:#9a3412; border-color:#fdba74; background:#fff7ed; }
        .state-box { background:#fff; border:1px dashed #cbd5e1; border-radius:18px; padding:36px 20px; text-align:center; color:#64748b; }
        @@media (max-width: 991.98px) { .shop-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
        @@media (max-width: 767.98px) { .shop-grid { grid-template-columns:1fr; } .search-box { width:100%; } }
    </style>
</head>
<body>
    @await Html.PartialAsync("_PromoBarLegacy")
    @await Html.PartialAsync("_HeaderLegacy")
    @await Html.PartialAsync("_NavLegacy")
    <main class="container page-shell">
        <section class="hero">
            <h1>Khám phá shop nông sản</h1>
            <p>Tìm các seller đang hoạt động trên FreshFarm, xem khu vực hoạt động và đi thẳng vào gian hàng công khai của họ.</p>
        </section>
        <div class="toolbar">
            <form id="shopSearchForm"
                  class="search-box"
                  data-shops-page
                  data-initial-keyword="@keyword"
                  data-endpoint-base="/bff/shops">
                <input id="shopSearchInput" name="q" value="@keyword" class="form-control" placeholder="Tìm theo tên shop, username, tỉnh/thành..." />
                <button class="btn-discover" type="submit">Tìm shop</button>
            </form>
            <div id="shopSummary" class="summary">Đang tải shop...</div>
        </div>
        <div id="shopEmpty" class="state-box d-none"></div>
        <div id="shopGrid" class="shop-grid"></div>
    </main>
    <script src="~/js/shops-page.js"></script>
</body>
</html>
