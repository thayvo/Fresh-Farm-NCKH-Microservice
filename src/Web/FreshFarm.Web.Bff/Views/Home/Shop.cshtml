@{
    Layout = null;
    var sellerId = ViewData["SellerId"] is int idValue ? idValue : 0;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isBuyerEligible = isAuthenticated && !User.IsInRole("Seller") && !User.IsInRole("Admin");
    var signInUrl = Url.Action("SignIn", "Account", new { returnUrl = $"/shop/{sellerId}#shop-chat" }) ?? $"/account/signin?returnUrl=%2Fshop%2F{sellerId}%23shop-chat";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gian hàng - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    @await Html.PartialAsync("_MarketplaceChromeStyles")
    <style>
        :root { --ff-green:#16a34a; --ff-orange:#f97316; --ff-border:#e5e7eb; --ff-soft:#f8fafc; }
        body { font-family:var(--marketplace-font); background-color:#f8f9fa; color:var(--text-color); }
        .page-shell { padding:28px 0 48px; }
        .back-link { display:inline-flex; align-items:center; gap:8px; margin-bottom:16px; color:#166534; text-decoration:none; font-weight:700; }
        .shop-hero { background:linear-gradient(135deg,rgba(22,163,74,.12),rgba(249,115,22,.08)); border:1px solid #dbeafe; border-radius:24px; padding:22px; display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:center; margin-bottom:18px; }
        .shop-avatar,.shop-fallback { width:88px; height:88px; border-radius:24px; object-fit:cover; display:grid; place-items:center; background:#dcfce7; color:#166534; font-size:1.6rem; font-weight:900; }
        .shop-name { font-size:clamp(1.8rem,3vw,2.5rem); font-weight:900; margin-bottom:8px; }
        .shop-meta { display:flex; flex-wrap:wrap; gap:10px; color:#475569; }
        .meta-chip { background:#fff; border:1px solid var(--ff-border); border-radius:999px; padding:8px 12px; }
        .grid-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
        .grid-head h2 { margin:0; font-size:1.25rem; font-weight:900; }
        .shop-chat-card { background:#fff; border:1px solid var(--ff-border); border-radius:22px; box-shadow:0 18px 40px rgba(15,23,42,.05); padding:18px; margin-bottom:18px; }
        .shop-chat-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
        .shop-chat-head h2 { margin:0; font-size:1.15rem; font-weight:900; }
        .shop-chat-kicker { color:#166534; font-size:.9rem; font-weight:700; }
        .shop-chat-shell { display:grid; gap:14px; }
        .shop-chat-toolbar { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }
        .shop-chat-title { font-size:1rem; font-weight:800; }
        .shop-chat-badge { display:inline-flex; align-items:center; justify-content:center; margin-left:8px; padding:4px 9px; border-radius:999px; background:#fee2e2; color:#b91c1c; font-size:.72rem; font-weight:800; vertical-align:middle; }
        .shop-chat-subtitle { color:#64748b; font-size:.9rem; }
        .shop-chat-messages { background:#f8fafc; border:1px solid var(--ff-border); border-radius:18px; padding:14px; min-height:220px; max-height:360px; overflow:auto; display:grid; gap:10px; }
        .shop-chat-message { display:flex; }
        .shop-chat-message.buyer { justify-content:flex-end; }
        .shop-chat-message.seller { justify-content:flex-start; }
        .shop-chat-bubble { max-width:min(100%, 480px); border-radius:18px; padding:12px 14px; box-shadow:0 10px 24px rgba(15,23,42,.05); }
        .shop-chat-bubble.buyer { background:#dcfce7; color:#14532d; }
        .shop-chat-bubble.seller { background:#fff; border:1px solid var(--ff-border); color:#0f172a; }
        .shop-chat-actor { font-size:.78rem; font-weight:800; margin-bottom:4px; text-transform:uppercase; letter-spacing:.03em; }
        .shop-chat-time { margin-top:8px; color:#64748b; font-size:.8rem; }
        .shop-chat-reply { border-left:3px solid #86efac; padding-left:10px; margin-bottom:8px; color:#334155; font-size:.88rem; }
        .shop-chat-reply-label { font-size:.76rem; font-weight:800; text-transform:uppercase; margin-bottom:2px; }
        .shop-chat-compose { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:end; }
        .shop-chat-input { width:100%; border:1px solid var(--ff-border); border-radius:16px; padding:12px 14px; resize:vertical; min-height:88px; }
        .shop-chat-input:focus { outline:none; border-color:#16a34a; box-shadow:0 0 0 4px rgba(22,163,74,.12); }
        .shop-chat-send,.shop-chat-signin { display:inline-flex; justify-content:center; align-items:center; border-radius:14px; padding:12px 16px; border:0; background:#16a34a; color:#fff; text-decoration:none; font-weight:800; min-width:130px; }
        .shop-chat-send:hover,.shop-chat-signin:hover { background:#15803d; color:#fff; }
        .shop-chat-send:disabled { opacity:.65; cursor:not-allowed; }
        .shop-chat-prompt { background:linear-gradient(135deg,rgba(22,163,74,.08),rgba(249,115,22,.08)); border:1px dashed #bbf7d0; border-radius:18px; padding:18px; color:#334155; }
        .shop-chat-prompt-title { font-size:1rem; font-weight:900; margin-bottom:6px; color:#14532d; }
        .shop-chat-empty { color:#64748b; text-align:center; padding:28px 16px; }
        .product-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
        .product-card { background:#fff; border:1px solid var(--ff-border); border-radius:18px; overflow:hidden; box-shadow:0 18px 40px rgba(15,23,42,.05); }
        .product-thumb { display:block; width:100%; aspect-ratio:1/1; object-fit:cover; }
        .product-body { padding:14px; display:grid; gap:8px; }
        .product-name { font-size:1rem; font-weight:800; color:#0f172a; text-decoration:none; min-height:46px; }
        .product-name:hover { color:#ea580c; }
        .product-meta { color:#64748b; font-size:.9rem; }
        .product-price { color:#ef4444; font-size:1.18rem; font-weight:900; }
        .product-link { display:inline-flex; justify-content:center; align-items:center; border-radius:12px; padding:10px 12px; border:1px solid #fdba74; background:#fff7ed; color:#9a3412; text-decoration:none; font-weight:800; }
        .product-link:hover { background:#ffedd5; color:#9a3412; }
        .state-box { background:#fff; border:1px dashed #cbd5e1; border-radius:18px; padding:38px 22px; text-align:center; color:#64748b; }
        @@media all and (max-width: 1199.98px) { .product-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
        @@media all and (max-width: 991.98px) { .product-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
        @@media all and (max-width: 767.98px) { .shop-hero { grid-template-columns:1fr; } .product-grid { grid-template-columns:1fr; } }
    </style>
</head>
<body>
    @await Html.PartialAsync("_PromoBarLegacy")
    @await Html.PartialAsync("_HeaderLegacy")
    @await Html.PartialAsync("_NavLegacy")
    <main class="container page-shell">
        <a class="back-link" href="/shop"><i class="bi bi-arrow-left"></i> Quay lại khám phá shop</a>
        <div id="shopLoading" class="state-box">
            <div class="spinner-border text-success mb-3" role="status"></div>
            <div>Đang tải gian hàng...</div>
        </div>
        <div id="shopError" class="state-box d-none"></div>
        <div id="shopRoot" class="d-none"></div>
    </main>
    <form id="shopChatAntiForgeryForm" class="d-none" method="post">
        @Html.AntiForgeryToken()
    </form>
    <div id="shopPageConfig"
         class="d-none"
         data-shop-page
         data-seller-id="@sellerId"
         data-is-authenticated="@(isAuthenticated ? "true" : "false")"
         data-is-buyer-eligible="@(isBuyerEligible ? "true" : "false")"
         data-signin-url="@signInUrl"
         data-shop-endpoint="/bff/shops/@sellerId"
         data-products-endpoint="/bff/products?sellerId=@sellerId"
         data-product-fallback-image="@ProductImagePaths.FallbackImageRequestPath"
         data-product-upload-root="@ProductImagePaths.UploadFolderRequestPath"
         data-support-chat-hub-url="/hubs/support-chat"></div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/public-shop-chat.js" asp-append-version="true"></script>
    <script src="~/js/shop-page.js" asp-append-version="true"></script>
</body>
</html>
