@{
    Layout = null;
}
@using FreshFarm.Web.Bff.Services
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trang Chủ - FreshFarm</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" rel="stylesheet" />

    @await Html.PartialAsync("_MarketplaceChromeStyles")
    <style>
        body {
            font-family: var(--marketplace-font);
            background-color: #f8f9fa;
            color: var(--text-color);
        }

        #bannerCarousel .carousel-inner img {
            border-radius: .5rem;
            max-height: 420px;
            object-fit: cover;
        }

        .carousel-control-prev,
        .carousel-control-next {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            transition: all .4s linear;
            position: absolute;
            top: 50%;
        }

        .carousel-control-prev {
            left: 5%;
            transform: translate(0, -50%);
        }

        .carousel-control-next {
            right: 5%;
            transform: translate(0, -50%);
        }

        .carousel-control-prev:hover,
        .carousel-control-next:hover {
            background-color: var(--primary-green);
            border: 1px solid #fff;
        }

        .category-container {
            padding-inline: 52px;
            overflow: hidden;
        }

        .category-scroll-wrapper {
            scroll-behavior: smooth;
            overflow-x: auto;
            overflow-y: hidden;
            gap: 16px;
            padding-block: 6px;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .category-scroll-wrapper::-webkit-scrollbar {
            display: none;
        }

        .category-item {
            flex: 0 0 auto;
            width: clamp(184px, 18vw, 220px);
            height: 132px;
            transition: box-shadow .3s ease;
        }

        .category-item img {
            object-fit: cover;
            transition: transform .4s ease;
        }

        .category-item:hover img {
            transform: scale(1.1);
        }

        .category-name {
            font-size: 1.05rem;
            line-height: 1.3;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, .9);
            max-width: 170px;
            white-space: normal;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .scroll-btn {
            width: 40px;
            height: 40px;
            top: 50%;
            transform: translateY(-50%);
            transition: all .2s ease-in-out;
            background-color: #fff;
            color: var(--primary-green);
        }

        .scroll-btn:hover {
            background-color: var(--primary-green) !important;
            color: #fff;
            border-color: var(--primary-green) !important;
        }

        .scroll-btn.btn-prev {
            left: 8px;
        }

        .scroll-btn.btn-next {
            right: 8px;
        }

        .product-card {
            transition: transform .2s ease, box-shadow .2s ease;
            position: relative;
            overflow: hidden;
        }

        .product-image-wrapper {
            position: relative;
            width: 100%;
            padding-bottom: 100%;
            overflow: hidden;
        }

        .product-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform .4s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.1);
        }

        .product-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, .5);
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 1rem;
            opacity: 0;
            visibility: hidden;
            transition: opacity .4s ease, visibility .4s ease;
        }

        .product-card:hover .product-overlay {
            opacity: 1;
            visibility: visible;
        }

        .product-card:hover .card-body {
            opacity: 0;
            transition: opacity .3s ease;
        }

        .product-overlay .view-details {
            color: #fff;
            text-decoration: none;
            transition: opacity .2s;
        }

        .product-overlay .view-details:hover {
            opacity: .8;
        }

        .mySwiper-suggest .swiper-button-prev,
        .mySwiper-suggest .swiper-button-next {
            background-color: rgba(255, 255, 255, .9);
            color: var(--primary-green);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            box-shadow: 0 0 6px rgba(0, 0, 0, .15);
        }

        .mySwiper-suggest .swiper-button-prev::after,
        .mySwiper-suggest .swiper-button-next::after {
            font-size: 16px;
        }

        .suggestion-fallback-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }

        .empty-state {
            border: 1px dashed #ced4da;
            border-radius: 14px;
            background: #fff;
            color: #6c757d;
            padding: 2rem;
            text-align: center;
        }

        .popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, .6);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 0;
            pointer-events: none;
        }

        .popup-overlay.show {
            display: flex;
            pointer-events: auto;
            animation: fadeIn .3s ease-out forwards;
        }

        @@keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        .popup-container {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, .3);
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow: hidden;
            transform: scale(.9) translateY(-20px);
        }

        .popup-overlay.show .popup-container {
            animation: popupEnter .4s cubic-bezier(.34, 1.56, .64, 1) forwards;
        }

        @@keyframes popupEnter {
            to {
                transform: scale(1) translateY(0);
            }
        }

        .popup-header {
            background: linear-gradient(135deg, var(--primary-green) 0%, #20c997 100%);
            color: #fff;
            padding: 30px 25px 25px;
            position: relative;
            text-align: center;
        }

        .popup-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 320'><path fill='rgba(255,255,255,0.1)' d='M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,138.7C960,139,1056,117,1152,101.3C1248,85,1344,75,1392,69.3L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z'></path></svg>") no-repeat bottom;
            background-size: cover;
            opacity: .3;
        }

        .welcome-icon {
            width: 70px;
            height: 70px;
            background: rgba(255, 255, 255, .2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 35px;
            position: relative;
            animation: bounce 2s infinite;
        }

        @@keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .popup-title {
            font-size: 26px;
            font-weight: 700;
            margin: 0;
            position: relative;
        }

        .popup-subtitle {
            font-size: 14px;
            opacity: .95;
            margin-top: 8px;
            position: relative;
        }

        .btn-close-popup {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(255, 255, 255, .2);
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .3s ease;
            z-index: 1;
        }

        .btn-close-popup:hover {
            background: rgba(255, 255, 255, .3);
            transform: rotate(90deg);
        }

        .popup-body {
            padding: 25px;
            max-height: 400px;
            overflow-y: auto;
        }

        .popup-body::-webkit-scrollbar {
            width: 6px;
        }

        .popup-body::-webkit-scrollbar-thumb {
            background: var(--primary-green);
            border-radius: 3px;
        }

        .coupon-card {
            background: #fff;
            border: 2px dashed var(--primary-green);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            position: relative;
            overflow: hidden;
            transition: all .3s ease;
            animation: slideIn .5s ease-out backwards;
        }

        .coupon-card:nth-child(1) {
            animation-delay: .1s;
        }

        .coupon-card:nth-child(2) {
            animation-delay: .2s;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .coupon-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, .15);
        }

        .coupon-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(180deg, var(--primary-green) 0%, #20c997 100%);
        }

        .coupon-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .coupon-code {
            background: linear-gradient(135deg, var(--primary-green) 0%, #20c997 100%);
            color: #fff;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 1px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(40, 167, 69, .3);
        }

        .coupon-badge {
            background: #ffc107;
            color: #000;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .coupon-body {
            padding-left: 10px;
        }

        .coupon-description {
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 10px;
            line-height: 1.6;
        }

        .coupon-info {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #495057;
        }

        .info-item i {
            color: var(--primary-green);
            font-size: 14px;
        }

        .expiry-warning {
            background: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 10px;
            border-radius: 6px;
            margin-top: 10px;
            font-size: 13px;
            color: #856404;
        }

        .popup-footer {
            padding: 20px 25px;
            background: #f8f9fa;
            text-align: center;
            border-top: 1px solid #e9ecef;
        }

        .btn-continue {
            background: linear-gradient(135deg, var(--primary-green) 0%, #20c997 100%);
            color: #fff;
            border: none;
            padding: 12px 40px;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all .3s ease;
            box-shadow: 0 4px 15px rgba(40, 167, 69, .3);
        }

        .btn-continue:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(40, 167, 69, .4);
        }

        .footer-link {
            color: #ccc;
            text-decoration: none;
            display: block;
            margin-bottom: .4rem;
            transition: color .2s;
        }

        .footer-link:hover {
            color: var(--primary-green);
        }

        .social-icon {
            color: #ccc;
            font-size: 1.3rem;
            transition: color .3s, transform .3s;
        }

        .social-icon:hover {
            color: var(--primary-green);
            transform: translateY(-2px);
        }

        @@media (max-width: 1199.98px) {
            .header-main-wrap {
                gap: 14px;
            }

            .header-brand-wrap {
                min-width: 200px;
            }

            .header-search-wrap {
                min-width: 260px;
            }
        }

        @@media (max-width: 991.98px) {
            .header-main-wrap {
                align-items: flex-start;
            }

            .header-brand-wrap {
                flex: 0 0 100%;
                min-width: 0;
            }

            .header-search-wrap {
                flex: 1 1 100%;
                min-width: 0;
            }

            .header-actions-wrap {
                margin-left: 0;
                justify-content: flex-end;
            }
        }

        @@media (max-width: 767.98px) {
            .header-cart-link span {
                display: none !important;
            }

            .header-cart-link i {
                font-size: 1.4rem;
            }

            .header-cart-panel {
                width: min(92vw, 360px);
                right: -8px;
            }

            .header-cart-name {
                font-size: .95rem;
            }

            .header-cart-price {
                font-size: .92rem;
            }
        }

        @@media (max-width: 576px) {
            .popup-container {
                width: 95%;
                margin: 10px;
            }

            .popup-header {
                padding: 25px 20px 20px;
            }

            .popup-title {
                font-size: 22px;
            }

            .coupon-code {
                font-size: 16px;
                padding: 6px 12px;
            }
        }
    </style>
</head>
<body>
    @await Html.PartialAsync("_PromoBarLegacy")
    @await Html.PartialAsync("_HeaderLegacy")
    @await Html.PartialAsync("_NavLegacy")

    <div id="bannerCarousel" class="carousel slide mt-3 container position-relative" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="2"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active"><img src="https://images.pexels.com/photos/2252584/pexels-photo-2252584.jpeg" class="d-block w-100" alt="Banner 1" /></div>
            <div class="carousel-item"><img src="https://images.pexels.com/photos/1435904/pexels-photo-1435904.jpeg" class="d-block w-100" alt="Banner 2" /></div>
            <div class="carousel-item"><img src="https://images.pexels.com/photos/1656663/pexels-photo-1656663.jpeg" class="d-block w-100" alt="Banner 3" /></div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
        <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
    </div>

    <section id="section-categories" class="bg-light py-5 position-relative">
        <div class="container position-relative">
            <h2 class="fw-bold mb-4 text-success">Danh mục</h2>
            <div class="category-container">
                <div class="category-scroll-wrapper d-flex overflow-hidden" id="categoryWrapper"></div>
            </div>
            <button class="scroll-btn btn-prev btn btn-white border rounded-circle shadow-sm position-absolute d-flex align-items-center justify-content-center z-3" id="btnPrev"><i class="bi bi-chevron-left"></i></button>
            <button class="scroll-btn btn-next btn btn-white border rounded-circle shadow-sm position-absolute d-flex align-items-center justify-content-center z-3" id="btnNext"><i class="bi bi-chevron-right"></i></button>
        </div>
    </section>

    <section id="section-suggest" class="container my-5">
        <h2 class="text-center fw-bold mb-4">Gợi Ý Hôm Nay</h2>
        <div class="swiper mySwiper-suggest">
            <div id="suggestionWrapper" class="swiper-wrapper"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
        <div id="suggestionEmpty" class="empty-state d-none mt-3">Chưa có sản phẩm gợi ý.</div>
    </section>

    <section id="section-featured" class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h2 class="fw-bold mb-0">Sản phẩm nổi bật</h2>
            <a href="#section-featured" class="btn btn-outline-success fw-semibold">Xem thêm <i class="bi bi-arrow-right"></i></a>
        </div>

        <div id="featuredGrid" class="row g-4"></div>
        <div id="featuredEmpty" class="empty-state d-none">Không có sản phẩm để hiển thị.</div>
    </section>

    <div class="popup-overlay" id="welcomePopup">
        <div class="popup-container">
            <div class="popup-header">
                <button class="btn-close-popup" type="button" data-popup-close="welcome"><i class="bi bi-x-lg"></i></button>
                <div class="welcome-icon">🎉</div>
                <h2 class="popup-title">Chào mừng bạn trở lại!</h2>
                <p class="popup-subtitle">Bạn có 2 ưu đãi đặc biệt đang chờ</p>
            </div>
            <div class="popup-body">
                <div class="coupon-card">
                    <div class="coupon-header">
                        <div class="coupon-code"><i class="bi bi-ticket-perforated-fill"></i> FRESH10</div>
                        <span class="coupon-badge">Giảm %</span>
                    </div>
                    <div class="coupon-body">
                        <p class="coupon-description">Giảm 10% cho đơn từ 300.000₫.</p>
                        <div class="coupon-info">
                            <div class="info-item">
                                <i class="bi bi-calendar-check"></i>
                                <span>Hết hạn: 31/12/2026</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-cart-check"></i>
                                <span>Đơn tối thiểu: 300.000₫</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-tag"></i>
                                <span>Giảm: 10%</span>
                            </div>
                        </div>
                        <div class="expiry-warning">
                            <i class="bi bi-clock"></i> Còn 6 ngày để sử dụng
                        </div>
                    </div>
                </div>
                <div class="coupon-card">
                    <div class="coupon-header">
                        <div class="coupon-code"><i class="bi bi-ticket-perforated-fill"></i> SHIPFREE</div>
                        <span class="coupon-badge">Giảm ngay</span>
                    </div>
                    <div class="coupon-body">
                        <p class="coupon-description">Miễn phí vận chuyển toàn quốc, không giới hạn đơn tối thiểu.</p>
                        <div class="coupon-info">
                            <div class="info-item">
                                <i class="bi bi-calendar-check"></i>
                                <span>Hết hạn: 31/12/2026</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-infinity"></i>
                                <span>Không giới hạn đơn tối thiểu</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-tag"></i>
                                <span>Giảm: 100% phí vận chuyển</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="popup-footer">
                <button class="btn-continue" type="button" data-popup-close="welcome"><i class="bi bi-bag-heart me-2"></i>Bắt đầu mua sắm</button>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_FooterLegacy")
    @await Html.PartialAsync("_ToastLegacy")
    <form id="homeAntiForgeryForm" class="d-none" method="post">
        @Html.AntiForgeryToken()
    </form>
    <div id="homePageConfig"
         class="d-none"
         data-fallback-image="@ProductImagePaths.FallbackImageRequestPath"
         data-upload-folder="@ProductImagePaths.UploadFolderRequestPath"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/home-page.js" asp-append-version="true"></script>
    <script src="~/js/home-welcome-popup.js" asp-append-version="true"></script>
    <script src="~/js/csp-phase2.js" asp-append-version="true"></script>
</body>
</html>
