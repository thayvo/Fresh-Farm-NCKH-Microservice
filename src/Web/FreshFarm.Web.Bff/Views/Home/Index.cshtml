@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sản phẩm - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-green: #28a745;
        }

        body {
            background: #f4f7f5;
        }

        .page-wrap {
            max-width: 1180px;
            margin: 40px auto;
            padding: 0 12px;
        }

        .hero-banner {
            border-radius: 18px;
            background: linear-gradient(135deg, #ecfff2 0%, #f7fffb 65%, #ffffff 100%);
            border: 1px solid #d7f1e4;
        }

        .hero-title {
            color: #0f172a;
            font-weight: 800;
            letter-spacing: -.02em;
        }

        .search-box .form-control:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 .25rem rgba(40, 167, 69, .15);
        }

        .btn-main {
            background: var(--primary-green);
            border-color: var(--primary-green);
            color: #fff;
        }

        .btn-main:hover {
            background: #1f8a3a;
            border-color: #1f8a3a;
            color: #fff;
        }

        .product-card {
            border: 0;
            border-radius: 14px;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .75rem 1.5rem rgba(2, 8, 20, .08);
        }

        .product-image-wrapper {
            position: relative;
            width: 100%;
            padding-bottom: 72%;
            overflow: hidden;
            border-radius: 10px;
            background: #eef5ef;
        }

        .product-image-wrapper .product-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .product-price {
            color: var(--primary-green);
            font-weight: 700;
        }

        .empty-box {
            border: 1px dashed #cbd5e1;
            border-radius: 14px;
            background: #fff;
        }
    </style>
</head>
<body>
    <main class="page-wrap">
        <section class="hero-banner p-4 p-md-5 mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-lg-7">
                    <h1 class="hero-title mb-2">Nông sản sạch mỗi ngày</h1>
                    <p class="text-muted mb-0">
                        Chọn sản phẩm tươi mới từ FreshFarm và đặt hàng ngay trong vài bước.
                    </p>
                </div>
                <div class="col-lg-5">
                    <div class="search-box">
                        <div class="input-group">
                            <input id="keywordInput" class="form-control form-control-lg" placeholder="Tìm theo tên sản phẩm..." />
                            <button id="searchBtn" class="btn btn-main btn-lg" type="button">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div id="statusBox" class="alert alert-info d-none" role="alert"></div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Danh sách sản phẩm</h4>
            <small id="resultCount" class="text-muted"></small>
        </div>

        <section id="productGrid" class="row g-3"></section>
    </main>

    <script>
        (() => {
            const productGrid = document.getElementById("productGrid");
            const keywordInput = document.getElementById("keywordInput");
            const searchBtn = document.getElementById("searchBtn");
            const statusBox = document.getElementById("statusBox");
            const resultCount = document.getElementById("resultCount");

            const endpointBase = "/bff/products";

            const escapeHtml = (value) => {
                const text = value ?? "";
                return text
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#39;");
            };

            const toVnd = (value) => {
                const amount = Number(value);
                const safe = Number.isFinite(amount) ? amount : 0;
                return safe.toLocaleString("vi-VN") + " ₫";
            };

            const normalizeProduct = (raw) => {
                const productId = raw.productID ?? raw.productId ?? raw.ProductID ?? raw.ProductId ?? 0;
                const productName = raw.productName ?? raw.ProductName ?? "Không rõ tên";
                const categoryName = raw.categoryName ?? raw.CategoryName ?? "Chưa phân loại";
                const unitName = raw.unitName ?? raw.UnitName ?? "đơn vị";
                const price = raw.price ?? raw.Price ?? 0;

                return { productId, productName, categoryName, unitName, price };
            };

            const showStatus = (message, type = "info") => {
                statusBox.className = `alert alert-${type}`;
                statusBox.textContent = message;
                statusBox.classList.remove("d-none");
            };

            const hideStatus = () => {
                statusBox.classList.add("d-none");
                statusBox.textContent = "";
            };

            const buildBuyNowUrl = (product) => {
                const query = new URLSearchParams({
                    productId: String(product.productId),
                    productName: product.productName,
                    unitPrice: String(product.price),
                    unitSymbol: product.unitName
                });
                return "/checkout?" + query.toString();
            };

            const renderProducts = (items) => {
                if (!Array.isArray(items) || items.length === 0) {
                    productGrid.innerHTML = `
                        <div class="col-12">
                            <div class="empty-box p-4 text-center text-muted">
                                Không tìm thấy sản phẩm phù hợp.
                            </div>
                        </div>`;
                    resultCount.textContent = "0 sản phẩm";
                    return;
                }

                const cards = items.map(normalizeProduct).map((product) => `
                    <div class="col-sm-6 col-lg-4">
                        <article class="card product-card shadow-sm h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="product-image-wrapper mb-3">
                                    <img class="product-image"
                                         src="https://images.pexels.com/photos/1656663/pexels-photo-1656663.jpeg"
                                         alt="${escapeHtml(product.productName)}" />
                                </div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge text-bg-light border">${escapeHtml(product.categoryName)}</span>
                                    <span class="small text-muted">Mã: #${escapeHtml(String(product.productId))}</span>
                                </div>
                                <h5 class="fw-semibold mb-2">${escapeHtml(product.productName)}</h5>
                                <p class="text-muted small mb-3">Đơn vị: ${escapeHtml(product.unitName)}</p>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <div class="product-price">${toVnd(product.price)}</div>
                                    <a href="${buildBuyNowUrl(product)}" class="btn btn-main btn-sm">
                                        <i class="bi bi-bag-check me-1"></i>Mua ngay
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                `).join("");

                productGrid.innerHTML = cards;
                resultCount.textContent = `${items.length} sản phẩm`;
            };

            const fetchProducts = async (keyword = "") => {
                try {
                    showStatus("Đang tải danh sách sản phẩm...", "info");
                    const url = keyword
                        ? `${endpointBase}?name=${encodeURIComponent(keyword)}`
                        : endpointBase;

                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    if (!response.ok) {
                        const body = await response.text();
                        showStatus(`Không tải được sản phẩm (${response.status}). ${body || ""}`.trim(), "danger");
                        productGrid.innerHTML = "";
                        resultCount.textContent = "";
                        return;
                    }

                    const data = await response.json();
                    renderProducts(data);
                    hideStatus();
                } catch (error) {
                    showStatus("Lỗi kết nối khi tải sản phẩm. Vui lòng thử lại.", "danger");
                    productGrid.innerHTML = "";
                    resultCount.textContent = "";
                    console.error(error);
                }
            };

            searchBtn.addEventListener("click", () => {
                fetchProducts(keywordInput.value.trim());
            });

            keywordInput.addEventListener("keydown", (event) => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    fetchProducts(keywordInput.value.trim());
                }
            });

            fetchProducts();
        })();
    </script>
</body>
</html>
