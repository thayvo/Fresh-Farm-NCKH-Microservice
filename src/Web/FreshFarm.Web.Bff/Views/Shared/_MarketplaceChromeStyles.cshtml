<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<style>
    :root {
        --primary-green: #28a745;
        --secondary-green: #1f8f3a;
        --text-color: #333;
        --border-color: #e0e0e0;
        --danger-color: #dc3545;
        --secondary-yellow: #ffb524;
        --text-green: #28a745;
        --marketplace-font: "Be Vietnam Pro", "Segoe UI", Roboto, sans-serif;
    }

    .promo-bar {
        background: linear-gradient(90deg, #18a85f 0%, #0b8f4d 100%);
        color: #fff;
        font-size: .875rem;
    }

    .promo-inner {
        min-height: 28px;
    }

    .promo-links {
        white-space: nowrap;
    }

    .promo-links a {
        color: #fff;
        text-decoration: none;
        opacity: .95;
    }

    .promo-links a:hover {
        opacity: 1;
        text-decoration: underline;
    }

    .promo-links i {
        margin-right: .2rem;
    }

    .promo-account-dropdown {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .promo-account-trigger {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #fff;
        text-decoration: none;
        opacity: .95;
        padding: 2px 0;
    }

    .promo-account-trigger:hover {
        color: #fff;
        opacity: 1;
        text-decoration: none;
    }

    .promo-account-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 210px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
        border: 1px solid #e5e7eb;
        padding: 6px 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: all .2s ease;
        z-index: 30;
    }

    .promo-account-menu::before {
        content: "";
        position: absolute;
        top: -7px;
        right: 18px;
        width: 12px;
        height: 12px;
        background: #fff;
        border-top: 1px solid #e5e7eb;
        border-left: 1px solid #e5e7eb;
        transform: rotate(45deg);
    }

    .promo-account-dropdown:hover .promo-account-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .promo-account-item {
        display: flex;
        width: 100%;
        border: 0;
        background: transparent;
        color: #111827 !important;
        text-decoration: none !important;
        padding: 10px 14px;
        font-size: .98rem;
        line-height: 1.25;
        text-align: left;
        white-space: nowrap;
        cursor: pointer;
    }

    .promo-account-item:hover {
        background: #f3f4f6;
        color: #0f172a !important;
    }

    .promo-account-btn {
        font: inherit;
    }

    .header-main-shell {
        background: #fff;
        padding: 14px 0 12px;
    }

    .header-main-wrap {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .header-brand-wrap {
        flex: 0 0 auto;
        min-width: 230px;
    }

    .brand-logo-wrap {
        width: 54px;
        height: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .brand-logo {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        background: linear-gradient(135deg, #12b76a 0%, #28a745 100%);
        color: #fff;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        letter-spacing: .02em;
        box-shadow: 0 8px 20px rgba(40, 167, 69, .25);
    }

    .brand-logo-image {
        width: 54px;
        height: 54px;
        object-fit: contain;
        display: block;
    }

    .brand-text {
        color: #111827;
        font-weight: 800;
        letter-spacing: .03em;
        line-height: 1.1;
    }

    .brand-sub {
        color: #6b7280;
        font-size: .78rem;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .brand-slogan-image {
        display: block;
        max-width: 190px;
        width: 100%;
        height: auto;
        margin-top: 2px;
    }

    .brand-slogan-image-footer {
        max-width: 170px;
    }

    .social-icon-image {
        width: 22px;
        height: 22px;
        object-fit: contain;
        display: block;
    }

    .header-search-wrap {
        flex: 1 1 540px;
        min-width: 320px;
    }

    .header-search-form {
        display: flex;
        align-items: stretch;
        border: 2px solid var(--primary-green);
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
    }

    .header-search-input {
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        padding: .7rem .9rem;
        font-size: 1.03rem;
    }

    .header-search-btn {
        border-radius: 0;
        min-width: 60px;
        border: 0;
        font-size: 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--primary-green);
        color: #fff;
    }

    .header-search-btn:hover {
        background-color: var(--secondary-green);
        color: #fff;
    }

    .header-search-keywords {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
        margin-top: 8px;
        padding-left: 2px;
    }

    .header-search-keywords a {
        color: #6b7280;
        text-decoration: none;
        font-size: .88rem;
        transition: color .2s ease;
    }

    .header-search-keywords a:hover {
        color: var(--primary-green);
    }

    .header-actions-wrap {
        flex: 0 0 auto;
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }

    .header-cart-link {
        color: #334155;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        line-height: 1;
        padding: 2px 0;
        position: relative;
    }

    .header-cart-link i {
        font-size: 1.7rem;
    }

    .header-cart-link:hover {
        color: var(--primary-green);
    }

    .header-cart-badge {
        position: absolute;
        top: -10px;
        right: -14px;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 999px;
        background: #fff;
        color: #ee4d2d;
        border: 2px solid #ee4d2d;
        font-size: .78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .header-cart-dropdown {
        position: relative;
    }

    .header-cart-panel {
        position: absolute;
        top: calc(100% + 14px);
        right: 0;
        width: 380px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, .2);
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: all .2s ease;
        z-index: 30;
        overflow: hidden;
    }

    .header-cart-panel::before {
        content: "";
        position: absolute;
        top: -8px;
        right: 26px;
        width: 14px;
        height: 14px;
        background: #fff;
        border-top: 1px solid #e5e7eb;
        border-left: 1px solid #e5e7eb;
        transform: rotate(45deg);
    }

    .header-cart-dropdown:hover .header-cart-panel,
    .header-cart-dropdown:focus-within .header-cart-panel {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .header-cart-title {
        padding: 12px 14px;
        font-size: .98rem;
        color: #9ca3af;
        border-bottom: 1px solid #f1f5f9;
    }

    .header-cart-empty {
        padding: 16px 14px 18px;
        color: #64748b;
        font-size: .95rem;
    }

    .header-cart-list {
        max-height: 320px;
        overflow-y: auto;
    }

    .header-cart-item {
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        text-decoration: none;
        color: #111827;
        border-bottom: 1px solid #f8fafc;
    }

    .header-cart-item:hover {
        background: #f8fafc;
        color: #111827;
    }

    .header-cart-thumb {
        width: 54px;
        height: 54px;
        object-fit: cover;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        background: #fff;
    }

    .header-cart-name-wrap {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .header-cart-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 1.02rem;
    }

    .header-cart-qty {
        color: #64748b;
        font-size: .82rem;
    }

    .header-cart-price {
        color: #ee4d2d;
        font-weight: 600;
        font-size: .98rem;
        margin-left: 8px;
        white-space: nowrap;
    }

    .header-cart-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 10px 14px;
        background: #fff;
    }

    .header-cart-meta {
        color: #374151;
        font-size: .95rem;
    }

    .header-cart-view-btn {
        border: 0;
        border-radius: 6px;
        background: #ee4d2d;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        padding: 8px 14px;
        white-space: nowrap;
    }

    .header-cart-view-btn:hover {
        background: #d94425;
        color: #fff;
    }

    .header-action-link {
        border: 0;
        background: transparent;
        color: #334155;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        padding: 0;
        line-height: 1;
    }

    .header-action-link i {
        font-size: 1.3rem;
    }

    .header-action-link:hover {
        color: var(--primary-green);
    }

    .header-action-btn:focus-visible {
        outline: 2px solid var(--primary-green);
        outline-offset: 2px;
    }

    .header-hello {
        font-size: .85rem;
        color: #6b7280;
        margin-right: 2px;
    }

    .btn-search {
        background-color: var(--primary-green);
        border-color: var(--primary-green);
        color: #fff;
    }

    .btn-search:hover {
        background-color: var(--secondary-green);
        border-color: var(--secondary-green);
        color: #fff;
    }

    .navbar-main {
        background: #fff;
        border-top: 1px solid #ebedf0;
        border-bottom: 1px solid #ebedf0;
    }

    .navbar-main .nav-link {
        position: relative;
        color: #333;
        transition: color .3s ease, text-shadow .3s ease;
        font-weight: 500;
    }

    .navbar-main .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 0%;
        height: 2px;
        background-color: var(--text-green);
        transition: width .3s ease;
    }

    .navbar-main .nav-link:hover {
        color: #000;
        text-shadow: 0 0 1px rgba(0, 0, 0, .35);
    }

    .navbar-main .nav-link:hover::after,
    .navbar-main .nav-link.active::after {
        width: 100%;
    }

    .navbar-main .nav-link.active {
        color: var(--primary-green);
    }

    .floating-chat-widget {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 1080;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .floating-chat-launcher {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff;
        padding: 14px 18px;
        box-shadow: 0 18px 48px rgba(21, 128, 61, .32);
        min-width: 0;
    }

    .floating-chat-launcher:hover {
        background: linear-gradient(135deg, #15803d, #166534);
    }

    .floating-chat-launcher-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .18);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex: 0 0 auto;
    }

    .floating-chat-launcher-copy {
        display: grid;
        text-align: left;
        line-height: 1.2;
    }

    .floating-chat-launcher-copy strong {
        font-size: .98rem;
        font-weight: 800;
    }

    .floating-chat-launcher-copy span {
        font-size: .8rem;
        opacity: .92;
    }

    .floating-chat-launcher-badge {
        position: absolute;
        top: -8px;
        right: -4px;
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        border-radius: 999px;
        background: #ef4444;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-weight: 800;
        border: 2px solid #fff;
    }

    .floating-chat-panel {
        width: min(920px, calc(100vw - 32px));
        height: min(620px, calc(100vh - 120px));
        background: rgba(255, 255, 255, .98);
        border: 1px solid rgba(226, 232, 240, .95);
        border-radius: 26px;
        box-shadow: 0 28px 80px rgba(15, 23, 42, .22);
        overflow: hidden;
        display: none;
        backdrop-filter: blur(18px);
    }

    .floating-chat-widget.is-open .floating-chat-panel {
        display: flex;
        flex-direction: column;
    }

    .floating-chat-panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 22px;
        background: linear-gradient(135deg, rgba(22, 163, 74, .14), rgba(255, 255, 255, .96));
        border-bottom: 1px solid rgba(226, 232, 240, .95);
    }

    .floating-chat-panel-title {
        font-size: 1.12rem;
        font-weight: 800;
        color: #0f172a;
    }

    .floating-chat-panel-subtitle {
        color: #64748b;
        font-size: .9rem;
        margin-top: 4px;
    }

    .floating-chat-panel-actions {
        display: inline-flex;
        gap: 8px;
    }

    .floating-chat-icon-btn {
        width: 40px;
        height: 40px;
        border: 1px solid rgba(203, 213, 225, .9);
        border-radius: 12px;
        background: #fff;
        color: #0f172a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .floating-chat-icon-btn:hover {
        border-color: #16a34a;
        color: #16a34a;
        background: #f0fdf4;
    }

    .floating-chat-panel-body {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        min-height: 0;
        flex: 1 1 auto;
    }

    .floating-chat-sidebar {
        border-right: 1px solid rgba(226, 232, 240, .95);
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .floating-chat-sidebar-toolbar {
        display: grid;
        gap: 12px;
        padding: 18px 18px 14px;
    }

    .floating-chat-search {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(203, 213, 225, .95);
        border-radius: 14px;
        padding: 0 12px;
        background: #fff;
    }

    .floating-chat-search i {
        color: #94a3b8;
    }

    .floating-chat-search input {
        border: 0;
        outline: none;
        width: 100%;
        padding: 11px 0;
        background: transparent;
        color: #0f172a;
    }

    .floating-chat-filters {
        display: inline-flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .floating-chat-filters button {
        border: 1px solid rgba(203, 213, 225, .95);
        border-radius: 999px;
        background: #fff;
        color: #475569;
        padding: 8px 12px;
        font-size: .82rem;
        font-weight: 700;
    }

    .floating-chat-filters button.is-active {
        border-color: #16a34a;
        background: #dcfce7;
        color: #166534;
    }

    .floating-chat-conversation-list {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 0 8px 12px;
    }

    .floating-chat-list-state {
        color: #64748b;
        text-align: center;
        padding: 36px 16px;
        font-size: .92rem;
    }

    .floating-chat-conversation-item {
        width: 100%;
        border: 0;
        background: transparent;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 12px;
        padding: 12px;
        border-radius: 18px;
        text-align: left;
        margin-bottom: 4px;
    }

    .floating-chat-conversation-item:hover,
    .floating-chat-conversation-item.is-active {
        background: #fff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, .08);
    }

    .floating-chat-conversation-avatar,
    .floating-chat-thread-avatar {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        object-fit: cover;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dcfce7;
        color: #166534;
        font-weight: 800;
        flex: 0 0 auto;
    }

    .floating-chat-conversation-main {
        min-width: 0;
        display: grid;
        gap: 4px;
    }

    .floating-chat-conversation-head,
    .floating-chat-conversation-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .floating-chat-conversation-name {
        font-weight: 800;
        color: #0f172a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .floating-chat-conversation-time {
        color: #94a3b8;
        font-size: .78rem;
        flex: 0 0 auto;
    }

    .floating-chat-conversation-preview,
    .floating-chat-conversation-address {
        color: #64748b;
        font-size: .84rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .floating-chat-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 4px 8px;
        font-size: .74rem;
        font-weight: 800;
    }

    .floating-chat-pill.unread {
        background: #fee2e2;
        color: #b91c1c;
    }

    .floating-chat-pill.closed {
        background: #e2e8f0;
        color: #475569;
    }

    .floating-chat-detail {
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .floating-chat-detail-empty,
    .floating-chat-guest-state {
        margin: auto;
        max-width: 420px;
        text-align: center;
        padding: 28px;
        color: #475569;
    }

    .floating-chat-empty-icon {
        width: 72px;
        height: 72px;
        border-radius: 24px;
        margin: 0 auto 18px;
        background: linear-gradient(135deg, rgba(22, 163, 74, .14), rgba(249, 115, 22, .12));
        color: #16a34a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .floating-chat-detail-empty h3,
    .floating-chat-guest-state h3 {
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .floating-chat-empty-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 16px;
        border-radius: 999px;
        padding: 11px 18px;
        background: #16a34a;
        color: #fff;
        text-decoration: none;
        font-weight: 800;
    }

    .floating-chat-empty-action:hover {
        background: #15803d;
        color: #fff;
    }

    .floating-chat-thread {
        display: flex;
        flex-direction: column;
        min-height: 0;
        flex: 1 1 auto;
    }

    .floating-chat-thread-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        padding: 18px 22px 16px;
        border-bottom: 1px solid rgba(226, 232, 240, .95);
    }

    .floating-chat-thread-shop {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .floating-chat-thread-name {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .floating-chat-thread-meta {
        color: #64748b;
        font-size: .86rem;
        margin-top: 4px;
    }

    .floating-chat-thread-status {
        border-radius: 999px;
        padding: 8px 12px;
        background: #dcfce7;
        color: #166534;
        font-size: .78rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .floating-chat-thread-status.is-closed {
        background: #e2e8f0;
        color: #475569;
    }

    .floating-chat-thread-messages {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 20px 22px;
        display: grid;
        gap: 12px;
        align-content: flex-start;
    }

    .floating-chat-message-row {
        display: flex;
    }

    .floating-chat-message-row.from-buyer {
        justify-content: flex-end;
    }

    .floating-chat-message-row.from-seller {
        justify-content: flex-start;
    }

