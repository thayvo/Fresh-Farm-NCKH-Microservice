@{
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var isOrderMenuActive = currentAction is "orderhistory" or "orderdetail";
    var isProfileMenuActive = currentAction is "profile" or "accountprofile" or "profileupdate";
    var isSellerApplicationActive = currentAction is "becomeseller";
    var isNotificationsMenuActive = currentAction is "notifications";
    var sellerApplication = ViewData["SellerApplicationSummary"] as FreshFarm.Web.Bff.Dtos.SellerApplicationSummaryDto;
    var accountNotificationSummary = ViewData["AccountNotificationSummary"] as FreshFarm.Web.Bff.Dtos.AccountNotificationNavSummaryDto;
    var hasSellerAlert = sellerApplication?.HasSellerReviewAlert ?? false;
    var sellerAlertTone = sellerApplication?.SellerReviewAlertTone ?? "secondary";
    var sellerAlertLabel = sellerApplication?.ReviewStatusLabel ?? "Cập nhật";
    var notificationCount = accountNotificationSummary?.UnreadCount ?? 0;
    var notificationRecentCount = accountNotificationSummary?.RecentCount ?? 0;
    var notificationPriorityLabel = accountNotificationSummary?.PriorityLabel ?? string.Empty;
    var notificationPrioritySummary = accountNotificationSummary?.PrioritySummary ?? string.Empty;
    var notificationHighlights = accountNotificationSummary?.Sections ?? new List<FreshFarm.Web.Bff.Dtos.AccountNotificationNavSectionSummaryDto>();
}
<div class="col-lg-3">
    <div class="card border-0 shadow-sm account-nav">
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                <a href="/account/profile"
                   class="list-group-item list-group-item-action @(isProfileMenuActive ? "active" : string.Empty)">
                    <i class="bi bi-person-circle me-2"></i>Thông tin tài khoản
                </a>
                <a href="/account/orders"
                   class="list-group-item list-group-item-action @(isOrderMenuActive ? "active" : string.Empty)">
                    <i class="bi bi-receipt me-2"></i>Lịch sử đơn hàng
                </a>
                <div class="list-group-item @(isNotificationsMenuActive ? "active" : string.Empty)">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <a href="@accountNotificationSummary?.NotificationsUrl"
                           class="text-decoration-none @(isNotificationsMenuActive ? "text-white" : "text-dark") flex-grow-1">
                            <i class="bi bi-bell me-2"></i>Thông báo tài khoản
                            @if (notificationCount > 0)
                            {
                                <span class="badge text-bg-danger ms-2">@notificationCount</span>
                            }
                        </a>
                        @if (notificationRecentCount > 0)
                        {
                            <a href="@accountNotificationSummary?.RecentNotificationsUrl"
                               class="badge text-bg-light text-dark border text-decoration-none">
                                @notificationRecentCount mới
                            </a>
                        }
                    </div>
                    @if (accountNotificationSummary?.HasHighlights == true)
                    {
                        <div class="small text-muted mt-2">
                            @if (!string.IsNullOrWhiteSpace(notificationPriorityLabel))
                            {
                                <div class="fw-semibold">
                                    <a href="@accountNotificationSummary?.PriorityNotificationsUrl"
                                       class="text-decoration-none @(isNotificationsMenuActive ? "text-white" : "text-dark")">
                                        @notificationPriorityLabel
                                    </a>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(notificationPrioritySummary))
                            {
                                <div>@notificationPrioritySummary</div>
                            }
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var highlight in notificationHighlights)
                                {
                                    <a href="@highlight.NavigateUrl"
                                       class="badge @(highlight.HasUnread ? "text-bg-danger" : "text-bg-light text-dark border") text-decoration-none">
                                        @(highlight.Label): @highlight.HeroSummaryText
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
                <a href="/account/become-seller"
                   class="list-group-item list-group-item-action @(isSellerApplicationActive ? "active" : string.Empty)">
                    <i class="bi bi-shop-window me-2"></i>Đăng ký người bán
                    @if (hasSellerAlert)
                    {
                        <span class="badge text-bg-@sellerAlertTone ms-2">@sellerAlertLabel</span>
                    }
                </a>
                <a href="/"
                   class="list-group-item list-group-item-action">
                    <i class="bi bi-house-door me-2"></i>Trang chủ
                </a>
            </div>
        </div>
        <div class="card-footer bg-white border-0 pt-0">
            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                </button>
            </form>
        </div>
    </div>
</div>
