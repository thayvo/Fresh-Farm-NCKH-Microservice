@model FreshFarm.Web.Bff.Dtos.ProfilePageViewModel
@{
    var returnUrl = Model?.ReturnUrl;
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = "/account/profile";
    }

    var ghnConfigured = ViewBag.GhnSandboxConfigured as bool? ?? false;
}

<div class="modal fade" id="createAddressModal" tabindex="-1" aria-labelledby="createAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="createAddressModalLabel">
                    <i class="bi bi-geo-alt me-2 text-success"></i>Thêm địa chỉ mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <form asp-controller="Account"
                  asp-action="CreateAddress"
                  method="post"
                  class="needs-validation ghn-address-form"
                  novalidate
                  data-ghn-form="true">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Người nhận</label>
                            <input class="form-control"
                                   name="RecipientName"
                                   placeholder="Nhập họ và tên người nhận"
                                   maxlength="100"
                                   required />
                            <div class="invalid-feedback">Vui lòng nhập tên người nhận.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input class="form-control"
                                   name="Phone"
                                   placeholder="0xxxxxxxxx"
                                   required
                                   pattern="^0\d{9}$"
                                   maxlength="10"
                                   minlength="10" />
                            <div class="invalid-feedback">Số điện thoại phải gồm 10 chữ số và bắt đầu bằng 0.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Số nhà, tên đường</label>
                            <input class="form-control ghn-street-input"
                                   name="AddressDetail"
                                   placeholder="Số nhà, tên đường, khu vực..."
                                   maxlength="255"
                                   required />
                            <div class="invalid-feedback">Vui lòng nhập số nhà, tên đường.</div>
                            <div class="form-text">Phường/xã, quận/huyện và tỉnh/thành sẽ lấy theo lựa chọn GHN bên dưới.</div>
                        </div>

                        <div class="col-12">
                            <div class="profile-address-picker p-3 rounded-3 border">
                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-3">
                                    <div>
                                        <div class="fw-semibold">Khu vực nhận hàng</div>
                                        <div class="small text-muted">Chọn tỉnh/thành, quận/huyện và phường/xã theo danh mục GHN.</div>
                                    </div>
                                    @if (!ghnConfigured)
                                    {
                                        <span class="badge text-bg-warning">GHN chưa sẵn sàng</span>
                                    }
                                </div>

                                @if (!ghnConfigured)
                                {
                                    <div class="alert alert-warning py-2 px-3 small mb-0">
                                        Hệ thống chưa tải được danh mục địa chỉ GHN. Vui lòng kiểm tra cấu hình GHN trước khi thêm địa chỉ mới.
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Tỉnh/Thành</label>
                                            <select class="form-select ghn-province-select" data-selected-id="">
                                                <option value="">Đang tải tỉnh/thành...</option>
                                            </select>
                                            <input type="hidden" name="Province" class="ghn-province-name" value="" />
                                            <div class="invalid-feedback">Vui lòng chọn tỉnh/thành.</div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Quận/Huyện</label>
                                            <select class="form-select ghn-district-select" data-selected-id="">
                                                <option value="">Chọn tỉnh/thành trước</option>
                                            </select>
                                            <input type="hidden" name="District" class="ghn-district-name" value="" />
                                            <div class="invalid-feedback">Vui lòng chọn quận/huyện.</div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Phường/Xã</label>
                                            <select class="form-select ghn-ward-select" data-selected-code="">
                                                <option value="">Chọn quận/huyện trước</option>
                                            </select>
                                            <input type="hidden" name="Ward" class="ghn-ward-name" value="" />
                                            <div class="invalid-feedback">Vui lòng chọn phường/xã.</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input type="hidden" name="IsDefault" value="false" />
                        <input class="form-check-input" type="checkbox" value="true" id="isDefaultAddress" name="IsDefault" />
                        <label class="form-check-label" for="isDefaultAddress">
                            Đặt làm địa chỉ mặc định
                        </label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save me-2"></i>Lưu địa chỉ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
