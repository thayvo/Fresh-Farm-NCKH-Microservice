@using FreshFarm.Web.Bff.Services
@{
    var currentPath = Context.Request.Path.HasValue ? Context.Request.Path.Value! : "/";
    var currentQuery = Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty;
    var currentUrl = $"{currentPath}{currentQuery}";
}

<footer class="bg-dark text-white pt-5 pb-4">
    <div class="container text-center text-md-start">
        <div class="row gy-4">
            <div class="col-md-4">
                <div class="d-flex align-items-center mb-3 gap-2">
                    <span class="brand-logo-wrap">
                        <img src="@WebAssetPaths.LogoRequestPath"
                             alt="Logo FreshFarm"
                             class="brand-logo-image"
                             onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                        <span class="brand-logo d-none">FF</span>
                    </span>
                    <div>
                        <div class="fw-bold">FreshFarm</div>
                        <img src="@WebAssetPaths.SloganRequestPath"
                             alt="Nông sản sạch mỗi ngày"
                             class="brand-slogan-image brand-slogan-image-footer"
                             onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                        <div class="small text-light-emphasis d-none">Nông sản sạch mỗi ngày</div>
                    </div>
                </div>
                <p class="small text-light-emphasis">
                    FreshFarm mang đến những sản phẩm nông sản sạch, an toàn và chất lượng cao,
                    vì sức khỏe của mỗi gia đình Việt.
                </p>
            </div>

            <div class="col-6 col-md-2">
                <h6 class="text-uppercase fw-bold mb-3" style="color:var(--primary-green)">Về chúng tôi</h6>
                <ul class="list-unstyled mb-0">
                    <li><a href="#" class="footer-link">Giới thiệu</a></li>
                    <li><a href="#" class="footer-link">Liên hệ</a></li>
                    <li><a href="#" class="footer-link">Chính sách giao hàng</a></li>
                    <li><a href="#" class="footer-link">Chính sách đổi trả</a></li>
                </ul>
            </div>

            <div class="col-6 col-md-2">
                <h6 class="text-uppercase fw-bold mb-3" style="color:var(--primary-green)">Tài khoản</h6>
                <ul class="list-unstyled mb-0">
                    <li>
                        <a asp-controller="Account"
                           asp-action="SignIn"
                           asp-route-returnUrl="@currentUrl"
                           class="footer-link">Đăng nhập</a>
                    </li>
                    <li><a href="/account/orders" class="footer-link">Lịch sử đơn hàng</a></li>
                    <li><a href="#section-featured" class="footer-link">Sản phẩm</a></li>
                    <li><a asp-controller="Account" asp-action="Terms" class="footer-link">Điều khoản sử dụng</a></li>
                    <li><a asp-controller="Account" asp-action="PrivacyPolicy" class="footer-link">Chính sách quyền riêng tư</a></li>
                </ul>
            </div>

            <div class="col-md-4">
                <h6 class="text-uppercase fw-bold mb-3" style="color:var(--primary-green)">Liên hệ</h6>
                <p><i class="bi bi-geo-alt-fill me-2"></i>123 Đường ABC, Quận 1, TP.HCM</p>
                <p><i class="bi bi-envelope-fill me-2"></i>support@freshfarm.vn</p>
                <p><i class="bi bi-telephone-fill me-2"></i>+84 123 456 789</p>

                <div class="mt-3 d-flex gap-3">
                    <a href="https://www.facebook.com/" target="_blank" rel="noopener" class="social-icon" aria-label="Facebook">
                        <img src="@WebAssetPaths.FacebookIconRequestPath" alt="Facebook" class="social-icon-image" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                        <i class="bi bi-facebook d-none"></i>
                    </a>
                    <a href="https://www.instagram.com/" target="_blank" rel="noopener" class="social-icon" aria-label="Instagram">
                        <img src="@WebAssetPaths.InstagramIconRequestPath" alt="Instagram" class="social-icon-image" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                        <i class="bi bi-instagram d-none"></i>
                    </a>
                    <a href="https://zalo.me/" target="_blank" rel="noopener" class="social-icon" aria-label="Zalo">
                        <img src="@WebAssetPaths.ZaloIconRequestPath" alt="Zalo" class="social-icon-image" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                        <i class="bi bi-chat-dots d-none"></i>
                    </a>
                    <a href="https://www.google.com/" target="_blank" rel="noopener" class="social-icon" aria-label="Google">
                        <img src="@WebAssetPaths.GoogleIconRequestPath" alt="Google" class="social-icon-image" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                        <i class="bi bi-google d-none"></i>
                    </a>
                    <a href="https://www.tiktok.com/" target="_blank" rel="noopener" class="social-icon" aria-label="TikTok">
                        <img src="@WebAssetPaths.TikTokIconRequestPath" alt="TikTok" class="social-icon-image" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');" />
                        <i class="bi bi-tiktok d-none"></i>
                    </a>
                </div>
            </div>
        </div>

        <hr class="border-secondary mt-4 mb-3" />
        <div class="text-center small text-light-emphasis">
            © 2026 Bản quyền thuộc về <strong class="text-success">FreshFarm</strong>
        </div>
    </div>
</footer>
