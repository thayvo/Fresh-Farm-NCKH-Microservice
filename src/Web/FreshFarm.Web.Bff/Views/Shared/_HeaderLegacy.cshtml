@using System.Globalization
@using FreshFarm.Web.Bff.Dtos
@using FreshFarm.Web.Bff.Services
@inject ICartSessionService CartSessionService
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var searchKeyword = Context.Request.Query["q"].ToString();
    var cartItems = isAuthenticated ? await CartSessionService.GetItemsAsync() : new List<CartItemDto>();
    var totalQuantity = cartItems.Sum(x => x.Quantity <= 0 ? 1 : x.Quantity);
    var previewItems = cartItems.AsEnumerable().Reverse().Take(5).ToList();
    var previewQuantity = previewItems.Sum(x => x.Quantity <= 0 ? 1 : x.Quantity);
    var remainingQuantity = Math.Max(0, totalQuantity - previewQuantity);
    string Vnd(decimal amount) => string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", amount);
    string ProductThumb(CartItemDto item) => ProductImagePaths.ResolveRequestPath(item.ImageFileName);
}

<header class="header-main-shell border-bottom">
    <div class="container">
        <div class="header-main-wrap">
            <div class="header-brand-wrap">
                <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
                    <span class="brand-logo-wrap">
                        <img src="@WebAssetPaths.LogoRequestPath"
                             alt="Logo FreshFarm"
                             class="brand-logo-image"
                             data-fallback-toggle-target="headerLogoFallback" />
                        <span id="headerLogoFallback" class="brand-logo d-none">FF</span>
                    </span>
                    <span>
                        <span class="d-block brand-text">FRESHFARM</span>
                        <img src="@WebAssetPaths.SloganRequestPath"
                             alt="Nông sản sạch mỗi ngày"
                             class="brand-slogan-image"
                             data-fallback-toggle-target="headerSloganFallback" />
                        <span id="headerSloganFallback"
                              class="brand-sub d-none"
                              data-fallback-remove-class="d-none"
                              data-fallback-add-class="d-inline">Nông sản sạch mỗi ngày</span>
                    </span>
                </a>
            </div>

            <div class="header-search-wrap">
                <form id="headerSearchForm" class="header-search-form" autocomplete="off" method="get" action="/search">
                    <input id="headerSearchInput"
                           name="q"
                           class="form-control header-search-input"
                           type="search"
                           placeholder="Tìm kiếm nông sản, trái cây, rau sạch..."
                           value="@searchKeyword" />
                    <button class="btn btn-search header-search-btn" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
                <div class="header-search-keywords d-none d-md-flex">
                    <a href="#" data-header-keyword="Rau sạch">Rau sạch</a>
                    <a href="#" data-header-keyword="Trái cây">Trái cây</a>
                    <a href="#" data-header-keyword="Nông sản hữu cơ">Nông sản hữu cơ</a>
                    <a href="#" data-header-keyword="Thực phẩm tươi">Thực phẩm tươi</a>
                    <a href="#" data-header-keyword="Giao nhanh">Giao nhanh</a>
                </div>
            </div>

            <div class="header-actions-wrap">
                @if (isAuthenticated)
                {
                    <div class="header-cart-dropdown">
                        <a href="/cart" class="header-cart-link" title="Giỏ hàng">
                            <i class="bi bi-cart3"></i><span class="d-none d-md-inline">Giỏ hàng</span>
                            @if (totalQuantity > 0)
                            {
                                <span class="header-cart-badge">@totalQuantity</span>
                            }
                        </a>

                        <div class="header-cart-panel">
                            <div class="header-cart-title">Sản phẩm mới thêm</div>

                            @if (previewItems.Count == 0)
                            {
                                <div class="header-cart-empty">Giỏ hàng của bạn đang trống.</div>
                            }
                            else
                            {
                                <div class="header-cart-list">
                                    @foreach (var item in previewItems)
                                    {
                                        var qty = item.Quantity <= 0 ? 1 : item.Quantity;
                                        <a href="/cart" class="header-cart-item">
                                            <img class="header-cart-thumb"
                                                 src="@ProductThumb(item)"
                                                 alt="@item.ProductName"
                                                 data-fallback-src="@ProductImagePaths.FallbackImageRequestPath" />
                                            <span class="header-cart-name-wrap">
                                                <span class="header-cart-name">@item.ProductName</span>
                                                <span class="header-cart-qty">@($"x{qty}")</span>
                                            </span>
                                            <span class="header-cart-price">@Vnd(item.UnitPrice)</span>
                                        </a>
                                    }
                                </div>

                                <div class="header-cart-footer">
                                    @if (remainingQuantity > 0)
                                    {
                                        <span class="header-cart-meta">Còn @remainingQuantity sản phẩm trong giỏ</span>
                                    }
                                    else
                                    {
                                        <span class="header-cart-meta">@totalQuantity sản phẩm trong giỏ</span>
                                    }
                                    <a href="/cart" class="header-cart-view-btn">Xem Giỏ Hàng</a>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="SignIn"
                       asp-route-returnUrl="/cart"
                       class="header-cart-link"
                       title="Giỏ hàng">
                        <i class="bi bi-cart3"></i><span class="d-none d-md-inline">Giỏ hàng</span>
                    </a>
                }
            </div>
        </div>
    </div>
</header>
