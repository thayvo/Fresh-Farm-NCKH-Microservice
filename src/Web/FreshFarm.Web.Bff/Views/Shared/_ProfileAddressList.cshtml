@model FreshFarm.Web.Bff.Dtos.ProfilePageViewModel
@using System.Linq
@{
    var addresses = Model?.Addresses ?? new List<FreshFarm.Web.Bff.Dtos.ProfileAddressItemDto>();
    var returnUrl = Model?.ReturnUrl;
    var ghnConfigured = ViewBag.GhnSandboxConfigured as bool? ?? false;
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = "/account/profile";
    }
}

@if (!addresses.Any())
{
    <div class="border rounded-3 p-4 text-center bg-light-subtle">
        <div class="mb-2"><i class="bi bi-geo-alt fs-2 text-success"></i></div>
        <h6 class="fw-bold mb-1">Bạn chưa có địa chỉ nào</h6>
        <p class="text-muted mb-0">Hãy thêm địa chỉ để dùng nhanh ở bước checkout.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var address in addresses)
        {
            var editModalId = $"editAddressModal-{address.AddressId}";
            var fullAddress = string.Join(", ", new[]
            {
                address.AddressDetail,
                address.Ward,
                address.District,
                address.Province
            }.Where(x => !string.IsNullOrWhiteSpace(x)));

            <div class="col-12">
                <div class="card border-0 shadow-sm @(address.IsDefault ? "border border-success-subtle" : string.Empty)">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                            <div>
                                <h6 class="fw-bold mb-1">
                                    @address.RecipientName
                                    @if (address.IsDefault)
                                    {
                                        <span class="badge bg-success-subtle text-success ms-2">Mặc định</span>
                                    }
                                </h6>
                                <div class="text-muted mb-1">
                                    <i class="bi bi-telephone me-1"></i>@address.Phone
                                </div>
                                <div class="mb-0">
                                    <i class="bi bi-geo-alt me-1"></i>@fullAddress
                                </div>
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@editModalId">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </button>

                                <form asp-controller="Account"
                                      asp-action="SetDefaultAddress"
                                      asp-route-addressId="@address.AddressId"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit"
                                            class="btn btn-sm @(address.IsDefault ? "btn-outline-success" : "btn-success")"
                                            @(address.IsDefault ? "disabled" : null)>
                                        <i class="bi bi-check2-circle me-1"></i>
                                        @(address.IsDefault ? "Đang mặc định" : "Đặt mặc định")
                                    </button>
                                </form>

                                <form asp-controller="Account"
                                      asp-action="DeleteAddress"
                                      asp-route-addressId="@address.AddressId"
                                      method="post"
                                      class="d-inline"
                                      data-confirm-message="Bạn có chắc muốn xóa địa chỉ này không?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="@editModalId" tabindex="-1" aria-labelledby="@(editModalId)-label" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold" id="@(editModalId)-label">
                                <i class="bi bi-pencil-square me-2 text-primary"></i>Cập nhật địa chỉ
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>

                        <form asp-controller="Account"
                              asp-action="UpdateAddress"
                              asp-route-addressId="@address.AddressId"
                              method="post"
                              class="needs-validation ghn-address-form"
                              novalidate
                              data-ghn-form="true">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                            <div class="modal-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Người nhận</label>
                                        <input class="form-control"
                                               name="RecipientName"
                                               value="@address.RecipientName"
                                               maxlength="100"
                                               required />
                                        <div class="invalid-feedback">Vui lòng nhập tên người nhận.</div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Số điện thoại</label>
                                        <input class="form-control"
                                               name="Phone"
                                               value="@address.Phone"
                                               required
                                               pattern="^0\d{9}$"
                                               maxlength="10"
                                               minlength="10" />
                                        <div class="invalid-feedback">Số điện thoại phải gồm 10 chữ số và bắt đầu bằng 0.</div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-semibold">Số nhà, tên đường</label>
                                        <input class="form-control ghn-street-input"
                                               name="AddressDetail"
                                               value="@address.AddressDetail"
                                               maxlength="255"
                                               required />
                                        <div class="invalid-feedback">Vui lòng nhập số nhà, tên đường.</div>
                                        <div class="form-text">Phường/xã, quận/huyện và tỉnh/thành sẽ lấy theo lựa chọn GHN bên dưới.</div>
                                    </div>

                                    <div class="col-12">
                                        <div class="profile-address-picker p-3 rounded-3 border">
                                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-3">
                                                <div>
                                                    <div class="fw-semibold">Khu vực nhận hàng</div>
                                                    <div class="small text-muted">Chọn lại tỉnh/thành, quận/huyện và phường/xã theo danh mục GHN nếu bạn muốn đổi khu vực.</div>
                                                </div>
                                                @if (!ghnConfigured)
                                                {
                                                    <span class="badge text-bg-warning">GHN chưa sẵn sàng</span>
                                                }
                                            </div>

                                            @if (!ghnConfigured)
                                            {
                                                <div class="alert alert-warning py-2 px-3 small mb-0">
                                                    Hệ thống chưa tải được danh mục địa chỉ GHN. Vui lòng kiểm tra cấu hình GHN trước khi cập nhật địa chỉ.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold">Tỉnh/Thành</label>
                                                        <select class="form-select ghn-province-select" data-selected-id="" data-selected-name="@address.Province">
                                                            <option value="">Đang tải tỉnh/thành...</option>
                                                        </select>
                                                        <input type="hidden" name="Province" class="ghn-province-name" value="@address.Province" />
                                                        <div class="invalid-feedback">Vui lòng chọn tỉnh/thành.</div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold">Quận/Huyện</label>
                                                        <select class="form-select ghn-district-select" data-selected-id="" data-selected-name="@address.District">
                                                            <option value="">Chọn tỉnh/thành trước</option>
                                                        </select>
                                                        <input type="hidden" name="District" class="ghn-district-name" value="@address.District" />
                                                        <div class="invalid-feedback">Vui lòng chọn quận/huyện.</div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold">Phường/Xã</label>
                                                        <select class="form-select ghn-ward-select" data-selected-code="" data-selected-name="@address.Ward">
                                                            <option value="">Chọn quận/huyện trước</option>
                                                        </select>
                                                        <input type="hidden" name="Ward" class="ghn-ward-name" value="@address.Ward" />
                                                        <div class="invalid-feedback">Vui lòng chọn phường/xã.</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="form-check mt-3">
                                    <input type="hidden" name="IsDefault" value="false" />
                                    <input class="form-check-input"
                                           type="checkbox"
                                           value="true"
                                           id="isDefault-@address.AddressId"
                                           name="IsDefault"
                                           @(address.IsDefault ? "checked" : null) />
                                    <label class="form-check-label" for="isDefault-@address.AddressId">
                                        Đặt làm địa chỉ mặc định
                                    </label>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save me-2"></i>Lưu cập nhật
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
