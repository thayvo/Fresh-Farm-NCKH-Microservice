@model FreshFarm.Web.Bff.Models.CheckoutPaymentResultViewModel
@{
    Layout = null;
    var orderId = Model?.OrderId;
    var isSuccess = Model?.IsSuccess ?? false;
    var message = Model?.Message ?? "Không đọc được trạng thái thanh toán.";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kết quả thanh toán - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: "Be Vietnam Pro", "Segoe UI", sans-serif;
            background: #f8fafc;
        }

        .payment-result-card {
            max-width: 640px;
            border: 0;
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="card payment-result-card shadow-sm mx-auto">
            <div class="card-body p-4 p-md-5">
                <div class="mb-3">
                    <span class="badge @(isSuccess ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-2">
                        @(isSuccess ? "Thanh toán thành công" : "Thanh toán chưa thành công")
                    </span>
                </div>

                <h1 class="h3 fw-bold mb-3">Kết quả VNPay</h1>
                <p class="text-muted mb-3">@message</p>

                @if (orderId.HasValue)
                {
                    <div class="alert alert-light border small mb-4">
                        <strong>Mã đơn hàng: @($"#FF{orderId.Value:D6}")</strong>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2">
                    <a href="/account/orders" class="btn btn-success">Đơn hàng của tôi</a>
                    <a href="/checkout" class="btn btn-outline-secondary">Quay lại thanh toán</a>
                    <a href="/" class="btn btn-outline-secondary">Về trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
