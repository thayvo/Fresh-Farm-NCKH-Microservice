@using System.Globalization
@using System.Linq
@using FreshFarm.Web.Bff.Dtos
@model CheckoutSubmitRequestDto
@{
    Layout = null;

    var items = Model?.Items ?? new List<CheckoutItemInputDto>();
    var shipping = Model?.Shipping ?? new CheckoutShippingInputDto { ShippingType = "HomeDelivery" };
    var paymentMethod = string.IsNullOrWhiteSpace(Model?.Payment?.PaymentMethod) ? "COD" : Model!.Payment!.PaymentMethod;
    var shippingFee = (Model?.ShippingFee ?? 15000m) < 0m ? 0m : (Model?.ShippingFee ?? 15000m);
    var hasItems = items.Count > 0;

    decimal subTotal = 0m;
    foreach (var item in items)
    {
        var qty = item.Quantity <= 0 ? 1 : item.Quantity;
        var unitPrice = item.UnitPrice < 0m ? 0m : item.UnitPrice;
        subTotal += unitPrice * qty;
    }

    var grandTotal = subTotal + shippingFee;

    var savedAddresses = ViewBag.SavedAddresses as List<ProfileAddressItemDto> ?? new List<ProfileAddressItemDto>();
    var addressMode = (ViewBag.AddressMode as string)?.ToLowerInvariant() == "saved" ? "saved" : "new";
    if (savedAddresses.Count == 0)
    {
        addressMode = "new";
    }

    object? selectedAddressIdRaw = ViewBag.SelectedAddressId;
    var selectedAddressId = 0;
    if (selectedAddressIdRaw is int selectedIdFromViewBag)
    {
        selectedAddressId = selectedIdFromViewBag;
    }
    else
    {
        var selectedAddressIdText = selectedAddressIdRaw?.ToString();
        if (!string.IsNullOrWhiteSpace(selectedAddressIdText))
        {
            _ = int.TryParse(selectedAddressIdText, out selectedAddressId);
        }
    }

    var selectedAddress = savedAddresses.FirstOrDefault(x => x.AddressId == selectedAddressId)
        ?? savedAddresses.FirstOrDefault(x => x.IsDefault)
        ?? savedAddresses.FirstOrDefault();
    if (selectedAddressId == 0 && selectedAddress is not null)
    {
        selectedAddressId = selectedAddress.AddressId;
    }

    var addressLoadError = ViewBag.AddressLoadError as string;

    if (addressMode == "saved" && selectedAddress is not null)
    {
        if (string.IsNullOrWhiteSpace(shipping.FullName))
        {
            shipping.FullName = selectedAddress.RecipientName;
        }

        if (string.IsNullOrWhiteSpace(shipping.Phone))
        {
            shipping.Phone = selectedAddress.Phone;
        }

        if (string.IsNullOrWhiteSpace(shipping.AddressDetail))
        {
            shipping.AddressDetail = string.Join(", ", new[]
            {
                selectedAddress.AddressDetail,
                selectedAddress.Ward,
                selectedAddress.District,
                selectedAddress.Province
            }.Where(x => !string.IsNullOrWhiteSpace(x)));
        }
    }

    string Vnd(decimal amount) => string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", amount);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh toán - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-green: #008a4f;
        }

        body {
            background: #f8f9fa;
            min-height: 100vh;
        }

        .checkout-container {
            max-width: 1140px;
        }

        .card {
            border: 0;
            border-radius: 12px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 .25rem rgba(0, 138, 79, .2);
        }

        .payment-option {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px 14px;
            cursor: pointer;
            background: #fff;
        }

        .payment-option.active {
            border-color: var(--primary-green);
            background: rgba(0, 138, 79, .06);
        }

        .btn-success {
            background-color: var(--primary-green);
            border-color: var(--primary-green);
            color: #fff;
        }

        .btn-success:hover {
            background-color: #006a3d;
            border-color: #006a3d;
            color: #fff;
        }

        .summary-price {
            color: var(--primary-green);
        }

        .invalid-flow {
            border: 1px dashed #ef4444;
            border-radius: 10px;
            background: #fff5f5;
            color: #842029;
        }

        .checkout-item-row {
            border: 1px solid #eef2f7;
            border-radius: 10px;
            padding: 12px;
            background: #fff;
        }

        .address-mode-wrap {
            background: #f8faf9;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px;
        }
    </style>
</head>
<body>
    <div class="container my-5 checkout-container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="mb-0">Thanh toán</h2>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-grid me-1"></i>Danh sách sản phẩm
                </a>
                <a href="/cart" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-cart me-1"></i>Quay lại giỏ hàng
                </a>
                <a href="/account/orders" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-receipt me-1"></i>Đơn hàng của tôi
                </a>
            </div>
        </div>

        @if (!hasItems)
        {
            <div class="invalid-flow p-3 mb-3">
                Không có sản phẩm trong giỏ hàng để thanh toán. Vui lòng quay lại giỏ hàng.
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <form id="checkoutForm"
                      asp-controller="Checkout"
                      asp-action="Index"
                      method="post"
                      class="needs-validation"
                      novalidate>
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="Shipping.ShippingType"
                           value="@(string.IsNullOrWhiteSpace(shipping.ShippingType) ? "HomeDelivery" : shipping.ShippingType)" />
                    <input type="hidden" id="paymentMethodHidden" name="Payment.PaymentMethod" value="@paymentMethod" />

                    <div class="card shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">Sản phẩm thanh toán</h5>

                            @if (!hasItems)
                            {
                                <div class="text-muted">Giỏ hàng đang trống.</div>
                            }
                            else
                            {
                                <div class="vstack gap-2" id="checkoutItemsWrap">
                                    @for (var i = 0; i < items.Count; i++)
                                    {
                                        var item = items[i];
                                        var unitPrice = item.UnitPrice < 0m ? 0m : item.UnitPrice;
                                        var qty = item.Quantity <= 0 ? 1 : item.Quantity;
                                        var unitSymbol = string.IsNullOrWhiteSpace(item.UnitSymbol) ? "đơn vị" : item.UnitSymbol;
                                        var lineTotal = unitPrice * qty;

                                        <div class="checkout-item-row" data-item-row data-unit-price="@unitPrice.ToString(CultureInfo.InvariantCulture)">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div>
                                                    <div class="fw-semibold">Sản phẩm #@item.ProductId</div>
                                                    <small class="text-muted">Đơn vị: @unitSymbol</small>
                                                </div>
                                                <div class="text-end">
                                                    <div class="small text-muted">Đơn giá</div>
                                                    <div class="fw-semibold">@Vnd(unitPrice)</div>
                                                </div>
                                            </div>

                                            <div class="row g-2 align-items-center mt-2">
                                                <div class="col-sm-6">
                                                    <label class="form-label mb-1">Số lượng</label>
                                                    <div class="input-group input-group-sm">
                                                        <button type="button" class="btn btn-outline-secondary qty-dec">-</button>
                                                        <input type="number"
                                                               min="1"
                                                               step="1"
                                                               name="Items[@i].Quantity"
                                                               value="@qty"
                                                               class="form-control text-center qty-input" />
                                                        <button type="button" class="btn btn-outline-secondary qty-inc">+</button>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6 text-sm-end">
                                                    <div class="small text-muted">Thành tiền</div>
                                                    <div class="fw-semibold summary-price line-total">@Vnd(lineTotal)</div>
                                                </div>
                                            </div>

                                            <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                            <input type="hidden" name="Items[@i].UnitPrice" value="@unitPrice.ToString(CultureInfo.InvariantCulture)" />
                                            <input type="hidden" name="Items[@i].UnitSymbol" value="@unitSymbol" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">Thông tin giao hàng</h5>

                            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                            @if (!string.IsNullOrWhiteSpace(addressLoadError))
                            {
                                <div class="alert alert-warning py-2 px-3 small">
                                    @addressLoadError
                                </div>
                            }

                            <div class="address-mode-wrap mb-3">
                                <label class="form-label fw-semibold mb-2">Nguồn địa chỉ giao hàng</label>
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="addressMode"
                                               id="addressModeSaved"
                                               value="saved"
                                               @(addressMode == "saved" && savedAddresses.Any() ? "checked" : null)
                                               @(!savedAddresses.Any() ? "disabled" : null) />
                                        <label class="form-check-label" for="addressModeSaved">Dùng địa chỉ đã lưu</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="addressMode"
                                               id="addressModeNew"
                                               value="new"
                                               @(addressMode == "new" || !savedAddresses.Any() ? "checked" : null) />
                                        <label class="form-check-label" for="addressModeNew">Nhập địa chỉ mới</label>
                                    </div>
                                </div>

                                @if (!savedAddresses.Any())
                                {
                                    <div class="small text-muted mb-2">
                                        Bạn chưa có địa chỉ đã lưu. Hãy thêm trong
                                        <a href="/account/profile" class="text-decoration-none">Thông tin tài khoản</a>
                                        để chọn nhanh ở bước thanh toán.
                                    </div>
                                }

                                <div id="savedAddressWrap">
                                    <label class="form-label mb-1">Chọn địa chỉ đã lưu</label>
                                    <select id="savedAddressSelect"
                                            name="selectedAddressId"
                                            class="form-select"
                                            @(!savedAddresses.Any() ? "disabled" : null)>
                                        @if (savedAddresses.Any())
                                        {
                                            @foreach (var address in savedAddresses)
                                            {
                                                var optionText = string.Join(" | ", new[]
                                                {
                                                    address.RecipientName,
                                                    address.Phone,
                                                    address.AddressDetail,
                                                    address.Ward,
                                                    address.District,
                                                    address.Province
                                                }.Where(x => !string.IsNullOrWhiteSpace(x)));
                                                if (selectedAddressId == address.AddressId)
                                                {
                                                    <option value="@address.AddressId"
                                                            data-recipient-name="@address.RecipientName"
                                                            data-phone="@address.Phone"
                                                            data-address-detail="@address.AddressDetail"
                                                            data-ward="@address.Ward"
                                                            data-district="@address.District"
                                                            data-province="@address.Province"
                                                            selected>
                                                        @optionText @(address.IsDefault ? "(Mặc định)" : string.Empty)
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@address.AddressId"
                                                            data-recipient-name="@address.RecipientName"
                                                            data-phone="@address.Phone"
                                                            data-address-detail="@address.AddressDetail"
                                                            data-ward="@address.Ward"
                                                            data-district="@address.District"
                                                            data-province="@address.Province">
                                                        @optionText @(address.IsDefault ? "(Mặc định)" : string.Empty)
                                                    </option>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <option value="">Chưa có địa chỉ đã lưu để chọn.</option>
                                        }
                                    </select>
                                    <div class="invalid-feedback">Vui lòng chọn một địa chỉ đã lưu.</div>
                                    <div class="form-text">Bạn có thể đổi sang “Nhập địa chỉ mới” nếu muốn giao tới nơi khác.</div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Họ và tên</label>
                                    <input name="Shipping.FullName"
                                           id="shippingFullName"
                                           class="form-control"
                                           placeholder="Nguyễn Văn A"
                                           required
                                           maxlength="100"
                                           value="@shipping.FullName" />
                                    <div class="invalid-feedback">Vui lòng nhập họ và tên người nhận.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại</label>
                                    <input name="Shipping.Phone"
                                           id="shippingPhone"
                                           class="form-control"
                                           placeholder="09xxxxxxxx"
                                           required
                                           pattern="^0\d{9}$"
                                           maxlength="10"
                                           minlength="10"
                                           inputmode="numeric"
                                           title="Số điện thoại phải gồm 10 chữ số và bắt đầu bằng 0."
                                           value="@shipping.Phone" />
                                    <div class="invalid-feedback">Số điện thoại phải gồm 10 chữ số và bắt đầu bằng 0.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Email</label>
                                    <input name="Shipping.Email"
                                           id="shippingEmail"
                                           class="form-control"
                                           type="email"
                                           placeholder="you@example.com"
                                           maxlength="100"
                                           value="@shipping.Email" />
                                    <div class="invalid-feedback">Email không đúng định dạng.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Địa chỉ chi tiết</label>
                                    <input name="Shipping.AddressDetail"
                                           id="shippingAddressDetail"
                                           class="form-control"
                                           placeholder="Số nhà, đường, phường/xã, quận/huyện..."
                                           required
                                           maxlength="255"
                                           value="@shipping.AddressDetail" />
                                    <div class="invalid-feedback">Vui lòng nhập địa chỉ giao hàng chi tiết.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ghi chú đơn hàng</label>
                                    <textarea name="OrderNote"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao...">@Model?.OrderNote</textarea>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h5 class="fw-bold mb-3">Phương thức thanh toán</h5>
                            <div class="vstack gap-2" id="paymentOptions">
                                <label class="payment-option @(paymentMethod.Equals("COD", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" data-value="COD">
                                    <input class="form-check-input me-2" type="radio" name="payment-method-ui" value="COD" @(paymentMethod.Equals("COD", System.StringComparison.OrdinalIgnoreCase) ? "checked" : string.Empty) />
                                    <span class="fw-semibold">Thanh toán khi nhận hàng (COD)</span>
                                </label>
                                <label class="payment-option @(paymentMethod.Equals("VNPay", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" data-value="VNPay">
                                    <input class="form-check-input me-2" type="radio" name="payment-method-ui" value="VNPay" @(paymentMethod.Equals("VNPay", System.StringComparison.OrdinalIgnoreCase) ? "checked" : string.Empty) />
                                    <span class="fw-semibold">Thanh toán qua VNPay</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Tóm tắt đơn hàng</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Số dòng sản phẩm</span>
                            <strong>@items.Count</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính</span>
                            <strong id="subtotalValue">@Vnd(subTotal)</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2 align-items-center">
                            <span>Phí vận chuyển</span>
                            <div style="max-width: 150px;">
                                <input id="shippingFeeInput"
                                       name="ShippingFee"
                                       form="checkoutForm"
                                       type="number"
                                       min="0"
                                       step="1000"
                                       class="form-control form-control-sm text-end"
                                       value="@shippingFee.ToString(CultureInfo.InvariantCulture)" />
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between fs-5">
                            <span>Tổng cộng</span>
                            <strong id="grandTotalValue" class="summary-price">@Vnd(grandTotal)</strong>
                        </div>

                        <button id="submitBtn" type="submit" form="checkoutForm" class="btn btn-success w-100 mt-3" @(hasItems ? null : "disabled")>
                            <i class="bi bi-bag-check me-2"></i>Đặt hàng
                        </button>
                        <a href="/cart" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại giỏ hàng
                        </a>

                        <p class="small text-muted mt-3 mb-0">Mẹo: bạn có thể chỉnh số lượng trực tiếp trong checkout trước khi đặt đơn.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const rows = Array.from(document.querySelectorAll("[data-item-row]"));
            const shippingFeeInput = document.getElementById("shippingFeeInput");
            const subtotalValue = document.getElementById("subtotalValue");
            const grandTotalValue = document.getElementById("grandTotalValue");
            const paymentMethodHidden = document.getElementById("paymentMethodHidden");
            const paymentOptions = document.querySelectorAll("#paymentOptions .payment-option");
            const addressModeInputs = document.querySelectorAll('input[name="addressMode"]');
            const savedAddressWrap = document.getElementById("savedAddressWrap");
            const savedAddressSelect = document.getElementById("savedAddressSelect");
            const hasSavedAddressOptions = !!(savedAddressSelect && savedAddressSelect.options.length > 0 && !savedAddressSelect.disabled);
            const shippingFullNameInput = document.getElementById("shippingFullName");
            const shippingPhoneInput = document.getElementById("shippingPhone");
            const shippingAddressDetailInput = document.getElementById("shippingAddressDetail");

            const manualSnapshot = {
                fullName: shippingFullNameInput ? shippingFullNameInput.value : "",
                phone: shippingPhoneInput ? shippingPhoneInput.value : "",
                addressDetail: shippingAddressDetailInput ? shippingAddressDetailInput.value : ""
            };
            let wasSavedMode = false;
            const checkoutForm = document.getElementById("checkoutForm");

            const toNumber = (value, fallback = 0) => {
                const num = Number(value);
                return Number.isFinite(num) ? num : fallback;
            };

            const toVnd = (value) => toNumber(value, 0).toLocaleString("vi-VN") + " ₫";

            const setShippingReadonly = (isReadonly) => {
                if (shippingFullNameInput) {
                    shippingFullNameInput.readOnly = isReadonly;
                }
                if (shippingPhoneInput) {
                    shippingPhoneInput.readOnly = isReadonly;
                }
                if (shippingAddressDetailInput) {
                    shippingAddressDetailInput.readOnly = isReadonly;
                }
            };

            const applySavedAddressToShipping = () => {
                if (!savedAddressSelect || !shippingFullNameInput || !shippingPhoneInput || !shippingAddressDetailInput) {
                    return;
                }

                const selectedOption = savedAddressSelect.options[savedAddressSelect.selectedIndex];
                if (!selectedOption) {
                    return;
                }

                const parts = [
                    selectedOption.dataset.addressDetail || "",
                    selectedOption.dataset.ward || "",
                    selectedOption.dataset.district || "",
                    selectedOption.dataset.province || ""
                ].map((x) => x.trim()).filter((x) => x.length > 0);

                shippingFullNameInput.value = selectedOption.dataset.recipientName || "";
                shippingPhoneInput.value = selectedOption.dataset.phone || "";
                shippingAddressDetailInput.value = parts.join(", ");
            };

            const syncAddressModeUi = () => {
                const selectedModeInput = document.querySelector('input[name="addressMode"]:checked');
                const mode = selectedModeInput ? selectedModeInput.value : "new";
                const useSavedMode = mode === "saved" && hasSavedAddressOptions;

                if (mode === "saved" && !hasSavedAddressOptions) {
                    const newModeInput = document.getElementById("addressModeNew");
                    if (newModeInput instanceof HTMLInputElement) {
                        newModeInput.checked = true;
                    }
                }

                if (savedAddressWrap) {
                    savedAddressWrap.style.display = useSavedMode ? "" : "none";
                }

                if (useSavedMode && !wasSavedMode) {
                    if (shippingFullNameInput) {
                        manualSnapshot.fullName = shippingFullNameInput.value;
                    }
                    if (shippingPhoneInput) {
                        manualSnapshot.phone = shippingPhoneInput.value;
                    }
                    if (shippingAddressDetailInput) {
                        manualSnapshot.addressDetail = shippingAddressDetailInput.value;
                    }
                }

                if (useSavedMode) {
                    applySavedAddressToShipping();
                    setShippingReadonly(true);
                } else {
                    setShippingReadonly(false);
                    if (wasSavedMode) {
                        if (shippingFullNameInput) {
                            shippingFullNameInput.value = manualSnapshot.fullName;
                        }
                        if (shippingPhoneInput) {
                            shippingPhoneInput.value = manualSnapshot.phone;
                        }
                        if (shippingAddressDetailInput) {
                            shippingAddressDetailInput.value = manualSnapshot.addressDetail;
                        }
                    }
                }

                if (savedAddressSelect) {
                    savedAddressSelect.required = !!useSavedMode;
                }
                if (shippingFullNameInput) {
                    shippingFullNameInput.required = !useSavedMode;
                }
                if (shippingPhoneInput) {
                    shippingPhoneInput.required = !useSavedMode;
                }
                if (shippingAddressDetailInput) {
                    shippingAddressDetailInput.required = !useSavedMode;
                }

                wasSavedMode = !!useSavedMode;
            };

            const recalcTotal = () => {
                let subTotal = 0;

                rows.forEach((row) => {
                    const unitPrice = toNumber(row.getAttribute("data-unit-price"), 0);
                    const qtyInput = row.querySelector(".qty-input");
                    const lineTotalNode = row.querySelector(".line-total");

                    const qty = qtyInput
                        ? Math.max(1, toNumber(qtyInput.value, 1))
                        : 1;

                    if (qtyInput) {
                        qtyInput.value = String(qty);
                    }

                    const lineTotal = unitPrice * qty;
                    subTotal += lineTotal;

                    if (lineTotalNode) {
                        lineTotalNode.textContent = toVnd(lineTotal);
                    }
                });

                const shippingFee = shippingFeeInput
                    ? Math.max(0, toNumber(shippingFeeInput.value, 0))
                    : 0;

                if (shippingFeeInput) {
                    shippingFeeInput.value = String(shippingFee);
                }

                subtotalValue.textContent = toVnd(subTotal);
                grandTotalValue.textContent = toVnd(subTotal + shippingFee);
            };

            document.addEventListener("click", (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) {
                    return;
                }

                const decButton = target.closest(".qty-dec");
                if (decButton) {
                    const row = decButton.closest("[data-item-row]");
                    const input = row?.querySelector(".qty-input");
                    if (input) {
                        input.value = String(Math.max(1, toNumber(input.value, 1) - 1));
                        recalcTotal();
                    }
                    return;
                }

                const incButton = target.closest(".qty-inc");
                if (incButton) {
                    const row = incButton.closest("[data-item-row]");
                    const input = row?.querySelector(".qty-input");
                    if (input) {
                        input.value = String(Math.max(1, toNumber(input.value, 1) + 1));
                        recalcTotal();
                    }
                    return;
                }

                const paymentOption = target.closest(".payment-option");
                if (paymentOption) {
                    paymentOptions.forEach((item) => item.classList.remove("active"));
                    paymentOption.classList.add("active");

                    const radio = paymentOption.querySelector('input[type="radio"]');
                    if (radio) {
                        radio.checked = true;
                        paymentMethodHidden.value = radio.value;
                    }
                }
            });

            document.addEventListener("input", (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement)) {
                    return;
                }

                if (target.classList.contains("qty-input") || target.id === "shippingFeeInput") {
                    recalcTotal();
                }

                if (target.id === "shippingPhone" && !target.readOnly) {
                    target.value = target.value.replace(/\D/g, "").slice(0, 10);
                }
            });

            addressModeInputs.forEach((input) => {
                input.addEventListener("change", syncAddressModeUi);
            });

            if (savedAddressSelect) {
                savedAddressSelect.addEventListener("change", () => {
                    const selectedModeInput = document.querySelector('input[name="addressMode"]:checked');
                    if (selectedModeInput && selectedModeInput.value === "saved") {
                        applySavedAddressToShipping();
                    }
                });
            }

            if (checkoutForm instanceof HTMLFormElement) {
                checkoutForm.addEventListener("submit", (event) => {
                    const selectedModeInput = document.querySelector('input[name="addressMode"]:checked');
                    const useSavedMode = !!(selectedModeInput && selectedModeInput.value === "saved" && hasSavedAddressOptions);

                    if (useSavedMode && savedAddressSelect && !savedAddressSelect.value) {
                        savedAddressSelect.setCustomValidity("Vui lòng chọn địa chỉ đã lưu.");
                    } else if (savedAddressSelect) {
                        savedAddressSelect.setCustomValidity("");
                    }

                    if (!checkoutForm.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    checkoutForm.classList.add("was-validated");
                });
            }

            syncAddressModeUi();
            recalcTotal();
        })();
    </script>
</body>
</html>
