@model FreshFarm.Web.Bff.Dtos.CheckoutSubmitRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh toán - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-green: #008a4f;
        }

        body {
            background: radial-gradient(circle at 0 0, #e8fff1 0, transparent 35%), #f4f7f5;
        }

        .checkout-wrap {
            max-width: 1140px;
            margin: 28px auto 40px;
            padding: 0 12px;
        }

        .top-nav {
            background: #fff;
            border: 1px solid #d7f1e4;
            border-radius: 14px;
        }

        .brand-chip {
            color: var(--primary-green);
            font-weight: 800;
            letter-spacing: .02em;
            text-decoration: none;
        }

        .section-title {
            color: #111827;
            font-weight: 700;
        }

        .step-chip {
            padding: .35rem .65rem;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 600;
            background: #eef5ef;
            color: #35534a;
        }

        .step-chip.active {
            background: rgba(0, 138, 79, .14);
            color: #004f2d;
            border: 1px solid rgba(0, 138, 79, .3);
        }

        .card {
            border: 0;
            border-radius: 14px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 .25rem rgba(0, 138, 79, .15);
        }

        .payment-option {
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 12px 14px;
            cursor: pointer;
        }

        .payment-option.active {
            border-color: var(--primary-green);
            background: rgba(0, 138, 79, .05);
        }

        .btn-main {
            background: var(--primary-green);
            border-color: var(--primary-green);
            color: #fff;
        }

        .btn-main:hover {
            background: #006a3d;
            border-color: #006a3d;
            color: #fff;
        }

        .summary-price {
            color: var(--primary-green);
        }

        .invalid-flow {
            border: 1px dashed #dc3545;
            border-radius: 10px;
            background: #fff5f5;
            color: #842029;
        }
    </style>
</head>
<body>
    <main class="checkout-wrap">
        <header class="top-nav d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 py-2 mb-3">
            <a href="/" class="brand-chip">FRESHFARM</a>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-grid me-1"></i>Danh sách sản phẩm
                </a>
                <a href="/account/orders" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-receipt me-1"></i>Đơn hàng của tôi
                </a>
            </div>
        </header>

        <div class="mb-4">
            <div class="d-flex flex-wrap gap-2 mb-2">
                <span class="step-chip">1. Chọn sản phẩm</span>
                <span class="step-chip active">2. Thanh toán</span>
                <span class="step-chip">3. Hoàn tất</span>
            </div>
            <h2 class="section-title mb-1">Thanh toán</h2>
            <p class="text-muted mb-0">Xác nhận thông tin giao hàng và hoàn tất đơn hàng.</p>
        </div>

        <div id="flowAlert" class="invalid-flow p-3 mb-3 d-none"></div>
        <div id="flowAction" class="d-none mb-3">
            <a href="/" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-arrow-left-circle me-1"></i>Quay lại trang sản phẩm
            </a>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <form id="checkoutForm" asp-controller="Checkout" asp-action="Index" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="Shipping.ShippingType" value="HomeDelivery" />
                    <input type="hidden" id="productIdInput" name="Items[0].ProductId" value="0" />
                    <input type="hidden" id="unitPriceInput" name="Items[0].UnitPrice" value="0" />
                    <input type="hidden" id="unitSymbolInput" name="Items[0].UnitSymbol" value="" />
                    <input type="hidden" id="paymentMethodHidden" name="Payment.PaymentMethod" value="COD" />

                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">Thông tin giao hàng</h5>

                            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Họ và tên</label>
                                    <input name="Shipping.FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại</label>
                                    <input name="Shipping.Phone" class="form-control" placeholder="09xxxxxxxx" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Email</label>
                                    <input name="Shipping.Email" class="form-control" type="email" placeholder="you@example.com" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Địa chỉ chi tiết</label>
                                    <input name="Shipping.AddressDetail" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện..." required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ghi chú đơn hàng</label>
                                    <textarea name="OrderNote" class="form-control" rows="3" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao..."></textarea>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h5 class="fw-bold mb-3">Phương thức thanh toán</h5>
                            <div class="vstack gap-2" id="paymentOptions">
                                <label class="payment-option active" data-value="COD">
                                    <input class="form-check-input me-2" type="radio" name="payment-method-ui" value="COD" checked />
                                    <span class="fw-semibold">Thanh toán khi nhận hàng (COD)</span>
                                </label>
                                <label class="payment-option" data-value="VNPay">
                                    <input class="form-check-input me-2" type="radio" name="payment-method-ui" value="VNPay" />
                                    <span class="fw-semibold">Thanh toán qua VNPay</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Tóm tắt đơn hàng</h5>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-start">
                                <div>
                                    <div id="productNameText" class="fw-semibold">Chưa chọn sản phẩm</div>
                                    <small id="productMetaText" class="text-muted">Hãy quay lại trang sản phẩm để chọn.</small>
                                </div>
                                <span id="lineTotalText">0 ₫</span>
                            </li>
                        </ul>

                        <div class="mb-2">
                            <label class="form-label">Số lượng</label>
                            <input id="quantityInput"
                                   name="Items[0].Quantity"
                                   type="number"
                                   min="1"
                                   step="1"
                                   class="form-control"
                                   value="1" />
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính</span>
                            <strong id="subtotalValue">0 ₫</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2 align-items-center">
                            <span>Phí vận chuyển</span>
                            <div style="max-width: 150px;">
                                <input id="shippingFeeInput"
                                       name="ShippingFee"
                                       form="checkoutForm"
                                       type="number"
                                       min="0"
                                       step="1000"
                                       class="form-control form-control-sm text-end"
                                       value="15000" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Giảm giá</span>
                            <strong>0 ₫</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5">
                            <span>Tổng cộng</span>
                            <strong id="grandTotalValue" class="summary-price">0 ₫</strong>
                        </div>

                        <button id="submitBtn" type="submit" form="checkoutForm" class="btn btn-main w-100 mt-3">
                            <i class="bi bi-bag-check me-2"></i>Đặt hàng
                        </button>
                        <a href="/" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="bi bi-arrow-left me-1"></i>Chọn sản phẩm khác
                        </a>

                        <p class="small text-muted mt-3 mb-0">
                            Luồng hiện tại nhận sản phẩm từ query string khi bấm “Mua ngay”.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const flowAlert = document.getElementById("flowAlert");
            const flowAction = document.getElementById("flowAction");
            const submitBtn = document.getElementById("submitBtn");

            const productIdInput = document.getElementById("productIdInput");
            const unitPriceInput = document.getElementById("unitPriceInput");
            const unitSymbolInput = document.getElementById("unitSymbolInput");
            const quantityInput = document.getElementById("quantityInput");
            const shippingFeeInput = document.getElementById("shippingFeeInput");
            const paymentMethodHidden = document.getElementById("paymentMethodHidden");

            const productNameText = document.getElementById("productNameText");
            const productMetaText = document.getElementById("productMetaText");
            const lineTotalText = document.getElementById("lineTotalText");
            const subtotalValue = document.getElementById("subtotalValue");
            const grandTotalValue = document.getElementById("grandTotalValue");

            const paymentOptions = document.querySelectorAll("#paymentOptions .payment-option");

            const toNumber = (value, fallback = 0) => {
                const num = Number(value);
                return Number.isFinite(num) ? num : fallback;
            };

            const toVnd = (value) => {
                const safe = toNumber(value, 0);
                return safe.toLocaleString("vi-VN") + " ₫";
            };

            const params = new URLSearchParams(window.location.search);
            const queryProductId = toNumber(params.get("productId"), 0);
            const queryProductName = params.get("productName") || "";
            const queryUnitPrice = toNumber(params.get("unitPrice"), 0);
            const queryUnitSymbol = params.get("unitSymbol") || "";

            const isValidFlow = queryProductId > 0 && queryUnitPrice >= 0;

            const setFlowError = (message) => {
                flowAlert.textContent = message;
                flowAlert.classList.remove("d-none");
                flowAction.classList.remove("d-none");
                submitBtn.setAttribute("disabled", "disabled");
            };

            const clearFlowError = () => {
                flowAlert.classList.add("d-none");
                flowAlert.textContent = "";
                flowAction.classList.add("d-none");
                submitBtn.removeAttribute("disabled");
            };

            const recalcTotal = () => {
                const quantity = Math.max(1, toNumber(quantityInput.value, 1));
                quantityInput.value = quantity;

                const unitPrice = toNumber(unitPriceInput.value, 0);
                const shippingFee = Math.max(0, toNumber(shippingFeeInput.value, 0));

                const subTotal = unitPrice * quantity;
                const grandTotal = subTotal + shippingFee;

                lineTotalText.textContent = toVnd(subTotal);
                subtotalValue.textContent = toVnd(subTotal);
                grandTotalValue.textContent = toVnd(grandTotal);

                const unitSymbol = unitSymbolInput.value || "đơn vị";
                productMetaText.textContent = `x ${quantity} • ${unitSymbol}`;
            };

            const initProductFromQuery = () => {
                if (!isValidFlow) {
                    setFlowError("Không có dữ liệu sản phẩm hợp lệ. Hãy quay lại trang sản phẩm và bấm “Mua ngay”.");
                    productNameText.textContent = "Chưa chọn sản phẩm";
                    productMetaText.textContent = "Hãy quay lại trang sản phẩm để chọn.";
                    return;
                }

                clearFlowError();
                productIdInput.value = String(queryProductId);
                unitPriceInput.value = String(queryUnitPrice);
                unitSymbolInput.value = queryUnitSymbol || "đơn vị";

                productNameText.textContent = queryProductName || `Sản phẩm #${queryProductId}`;
                recalcTotal();
            };

            paymentOptions.forEach((option) => {
                option.addEventListener("click", () => {
                    paymentOptions.forEach((item) => item.classList.remove("active"));
                    option.classList.add("active");

                    const radio = option.querySelector('input[type="radio"]');
                    if (radio) {
                        radio.checked = true;
                        paymentMethodHidden.value = radio.value;
                    }
                });
            });

            quantityInput.addEventListener("input", recalcTotal);
            shippingFeeInput.addEventListener("input", recalcTotal);

            initProductFromQuery();
        })();
    </script>
</body>
</html>
