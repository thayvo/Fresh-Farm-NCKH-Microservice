@using System.Globalization
@model dynamic
@{
    Layout = null;

    string Vnd(decimal value) => string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", value);
    const decimal sampleUnitPrice = 28000m;
    const int sampleQuantity = 1;
    const decimal defaultShippingFee = 15000m;
    var subTotal = sampleUnitPrice * sampleQuantity;
    var grandTotal = subTotal + defaultShippingFee;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh toán - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-green: #008a4f;
        }

        body {
            background: #f4f7f5;
        }

        .checkout-wrap {
            max-width: 1140px;
            margin: 40px auto;
            padding: 0 12px;
        }

        .section-title {
            color: #111827;
            font-weight: 700;
        }

        .card {
            border: 0;
            border-radius: 14px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 .25rem rgba(0, 138, 79, .15);
        }

        .payment-option {
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 12px 14px;
        }

        .payment-option.active {
            border-color: var(--primary-green);
            background: rgba(0, 138, 79, .05);
        }

        .btn-main {
            background: var(--primary-green);
            border-color: var(--primary-green);
            color: #fff;
        }

        .btn-main:hover {
            background: #006a3d;
            border-color: #006a3d;
            color: #fff;
        }

        .summary-price {
            color: var(--primary-green);
        }
    </style>
</head>
<body>
    <main class="checkout-wrap">
        <div class="mb-4">
            <h2 class="section-title mb-1">Thanh toán</h2>
            <p class="text-muted mb-0">Xác nhận thông tin giao hàng và hoàn tất đơn hàng.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <form id="checkoutForm" asp-controller="Checkout" asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Shipping.ShippingType" value="HomeDelivery" />
                    <input type="hidden" name="Items[0].ProductId" value="117" />
                    <input type="hidden" name="Items[0].Quantity" value="@sampleQuantity" />
                    <input type="hidden" name="Items[0].UnitPrice" value="@sampleUnitPrice" />
                    <input type="hidden" name="Items[0].UnitSymbol" value="kg" />
                    <input type="hidden" name="Payment.PaymentMethod" id="paymentMethodHidden" value="COD" />

                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">Thông tin giao hàng</h5>

                            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Họ và tên</label>
                                    <input name="Shipping.FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại</label>
                                    <input name="Shipping.Phone" class="form-control" placeholder="09xxxxxxxx" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Email</label>
                                    <input name="Shipping.Email" class="form-control" type="email" placeholder="you@example.com" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Địa chỉ chi tiết</label>
                                    <input name="Shipping.AddressDetail" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện..." required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ghi chú đơn hàng</label>
                                    <textarea name="OrderNote" class="form-control" rows="3" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao..."></textarea>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h5 class="fw-bold mb-3">Phương thức thanh toán</h5>
                            <div class="vstack gap-2" id="paymentOptions">
                                <label class="payment-option active" data-value="COD">
                                    <input class="form-check-input me-2" type="radio" name="payment-method-ui" value="COD" checked />
                                    <span class="fw-semibold">Thanh toán khi nhận hàng (COD)</span>
                                </label>
                                <label class="payment-option" data-value="VNPay">
                                    <input class="form-check-input me-2" type="radio" name="payment-method-ui" value="VNPay" />
                                    <span class="fw-semibold">Thanh toán qua VNPay</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Tóm tắt đơn hàng</h5>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">Rau xà lách hữu cơ</div>
                                    <small class="text-muted">x @sampleQuantity • 1 kg</small>
                                </div>
                                <span>@Vnd(subTotal)</span>
                            </li>
                        </ul>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính</span>
                            <strong id="subtotalValue">@Vnd(subTotal)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 align-items-center">
                            <span>Phí vận chuyển</span>
                            <div style="max-width: 150px;">
                                <input id="shippingFeeInput"
                                       name="ShippingFee"
                                       form="checkoutForm"
                                       type="number"
                                       min="0"
                                       step="1000"
                                       class="form-control form-control-sm text-end"
                                       value="@defaultShippingFee" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Giảm giá</span>
                            <strong>0 ₫</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5">
                            <span>Tổng cộng</span>
                            <strong id="grandTotalValue" class="summary-price">@Vnd(grandTotal)</strong>
                        </div>

                        <div class="input-group mt-3">
                            <input class="form-control" placeholder="Mã giảm giá (sẽ mở sau)" disabled />
                            <button type="button" class="btn btn-outline-secondary" disabled>Áp dụng</button>
                        </div>

                        <button type="submit" form="checkoutForm" class="btn btn-main w-100 mt-3">
                            <i class="bi bi-bag-check me-2"></i>Đặt hàng
                        </button>

                        <p class="small text-muted mt-3 mb-0">
                            Giao diện đã giữ đúng phong cách cũ. Phần coupon/điểm thưởng sẽ nối logic ở bước sau.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const paymentOptions = document.querySelectorAll("#paymentOptions .payment-option");
            const paymentHidden = document.getElementById("paymentMethodHidden");
            const shippingFeeInput = document.getElementById("shippingFeeInput");
            const grandTotalValue = document.getElementById("grandTotalValue");
            const subTotal = @subTotal.ToString(CultureInfo.InvariantCulture);

            const formatVnd = (value) => {
                const safeValue = Number.isFinite(value) ? value : 0;
                return safeValue.toLocaleString("vi-VN") + " ₫";
            };

            const recalcGrandTotal = () => {
                const shipping = Number(shippingFeeInput?.value || 0);
                const total = Math.max(0, Number(subTotal) + (Number.isFinite(shipping) ? shipping : 0));
                if (grandTotalValue) {
                    grandTotalValue.textContent = formatVnd(total);
                }
            };

            paymentOptions.forEach((option) => {
                option.addEventListener("click", () => {
                    paymentOptions.forEach((item) => item.classList.remove("active"));
                    option.classList.add("active");

                    const radio = option.querySelector('input[type="radio"]');
                    if (radio) {
                        radio.checked = true;
                        if (paymentHidden) {
                            paymentHidden.value = radio.value;
                        }
                    }
                });
            });

            if (shippingFeeInput) {
                shippingFeeInput.addEventListener("input", recalcGrandTotal);
            }

            recalcGrandTotal();
        })();
    </script>
</body>
</html>
