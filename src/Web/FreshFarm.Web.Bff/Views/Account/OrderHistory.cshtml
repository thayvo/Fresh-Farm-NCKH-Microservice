@using System.Globalization
@model List<FreshFarm.Web.Bff.Dtos.OrderHistoryItemDto>
@{
    Layout = null;

    string FormatVnd(decimal amount) =>
        string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", amount);

    (string CssClass, string Label) GetOrderStatusBadge(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "completed" or "delivered" => ("bg-success", "Đã giao"),
            "pending" => ("bg-warning text-dark", "Chờ xử lý"),
            "processing" => ("bg-info text-dark", "Đang xử lý"),
            "shipping" or "shipped" => ("bg-primary", "Đang giao"),
            "canceled" or "cancelled" => ("bg-danger", "Đã hủy"),
            _ => ("bg-secondary", string.IsNullOrWhiteSpace(status) ? "Không rõ" : status!)
        };
    }

    (string CssClass, string Label) GetPaymentStatusBadge(string? paymentStatus)
    {
        var normalized = (paymentStatus ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "paid" => ("bg-success", "Đã thanh toán"),
            "pending" => ("bg-warning text-dark", "Chờ thanh toán"),
            "failed" => ("bg-danger", "Thanh toán lỗi"),
            "refunded" => ("bg-secondary", "Đã hoàn tiền"),
            _ => ("bg-light text-dark border", string.IsNullOrWhiteSpace(paymentStatus) ? "Chưa rõ" : paymentStatus!)
        };
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lịch sử đơn hàng - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-green: #008a4f;
        }

        body {
            background: #f4f7f5;
        }

        .page-wrap {
            max-width: 1120px;
            margin: 40px auto;
            padding: 0 12px;
        }

        .account-nav .list-group-item.active {
            background: var(--primary-green);
            border-color: var(--primary-green);
        }

        .accordion-button:not(.collapsed) {
            background: #f8f9fa;
            color: #111827;
            box-shadow: inset 0 -1px 0 rgba(0, 0, 0, .08);
        }

        .accordion-button:focus {
            box-shadow: 0 0 0 .25rem rgba(0, 138, 79, .2);
        }

        .order-meta {
            font-size: .9rem;
            color: #6b7280;
        }

        .btn-main {
            background: var(--primary-green);
            border-color: var(--primary-green);
            color: #fff;
        }

        .btn-main:hover {
            background: #006a3d;
            border-color: #006a3d;
            color: #fff;
        }
    </style>
</head>
<body>
    <main class="page-wrap">
        <div class="mb-4">
            <h1 class="fw-bold mb-1">Tài khoản của tôi</h1>
            <p class="text-muted mb-0">Theo dõi đơn hàng bạn đã đặt.</p>
        </div>

        <div class="row g-4">
            <aside class="col-lg-3">
                <div class="card border-0 shadow-sm account-nav">
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="/account/orders" class="list-group-item list-group-item-action active">
                                <i class="bi bi-receipt me-2"></i>Lịch sử đơn hàng
                            </a>
                            <a href="/" class="list-group-item list-group-item-action">
                                <i class="bi bi-house-door me-2"></i>Trang chủ
                            </a>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <form asp-action="Logout" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <section class="col-lg-9">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h4 class="fw-bold mb-0">Lịch sử đơn hàng</h4>
                            <span class="badge text-bg-light border">Tổng đơn: @(Model?.Count ?? 0)</span>
                        </div>

                        @if (ViewBag.Error is not null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }

                        @if (Model is null || !Model.Any())
                        {
                            <div class="alert alert-info mb-0">Bạn chưa có đơn hàng nào.</div>
                        }
                        else
                        {
                            <div class="accordion" id="orderHistoryAccordion">
                                @for (var i = 0; i < Model.Count; i++)
                                {
                                    var order = Model[i];
                                    var orderBadge = GetOrderStatusBadge(order.Status);
                                    var paymentBadge = GetPaymentStatusBadge(order.PaymentStatus);
                                    var collapseId = $"order_{order.OrderId}";
                                    var isOpen = i == 0;

                                    <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button @(isOpen ? string.Empty : "collapsed")"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="@(isOpen ? "true" : "false")"
                                                    aria-controls="@collapseId">
                                                <div class="d-flex w-100 justify-content-between align-items-center flex-wrap gap-2 pe-3">
                                                    <div class="fw-semibold">Mã đơn: #@order.OrderId</div>
                                                    <div class="order-meta">
                                                        <i class="bi bi-clock-history me-1"></i>@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                    </div>
                                                    <div class="fw-semibold" style="color: var(--primary-green);">@FormatVnd(order.TotalAmount)</div>
                                                    <span class="badge @orderBadge.CssClass">@orderBadge.Label</span>
                                                </div>
                                            </button>
                                        </h2>

                                        <div id="@collapseId"
                                             class="accordion-collapse collapse @(isOpen ? "show" : string.Empty)"
                                             data-bs-parent="#orderHistoryAccordion">
                                            <div class="accordion-body">
                                                <div class="row g-3 mb-4">
                                                    <div class="col-md-6">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted small mb-1">Trạng thái đơn</div>
                                                            <span class="badge @orderBadge.CssClass">@orderBadge.Label</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted small mb-1">Thanh toán</div>
                                                            <span class="badge @paymentBadge.CssClass">@paymentBadge.Label</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="d-flex gap-2 flex-wrap">
                                                    <a href="/account/orders/@order.OrderId" class="btn btn-main btn-sm">
                                                        <i class="bi bi-eye me-1"></i>Xem chi tiết đơn
                                                    </a>
                                                    <a href="/bff/orders/@order.OrderId" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                                                        <i class="bi bi-code-slash me-1"></i>Xem JSON
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
