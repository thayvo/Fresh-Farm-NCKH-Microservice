@using System.Globalization
@model List<FreshFarm.Web.Bff.Dtos.OrderHistoryItemDto>
@{
    Layout = null;
    ViewBag.Title = "Lịch sử đơn hàng";
    ViewBag.BreadcrumbItems = Tuple.Create("Tài khoản", "/account/orders");

    string FormatVnd(decimal amount) =>
        string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", amount);

    (string CssClass, string Label) GetOrderStatusBadge(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "completed" or "delivered" => ("bg-success", "Đã giao hàng"),
            "pending" or "processing" => ("bg-warning text-dark", "Đang xử lý"),
            "shipping" or "shipped" => ("bg-info text-dark", "Đang giao"),
            "canceled" or "cancelled" => ("bg-danger", "Đã hủy"),
            _ => ("bg-secondary", string.IsNullOrWhiteSpace(status) ? "Không rõ" : status!)
        };
    }

    (string CssClass, string Label) GetPaymentStatusBadge(string? paymentStatus)
    {
        var normalized = (paymentStatus ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "paid" => ("bg-success", "Đã thanh toán"),
            "pending" => ("bg-warning text-dark", "Chờ thanh toán"),
            "failed" => ("bg-danger", "Thanh toán lỗi"),
            "refunded" => ("bg-secondary", "Đã hoàn tiền"),
            _ => ("bg-light text-dark border", string.IsNullOrWhiteSpace(paymentStatus) ? "Chưa rõ" : paymentStatus!)
        };
    }

    var orders = Model ?? new List<FreshFarm.Web.Bff.Dtos.OrderHistoryItemDto>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lịch sử đơn hàng - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: radial-gradient(circle at 0 0, #e8fff1 0, transparent 35%), #f4f7f5;
        }

        .account-nav .list-group-item.active {
            background: var(--primary-green, #008a4f);
            border-color: var(--primary-green, #008a4f);
        }

        .accordion-button:not(.collapsed) {
            color: #000;
            background: #f8f9fa;
            box-shadow: inset 0 -1px 0 rgba(0, 0, 0, .125);
        }

        .accordion-button:focus {
            box-shadow: 0 0 0 .25rem rgba(0, 138, 79, .25);
        }

        .order-meta {
            font-size: .9rem;
            color: #6b7280;
        }

        .order-total {
            color: var(--primary-green, #008a4f);
            font-weight: 700;
        }
    </style>
</head>
<body>
    <main class="container my-5">
        <div class="mb-4">
            <h1 class="fw-bold">Tài khoản của tôi</h1>
            @await Html.PartialAsync("_BreadCrumb")
        </div>

        <div class="row g-4">
            @await Html.PartialAsync("_AccountNav")

            <section class="col-lg-9">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
                            <h4 class="card-title fw-bold mb-0">Lịch sử đơn hàng</h4>
                            <span class="badge text-bg-light border">Tổng đơn: @orders.Count</span>
                        </div>

                        @if (ViewBag.Error is not null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }

                        @if (!orders.Any())
                        {
                            <div class="alert alert-info mb-0">Bạn chưa có đơn hàng nào.</div>
                        }
                        else
                        {
                            <div class="accordion" id="orderHistoryAccordion">
                                @for (var i = 0; i < orders.Count; i++)
                                {
                                    var order = orders[i];
                                    var collapseId = $"order_{order.OrderId}";
                                    var isOpen = i == 0;
                                    var orderBadge = GetOrderStatusBadge(order.Status);
                                    var paymentBadge = GetPaymentStatusBadge(order.PaymentStatus);

                                    <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button @(isOpen ? string.Empty : "collapsed")"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="@(isOpen ? "true" : "false")"
                                                    aria-controls="@collapseId">
                                                <div class="d-flex w-100 justify-content-between align-items-center flex-wrap gap-2 pe-3">
                                                    <div class="fw-semibold">Mã đơn: #@order.OrderId</div>
                                                    <div class="order-meta">Ngày đặt: @order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                                    <div class="order-total">@FormatVnd(order.TotalAmount)</div>
                                                    <span class="badge @orderBadge.CssClass">@orderBadge.Label</span>
                                                </div>
                                            </button>
                                        </h2>

                                        <div id="@collapseId"
                                             class="accordion-collapse collapse @(isOpen ? "show" : string.Empty)"
                                             data-bs-parent="#orderHistoryAccordion">
                                            <div class="accordion-body">
                                                <div class="mb-3 text-muted small">
                                                    Thanh toán: <strong>@paymentBadge.Label</strong>
                                                </div>

                                                <div class="d-flex gap-2 flex-wrap">
                                                    <a href="/account/orders/@order.OrderId" class="btn btn-success btn-sm">
                                                        <i class="bi bi-eye me-1"></i>Xem chi tiết đơn
                                                    </a>
                                                    <a href="/" class="btn btn-outline-success btn-sm">
                                                        <i class="bi bi-cart-plus me-1"></i>Mua thêm
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_IdleSessionMonitor")
</body>
</html>
