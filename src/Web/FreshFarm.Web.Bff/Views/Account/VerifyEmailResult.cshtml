@model FreshFarm.Web.Bff.Dtos.EmailVerificationResultViewModel
@{
    Layout = null;
    var badgeClass = Model.Success ? "text-bg-success" : "text-bg-danger";
    var primaryButtonClass = Model.Success ? "btn-success" : "btn-outline-success";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: #f7faf8;
        }

        .card-shell {
            max-width: 620px;
            width: 100%;
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <div class="card border-0 shadow-sm card-shell">
        <div class="card-body p-4 p-lg-5">
            <div class="mb-3">
                <span class="badge rounded-pill @badgeClass px-3 py-2">@(Model.Success ? "Xác minh thành công" : "Xác minh chưa thành công")</span>
            </div>
            <h1 class="h2 fw-bold mb-3">@Model.Title</h1>
            <p class="text-muted mb-4">@Model.Message</p>

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <div class="border rounded-3 px-3 py-3 bg-light mb-4">
                    <div class="small text-muted mb-1">Email liên quan</div>
                    <div class="fw-semibold">@Model.Email</div>
                </div>
            }

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="SignIn" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl" class="btn @primaryButtonClass">Đến trang đăng nhập</a>
                @if (!Model.Success)
                {
                    <a asp-action="VerifyEmailPending"
                       asp-controller="Account"
                       asp-route-email="@Model.Email"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="btn btn-outline-secondary">Gửi lại email xác minh</a>
                }
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Về trang chủ</a>
            </div>
        </div>
    </div>
</body>
</html>
