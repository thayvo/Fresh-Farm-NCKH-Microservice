@using FreshFarm.Web.Bff.Services
@model FreshFarm.Web.Bff.Dtos.ForgotPasswordRequestDto
@{
    Layout = null;
    var cspNonce = Context.Items["CspNonce"] as string ?? string.Empty;
    var botChallenge = ViewData["BotChallenge"] as BotChallengePresentation ?? new BotChallengePresentation();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/account-auth.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="account-auth account-auth--forgot-password">
    <main class="account-auth__shell">
        <section class="account-auth-card" aria-labelledby="forgotPasswordHeading">
            <header class="account-auth-header">
                <div class="account-auth-icon">
                    <i class="bi bi-envelope-arrow-up"></i>
                </div>
                <h1 id="forgotPasswordHeading" class="h3">Quên mật khẩu?</h1>
                <p class="text-muted mb-0">Nhập email tài khoản để nhận liên kết đặt lại mật khẩu.</p>
            </header>

            <form asp-action="ForgotPassword"
                  asp-controller="Account"
                  method="post"
                  id="forgotPasswordForm"
                  data-bot-challenge-form
                  data-bot-challenge-site-key="@botChallenge.SiteKey"
                  data-bot-challenge-action="@botChallenge.Action"
                  class="needs-validation"
                  novalidate>
                @Html.AntiForgeryToken()

                @if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success py-2 small mb-3">@successMessage</div>
                }

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           placeholder="name@example.com"
                           autocomplete="email"
                           required />
                    <label asp-for="Email">Địa chỉ email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                @if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.CloudflareTurnstile)
                {
                    <section class="account-auth-challenge" aria-labelledby="forgotPasswordSecurityHeading">
                        <h2 id="forgotPasswordSecurityHeading" class="account-auth-challenge__heading">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            Xác minh bảo mật
                        </h2>
                        <input asp-for="BotChallengeToken" type="hidden" data-bot-challenge-token />
                        <div class="account-auth-challenge__widget">
                            <div class="cf-turnstile"
                                 data-sitekey="@botChallenge.SiteKey"
                                 data-action="@botChallenge.Action"
                                 data-size="flexible"
                                 data-callback="freshFarmBotChallengeCompleted"
                                 data-expired-callback="freshFarmBotChallengeReset"
                                 data-error-callback="freshFarmBotChallengeReset"></div>
                            <div class="account-auth-challenge__status" data-bot-challenge-status role="status" aria-live="polite" hidden></div>
                        </div>
                        <span asp-validation-for="BotChallengeToken" class="text-danger small d-block mt-2"></span>
                    </section>
                }
                else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.GoogleRecaptcha)
                {
                    <section class="account-auth-challenge" aria-labelledby="forgotPasswordSecurityHeading">
                        <h2 id="forgotPasswordSecurityHeading" class="account-auth-challenge__heading">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            Xác minh bảo mật
                        </h2>
                        <p class="account-auth-challenge__help small text-muted mb-2">
                            FreshFarm sẽ kiểm tra tự động khi bạn gửi yêu cầu.
                        </p>
                        <input asp-for="BotChallengeToken" type="hidden" data-bot-challenge-token />
                        <span asp-validation-for="BotChallengeToken" class="text-danger small d-block"></span>
                    </section>
                }
                else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.LocalSvg)
                {
                    <section class="account-auth-challenge" aria-labelledby="forgotPasswordSecurityHeading">
                        <h2 id="forgotPasswordSecurityHeading" class="account-auth-challenge__heading">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            Xác minh bảo mật
                        </h2>
                        <img id="forgotPasswordCaptchaImage"
                             src="@Url.Action("ForgotPasswordCaptcha", "Account")"
                             alt="Mã CAPTCHA"
                             class="border rounded-3 bg-white mb-3"
                             width="180"
                             height="64"
                             data-local-captcha-image />
                        <label asp-for="CaptchaCode" class="form-label fw-semibold">Mã xác nhận</label>
                        <div class="input-group">
                            <input asp-for="CaptchaCode"
                                   class="form-control"
                                   aria-label="Nhập mã trong hình"
                                   placeholder="Nhập mã trong hình"
                                   autocomplete="off"
                                   autocapitalize="characters"
                                   spellcheck="false"
                                   required />
                            <button type="button" class="btn btn-outline-success" data-local-captcha-refresh>
                                <i class="bi bi-arrow-clockwise"></i>
                                <span class="visually-hidden">Lấy mã mới</span>
                            </button>
                        </div>
                        <span asp-validation-for="CaptchaCode" class="text-danger small d-block mt-2"></span>
                    </section>
                }
                else
                {
                    <div class="alert alert-danger small mb-3" role="alert">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        @(botChallenge.ErrorMessage ?? "Tính năng xác minh bảo mật chưa sẵn sàng. Vui lòng thử lại sau.")
                    </div>
                }

                <div class="d-grid">
                    <button class="btn btn-success btn-lg" type="submit">Gửi liên kết đặt lại mật khẩu</button>
                </div>
            </form>

            <p class="text-center mt-4 mb-0 text-muted">
                Đã nhớ mật khẩu?
                <a asp-action="SignIn"
                   asp-controller="Account"
                   class="fw-bold">Quay lại đăng nhập</a>
            </p>
        </section>
    </main>

    <script nonce="@cspNonce" src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@cspNonce" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce="@cspNonce" src="~/js/csp-phase2.js" asp-append-version="true"></script>
    @if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.CloudflareTurnstile)
    {
        <script nonce="@cspNonce" src="~/js/bot-challenge-turnstile.js" asp-append-version="true"></script>
        <script nonce="@cspNonce" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.GoogleRecaptcha)
    {
        <script nonce="@cspNonce" src="~/js/signup-recaptcha.js" asp-append-version="true"></script>
        <script nonce="@cspNonce" src="https://www.google.com/recaptcha/api.js?render=@botChallenge.SiteKey" async defer></script>
    }
    else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.LocalSvg)
    {
        <script nonce="@cspNonce" src="~/js/signup-captcha.js" asp-append-version="true"></script>
    }
</body>
</html>
