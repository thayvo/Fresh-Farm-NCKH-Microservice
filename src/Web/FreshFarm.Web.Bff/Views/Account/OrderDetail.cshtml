@using System.Globalization
@model FreshFarm.Web.Bff.Dtos.OrderDetailDto?
@{
    Layout = null;
    ViewBag.Title = "Chi tiết đơn hàng";
    ViewBag.BreadcrumbItems = Tuple.Create("Tài khoản", "/account/orders");

    string Vnd(decimal amount) => string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", amount);

    (string CssClass, string Label) OrderBadge(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "completed" or "delivered" => ("bg-success", "Đã giao hàng"),
            "pending" or "processing" => ("bg-warning text-dark", "Đang xử lý"),
            "shipping" or "shipped" => ("bg-info text-dark", "Đang giao"),
            "canceled" or "cancelled" => ("bg-danger", "Đã hủy"),
            _ => ("bg-secondary", string.IsNullOrWhiteSpace(status) ? "Không rõ" : status!)
        };
    }

    (string CssClass, string Label) PaymentBadge(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "paid" => ("bg-success", "Đã thanh toán"),
            "pending" => ("bg-warning text-dark", "Chờ thanh toán"),
            "failed" => ("bg-danger", "Thanh toán lỗi"),
            "refunded" => ("bg-secondary", "Đã hoàn tiền"),
            _ => ("bg-light text-dark border", string.IsNullOrWhiteSpace(status) ? "Chưa rõ" : status!)
        };
    }

    bool CanReviewOrder(string? orderStatus, string? paymentStatus)
    {
        var normalizedOrder = (orderStatus ?? string.Empty).Trim().ToLowerInvariant();
        var normalizedPayment = (paymentStatus ?? string.Empty).Trim().ToLowerInvariant();

        if (normalizedOrder is "awaitingpayment" or "expired" or "canceled" or "cancelled")
        {
            return false;
        }

        if (normalizedPayment is "failed" or "expired")
        {
            return false;
        }

        return true;
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chi tiết đơn hàng - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: radial-gradient(circle at 0 0, #e8fff1 0, transparent 35%), #f4f7f5;
        }

        .account-nav .list-group-item.active {
            background: var(--primary-green, #008a4f);
            border-color: var(--primary-green, #008a4f);
        }

        .meta-label {
            color: #6b7280;
            font-size: .9rem;
        }

        .order-number {
            color: var(--primary-green, #008a4f);
        }
    </style>
</head>
<body>
    <main class="container my-5">
        <div class="mb-4">
            <h1 class="fw-bold">Tài khoản của tôi</h1>
            @await Html.PartialAsync("_BreadCrumb")
        </div>

        <div class="row g-4">
            @await Html.PartialAsync("_AccountNav")

            <section class="col-lg-9">
                @if (ViewBag.Error is not null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                @if (Model is null)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h4 class="fw-bold mb-3">Chi tiết đơn hàng</h4>
                            <div class="alert alert-warning mb-3">Không có dữ liệu chi tiết đơn hàng để hiển thị.</div>
                            <a href="/account/orders" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Quay lại lịch sử đơn
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    var orderBadge = OrderBadge(Model.Status);
                    var paymentBadge = PaymentBadge(Model.PaymentStatus);
                    var primaryShipping = (Model.Shippings is not null && Model.Shippings.Count > 0)
                        ? Model.Shippings[0]
                        : null;
                    var hasItems = Model.Items is not null && Model.Items.Count > 0;
                    var hasPayments = Model.Payments is not null && Model.Payments.Count > 0;
                    var canReviewThisOrder = CanReviewOrder(Model.Status, Model.PaymentStatus);

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                                <div>
                                    <h4 class="fw-bold mb-1">Chi tiết đơn hàng</h4>
                                    <div class="text-muted">Mã đơn: <strong class="order-number">#@Model.OrderId</strong></div>
                                </div>
                                <a href="/account/orders" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-arrow-left me-1"></i>Quay lại lịch sử đơn
                                </a>
                            </div>

                            <div class="row g-3 align-items-center">
                                <div class="col-md-4">
                                    <div class="meta-label">Ngày đặt</div>
                                    <div class="fw-semibold">@Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="meta-label">Trạng thái đơn</div>
                                    <span class="badge @orderBadge.CssClass">@orderBadge.Label</span>
                                </div>
                                <div class="col-md-4">
                                    <div class="meta-label">Thanh toán</div>
                                    <span class="badge @paymentBadge.CssClass">@paymentBadge.Label</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-lg-7">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">Thông tin người nhận</h5>
                                    <p class="mb-1"><strong>Họ tên:</strong> @(primaryShipping?.FullName ?? Model.BuyerFullName ?? "Chưa cập nhật")</p>
                                    <p class="mb-1"><strong>Số điện thoại:</strong> @(primaryShipping?.Phone ?? Model.BuyerPhone ?? "Chưa cập nhật")</p>
                                    <p class="mb-1"><strong>Email:</strong> @(primaryShipping?.Email ?? Model.BuyerEmail ?? "Chưa cập nhật")</p>
                                    <p class="mb-0"><strong>Địa chỉ:</strong> @(primaryShipping?.AddressDetail ?? "Chưa cập nhật")</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">Tổng quan thanh toán</h5>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tổng tiền hàng + phí ship</span>
                                        <strong>@Vnd(Model.TotalAmount)</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Phí vận chuyển</span>
                                        <strong>@Vnd(Model.ShippingFee)</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Điểm đã dùng</span>
                                        <strong>@Model.PointsRedeemed</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Điểm tích lũy</span>
                                        <strong>@Model.PointsEarned</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">Sản phẩm trong đơn</h5>
                            @if (!hasItems)
                            {
                                <div class="text-muted">Không có dữ liệu sản phẩm.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Mã SP</th>
                                                <th>Số lượng</th>
                                                <th>Đơn vị</th>
                                                <th>Đơn giá</th>
                                                <th>Thành tiền</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Items!)
                                            {
                                                var lineTotal = item.UnitPrice * item.Quantity;
                                                <tr>
                                                    <td>@item.ProductId</td>
                                                    <td>@item.Quantity</td>
                                                    <td>@(item.UnitSymbol ?? "-")</td>
                                                    <td>@Vnd(item.UnitPrice)</td>
                                                    <td class="fw-semibold">@Vnd(lineTotal)</td>
                                                    <td class="text-end">
                                                        @if (canReviewThisOrder)
                                                        {
                                                            <a href="/products/@item.ProductId#product-reviews" class="btn btn-outline-success btn-sm">
                                                                <i class="bi bi-star me-1"></i>Đánh giá
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (canReviewThisOrder)
                                {
                                    <div class="text-muted small mt-2">
                                        Bạn có thể mở từng sản phẩm để gửi hoặc cập nhật đánh giá nếu đây là đơn mua hợp lệ.
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">Lịch sử thanh toán</h5>
                            @if (!hasPayments)
                            {
                                <div class="text-muted mb-3">Chưa có bản ghi thanh toán.</div>
                            }
                            else
                            {
                                <div class="table-responsive mb-3">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Phương thức</th>
                                                <th>Mã giao dịch</th>
                                                <th>Trạng thái</th>
                                                <th>Thời gian</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var payment in Model.Payments!)
                                            {
                                                var paymentLineBadge = PaymentBadge(payment.PaymentStatus);
                                                <tr>
                                                    <td>@(payment.PaymentMethod ?? "-")</td>
                                                    <td>@(payment.TransactionCode ?? "-")</td>
                                                    <td><span class="badge @paymentLineBadge.CssClass">@paymentLineBadge.Label</span></td>
                                                    <td>@(payment.PaymentDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.OrderNote))
                            {
                                <div class="border rounded p-3 bg-light mb-3">
                                    <div class="meta-label mb-1">Ghi chú đơn hàng</div>
                                    <div>@Model.OrderNote</div>
                                </div>
                            }

                            <div class="d-flex gap-2 flex-wrap">
                                <a href="/" class="btn btn-success">Tiếp tục mua sắm</a>
                                <a href="/account/orders" class="btn btn-outline-secondary">Quay lại lịch sử đơn</a>
                            </div>
                        </div>
                    </div>
                }
            </section>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_IdleSessionMonitor")
</body>
</html>
