@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chính sách quyền riêng tư - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    @await Html.PartialAsync("_MarketplaceChromeStyles")
    <style>
        body {
            font-family: var(--marketplace-font);
            background:
                radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 28%),
                linear-gradient(180deg, #f8fbff 0%, #edf7f1 100%);
            color: #1f2937;
        }

        .policy-shell {
            padding: 28px 0 56px;
        }

        .policy-card {
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid #dbe9df;
            border-radius: 28px;
            box-shadow: 0 18px 45px rgba(31, 41, 55, 0.08);
            overflow: hidden;
        }

        .policy-hero {
            padding: 36px 36px 28px;
            background: linear-gradient(135deg, #115e59 0%, #008a4f 100%);
            color: #fff;
        }

        .policy-body {
            padding: 34px 36px 40px;
        }

        .policy-section + .policy-section {
            margin-top: 28px;
        }

        .policy-section h2 {
            font-size: 1.15rem;
            color: #008a4f;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .policy-note {
            background: #f4fbf7;
            border-left: 4px solid #008a4f;
            padding: 14px 16px;
            border-radius: 12px;
        }

        .policy-breadcrumb {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.18);
            font-size: .9rem;
        }
    </style>
</head>
<body>
    @await Html.PartialAsync("_PromoBarLegacy")
    @await Html.PartialAsync("_HeaderLegacy")
    @await Html.PartialAsync("_NavLegacy")

    <main class="policy-shell">
        <div class="container">
            <article class="policy-card">
                <header class="policy-hero">
                    <div class="policy-breadcrumb mb-3">
                        <i class="bi bi-lock"></i>
                        <span>Bảo vệ dữ liệu cá nhân trên FreshFarm</span>
                    </div>
                    <h1 class="h3 fw-bold mb-2">Chính sách quyền riêng tư</h1>
                    <p class="mb-0 opacity-75">
                        FreshFarm tôn trọng dữ liệu cá nhân của bạn và chỉ sử dụng trong phạm vi cần thiết để vận hành nền tảng, xử lý giao dịch và hỗ trợ người dùng.
                    </p>
                </header>

                <div class="policy-body">
                    <section class="policy-section">
                        <h2>1. Thông tin chúng tôi thu thập</h2>
                        <p class="mb-0">
                            Khi bạn tạo tài khoản hoặc đặt hàng, FreshFarm có thể thu thập các thông tin như họ tên, email, số điện thoại, địa chỉ giao hàng,
                            lịch sử đơn hàng và các dữ liệu cần thiết để xác thực, hỗ trợ thanh toán và vận chuyển.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>2. Mục đích sử dụng dữ liệu</h2>
                        <p class="mb-2">Dữ liệu của bạn được sử dụng để:</p>
                        <ul class="mb-0">
                            <li>Tạo và quản lý tài khoản người dùng.</li>
                            <li>Xử lý đơn hàng, giao hàng, thanh toán và chăm sóc sau mua.</li>
                            <li>Gửi thông báo liên quan đến đơn hàng, bảo mật tài khoản hoặc thay đổi quan trọng của dịch vụ.</li>
                            <li>Cải thiện trải nghiệm sử dụng, chất lượng vận hành và khả năng hỗ trợ khách hàng.</li>
                        </ul>
                    </section>

                    <section class="policy-section">
                        <h2>3. Nguyên tắc bảo vệ thông tin</h2>
                        <p>
                            FreshFarm áp dụng các biện pháp kỹ thuật và vận hành phù hợp để hạn chế truy cập trái phép, mất mát hoặc lạm dụng dữ liệu cá nhân.
                            Chúng tôi chỉ cho phép truy cập dữ liệu trong phạm vi cần thiết phục vụ công việc và chức năng của hệ thống.
                        </p>
                        <p class="mb-0">
                            Bạn cũng nên chủ động bảo vệ thông tin đăng nhập của mình, đặc biệt là mật khẩu và các thiết bị đang sử dụng.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>4. Chia sẻ dữ liệu</h2>
                        <p class="mb-0">
                            FreshFarm không chia sẻ thông tin cá nhân của bạn một cách tùy tiện. Trong một số trường hợp cần thiết,
                            dữ liệu có thể được sử dụng trong phạm vi phục vụ giao vận, thanh toán, hỗ trợ kỹ thuật hoặc theo yêu cầu hợp pháp của cơ quan có thẩm quyền.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>5. Quyền của người dùng</h2>
                        <p class="mb-0">
                            Bạn có thể kiểm tra, cập nhật các thông tin cơ bản của tài khoản và yêu cầu hỗ trợ khi phát hiện dữ liệu không chính xác.
                            Trong trường hợp cần xử lý sâu hơn, bạn có thể liên hệ FreshFarm để được hướng dẫn theo quy trình hỗ trợ hiện hành.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>6. Thời gian lưu trữ</h2>
                        <p class="mb-0">
                            Dữ liệu được lưu trữ trong khoảng thời gian phù hợp với mục đích vận hành dịch vụ, lịch sử giao dịch, giải quyết khiếu nại,
                            bảo mật hệ thống và các nghĩa vụ liên quan nếu có.
                        </p>
                    </section>

                    <section class="policy-section">
                        <div class="policy-note">
                            <strong>Lưu ý:</strong> Đây là bản chính sách quyền riêng tư rút gọn, được dùng để hoàn thiện luồng đăng ký tài khoản và giao tiếp minh bạch với người dùng trên FreshFarm.
                        </div>
                    </section>
                </div>
            </article>
        </div>
    </main>

    @await Html.PartialAsync("_FooterLegacy")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
