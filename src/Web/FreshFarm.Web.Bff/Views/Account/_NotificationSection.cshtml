@model FreshFarm.Web.Bff.Dtos.AccountNotificationSectionViewModel
@{
    var vm = Model.Page;
    var notificationSection = Model.Section;
    var collapseId = $"{notificationSection.SectionKey}-body";
    var isExpanded = notificationSection.IsInitiallyExpanded;
}

<section class="border rounded-4 p-3 p-md-4 bg-white shadow-sm"
         data-notification-section
         data-section-key="@notificationSection.SectionKey"
         data-notification-type="@notificationSection.NotificationType">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-3">
        <div>
            <div class="fw-semibold">@notificationSection.Label</div>
            <div class="small text-muted">@notificationSection.SummaryText</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (!string.IsNullOrWhiteSpace(notificationSection.LastUpdatedLabel))
            {
                <span class="badge text-bg-light border">@notificationSection.LastUpdatedLabel</span>
            }
            <span class="badge text-bg-light border">@notificationSection.TotalCount tổng</span>
            @if (notificationSection.UnreadCount > 0)
            {
                <span class="badge text-bg-danger">@notificationSection.UnreadCount chưa đọc</span>
            }
            @if (notificationSection.HasReadItems && notificationSection.UnreadCount > 0)
            {
                <button class="btn btn-sm btn-outline-danger"
                        type="button"
                        data-section-unread-toggle
                        data-section-key="@notificationSection.SectionKey">
                    <i class="bi bi-funnel me-2"></i>Chỉ chưa đọc
                </button>
            }
            <button class="btn btn-sm btn-outline-secondary"
                    type="button"
                    data-section-toggle-button
                    data-section-target="@collapseId"
                    data-bs-toggle="collapse"
                    data-bs-target="#@collapseId"
                    aria-expanded="@(isExpanded ? "true" : "false")"
                    aria-controls="@collapseId">
                <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") me-2"></i>
                @(isExpanded ? "Thu gọn" : "Mở rộng")
            </button>
        </div>
    </div>

    <div id="@collapseId"
         class="collapse @(isExpanded ? "show" : null)"
         data-section-collapse
         data-section-key="@notificationSection.SectionKey">
        <div class="d-flex flex-column gap-3">
            @foreach (var item in notificationSection.Notifications)
            {
                var feedItemClass = $"feed-item {item.Tone}";

                <article class="@feedItemClass"
                         data-notification-item
                         data-is-read="@item.IsRead.ToString().ToLowerInvariant()"
                         data-is-recent="@item.IsRecentNotification.ToString().ToLowerInvariant()">
                    <div class="border rounded-4 p-3 @(item.IsRead ? "bg-light" : "bg-white shadow-sm")">
                        <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-2">
                            <div class="fw-semibold d-flex align-items-center gap-2">
                                <span>@item.Title</span>
                                @if (!item.IsRead)
                                {
                                    <span class="badge text-bg-danger">Mới</span>
                                }
                            </div>
                            <div class="small text-muted">@(item.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                        </div>
                        <div class="small mb-2 d-flex flex-wrap gap-2">
                            <span class="badge text-bg-@item.Tone">@item.NotificationTypeLabel</span>
                            <span class="badge text-bg-light border">@item.ContextLabel</span>
                            @if (!string.IsNullOrWhiteSpace(item.RecencyLabel))
                            {
                                <span class="badge @(item.IsRecentNotification ? "text-bg-warning" : "text-bg-light border")">@item.RecencyLabel</span>
                            }
                            @if (item.IsRead)
                            {
                                <span class="text-muted">Đã đọc @(item.ReadAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</span>
                            }
                        </div>
                        <div class="notification-preview p-3 mb-3">
                            <div class="small text-uppercase text-muted fw-semibold mb-1">@item.PreviewCaption</div>
                            <div class="fw-semibold">@item.PreviewValue</div>
                            <div class="small text-muted mt-1">@item.PreviewHint</div>
                        </div>
                        <div>@item.Message</div>
                        @if (item.OrderId > 0)
                        {
                            <div class="small text-muted mt-2">Đơn liên quan: #@item.OrderId</div>
                        }
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <a href="@item.ActionUrl" class="btn btn-sm btn-success">
                                <i class="bi bi-arrow-up-right-circle me-2"></i>@item.ActionLabel
                            </a>
                            @if (!item.IsRead)
                            {
                                <form method="post" action="/account/notifications/@item.NotificationId/mark-read">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="q" value="@vm.Query" />
                                    <input type="hidden" name="type" value="@vm.Type" />
                                    @if (vm.IsRead.HasValue)
                                    {
                                        <input type="hidden" name="isRead" value="@vm.IsRead.Value.ToString().ToLowerInvariant()" />
                                    }
                                    <input type="hidden" name="recentOnly" value="@vm.RecentOnly.ToString().ToLowerInvariant()" />
                                    <input type="hidden" name="focusType" value="@vm.FocusType" />
                                    <input type="hidden" name="page" value="@vm.Page" />
                                    <input type="hidden" name="returnUrl" value="@vm.ReturnUrl" />
                                    <button type="submit" class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-check2 me-2"></i>Đánh dấu đã đọc
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
