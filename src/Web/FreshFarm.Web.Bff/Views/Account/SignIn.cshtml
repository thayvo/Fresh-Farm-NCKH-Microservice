@using FreshFarm.Web.Bff.Services
@model FreshFarm.Web.Bff.Dtos.LoginRequestDto
@{
    Layout = null;
    var cspNonce = Context.Items["CspNonce"] as string ?? string.Empty;
    var returnUrl = ViewData["ReturnUrl"] as string;
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Context.Request.Query["returnUrl"].ToString();
    }
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    }
    var signUpReturnUrl = returnUrl;
    var googleLoginEnabled = ViewData["GoogleLoginEnabled"] as bool? ?? false;
    var pendingVerificationIdentifier = ViewData["PendingVerificationIdentifier"] as string;
    var formErrorMessage = ViewData["FormErrorMessage"] as string;
    var lockoutExpiresAtUtc = ViewData["LockoutExpiresAtUtc"] as string;
    var rateLimitErrorMessage = ViewData["RateLimitErrorMessage"] as string;
    var pendingApproval = ViewData["PendingApproval"] as bool? ?? false;
    var pendingApprovalMessage = ViewData["PendingApprovalMessage"] as string
        ?? "Tài khoản của bạn đang chờ quản trị viên phê duyệt.";
    var pendingAccountName = ViewData["PendingAccountName"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/account-auth.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="account-auth account-auth--signin">
    <main class="account-auth__shell">
        <section class="account-auth-card" aria-labelledby="signinHeading">
            <header class="account-auth-header">
                <img id="signinLogo"
                     src="@WebAssetPaths.LogoRequestPath"
                     alt="Logo FreshFarm"
                     class="account-auth-logo"
                     data-fallback-toggle-target="signinLogoFallback" />
                <div id="signinLogoFallback" class="account-auth-logo-fallback d-none">
                    <i class="bi bi-basket2-fill"></i>
                </div>
                <h1 id="signinHeading" class="h3">@(pendingApproval ? "Trạng thái tài khoản" : "Chào mừng trở lại!")</h1>
                <p class="text-muted mb-0">@(pendingApproval ? "FreshFarm đã ghi nhận phiên đăng nhập của bạn." : "Đăng nhập để tiếp tục.")</p>
            </header>

            @if (pendingApproval)
            {
                <section class="account-auth-pending" role="status" aria-live="polite">
                    <div class="account-auth-pending__icon" aria-hidden="true">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <span class="account-auth-pending__badge">
                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                        Đã đăng nhập · Quyền Khách
                    </span>
                    <h2 class="h4 fw-bold">@pendingApprovalMessage</h2>
                    @if (!string.IsNullOrWhiteSpace(pendingAccountName))
                    {
                        <p class="fw-semibold mb-2">@pendingAccountName</p>
                    }
                    <p class="text-muted mb-3">
                        Email của bạn đã được xác nhận. Trong thời gian chờ duyệt, các chức năng mua hàng,
                        bán hàng và quản lý đều được khóa để bảo vệ hệ thống.
                    </p>
                    <div class="alert alert-warning text-start small mb-4">
                        <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>
                        Khi quản trị viên phê duyệt, hệ thống sẽ gửi email thông báo. Sau đó hãy đăng xuất và đăng nhập lại để dùng đầy đủ chức năng.
                    </div>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Đăng xuất
                        </button>
                    </form>
                </section>
            }
            else
            {
             <form asp-action="SignIn" asp-controller="Account" method="post" class="needs-validation" novalidate>
                 @Html.AntiForgeryToken()
                 @if (!string.IsNullOrWhiteSpace(returnUrl))
                 {
                     <input type="hidden" name="returnUrl" value="@returnUrl" />
                 }

                @if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success py-2 small mb-3">@successMessage</div>
                }

                 @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                 {
                     <div class="alert alert-danger py-2 small mb-3">@errorMessage</div>
                 }

                 @if (!string.IsNullOrWhiteSpace(rateLimitErrorMessage))
                 {
                     <div class="alert alert-warning py-2 small mb-3">@rateLimitErrorMessage</div>
                 }

                 @if (!string.IsNullOrWhiteSpace(formErrorMessage))
                 {
                     <div class="alert alert-danger py-2 small mb-3"
                          data-lockout-countdown="@(string.IsNullOrWhiteSpace(lockoutExpiresAtUtc) ? "false" : "true")"
                          data-locked-until-utc="@lockoutExpiresAtUtc">
                         <span data-lockout-message>@formErrorMessage</span>
                     </div>
                 }

                 @if (!string.IsNullOrWhiteSpace(pendingVerificationIdentifier))
                 {
                    <div class="alert alert-warning small mb-3">
                        <div class="fw-semibold mb-2">Tài khoản này chưa xác minh email.</div>
                        <div class="mb-2">Bạn cần xác minh email trước khi đăng nhập. Nếu chưa nhận được thư, bạn có thể gửi lại ngay tại đây.</div>
                        <form asp-action="ResendVerificationEmail"
                              asp-controller="Account"
                              method="post"
                              class="d-flex flex-column gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Identifier" value="@pendingVerificationIdentifier" />
                            <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-outline-warning btn-sm">Gửi lại email xác minh</button>
                        </form>
                    </div>
                }

                 <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Identifier"
                               class="form-control"
                               placeholder="Tên đăng nhập hoặc email"
                               autocomplete="username"
                               required />
                        <label asp-for="Identifier">Tên đăng nhập hoặc email</label>
                        <div class="invalid-feedback">Tên đăng nhập hoặc email không được để trống.</div>
                    </div>
                    <span asp-validation-for="Identifier" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               placeholder="Mật khẩu"
                               autocomplete="current-password"
                               required />
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="invalid-feedback">Mật khẩu không được để trống.</div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small text-muted">
                        <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>
                        Đóng trình duyệt sẽ kết thúc phiên đăng nhập
                    </span>
                    <a asp-action="ForgotPassword" asp-controller="Account" class="small text-decoration-none">Quên mật khẩu?</a>
                </div>

                <div class="d-grid">
                    <button class="btn btn-success btn-lg" type="submit">Đăng nhập</button>
                </div>

                <p class="account-auth__divider"><span>HOẶC</span></p>

                <div class="d-grid gap-2">
                    @if (googleLoginEnabled)
                    {
                        <a asp-action="SignInWithGoogle"
                           asp-controller="Account"
                           asp-route-returnUrl="@returnUrl"
                           class="btn btn-lg account-auth__google">
                            <i class="bi bi-google me-2"></i> Đăng nhập với Google
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-lg account-auth__google" disabled>
                            <i class="bi bi-google me-2"></i> Đăng nhập với Google
                        </button>
                        <div class="small text-muted text-center">
                            Đăng nhập bằng Google hiện chưa khả dụng.
                        </div>
                    }
                </div>
            </form>

            <p class="text-center mt-4 mb-0 text-muted">
                Chưa có tài khoản?
                <a asp-action="SignUp"
                   asp-controller="Account"
                   asp-route-returnUrl="@signUpReturnUrl"
                   class="fw-bold">Đăng ký ngay</a>
            </p>
            }
        </section>
    </main>

    <script nonce="@cspNonce" src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@cspNonce" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce="@cspNonce" src="~/js/csp-phase2.js" asp-append-version="true"></script>
    <script nonce="@cspNonce" src="~/js/account-lockout-countdown.js" asp-append-version="true"></script>
</body>
</html>
