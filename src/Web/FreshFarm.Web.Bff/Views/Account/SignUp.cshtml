@model FreshFarm.Web.Bff.Dtos.RegisterRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-green: #008a4f;
        }

        body {
            background: #f8f9fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .signup-card {
            width: 100%;
            max-width: 520px;
            border: 0;
            border-radius: 16px;
        }

        .brand-mark {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(0, 138, 79, 0.12);
            color: var(--primary-green);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }

        .btn-main {
            background: var(--primary-green);
            border-color: var(--primary-green);
        }

        .btn-main:hover {
            background: #006a3d;
            border-color: #006a3d;
        }

        .form-floating > .form-control:focus ~ label {
            color: var(--primary-green);
        }

        .form-control:focus, .form-check-input:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 .25rem rgba(0, 138, 79, .20);
        }
    </style>
</head>
<body>
    <div class="card shadow-sm p-4 signup-card">
        <div class="card-body">
            <div class="text-center mb-4">
                <div class="brand-mark mb-3"><i class="bi bi-person-plus-fill"></i></div>
                <h3 class="fw-bold mb-1">Tạo tài khoản mới</h3>
                <p class="text-muted mb-0">Bắt đầu hành trình nông sản sạch cùng FreshFarm.</p>
            </div>

            <form asp-action="SignUp" asp-controller="Account" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="RoleName" type="hidden" value="Customer" />

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="FullName" class="form-control" placeholder="Họ và tên" autocomplete="name" required />
                    <label asp-for="FullName">Họ và tên</label>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="UserName" class="form-control" placeholder="UserName" autocomplete="username" required />
                    <label asp-for="UserName">UserName</label>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" autocomplete="email" required />
                    <label asp-for="Email">Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Phone" class="form-control" type="tel" placeholder="Số điện thoại" autocomplete="tel" required />
                    <label asp-for="Phone">Số điện thoại</label>
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" type="password" placeholder="Mật khẩu" autocomplete="new-password" required />
                    <label asp-for="Password">Mật khẩu</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Xác nhận mật khẩu" autocomplete="new-password" required />
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="acceptTerms" disabled />
                    <label class="form-check-label text-muted" for="acceptTerms">
                        Điều khoản dịch vụ (sẽ bật khi thêm trường AcceptTerms)
                    </label>
                </div>

                <div class="d-grid">
                    <button class="btn btn-main btn-lg text-white" type="submit">Đăng ký</button>
                </div>
            </form>

            <p class="text-center mt-4 mb-0 text-muted">
                Đã có tài khoản?
                <a asp-action="SignIn" asp-controller="Account" class="fw-semibold text-decoration-none" style="color: var(--primary-green)">Đăng nhập</a>
            </p>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const forms = document.querySelectorAll(".needs-validation");
            Array.from(forms).forEach(form => {
                form.addEventListener("submit", event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add("was-validated");
                }, false);
            });
        })();
    </script>
</body>
</html>
