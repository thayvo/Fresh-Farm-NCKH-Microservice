@using FreshFarm.Web.Bff.Services
@model FreshFarm.Web.Bff.Dtos.RegisterRequestDto
@{
    Layout = null;
    var cspNonce = Context.Items["CspNonce"] as string ?? string.Empty;
    var returnUrl = ViewData["ReturnUrl"] as string;
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Context.Request.Query["returnUrl"].ToString();
    }
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    }
    var googleRecaptchaEnabled = ViewData["GoogleRecaptchaEnabled"] as bool? ?? false;
    var googleRecaptchaSiteKey = ViewData["GoogleRecaptchaSiteKey"] as string ?? string.Empty;
    var googleRecaptchaAction = ViewData["GoogleRecaptchaAction"] as string ?? "signup";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-green: #008a4f;
        }

        body {
            background: #f8f9fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .signup-card {
            max-width: 560px;
            width: 100%;
            border-radius: 16px;
        }

        .form-hint {
            font-size: .85rem;
            color: #6c757d;
        }

        .terms-box {
            border: 1px solid #dfe7e3;
            border-radius: 14px;
            background: #f8fcfa;
            padding: 1rem;
        }

        .terms-box h6 {
            color: var(--primary-green);
        }

        .logo-fallback {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: rgba(0, 138, 79, .12);
            color: var(--primary-green);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
        }

        .btn-success {
            background-color: var(--primary-green);
            border-color: var(--primary-green);
        }

        .btn-success:hover {
            background-color: #006a3d;
            border-color: #006a3d;
        }

        .form-floating > .form-control:focus ~ label {
            color: var(--primary-green);
        }

        .form-control:focus, .form-check-input:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 .25rem rgba(0, 138, 79, .25);
        }

        .field-validation-error {
            display: block;
            margin-top: .5rem;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 0;
            list-style: none;
        }

        .form-check-input:checked {
            background-color: var(--primary-green);
            border-color: var(--primary-green);
        }
    </style>
</head>
<body>
    <div class="card border-0 shadow-sm p-4 signup-card">
        <div class="card-body">
            <div class="text-center mb-4">
                <img id="signupLogo"
                     src="@WebAssetPaths.LogoRequestPath"
                     alt="Logo FreshFarm"
                     style="max-height: 70px"
                     data-fallback-toggle-target="signupLogoFallback" />
                <div id="signupLogoFallback" class="logo-fallback d-none">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <h3 class="fw-bold mt-3">Tạo tài khoản mới</h3>
                <p class="text-muted mb-0">Đăng ký nhanh để mua sắm nông sản tươi, an toàn và minh bạch nguồn gốc.</p>
            </div>

            <form asp-action="SignUp"
                  asp-controller="Account"
                  asp-route-returnUrl="@returnUrl"
                  method="post"
                  id="signUpForm"
                  data-recaptcha-site-key="@googleRecaptchaSiteKey"
                  data-recaptcha-action="@googleRecaptchaAction"
                  class="needs-validation"
                  novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="RoleName" type="hidden" value="Customer" />
                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Ví dụ: Nguyễn Văn A"
                               autocomplete="name"
                               required />
                        <label asp-for="FullName">Họ và tên</label>
                        <div class="invalid-feedback">Họ và tên không được để trống.</div>
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Ví dụ: nguyenvana"
                               autocomplete="username"
                               required />
                        <label asp-for="UserName">Tên đăng nhập</label>
                        <div class="invalid-feedback">Tên đăng nhập không được để trống.</div>
                    </div>
                    <div class="form-hint mt-1">Dùng 4-50 ký tự gồm chữ cái, số, dấu chấm, gạch dưới hoặc gạch ngang.</div>
                    <span asp-validation-for="UserName" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               placeholder="name@example.com"
                               autocomplete="email"
                               required />
                        <label asp-for="Email">Địa chỉ email</label>
                        <div class="invalid-feedback">Email không được để trống.</div>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Phone"
                               class="form-control"
                               type="tel"
                               placeholder="Ví dụ: 0912345678"
                               autocomplete="tel"
                               required />
                        <label asp-for="Phone">Số điện thoại</label>
                        <div class="invalid-feedback">Số điện thoại không được để trống.</div>
                    </div>
                    <div class="form-hint mt-1">Hệ thống ưu tiên số điện thoại Việt Nam để thuận tiện giao hàng và hỗ trợ đơn.</div>
                    <span asp-validation-for="Phone" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               placeholder="Mật khẩu"
                               autocomplete="new-password"
                               required />
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="invalid-feedback">Mật khẩu không được để trống.</div>
                    </div>
                    <div class="form-hint mt-1">Nên có ít nhất 8 ký tự, gồm chữ cái và chữ số.</div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               type="password"
                               placeholder="Xác nhận mật khẩu"
                               autocomplete="new-password"
                               required />
                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                        <div class="invalid-feedback">Vui lòng nhập lại mật khẩu.</div>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="terms-box mb-3">
                    <h6 class="fw-bold mb-2">Điều khoản sử dụng và quyền riêng tư</h6>
                    <p class="small text-muted mb-2">
                        Khi tạo tài khoản FreshFarm, bạn xác nhận thông tin cung cấp là chính xác, không dùng tài khoản cho mục đích gian lận,
                        và đồng ý để hệ thống lưu thông tin cần thiết nhằm xử lý đơn hàng, giao vận, chăm sóc khách hàng và bảo vệ tài khoản.
                    </p>
                    <p class="small text-muted mb-0">
                        FreshFarm cam kết chỉ sử dụng dữ liệu của bạn cho vận hành dịch vụ, cải thiện trải nghiệm mua sắm và các thông báo liên quan đến đơn hàng,
                        theo phạm vi cần thiết và phù hợp với chính sách của nền tảng.
                    </p>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="AcceptTerms" class="form-check-input" />
                    <label asp-for="AcceptTerms" class="form-check-label">
                        Tôi đã đọc và đồng ý với
                        <a asp-action="Terms" asp-controller="Account" target="_blank" rel="noopener noreferrer" class="text-decoration-none">Điều khoản sử dụng</a>
                        và
                        <a asp-action="PrivacyPolicy" asp-controller="Account" target="_blank" rel="noopener noreferrer" class="text-decoration-none">Chính sách quyền riêng tư</a>
                        của FreshFarm.
                    </label>
                    <div>
                        <span asp-validation-for="AcceptTerms" class="text-danger small"></span>
                    </div>
                </div>

                @if (googleRecaptchaEnabled && !string.IsNullOrWhiteSpace(googleRecaptchaSiteKey))
                {
                    <input asp-for="RecaptchaToken" type="hidden" />
                    <span asp-validation-for="RecaptchaToken" class="text-danger small d-block mb-4"></span>
                }
                else
                {
                    <div class="mb-4">
                        <label asp-for="CaptchaCode" class="form-label fw-semibold">Mã xác nhận</label>
                        <div class="border rounded-4 p-3 bg-light-subtle">
                            <div class="d-flex flex-column flex-md-row gap-3 align-items-md-center">
                                <img id="signupCaptchaImage"
                                     src="@Url.Action("SignUpCaptcha", "Account")"
                                     alt="Mã CAPTCHA"
                                     class="border rounded-3 bg-white"
                                     width="180"
                                     height="64" />
                                <div class="flex-grow-1">
                                    <div class="form-floating">
                                        <input asp-for="CaptchaCode"
                                               class="form-control"
                                               placeholder="Nhập mã xác nhận"
                                               autocomplete="off"
                                               autocapitalize="characters"
                                               spellcheck="false"
                                               required />
                                        <label asp-for="CaptchaCode">Nhập mã trong hình</label>
                                        <div class="invalid-feedback">Vui lòng nhập mã xác nhận.</div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2 gap-2 flex-wrap">
                                        <div class="form-hint">Phân biệt chữ và số theo mã đang hiển thị.</div>
                                        <button id="refreshCaptchaButton" type="button" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-arrow-clockwise me-1"></i>Lấy mã mới
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="CaptchaCode" class="text-danger small d-block mt-2"></span>
                    </div>
                }

                <div class="d-grid">
                    <button class="btn btn-success btn-lg" type="submit">Tạo tài khoản</button>
                </div>
            </form>

            <p class="text-center mt-4 mb-0 text-muted">
                Đã có tài khoản?
                <a asp-action="SignIn"
                   asp-controller="Account"
                   asp-route-returnUrl="@returnUrl"
                   class="fw-bold text-decoration-none"
                   style="color: var(--primary-green)">Đăng nhập</a>
            </p>
        </div>
    </div>

    <script nonce="@cspNonce" src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@cspNonce" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce="@cspNonce" src="~/js/csp-phase2.js" asp-append-version="true"></script>
    @if (googleRecaptchaEnabled && !string.IsNullOrWhiteSpace(googleRecaptchaSiteKey))
    {
        <script nonce="@cspNonce" src="~/js/signup-recaptcha.js" asp-append-version="true"></script>
        <script nonce="@cspNonce" src="https://www.google.com/recaptcha/api.js?render=@googleRecaptchaSiteKey" async defer></script>
    }
    else
    {
        <script nonce="@cspNonce" src="~/js/signup-captcha.js" asp-append-version="true"></script>
    }
</body>
</html>
