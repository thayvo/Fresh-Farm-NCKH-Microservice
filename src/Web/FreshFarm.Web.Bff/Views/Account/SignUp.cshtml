@using FreshFarm.Web.Bff.Services
@model FreshFarm.Web.Bff.Dtos.RegisterRequestDto
@{
    Layout = null;
    var cspNonce = Context.Items["CspNonce"] as string ?? string.Empty;
    var returnUrl = ViewData["ReturnUrl"] as string;
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Context.Request.Query["returnUrl"].ToString();
    }
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    }
    var botChallenge = ViewData["BotChallenge"] as BotChallengePresentation ?? new BotChallengePresentation();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/account-auth.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="account-auth account-auth--signup">
    <main class="account-auth__shell account-auth__shell--wide">
        <section class="account-auth-card" aria-labelledby="signupHeading">
            <header class="account-auth-header">
                <img id="signupLogo"
                     src="@WebAssetPaths.LogoRequestPath"
                     alt="Logo FreshFarm"
                     class="account-auth-logo"
                     data-fallback-toggle-target="signupLogoFallback" />
                <div id="signupLogoFallback" class="account-auth-logo-fallback d-none">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <h1 id="signupHeading" class="h3">Tạo tài khoản mới</h1>
                <p class="text-muted mb-0">Đăng ký nhanh để mua sắm nông sản tươi, an toàn và minh bạch nguồn gốc.</p>
            </header>

            <div class="account-auth__process" role="note">
                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                <div>
                    <strong>Quy trình kích hoạt:</strong>
                    tạo tài khoản, xác minh email, sau đó chờ quản trị viên phê duyệt trước khi sử dụng đầy đủ FreshFarm.
                </div>
            </div>

            <form asp-action="SignUp"
                  asp-controller="Account"
                  asp-route-returnUrl="@returnUrl"
                  method="post"
                  id="signUpForm"
                  data-bot-challenge-form
                  data-bot-challenge-site-key="@botChallenge.SiteKey"
                  data-bot-challenge-action="@botChallenge.Action"
                  class="needs-validation"
                  novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="RoleName" type="hidden" value="Customer" />
                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Ví dụ: Nguyễn Văn A"
                               autocomplete="name"
                               required />
                        <label asp-for="FullName">Họ và tên</label>
                        <div class="invalid-feedback">Họ và tên không được để trống.</div>
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Ví dụ: nguyenvana"
                               autocomplete="username"
                               required />
                        <label asp-for="UserName">Tên đăng nhập</label>
                        <div class="invalid-feedback">Tên đăng nhập không được để trống.</div>
                    </div>
                    <div class="account-auth__form-hint">Dùng 4-50 ký tự gồm chữ cái, số, dấu chấm, gạch dưới hoặc gạch ngang.</div>
                    <span asp-validation-for="UserName" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               placeholder="name@example.com"
                               autocomplete="email"
                               required />
                        <label asp-for="Email">Địa chỉ email</label>
                        <div class="invalid-feedback">Email không được để trống.</div>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Phone"
                               class="form-control"
                               type="tel"
                               placeholder="Ví dụ: 0912345678"
                               autocomplete="tel"
                               required />
                        <label asp-for="Phone">Số điện thoại</label>
                        <div class="invalid-feedback">Số điện thoại không được để trống.</div>
                    </div>
                    <div class="account-auth__form-hint">Hệ thống ưu tiên số điện thoại Việt Nam để thuận tiện giao hàng và hỗ trợ đơn.</div>
                    <span asp-validation-for="Phone" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               placeholder="Mật khẩu"
                               autocomplete="new-password"
                               required />
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="invalid-feedback">Mật khẩu không được để trống.</div>
                    </div>
                    <div class="account-auth__form-hint">Nên có ít nhất 8 ký tự, gồm chữ cái và chữ số.</div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               type="password"
                               placeholder="Xác nhận mật khẩu"
                               autocomplete="new-password"
                               required />
                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                        <div class="invalid-feedback">Vui lòng nhập lại mật khẩu.</div>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-2"></span>
                </div>

                <section class="account-auth__terms mb-3" aria-labelledby="termsHeading">
                    <h2 id="termsHeading" class="h6 fw-bold mb-2">Điều khoản sử dụng và quyền riêng tư</h2>
                    <p class="small text-muted mb-2">
                        Khi tạo tài khoản FreshFarm, bạn xác nhận thông tin cung cấp là chính xác, không dùng tài khoản cho mục đích gian lận,
                        và đồng ý để hệ thống lưu thông tin cần thiết nhằm xử lý đơn hàng, giao vận, chăm sóc khách hàng và bảo vệ tài khoản.
                    </p>
                    <p class="small text-muted mb-0">
                        FreshFarm cam kết chỉ sử dụng dữ liệu của bạn cho vận hành dịch vụ, cải thiện trải nghiệm mua sắm và các thông báo liên quan đến đơn hàng,
                        theo phạm vi cần thiết và phù hợp với chính sách của nền tảng.
                    </p>
                </section>

                <div class="form-check mb-3">
                    <input asp-for="AcceptTerms" class="form-check-input" />
                    <label asp-for="AcceptTerms" class="form-check-label">
                        Tôi đã đọc và đồng ý với
                        <a asp-action="Terms" asp-controller="Account" target="_blank" rel="noopener noreferrer" class="text-decoration-none">Điều khoản sử dụng</a>
                        và
                        <a asp-action="PrivacyPolicy" asp-controller="Account" target="_blank" rel="noopener noreferrer" class="text-decoration-none">Chính sách quyền riêng tư</a>
                        của FreshFarm.
                    </label>
                    <div>
                        <span asp-validation-for="AcceptTerms" class="text-danger small"></span>
                    </div>
                </div>

                @if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.CloudflareTurnstile)
                {
                    <section class="account-auth-challenge" aria-labelledby="signupSecurityHeading">
                        <h2 id="signupSecurityHeading" class="account-auth-challenge__heading">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            Xác minh bảo mật
                        </h2>
                        <input asp-for="BotChallengeToken" type="hidden" data-bot-challenge-token />
                        <div class="account-auth-challenge__widget">
                            <div class="cf-turnstile"
                                 data-sitekey="@botChallenge.SiteKey"
                                 data-action="@botChallenge.Action"
                                 data-size="flexible"
                                 data-callback="freshFarmBotChallengeCompleted"
                                 data-expired-callback="freshFarmBotChallengeReset"
                                 data-error-callback="freshFarmBotChallengeReset"></div>
                            <div class="account-auth-challenge__status" data-bot-challenge-status role="status" aria-live="polite" hidden></div>
                        </div>
                        <span asp-validation-for="BotChallengeToken" class="text-danger small d-block mt-2"></span>
                    </section>
                }
                else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.GoogleRecaptcha)
                {
                    <section class="account-auth-challenge" aria-labelledby="signupSecurityHeading">
                        <h2 id="signupSecurityHeading" class="account-auth-challenge__heading">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            Xác minh bảo mật
                        </h2>
                        <p class="account-auth-challenge__help small text-muted mb-2">
                            FreshFarm sẽ kiểm tra tự động khi bạn gửi biểu mẫu.
                        </p>
                        <input asp-for="BotChallengeToken" type="hidden" data-bot-challenge-token />
                        <span asp-validation-for="BotChallengeToken" class="text-danger small d-block"></span>
                    </section>
                }
                else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.LocalSvg)
                {
                    <section class="account-auth-challenge" aria-labelledby="signupSecurityHeading">
                        <h2 id="signupSecurityHeading" class="account-auth-challenge__heading">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            Xác minh bảo mật
                        </h2>
                        <div class="d-flex flex-column flex-md-row gap-3 align-items-md-center">
                            <img id="signupCaptchaImage"
                                 src="@Url.Action("SignUpCaptcha", "Account")"
                                 alt="Mã CAPTCHA"
                                 class="border rounded-3 bg-white"
                                 width="180"
                                 height="64"
                                 data-local-captcha-image />
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input asp-for="CaptchaCode"
                                           class="form-control"
                                           placeholder="Nhập mã xác nhận"
                                           autocomplete="off"
                                           autocapitalize="characters"
                                           spellcheck="false"
                                           required />
                                    <label asp-for="CaptchaCode">Nhập mã trong hình</label>
                                    <div class="invalid-feedback">Vui lòng nhập mã xác nhận.</div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 gap-2 flex-wrap">
                                    <div class="account-auth__form-hint">Phân biệt chữ và số theo mã đang hiển thị.</div>
                                    <button id="refreshCaptchaButton" type="button" class="btn btn-outline-success btn-sm" data-local-captcha-refresh>
                                        <i class="bi bi-arrow-clockwise me-1"></i>Lấy mã mới
                                    </button>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="CaptchaCode" class="text-danger small d-block mt-2"></span>
                    </section>
                }
                else
                {
                    <div class="alert alert-danger small mb-4" role="alert">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        @(botChallenge.ErrorMessage ?? "Tính năng xác minh bảo mật chưa sẵn sàng. Vui lòng thử lại sau.")
                    </div>
                }

                <div class="d-grid">
                    <button class="btn btn-success btn-lg" type="submit">Tạo tài khoản</button>
                </div>
            </form>

            <p class="text-center mt-4 mb-0 text-muted">
                Đã có tài khoản?
                <a asp-action="SignIn"
                   asp-controller="Account"
                   asp-route-returnUrl="@returnUrl"
                   class="fw-bold">Đăng nhập</a>
            </p>
        </section>
    </main>

    <script nonce="@cspNonce" src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@cspNonce" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce="@cspNonce" src="~/js/csp-phase2.js" asp-append-version="true"></script>
    @if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.CloudflareTurnstile)
    {
        <script nonce="@cspNonce" src="~/js/bot-challenge-turnstile.js" asp-append-version="true"></script>
        <script nonce="@cspNonce" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.GoogleRecaptcha)
    {
        <script nonce="@cspNonce" src="~/js/signup-recaptcha.js" asp-append-version="true"></script>
        <script nonce="@cspNonce" src="https://www.google.com/recaptcha/api.js?render=@botChallenge.SiteKey" async defer></script>
    }
    else if (botChallenge.IsAvailable && botChallenge.Provider == BotChallengeProvider.LocalSvg)
    {
        <script nonce="@cspNonce" src="~/js/signup-captcha.js" asp-append-version="true"></script>
    }
</body>
</html>
