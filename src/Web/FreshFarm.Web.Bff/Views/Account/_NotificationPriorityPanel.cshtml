@model FreshFarm.Web.Bff.Dtos.AccountNotificationsPageViewModel

@if (Model.PrioritySection is not null)
{
    <div class="border rounded-4 p-3 p-md-4 mb-4 bg-success-subtle">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3">
            <div>
                <div class="small text-uppercase text-success-emphasis fw-semibold mb-2">Ưu tiên lúc này</div>
                <div class="fw-semibold fs-5 mb-1">@Model.PrioritySection.PriorityHeadline</div>
                <div class="text-muted mb-2">@Model.PrioritySection.PrioritySummary</div>
                <div class="d-flex flex-wrap gap-2 small">
                    <span class="badge text-bg-light border">@Model.PrioritySection.Label</span>
                    @if (Model.PrioritySection.UnreadCount > 0)
                    {
                        <span class="badge text-bg-danger">@Model.PrioritySection.UnreadCount chưa đọc</span>
                    }
                    @if (Model.PrioritySection.RecentCount > 0)
                    {
                        <span class="badge text-bg-warning">@Model.PrioritySection.RecentCount mới trong 24h</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.PrioritySection.LastUpdatedLabel))
                    {
                        <span class="badge text-bg-light border">@Model.PrioritySection.LastUpdatedLabel</span>
                    }
                </div>
            </div>
            <div class="text-lg-end">
                <a href="@Model.BuildNotificationsUrl(Model.PrioritySection.NotificationType, Model.PrioritySection.UnreadCount > 0 ? false : null, Model.PrioritySection.UnreadCount > 0 ? false : Model.PrioritySection.RecentCount > 0, Model.PrioritySection.NotificationType)"
                   class="btn btn-success"
                   data-open-notification-section
                   data-section-key="@Model.PrioritySection.SectionKey"
                   data-section-target="@($"{Model.PrioritySection.SectionKey}-body")">
                    <i class="bi bi-arrow-down-right-circle me-2"></i>Mở nhóm ưu tiên
                </a>
            </div>
        </div>

        <div class="mt-3 pt-3 border-top border-success-subtle">
            <div class="small text-uppercase text-success-emphasis fw-semibold mb-2">Tổng quan theo nhóm</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var notificationGroup in Model.NotificationSections)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <a href="@Model.BuildNotificationsUrl(notificationGroup.NotificationType, notificationGroup.UnreadCount > 0 ? false : null, notificationGroup.UnreadCount <= 0 && notificationGroup.RecentCount > 0, notificationGroup.NotificationType)"
                           class="btn btn-sm @(notificationGroup.UnreadCount > 0 ? "btn-outline-danger" : "btn-outline-light")"
                           data-open-notification-section
                           data-section-key="@notificationGroup.SectionKey"
                           data-section-target="@($"{notificationGroup.SectionKey}-body")">
                            @notificationGroup.Label
                            <span class="ms-1 badge @(notificationGroup.UnreadCount > 0 ? "text-bg-danger" : "text-bg-light")">@notificationGroup.HeroSummaryText</span>
                        </a>
                        @if (notificationGroup.UnreadCount > 0)
                        {
                            <a href="@Model.BuildNotificationsUrl(notificationGroup.NotificationType, false, false, notificationGroup.NotificationType)"
                               class="btn btn-sm btn-outline-danger"
                               data-open-notification-section
                               data-section-key="@notificationGroup.SectionKey"
                               data-section-target="@($"{notificationGroup.SectionKey}-body")"
                               data-force-unread-only="true">
                                <i class="bi bi-funnel me-2"></i>Chỉ unread
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
