@model FreshFarm.Web.Bff.Dtos.EmailVerificationPendingViewModel
@{
    Layout = null;
    const int resendCooldownSeconds = 60;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chờ xác minh email - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/account-auth.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="account-auth account-auth--verify-email">
    <main class="account-auth__shell account-auth__shell--wide">
        <section class="account-auth-card" aria-labelledby="verifyEmailHeading">
            <header class="mb-4">
                <span class="account-auth-status account-auth-status--warning">
                    <i class="bi bi-envelope-exclamation" aria-hidden="true"></i>
                    Cần xác minh email
                </span>
                <h1 id="verifyEmailHeading" class="h2 fw-bold mt-3 mb-2">Kiểm tra hộp thư của bạn</h1>
                <p class="text-muted mb-0">@Model.Message</p>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <div class="account-auth__summary mb-4">
                    <div class="small text-muted mb-1">Email đăng ký</div>
                    <div class="fw-semibold">@Model.Email</div>
                </div>
            }

            @if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success small">@successMessage</div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger small">@errorMessage</div>
            }

            <form asp-action="ResendVerificationEmail"
                  asp-controller="Account"
                  method="post"
                  class="mb-3"
                  id="resend-verification-form"
                  data-cooldown-seconds="@resendCooldownSeconds"
                  data-identifier="@Model.ResendRequest.Identifier">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Identifier" value="@Model.ResendRequest.Identifier" />
                <input type="hidden" name="ReturnUrl" value="@Model.ResendRequest.ReturnUrl" />
                <button type="submit" class="btn btn-outline-success" id="resend-verification-button">Gửi lại email xác minh</button>
                <div class="form-text mt-2" id="resend-verification-hint">
                    Bạn có thể gửi lại email xác minh nếu chưa nhận được thư.
                </div>
            </form>

            <div class="account-auth__actions">
                <a asp-action="SignIn" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-success">Về trang đăng nhập</a>
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Về trang chủ</a>
            </div>
        </section>
    </main>
    <script src="~/js/verify-email-pending.js" asp-append-version="true"></script>
</body>
</html>
