@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Điều khoản sử dụng - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    @await Html.PartialAsync("_MarketplaceChromeStyles")
    <style>
        body {
            font-family: var(--marketplace-font);
            background:
                radial-gradient(circle at top left, rgba(22, 163, 74, 0.08), transparent 28%),
                linear-gradient(180deg, #f7fbf8 0%, #eef7f1 100%);
            color: #1f2937;
        }

        .policy-shell {
            padding: 28px 0 56px;
        }

        .policy-card {
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid #dbe9df;
            border-radius: 28px;
            box-shadow: 0 18px 45px rgba(31, 41, 55, 0.08);
            overflow: hidden;
        }

        .policy-hero {
            padding: 36px 36px 28px;
            background: linear-gradient(135deg, #008a4f 0%, #14a05d 100%);
            color: #fff;
        }

        .policy-body {
            padding: 34px 36px 40px;
        }

        .policy-section + .policy-section {
            margin-top: 28px;
        }

        .policy-section h2 {
            font-size: 1.15rem;
            color: #008a4f;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .policy-note {
            background: #f4fbf7;
            border-left: 4px solid #008a4f;
            padding: 14px 16px;
            border-radius: 12px;
        }

        .policy-breadcrumb {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.18);
            font-size: .9rem;
        }
    </style>
</head>
<body>
    @await Html.PartialAsync("_PromoBarLegacy")
    @await Html.PartialAsync("_HeaderLegacy")
    @await Html.PartialAsync("_NavLegacy")

    <main class="policy-shell">
        <div class="container">
            <article class="policy-card">
                <header class="policy-hero">
                    <div class="policy-breadcrumb mb-3">
                        <i class="bi bi-shield-check"></i>
                        <span>Tài liệu dành cho người dùng FreshFarm</span>
                    </div>
                    <h1 class="h3 fw-bold mb-2">Điều khoản sử dụng</h1>
                    <p class="mb-0 opacity-75">
                        Tài liệu này mô tả các nguyên tắc cơ bản khi bạn tạo tài khoản, sử dụng website và thực hiện giao dịch trên nền tảng FreshFarm.
                    </p>
                </header>

                <div class="policy-body">
                    <section class="policy-section">
                        <h2>1. Phạm vi áp dụng</h2>
                        <p class="mb-0">
                            Điều khoản này áp dụng cho mọi người dùng truy cập, đăng ký tài khoản, mua hàng hoặc sử dụng các tính năng liên quan đến đơn hàng,
                            vận chuyển, thanh toán và hỗ trợ khách hàng trên FreshFarm.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>2. Trách nhiệm của người dùng</h2>
                        <p>
                            Khi sử dụng FreshFarm, bạn cam kết cung cấp thông tin chính xác, đầy đủ và cập nhật. Bạn có trách nhiệm bảo mật mật khẩu,
                            không chia sẻ tài khoản cho người khác và không sử dụng nền tảng vào các mục đích gian lận, gây rối hoặc vi phạm pháp luật.
                        </p>
                        <p class="mb-0">
                            Nếu phát hiện dấu hiệu truy cập trái phép hoặc nghi ngờ lộ tài khoản, bạn cần đổi mật khẩu và thông báo cho FreshFarm sớm nhất có thể.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>3. Nội dung giao dịch và đơn hàng</h2>
                        <p>
                            FreshFarm nỗ lực hiển thị thông tin sản phẩm, giá bán, chương trình khuyến mãi và trạng thái tồn kho một cách rõ ràng.
                            Tuy nhiên, trong một số trường hợp bất khả kháng hoặc do cập nhật hệ thống, thông tin có thể thay đổi trước khi đơn hàng được xác nhận hoàn tất.
                        </p>
                        <p class="mb-0">
                            Đơn hàng chỉ được xem là hoàn chỉnh khi hệ thống ghi nhận thành công theo quy trình vận hành và thanh toán tương ứng.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>4. Hành vi không được phép</h2>
                        <p class="mb-2">Bạn không được:</p>
                        <ul class="mb-0">
                            <li>Đăng tải hoặc cung cấp thông tin giả mạo, sai lệch hoặc gây hiểu nhầm.</li>
                            <li>Lợi dụng lỗi hệ thống để trục lợi, tạo đơn hàng ảo hoặc can thiệp trái phép vào dữ liệu.</li>
                            <li>Thực hiện hành vi gây ảnh hưởng đến trải nghiệm của người dùng khác hoặc hoạt động bình thường của nền tảng.</li>
                        </ul>
                    </section>

                    <section class="policy-section">
                        <h2>5. Quyền của FreshFarm</h2>
                        <p class="mb-0">
                            FreshFarm có quyền tạm khóa, giới hạn hoặc chấm dứt quyền truy cập đối với tài khoản có dấu hiệu vi phạm điều khoản,
                            gian lận thanh toán, lạm dụng khuyến mãi hoặc gây rủi ro cho hệ thống và cộng đồng người dùng.
                        </p>
                    </section>

                    <section class="policy-section">
                        <h2>6. Thay đổi điều khoản</h2>
                        <p class="mb-0">
                            FreshFarm có thể cập nhật nội dung điều khoản khi cần thiết để phù hợp với mô hình vận hành, tính năng mới hoặc yêu cầu pháp lý.
                            Phiên bản mới sẽ được công bố trên website và có hiệu lực từ thời điểm đăng tải.
                        </p>
                    </section>

                    <section class="policy-section">
                        <div class="policy-note">
                            <strong>Lưu ý:</strong> Đây là phiên bản điều khoản sử dụng gọn, phục vụ cho luồng đăng ký tài khoản và trải nghiệm vận hành hiện tại của FreshFarm.
                        </div>
                    </section>
                </div>
            </article>
        </div>
    </main>

    @await Html.PartialAsync("_FooterLegacy")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
