@{
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    bool isPeopleActive = currentController is "User" or "Merchant";
    bool isOperationsActive = currentController is "Order" or "Shipping";
    bool isMoneyActive = currentController is "Finance" or "Report";
    bool isCatalogActive = currentController is "Product" or "Category" or "CatalogModeration" or "Unit" or "Status";
    bool isMarketingActive = currentController is "Coupon" or "Campaign" or "Loyalty" or "Notification";
    bool isTrustActive = currentController is "Audit" or "SupportChat" or "Setting";
}

<nav id="sidebar">
    <div class="sidebar-header text-center">
        <h3><i class="bi bi-person-workspace"></i> Admin</h3>
    </div>

    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link @(currentAction == "Dashboard" && currentController == "Home" ? "active" : "")"
               href="@Url.Action("Dashboard", "Home", new { area = "Admin" })">
                <i class="bi bi-grid-1x2-fill"></i> Bảng điều khiển
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(isPeopleActive ? "active" : "")"
               href="#adminPeopleMenu"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="@(isPeopleActive.ToString().ToLowerInvariant())"
               aria-controls="adminPeopleMenu">
                <i class="bi bi-people-fill"></i> Người dùng & nhà bán
            </a>
            <ul class="collapse list-unstyled submenu @(isPeopleActive ? "show" : "")" id="adminPeopleMenu">
                <li>
                    <a class="nav-link @(currentController == "User" && currentAction == "ManageUsers" ? "active" : "")"
                       href="@Url.Action("ManageUsers", "User", new { area = "Admin" })">
                        <i class="bi bi-person-lines-fill"></i> Quản lý người dùng
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Merchant" ? "active" : "")"
                       href="@Url.Action("Index", "Merchant", new { area = "Admin" })">
                        <i class="bi bi-patch-check-fill"></i> Duyệt nhà bán
                    </a>
                </li>
            </ul>
        </li>

        <li class="nav-item">
            <a class="nav-link @(isOperationsActive ? "active" : "")"
               href="#adminOperationsMenu"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="@(isOperationsActive.ToString().ToLowerInvariant())"
               aria-controls="adminOperationsMenu">
                <i class="bi bi-truck"></i> Đơn hàng & vận hành
            </a>
            <ul class="collapse list-unstyled submenu @(isOperationsActive ? "show" : "")" id="adminOperationsMenu">
                <li>
                    <a class="nav-link @(currentController == "Order" ? "active" : "")"
                       href="@Url.Action("ManageOrders", "Order", new { area = "Admin" })">
                        <i class="bi bi-receipt-cutoff"></i> Quản lý đơn hàng
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Shipping" ? "active" : "")"
                       href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin" })">
                        <i class="bi bi-truck"></i> Quản lý vận chuyển
                    </a>
                </li>
            </ul>
        </li>

        <li class="nav-item">
            <a class="nav-link @(isMoneyActive ? "active" : "")"
               href="#adminMoneyMenu"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="@(isMoneyActive.ToString().ToLowerInvariant())"
               aria-controls="adminMoneyMenu">
                <i class="bi bi-cash-stack"></i> Tài chính & báo cáo
            </a>
            <ul class="collapse list-unstyled submenu @(isMoneyActive ? "show" : "")" id="adminMoneyMenu">
                <li>
                    <a class="nav-link @(currentController == "Finance" ? "active" : "")"
                       href="@Url.Action("Index", "Finance", new { area = "Admin" })">
                        <i class="bi bi-wallet2"></i> Tài chính & đối soát
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Report" ? "active" : "")"
                       href="@Url.Action("Revenue", "Report", new { area = "Admin" })">
                        <i class="bi bi-bar-chart-line-fill"></i> Báo cáo
                    </a>
                </li>
            </ul>
        </li>

        <li class="nav-item">
            <a class="nav-link @(isCatalogActive ? "active" : "")"
               href="#adminCatalogMenu"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="@(isCatalogActive.ToString().ToLowerInvariant())"
               aria-controls="adminCatalogMenu">
                <i class="bi bi-box-seam-fill"></i> Sản phẩm & danh mục
            </a>
            <ul class="collapse list-unstyled submenu @(isCatalogActive ? "show" : "")" id="adminCatalogMenu">
                <li>
                    <a class="nav-link @(currentController == "Product" ? "active" : "")"
                       href="@Url.Action("ManageProducts", "Product", new { area = "Admin" })">
                        <i class="bi bi-box-seam-fill"></i> Sản phẩm
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "CatalogModeration" ? "active" : "")"
                       href="@Url.Action("Index", "CatalogModeration", new { area = "Admin" })">
                        <i class="bi bi-shield-check"></i> Kiểm duyệt sản phẩm
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Category" ? "active" : "")"
                       href="@Url.Action("ManageCategories", "Category", new { area = "Admin" })">
                        <i class="bi bi-collection-fill"></i> Danh mục
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Unit" ? "active" : "")"
                       href="@Url.Action("Index", "Unit", new { area = "Admin" })">
                        <i class="bi bi-rulers"></i> Đơn vị tính
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Status" && currentAction == "Status" ? "active" : "")"
                       href="@Url.Action("Status", "Status", new { area = "Admin" })">
                        <i class="bi bi-list-task"></i> Trạng thái
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Status" && currentAction == "StatusType" ? "active" : "")"
                       href="@Url.Action("StatusType", "Status", new { area = "Admin" })">
                        <i class="bi bi-diagram-3"></i> Loại trạng thái
                    </a>
                </li>
            </ul>
        </li>

        <li class="nav-item">
            <a class="nav-link @(isMarketingActive ? "active" : "")"
               href="#adminMarketingMenu"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="@(isMarketingActive.ToString().ToLowerInvariant())"
               aria-controls="adminMarketingMenu">
                <i class="bi bi-megaphone-fill"></i> Marketing & tương tác
            </a>
            <ul class="collapse list-unstyled submenu @(isMarketingActive ? "show" : "")" id="adminMarketingMenu">
                <li>
                    <a class="nav-link @(currentController == "Coupon" ? "active" : "")"
                       href="@Url.Action("ManageCoupons", "Coupon", new { area = "Admin" })">
                        <i class="bi bi-ticket-perforated-fill"></i> Voucher sàn
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Campaign" ? "active" : "")"
                       href="@Url.Action("Index", "Campaign", new { area = "Admin" })">
                        <i class="bi bi-megaphone-fill"></i> Chương trình khuyến mãi
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Notification" ? "active" : "")"
                       href="@Url.Action("Index", "Notification", new { area = "Admin" })">
                        <i class="bi bi-bell-fill"></i> Trung tâm thông báo
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Loyalty" ? "active" : "")"
                       href="@Url.Action("Index", "Loyalty", new { area = "Admin" })">
                        <i class="bi bi-stars"></i> Tích điểm
                    </a>
                </li>
            </ul>
        </li>

        <li class="nav-item">
            <a class="nav-link @(isTrustActive ? "active" : "")"
               href="#adminTrustMenu"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="@(isTrustActive.ToString().ToLowerInvariant())"
               aria-controls="adminTrustMenu">
                <i class="bi bi-shield-check"></i> Hỗ trợ & hệ thống
            </a>
            <ul class="collapse list-unstyled submenu @(isTrustActive ? "show" : "")" id="adminTrustMenu">
                <li>
                    <a class="nav-link @(currentController == "SupportChat" ? "active" : "")"
                       href="@Url.Action("Index", "SupportChat", new { area = "Admin" })">
                        <i class="bi bi-headset"></i> Hỗ trợ trực tuyến
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Audit" ? "active" : "")"
                       href="@Url.Action("Index", "Audit", new { area = "Admin" })">
                        <i class="bi bi-journal-text"></i> Nhật ký hệ thống
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Setting" ? "active" : "")"
                       href="@Url.Action("Index", "Setting", new { area = "Admin" })">
                        <i class="bi bi-gear-fill"></i> Cài đặt hệ thống
                    </a>
                </li>
            </ul>
        </li>
    </ul>
</nav>

