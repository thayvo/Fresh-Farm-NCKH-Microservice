@model FreshFarm.Web.Bff.Areas.Admin.Models.RiskCenterPageViewModel
@{
    ViewData["Title"] = "Trung tâm rủi ro";

    string ToneClass(string severity)
    {
        return (severity ?? string.Empty).ToLowerInvariant() switch
        {
            "critical" => "tone-critical",
            "high" => "tone-high",
            "medium" => "tone-medium",
            "low" => "tone-low",
            _ => "tone-neutral"
        };
    }

    string TranslateRiskValue(string? value)
    {
        return (value ?? string.Empty).ToLowerInvariant() switch
        {
            "voucher_abuse" => "Lạm dụng voucher",
            "return_spike" => "Tăng đột biến hoàn trả",
            "open" => "Mở",
            "pending_review" => "Chờ duyệt",
            "monitoring" => "Theo dõi",
            "resolved" => "Đã xử lý",
            "dismissed" => "Bỏ qua",
            "critical" => "Nghiêm trọng",
            "high" => "Cao",
            "medium" => "Trung bình",
            "low" => "Thấp",
            _ => (value ?? string.Empty).Replace("_", " ")
        };
    }
}

<section class="risk-console ff-admin-shell">
    <div class="risk-hero ff-admin-hero mb-4">
        <div>
            <p class="eyebrow ff-admin-kicker mb-2">Kiểm soát liên thông</p>
            <h1 class="fw-bold mb-2">Trung tâm rủi ro</h1>
            <p class="mb-0 opacity-75">Theo dõi hàng đợi nghi ngờ gian lận cho lạm dụng voucher và tăng đột biến hoàn trả, kèm nhật ký quyết định để vận hành lane 7.7A.</p>
        </div>
        <div class="hero-chip ff-admin-chip">Phase 7.7A MVP</div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (ViewBag.Error is string pageError && !string.IsNullOrWhiteSpace(pageError))
    {
        <div class="alert alert-warning">@pageError</div>
    }
    @if (ViewBag.DetailError is string detailError && !string.IsNullOrWhiteSpace(detailError))
    {
        <div class="alert alert-warning">@detailError</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Tổng số ca</span>
                <strong>@Model.Overview.TotalCases</strong>
                <small>@Model.Overview.OpenCases đang mở</small>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Chờ duyệt</span>
                <strong>@Model.Overview.ReviewCases</strong>
                <small>@Model.Overview.EscalatedCases đã leo thang</small>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Mức độ cao</span>
                <strong>@Model.Overview.HighSeverityCases</strong>
                <small>@Model.Overview.DecisionsLast7d quyết định / 7 ngày</small>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Cơ cấu ca</span>
                <strong>@Model.Overview.VoucherAbuseCases</strong>
                <small>@Model.Overview.ReturnSpikeCases ca hoàn trả tăng đột biến</small>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-xl-7">
            <div class="panel-card ff-admin-card mb-4">
                <div class="panel-head d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1">Hàng đợi rủi ro</h2>
                        <p class="text-muted mb-0">Lọc theo loại ca, trạng thái và mức độ nghiêm trọng để xử lý nhanh các tín hiệu đang nổi lên.</p>
                    </div>
                    <form method="post" asp-action="SyncHeuristics" asp-controller="Risk" asp-area="Admin">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="q" value="@Model.Query" />
                        <input type="hidden" name="type" value="@Model.Type" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="severity" value="@Model.Severity" />
                        <input type="hidden" name="riskCaseId" value="@Model.SelectedCaseId" />
                        <button type="submit" class="btn btn-outline-primary">Đồng bộ heuristic</button>
                    </form>
                </div>

                <form method="get" asp-action="Index" asp-controller="Risk" asp-area="Admin" class="row g-3 mb-4">
                    <div class="col-md-4">
                        <input class="form-control" type="text" name="q" value="@Model.Query" placeholder="Tìm theo tiêu đề, tóm tắt, mã tham chiếu..." />
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="type">
                            @foreach (var option in Model.TypeOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.Type)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="status">
                            @foreach (var option in Model.StatusOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.Status)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="severity">
                            @foreach (var option in Model.SeverityOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.Severity)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button class="btn btn-primary" type="submit">Lọc</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table align-middle risk-table">
                        <thead>
                            <tr>
                                <th>Ca</th>
                                <th>Liên kết</th>
                                <th>Tín hiệu</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Chưa có ca rủi ro nào khớp với bộ lọc hiện tại.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Rows)
                                {
                                    <tr class="@(Model.SelectedCaseId == item.RiskCaseId ? "is-selected" : string.Empty)">
                                        <td>
                                            <div class="fw-semibold">@item.Title</div>
                                            <div class="small text-muted">@TranslateRiskValue(item.CaseType)</div>
                                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                                            {
                                                <div class="small text-muted mt-1">@item.Summary</div>
                                            }
                                        </td>
                                        <td>
                                            @if (item.SellerId.HasValue)
                                            {
                                                <div class="small">Nhà bán #@item.SellerId</div>
                                            }
                                            @if (item.BuyerId.HasValue)
                                            {
                                                <div class="small">Người mua #@item.BuyerId</div>
                                            }
                                            @if (item.OrderId.HasValue)
                                            {
                                                <div class="small">Đơn hàng #@item.OrderId</div>
                                            }
                                            @if (item.VoucherCouponId.HasValue)
                                            {
                                                <div class="small">Mã giảm giá #@item.VoucherCouponId</div>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@item.SignalCount tín hiệu</div>
                                            <div class="small text-muted">@(item.LastSignalAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "-")</div>
                                        </td>
                                        <td>
                                            <span class="status-pill @ToneClass(item.Severity)">@TranslateRiskValue(item.Severity)</span>
                                            <div class="small text-muted mt-1">@TranslateRiskValue(item.Status)</div>
                                            @if (item.IsEscalated)
                                            {
                                                <div class="small text-danger">Đã leo thang</div>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-riskCaseId="@item.RiskCaseId" asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity">Chi tiết</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel-card ff-admin-card">
                <div class="panel-head">
                    <h2 class="h5 mb-1">Tín hiệu gần đây</h2>
                    <p class="text-muted mb-0">Theo dõi nhanh các ca vừa cập nhật để đội tăng trưởng và vận hành không bỏ sót.</p>
                </div>

                @if (Model.Overview.Recent.Count == 0)
                {
                    <div class="text-muted">Chưa có ca mới gần đây.</div>
                }
                else
                {
                    <div class="detail-stack">
                        @foreach (var item in Model.Overview.Recent)
                        {
                            <div class="detail-item">
                                <div>
                                    <div class="fw-semibold">@item.Title</div>
                                    <div class="small text-muted">@TranslateRiskValue(item.CaseType) | @TranslateRiskValue(item.Status)</div>
                                </div>
                                <div class="text-end">
                                    <div class="status-pill @ToneClass(item.Severity)">@TranslateRiskValue(item.Severity)</div>
                                    <div class="small text-muted mt-1">@item.SignalCount tín hiệu</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-xl-5">
            <div class="panel-card ff-admin-card sticky-panel">
                <div class="panel-head">
                    <h2 class="h5 mb-1">Chi tiết ca</h2>
                    <p class="text-muted mb-0">Dòng thời gian tinh gọn để admin ra quyết định nhanh và lưu lại nhật ký xử lý cơ bản.</p>
                </div>

                @if (Model.SelectedCase is null)
                {
                    <div class="text-muted">Chọn một ca để xem chi tiết.</div>
                }
                else
                {
                    <div class="case-detail-head mb-3">
                        <div>
                            <div class="section-label">@TranslateRiskValue(Model.SelectedCase.CaseType)</div>
                            <h3 class="h5 mb-1">@Model.SelectedCase.Title</h3>
                            <div class="small text-muted">@Model.SelectedCase.ReferenceKey</div>
                        </div>
                        <div class="text-end">
                            <div class="status-pill @ToneClass(Model.SelectedCase.Severity)">@TranslateRiskValue(Model.SelectedCase.Severity)</div>
                            <div class="small text-muted mt-1">@TranslateRiskValue(Model.SelectedCase.Status)</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedCase.Summary))
                    {
                        <div class="detail-item mb-3">
                            <div class="small">@Model.SelectedCase.Summary</div>
                        </div>
                    }

                    <div class="meta-grid mb-4">
                        <div class="meta-item"><span class="section-label">Nhà bán</span><strong>@(Model.SelectedCase.SellerId?.ToString() ?? "-")</strong></div>
                        <div class="meta-item"><span class="section-label">Người mua</span><strong>@(Model.SelectedCase.BuyerId?.ToString() ?? "-")</strong></div>
                        <div class="meta-item"><span class="section-label">Đơn hàng</span><strong>@(Model.SelectedCase.OrderId?.ToString() ?? "-")</strong></div>
                        <div class="meta-item"><span class="section-label">Voucher</span><strong>@(Model.SelectedCase.VoucherCode ?? Model.SelectedCase.VoucherCouponId?.ToString() ?? "-")</strong></div>
                    </div>

                    <div class="section-label">Tín hiệu</div>
                    @if (Model.SelectedCase.Signals.Count == 0)
                    {
                        <div class="text-muted small mb-4">Chưa có tín hiệu chi tiết.</div>
                    }
                    else
                    {
                        <div class="detail-stack mb-4">
                            @foreach (var signal in Model.SelectedCase.Signals.Take(4))
                            {
                                <div class="detail-item">
                                    <div>
                                        <strong>@TranslateRiskValue(signal.SignalType)</strong>
                                        <div class="small text-muted">@signal.SignalCode | @signal.Source</div>
                                    </div>
                                    <div class="small text-end text-muted">@signal.Score.ToString("N1") điểm<br />@signal.TriggeredAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                </div>
                            }
                        </div>
                    }

                    @if (Model.SelectedCase.VoucherAbuseCases.Count > 0)
                    {
                        <div class="section-label">Dấu vết lạm dụng voucher</div>
                        <div class="detail-stack mb-4">
                            @foreach (var abuse in Model.SelectedCase.VoucherAbuseCases.Take(3))
                            {
                                <div class="detail-item">
                                    <div>
                                        <strong>@TranslateRiskValue(abuse.AbuseType)</strong>
                                        <div class="small text-muted">Mã giảm giá #@abuse.CouponId | Người mua #@(abuse.BuyerId?.ToString() ?? "-")</div>
                                    </div>
                                    <div class="small text-end text-muted">@(abuse.SuspectedBenefitAmount?.ToString("N0") ?? "0") đ</div>
                                </div>
                            }
                        </div>
                    }

                    <div class="section-label">Nhật ký quyết định</div>
                    @if (Model.SelectedCase.Decisions.Count == 0)
                    {
                        <div class="text-muted small mb-3">Chưa có quyết định nào.</div>
                    }
                    else
                    {
                        <div class="detail-stack mb-4">
                            @foreach (var decision in Model.SelectedCase.Decisions.Take(4))
                            {
                                <div class="detail-item">
                                    <div>
                                        <strong>@TranslateRiskValue(decision.DecisionType)</strong>
                                        <div class="small text-muted">@decision.Notes</div>
                                    </div>
                                    <div class="small text-end text-muted">@decision.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                </div>
                            }
                        </div>
                    }

                    <form method="post" asp-action="SubmitDecision" asp-controller="Risk" asp-area="Admin" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input asp-for="DecisionEditor.RiskCaseId" type="hidden" />
                        <input type="hidden" name="q" value="@Model.Query" />
                        <input type="hidden" name="type" value="@Model.Type" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="severity" value="@Model.Severity" />
                        <div class="col-12">
                            <label asp-for="DecisionEditor.DecisionType" class="form-label">Quyết định</label>
                            <select asp-for="DecisionEditor.DecisionType" class="form-select">
                                @foreach (var option in Model.SelectedCase.DecisionOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="DecisionEditor.Notes" class="form-label">Ghi chú</label>
                            <textarea asp-for="DecisionEditor.Notes" class="form-control" rows="3" placeholder="Ghi chú quyết định hoặc phần handoff tiếp theo..."></textarea>
                        </div>
                        <div class="col-12 d-grid">
                            <button type="submit" class="btn btn-primary">Ghi nhận quyết định</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .risk-console .risk-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .risk-console .hero-chip {
    }

    .risk-console .metric-card,
    .risk-console .panel-card {
        border: 1px solid var(--ff-border);
    }

    .risk-console .metric-card {
        padding: 1.25rem;
        min-height: 128px;
    }

    .risk-console .metric-card strong {
        display: block;
        font-size: 2rem;
        line-height: 1.1;
        color: #0f172a;
    }

    .risk-console .metric-label,
    .risk-console .section-label {
        display: block;
        text-transform: uppercase;
        letter-spacing: .12em;
        font-size: .75rem;
        color: #64748b;
        margin-bottom: .5rem;
    }

    .risk-console .panel-card {
        padding: 1.5rem;
    }

    .risk-console .panel-head {
        margin-bottom: 1rem;
    }

    .risk-console .risk-table th {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #6b7280;
    }

    .risk-console .risk-table .is-selected {
        background: rgba(59,130,246,.06);
    }

    .risk-console .status-pill {
        display: inline-flex;
        align-items: center;
        padding: .35rem .75rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
        text-transform: capitalize;
    }

    .risk-console .tone-critical {
        background: rgba(153, 27, 27, .12);
        color: #991b1b;
    }

    .risk-console .tone-high {
        background: rgba(220, 38, 38, .12);
        color: #b91c1c;
    }

    .risk-console .tone-medium {
        background: rgba(245, 158, 11, .16);
        color: #b45309;
    }

    .risk-console .tone-low {
        background: rgba(34, 197, 94, .14);
        color: #15803d;
    }

    .risk-console .tone-neutral {
        background: rgba(59, 130, 246, .12);
        color: #1d4ed8;
    }

    .risk-console .detail-stack {
        display: grid;
        gap: .85rem;
    }

    .risk-console .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: .9rem 1rem;
        border-radius: 1rem;
        background: rgba(15, 23, 42, .03);
    }

    .risk-console .meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
    }

    .risk-console .meta-item {
        padding: .9rem 1rem;
        border-radius: 1rem;
        background: rgba(59,130,246,.04);
    }

    .risk-console .sticky-panel {
        position: sticky;
        top: 1rem;
    }

    @@media (max-width: 1199.98px) {
        .risk-console .sticky-panel {
            position: static;
        }
    }
</style>
