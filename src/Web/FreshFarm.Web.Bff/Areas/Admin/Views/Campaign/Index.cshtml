@model FreshFarm.Web.Bff.Areas.Admin.Models.CampaignCenterPageViewModel
@{
    ViewData["Title"] = "Chương trình khuyến mãi";
    string selectedStatus = Model.SelectedCampaign?.Status ?? Model.Editor.Status;
    string selectedType = Model.SelectedCampaign?.CampaignType ?? Model.Editor.CampaignType;

    string TranslateCampaignValue(string? value)
    {
        return (value ?? string.Empty).ToLowerInvariant() switch
        {
            "flash_sale" => "Flash sale",
            "voucher_boost" => "Đẩy voucher",
            "seasonal" => "Theo mùa",
            "livestream" => "Livestream",
            "draft" => "Nháp",
            "registration_open" => "Mở đăng ký",
            "registration_closed" => "Đóng đăng ký",
            "scheduled" => "Đã lên lịch",
            "running" => "Đang chạy",
            "completed" => "Hoàn tất",
            "suspended" => "Tạm ngưng",
            "paused" => "Tạm dừng",
            "active" => "Hoạt động",
            _ => (value ?? string.Empty).Replace("_", " ")
        };
    }
}

<section class="campaign-console ff-admin-shell">
    <div class="page-header ff-admin-hero mb-4">
        <div>
            <p class="eyebrow ff-admin-kicker mb-2">Khuyến mãi sàn</p>
            <h1 class="fw-bold mb-2">Chương trình khuyến mãi</h1>
            <p class="mb-0 opacity-75">Tạo và quản lý các chương trình flash sale, voucher và ưu đãi theo mùa cho nhà bán tham gia.</p>
        </div>
        <div class="header-note">
            <span class="ff-admin-chip">Quản lý ưu đãi</span>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (ViewBag.Error is string pageError && !string.IsNullOrWhiteSpace(pageError))
    {
        <div class="alert alert-warning">@pageError</div>
    }
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Chương trình</span>
                <strong>@Model.Overview.TotalCampaigns</strong>
                <small>@Model.Overview.RunningCampaigns đang chạy</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Đăng ký nhà bán</span>
                <strong>@Model.Overview.RegistrationOpenCampaigns</strong>
                <small>@Model.Overview.PendingParticipations chờ duyệt</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Suất sản phẩm</span>
                <strong>@Model.Overview.TotalSlots</strong>
                <small>@Model.Overview.LiveSlots đang hiển thị</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Ngân sách</span>
                <strong>@Model.Overview.TotalBudget.ToString("N0") đ</strong>
                <small>@Model.Overview.ApprovedParticipations nhà bán được duyệt</small>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="panel-card ff-admin-card mb-4">
                <div class="panel-head d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1">Danh sách chương trình</h2>
                        <p class="text-muted mb-0">Lọc theo trạng thái, loại ưu đãi và từ khóa để quản lý các chương trình khuyến mãi đang mở trên sàn.</p>
                    </div>
                </div>

                <form method="get" asp-action="Index" asp-controller="Campaign" asp-area="Admin" class="row g-3 mb-4">
                    <div class="col-md-5">
                        <input class="form-control" type="text" name="q" value="@Model.Query" placeholder="Tìm theo tên, mô tả..." />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="status">
                            @foreach (var option in Model.StatusOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.Status)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="type">
                            @foreach (var option in Model.TypeOptions.Where(x => !string.Equals(x.Value, "livestream", StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.Type)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1 d-grid">
                        <button class="btn btn-primary" type="submit">Lọc</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table align-middle campaign-table">
                        <thead>
                            <tr>
                                <th>Chương trình</th>
                                <th>Trạng thái</th>
                                <th>Thời gian</th>
                                <th>Voucher</th>
                                <th>Nhà bán</th>
                                <th>Suất</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Campaigns.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chưa có chương trình khuyến mãi nào. Hãy tạo chương trình đầu tiên ở cột bên phải.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Campaigns)
                                {
                                    <tr class="@(Model.SelectedCampaignId == item.CampaignId ? "is-selected" : string.Empty)">
                                        <td>
                                            <div class="fw-semibold">@item.Name</div>
                                            <div class="small text-muted">@TranslateCampaignValue(item.CampaignType)</div>
                                        </td>
                                        <td><span class="status-pill status-@item.Status.Replace("_", "-")">@TranslateCampaignValue(item.Status)</span></td>
                                        <td>
                                            <div class="small">@item.StartAt.ToString("dd/MM/yyyy") - @item.EndAt.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">Đăng ký đến @item.RegistrationEndAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.VoucherCode))
                                            {
                                                <span class="fw-semibold">@item.VoucherCode</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa liên kết</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@item.ApprovedParticipationCount/@item.ParticipationCount</span>
                                            <div class="text-muted small">đã duyệt / tổng</div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@item.ApprovedSlotCount/@item.ProductSlotCount</span>
                                            <div class="text-muted small">đã duyệt / tổng</div>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-campaignId="@item.CampaignId" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-type="@Model.Type">Chi tiết</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel-card ff-admin-card">
                <div class="panel-head">
                    <h2 class="h5 mb-1">Chương trình sắp diễn ra</h2>
                    <p class="text-muted mb-0">Theo dõi các chương trình gần hết hạn đăng ký để đội vận hành không bỏ sót.</p>
                </div>
                <div class="upcoming-list">
                    @if (Model.Overview.Upcoming.Count == 0)
                    {
                        <div class="text-muted">Chưa có chương trình sắp diễn ra.</div>
                    }
                    else
                    {
                        @foreach (var upcoming in Model.Overview.Upcoming)
                        {
                            <div class="upcoming-item">
                                <div>
                                    <div class="fw-semibold">@upcoming.Name</div>
                                    <div class="small text-muted">@TranslateCampaignValue(upcoming.CampaignType) | @upcoming.StartAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted">Hạn đăng ký</div>
                                    <div class="fw-semibold">@upcoming.RegistrationEndAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="panel-card ff-admin-card mb-4">
                <div class="panel-head">
                    <h2 class="h5 mb-1">@(Model.SelectedCampaign is null ? "Tạo chương trình mới" : "Cập nhật chương trình")</h2>
                    <p class="text-muted mb-0">Thiết lập thời gian, loại ưu đãi, voucher liên kết và trạng thái đăng ký của nhà bán.</p>
                </div>

                <form method="post" asp-action="Save" asp-controller="Campaign" asp-area="Admin" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Editor.CampaignId" />
                    <div class="col-12">
                        <label asp-for="Editor.Name" class="form-label">Tên chương trình</label>
                        <input asp-for="Editor.Name" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.CampaignType" class="form-label">Loại</label>
                        <select asp-for="Editor.CampaignType" class="form-select">
                            @foreach (var option in Model.TypeOptions.Where(x => x.Value != "all" && !string.Equals(x.Value, "livestream", StringComparison.OrdinalIgnoreCase)))
                            {
                                if (option.Value == selectedType)
                                {
                                    <option value="@option.Value" selected>@option.Text</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.Status" class="form-label">Trạng thái</label>
                        <select asp-for="Editor.Status" class="form-select">
                            @foreach (var option in Model.StatusOptions.Where(x => x.Value != "all"))
                            {
                                if (option.Value == selectedStatus)
                                {
                                    <option value="@option.Value" selected>@option.Text</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Editor.Description" class="form-label">Mô tả</label>
                        <textarea asp-for="Editor.Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.RegistrationStartAt" class="form-label">Mở đăng ký</label>
                        <input asp-for="Editor.RegistrationStartAt" type="datetime-local" class="form-control" value="@Model.Editor.RegistrationStartAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.RegistrationEndAt" class="form-label">Đóng đăng ký</label>
                        <input asp-for="Editor.RegistrationEndAt" type="datetime-local" class="form-control" value="@Model.Editor.RegistrationEndAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.StartAt" class="form-label">Bắt đầu</label>
                        <input asp-for="Editor.StartAt" type="datetime-local" class="form-control" value="@Model.Editor.StartAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.EndAt" class="form-label">Kết thúc</label>
                        <input asp-for="Editor.EndAt" type="datetime-local" class="form-control" value="@Model.Editor.EndAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.BudgetAmount" class="form-label">Ngân sách</label>
                        <input asp-for="Editor.BudgetAmount" class="form-control" type="number" min="0" step="1000" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.VoucherCouponId" class="form-label">Mã voucher</label>
                        <input asp-for="Editor.VoucherCouponId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-12 form-check form-switch ms-1">
                        <input asp-for="Editor.IsFeatured" class="form-check-input" />
                        <label asp-for="Editor.IsFeatured" class="form-check-label">Đánh dấu chương trình ưu tiên trên bảng điều khiển</label>
                    </div>
                    <div class="col-12 d-grid gap-2">
                        <button type="submit" class="btn btn-primary">@(Model.SelectedCampaign is null ? "Tạo chương trình" : "Lưu thay đổi")</button>
                        @if (Model.SelectedCampaign is not null)
                        {
                            <button type="submit" formaction="@Url.Action("ToggleRegistration", "Campaign", new { area = "Admin", id = Model.SelectedCampaign.CampaignId })" formmethod="post" class="btn btn-outline-secondary">Mở / đóng đăng ký nhà bán</button>
                        }
                    </div>
                </form>
                @if (Model.SelectedCampaign is not null)
                {
                    <form method="post" asp-action="Delete" asp-controller="Campaign" asp-area="Admin" asp-route-id="@Model.SelectedCampaign.CampaignId" class="mt-3" onsubmit="return confirm('Xóa chương trình này? Chỉ chương trình chưa có nhà bán hoặc suất sản phẩm liên kết mới xóa được.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100">Xóa chương trình</button>
                    </form>
                }
            </div>

            @if (Model.SelectedCampaign is not null)
            {
                <div class="panel-card ff-admin-card">
                    <div class="panel-head">
                        <h2 class="h5 mb-1">Tham gia của nhà bán</h2>
                        <p class="text-muted mb-0">Đọc nhanh hàng đợi nhà bán đăng ký và các suất sản phẩm đã được đưa vào chương trình.</p>
                    </div>
                    <div class="detail-stack">
                        <div>
                            <div class="section-label">Hàng đợi nhà bán</div>
                            @if (Model.SelectedCampaign.Participations.Count == 0)
                            {
                                <div class="text-muted small">Chưa có nhà bán đăng ký.</div>
                            }
                            else
                            {
                                @foreach (var item in Model.SelectedCampaign.Participations.Take(5))
                                {
                                    <div class="detail-item">
                                        <div>
                                            <strong>Nhà bán #@item.SellerId</strong>
                                            <div class="small text-muted">@TranslateCampaignValue(item.Status) | @item.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                        <div class="small text-end text-muted">@item.ApprovedSlots / @item.RequestedSlots suất</div>
                                    </div>
                                }
                            }
                        </div>
                        <div>
                            <div class="section-label">Suất flash sale</div>
                            @if (Model.SelectedCampaign.Slots.Count == 0)
                            {
                                <div class="text-muted small">Chưa có suất sản phẩm.</div>
                            }
                            else
                            {
                                @foreach (var slot in Model.SelectedCampaign.Slots.Take(5))
                                {
                                    <div class="detail-item">
                                        <div>
                                            <strong>Sản phẩm #@slot.ProductId</strong>
                                            <div class="small text-muted">Nhà bán #@slot.SellerId | @TranslateCampaignValue(slot.Status)</div>
                                        </div>
                                        <div class="small text-end text-muted">@(slot.FlashSalePrice?.ToString("N0") ?? "-") đ</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .campaign-console .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .campaign-console .eyebrow {
        letter-spacing: .18em;
    }

    .campaign-console .metric-card,
    .campaign-console .panel-card {
        border: 1px solid var(--ff-border);
    }

    .campaign-console .metric-card {
        padding: 1.25rem;
        min-height: 130px;
    }

    .campaign-console .metric-card.compact {
        min-height: 0;
        padding: 1rem;
    }

    .campaign-console .metric-card strong {
        display: block;
        font-size: 2rem;
        line-height: 1.1;
        color: #0b3c8a;
    }

    .campaign-console .metric-label,
    .campaign-console .section-label {
        display: block;
        text-transform: uppercase;
        letter-spacing: .12em;
        font-size: .75rem;
        color: #5f7ba8;
        margin-bottom: .5rem;
    }

    .campaign-console .panel-card {
        padding: 1.5rem;
    }

    .campaign-console .panel-head {
        margin-bottom: 1rem;
    }

    .campaign-console .campaign-table th {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #6c7b93;
    }

    .campaign-console .campaign-table .is-selected {
        background: rgba(13,110,253,.06);
    }

    .campaign-console .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem .75rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
        text-transform: capitalize;
        background: rgba(13,110,253,.08);
        color: #0b57d0;
    }

    .campaign-console .status-running,
    .campaign-console .status-live {
        background: rgba(25,135,84,.12);
        color: #146c43;
    }

    .campaign-console .status-suspended,
    .campaign-console .status-rejected {
        background: rgba(220,53,69,.12);
        color: #b42318;
    }

    .campaign-console .status-registration-open {
        background: rgba(13,202,240,.12);
        color: #087990;
    }

    .campaign-console .upcoming-list,
    .campaign-console .detail-stack {
        display: grid;
        gap: .9rem;
    }

    .campaign-console .upcoming-item,
    .campaign-console .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: .9rem 1rem;
        border-radius: 1rem;
        background: rgba(37,99,235,.05);
    }

    @@media (max-width: 575.98px) {
        .campaign-console .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .campaign-console .panel-card,
        .campaign-console .metric-card {
            border-radius: 1rem;
        }
    }
</style>
