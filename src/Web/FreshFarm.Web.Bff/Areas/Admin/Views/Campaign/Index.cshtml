@model FreshFarm.Web.Bff.Areas.Admin.Models.CampaignCenterPageViewModel
@{
    ViewData["Title"] = "Campaign Center";
    string selectedStatus = Model.SelectedCampaign?.Status ?? Model.Editor.Status;
    string selectedType = Model.SelectedCampaign?.CampaignType ?? Model.Editor.CampaignType;
}

<section class="campaign-console ff-admin-shell">
    <div class="page-header ff-admin-hero mb-4">
        <div>
            <p class="eyebrow ff-admin-kicker mb-2">Growth ops</p>
            <h1 class="fw-bold mb-2">Campaign center</h1>
            <p class="mb-0 opacity-75">Van hanh voucher san, flash sale va readiness cho seller participation trong cung mot lane Admin.</p>
        </div>
        <div class="header-note">
            <span class="ff-admin-chip">Phase 7.7 MVP</span>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (ViewBag.Error is string pageError && !string.IsNullOrWhiteSpace(pageError))
    {
        <div class="alert alert-warning">@pageError</div>
    }
    @if (ViewBag.AdsError is string adsError && !string.IsNullOrWhiteSpace(adsError))
    {
        <div class="alert alert-warning">@adsError</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Campaign</span>
                <strong>@Model.Overview.TotalCampaigns</strong>
                <small>@Model.Overview.RunningCampaigns dang chay</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Dang ky seller</span>
                <strong>@Model.Overview.RegistrationOpenCampaigns</strong>
                <small>@Model.Overview.PendingParticipations cho duyet</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Product slots</span>
                <strong>@Model.Overview.TotalSlots</strong>
                <small>@Model.Overview.LiveSlots dang live</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card ff-admin-card">
                <span class="metric-label">Budget</span>
                <strong>@Model.Overview.TotalBudget.ToString("N0") đ</strong>
                <small>@Model.Overview.ApprovedParticipations seller duoc duyet</small>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="panel-card ff-admin-card mb-4">
                <div class="panel-head d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1">Danh sach campaign</h2>
                        <p class="text-muted mb-0">Loc theo trang thai, loai campaign va keyword de dieu phói sprint growth.</p>
                    </div>
                </div>

                <form method="get" asp-action="Index" asp-controller="Campaign" asp-area="Admin" class="row g-3 mb-4">
                    <div class="col-md-5">
                        <input class="form-control" type="text" name="q" value="@Model.Query" placeholder="Tim theo ten, mo ta..." />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="status">
                            @foreach (var option in Model.StatusOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.Status)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="type">
                            @foreach (var option in Model.TypeOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.Type)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1 d-grid">
                        <button class="btn btn-primary" type="submit">Loc</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table align-middle campaign-table">
                        <thead>
                            <tr>
                                <th>Campaign</th>
                                <th>Trang thai</th>
                                <th>Timeline</th>
                                <th>Voucher</th>
                                <th>Seller</th>
                                <th>Slots</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Campaigns.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chua co campaign nao. Tao campaign dau tien o cot ben phai.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Campaigns)
                                {
                                    <tr class="@(Model.SelectedCampaignId == item.CampaignId ? "is-selected" : string.Empty)">
                                        <td>
                                            <div class="fw-semibold">@item.Name</div>
                                            <div class="small text-muted">@item.CampaignType.Replace("_", " ")</div>
                                        </td>
                                        <td><span class="status-pill status-@item.Status.Replace("_", "-")">@item.Status.Replace("_", " ")</span></td>
                                        <td>
                                            <div class="small">@item.StartAt.ToString("dd/MM/yyyy") - @item.EndAt.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">Dang ky den @item.RegistrationEndAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.VoucherCode))
                                            {
                                                <span class="fw-semibold">@item.VoucherCode</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Khong lien ket</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@item.ApprovedParticipationCount/@item.ParticipationCount</span>
                                            <div class="text-muted small">approved / total</div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@item.ApprovedSlotCount/@item.ProductSlotCount</span>
                                            <div class="text-muted small">approved / total</div>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-campaignId="@item.CampaignId" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-type="@Model.Type">Chi tiet</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel-card ff-admin-card">
                <div class="panel-head">
                    <h2 class="h5 mb-1">Campaign sap dien ra</h2>
                    <p class="text-muted mb-0">Theo doi campaign den han chot dang ky de khong trep nhiep team growth.</p>
                </div>
                <div class="upcoming-list">
                    @if (Model.Overview.Upcoming.Count == 0)
                    {
                        <div class="text-muted">Chua co campaign upcoming.</div>
                    }
                    else
                    {
                        @foreach (var upcoming in Model.Overview.Upcoming)
                        {
                            <div class="upcoming-item">
                                <div>
                                    <div class="fw-semibold">@upcoming.Name</div>
                                    <div class="small text-muted">@upcoming.CampaignType.Replace("_", " ") | @upcoming.StartAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="text-end">
                                    <div class="small text-muted">Han dang ky</div>
                                    <div class="fw-semibold">@upcoming.RegistrationEndAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="panel-card ff-admin-card mt-4">
                <div class="panel-head">
                    <h2 class="h5 mb-1">Ads finance overview</h2>
                    <p class="text-muted mb-0">Theo doi so du wallet, reserve budget va cac ads campaign dang chay theo seller.</p>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="metric-card ff-admin-card compact">
                            <span class="metric-label">Wallet</span>
                            <strong>@Model.AdsOverview.WalletCount</strong>
                            <small>@Model.AdsOverview.ActiveWalletCount active</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card ff-admin-card compact">
                            <span class="metric-label">Tong so du</span>
                            <strong>@Model.AdsOverview.TotalBalance.ToString("N0") đ</strong>
                            <small>@Model.AdsOverview.TotalAvailable.ToString("N0") đ kha dung</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card ff-admin-card compact">
                            <span class="metric-label">Reserve</span>
                            <strong>@Model.AdsOverview.TotalReserved.ToString("N0") đ</strong>
                            <small>@Model.AdsOverview.RunningAdsCampaigns ads dang chay</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card ff-admin-card compact">
                            <span class="metric-label">Topup / Spend</span>
                            <strong>@Model.AdsOverview.TotalTopup.ToString("N0") đ</strong>
                            <small>@Model.AdsOverview.TotalSpend.ToString("N0") đ da chi</small>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table align-middle campaign-table">
                        <thead>
                            <tr>
                                <th>Seller</th>
                                <th>So du</th>
                                <th>Reserve</th>
                                <th>Kha dung</th>
                                <th>Trang thai</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AdsWallets.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Chua co ads wallet nao. Dung form ben phai de topup khoi tao.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var wallet in Model.AdsWallets.Take(6))
                                {
                                    <tr>
                                        <td>
                                            <strong>Seller #@wallet.SellerId</strong>
                                            <div class="small text-muted">Wallet #@wallet.WalletId</div>
                                        </td>
                                        <td>@wallet.Balance.ToString("N0") đ</td>
                                        <td>@wallet.ReservedBalance.ToString("N0") đ</td>
                                        <td>@wallet.AvailableBalance.ToString("N0") đ</td>
                                        <td><span class="status-pill status-@wallet.Status.Replace("_", "-")">@wallet.Status</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="section-label">Ads campaign running queue</div>
                        @if (Model.AdsCampaigns.Count == 0)
                        {
                            <div class="text-muted small">Chua co ads campaign MVP.</div>
                        }
                        else
                        {
                            @foreach (var ads in Model.AdsCampaigns.Take(5))
                            {
                                <div class="detail-item">
                                    <div>
                                        <strong>@ads.Name</strong>
                                        <div class="small text-muted">Seller #@ads.SellerId | @ads.Channel | @ads.Status</div>
                                    </div>
                                    <div class="small text-end text-muted">@ads.SpendToDate.ToString("N0") / @ads.TotalBudget.ToString("N0") đ</div>
                                </div>
                            }
                        }
                    </div>
                    <div class="col-lg-5">
                        <div class="section-label">Recent topups</div>
                        @if (Model.RecentTopups.Count == 0)
                        {
                            <div class="text-muted small">Chua co lich su nap ngan sach.</div>
                        }
                        else
                        {
                            @foreach (var topup in Model.RecentTopups.Take(4))
                            {
                                <div class="detail-item">
                                    <div>
                                        <strong>Seller #@topup.SellerId</strong>
                                        <div class="small text-muted">@topup.PaymentMethod ?? "manual" | @topup.CreatedAt.ToString("dd/MM HH:mm")</div>
                                    </div>
                                    <div class="small text-end text-muted">@topup.Amount.ToString("N0") đ</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="panel-card ff-admin-card mb-4 sticky-panel">
                <div class="panel-head">
                    <h2 class="h5 mb-1">@(Model.SelectedCampaign is null ? "Tao campaign moi" : "Cap nhat campaign")</h2>
                    <p class="text-muted mb-0">MVP tap trung vao voucher san, flash sale va da noi them ads wallet overview co ban.</p>
                </div>

                <form method="post" asp-action="Save" asp-controller="Campaign" asp-area="Admin" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Editor.CampaignId" />
                    <div class="col-12">
                        <label asp-for="Editor.Name" class="form-label">Ten campaign</label>
                        <input asp-for="Editor.Name" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.CampaignType" class="form-label">Loai</label>
                        <select asp-for="Editor.CampaignType" class="form-select">
                            @foreach (var option in Model.TypeOptions.Where(x => x.Value != "all"))
                            {
                                if (option.Value == selectedType)
                                {
                                    <option value="@option.Value" selected>@option.Text</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.Status" class="form-label">Trang thai</label>
                        <select asp-for="Editor.Status" class="form-select">
                            @foreach (var option in Model.StatusOptions.Where(x => x.Value != "all"))
                            {
                                if (option.Value == selectedStatus)
                                {
                                    <option value="@option.Value" selected>@option.Text</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Editor.Description" class="form-label">Mo ta</label>
                        <textarea asp-for="Editor.Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.RegistrationStartAt" class="form-label">Mo dang ky</label>
                        <input asp-for="Editor.RegistrationStartAt" type="datetime-local" class="form-control" value="@Model.Editor.RegistrationStartAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.RegistrationEndAt" class="form-label">Dong dang ky</label>
                        <input asp-for="Editor.RegistrationEndAt" type="datetime-local" class="form-control" value="@Model.Editor.RegistrationEndAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.StartAt" class="form-label">Bat dau</label>
                        <input asp-for="Editor.StartAt" type="datetime-local" class="form-control" value="@Model.Editor.StartAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.EndAt" class="form-label">Ket thuc</label>
                        <input asp-for="Editor.EndAt" type="datetime-local" class="form-control" value="@Model.Editor.EndAt.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.BudgetAmount" class="form-label">Budget</label>
                        <input asp-for="Editor.BudgetAmount" class="form-control" type="number" min="0" step="1000" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Editor.VoucherCouponId" class="form-label">Voucher ID</label>
                        <input asp-for="Editor.VoucherCouponId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-12 form-check form-switch ms-1">
                        <input asp-for="Editor.IsFeatured" class="form-check-input" />
                        <label asp-for="Editor.IsFeatured" class="form-check-label">Danh dau campaign uu tien tren dashboard</label>
                    </div>
                    <div class="col-12 d-grid gap-2">
                        <button type="submit" class="btn btn-primary">@(Model.SelectedCampaign is null ? "Tao campaign" : "Luu thay doi")</button>
                        @if (Model.SelectedCampaign is not null)
                        {
                            <button type="submit" formaction="@Url.Action("ToggleRegistration", "Campaign", new { area = "Admin", id = Model.SelectedCampaign.CampaignId })" formmethod="post" class="btn btn-outline-secondary">Mo / dong dang ky seller</button>
                        }
                    </div>
                </form>
            </div>

            @if (Model.SelectedCampaign is not null)
            {
                <div class="panel-card ff-admin-card">
                    <div class="panel-head">
                        <h2 class="h5 mb-1">Seller participation</h2>
                        <p class="text-muted mb-0">Doc nhanh queue seller dang ky va product slot da nhet vao campaign.</p>
                    </div>
                    <div class="detail-stack">
                        <div>
                            <div class="section-label">Seller queue</div>
                            @if (Model.SelectedCampaign.Participations.Count == 0)
                            {
                                <div class="text-muted small">Chua co seller dang ky.</div>
                            }
                            else
                            {
                                @foreach (var item in Model.SelectedCampaign.Participations.Take(5))
                                {
                                    <div class="detail-item">
                                        <div>
                                            <strong>Seller #@item.SellerId</strong>
                                            <div class="small text-muted">@item.Status | @item.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                        <div class="small text-end text-muted">@item.ApprovedSlots / @item.RequestedSlots slots</div>
                                    </div>
                                }
                            }
                        </div>
                        <div>
                            <div class="section-label">Flash sale slots</div>
                            @if (Model.SelectedCampaign.Slots.Count == 0)
                            {
                                <div class="text-muted small">Chua co product slot.</div>
                            }
                            else
                            {
                                @foreach (var slot in Model.SelectedCampaign.Slots.Take(5))
                                {
                                    <div class="detail-item">
                                        <div>
                                            <strong>Product #@slot.ProductId</strong>
                                            <div class="small text-muted">Seller #@slot.SellerId | @slot.Status</div>
                                        </div>
                                        <div class="small text-end text-muted">@(slot.FlashSalePrice?.ToString("N0") ?? "-") đ</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="panel-card ff-admin-card mt-4">
                <div class="panel-head">
                    <h2 class="h5 mb-1">Ads wallet actions</h2>
                    <p class="text-muted mb-0">Topup, spend ledger va tao ads campaign MVP cho seller ma khong can roi campaign center.</p>
                </div>

                <form method="post" asp-action="TopupAdsWallet" asp-controller="Campaign" asp-area="Admin" class="row g-3 mb-4">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label asp-for="AdsTopupEditor.SellerId" class="form-label">Seller ID</label>
                        <input asp-for="AdsTopupEditor.SellerId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AdsTopupEditor.Amount" class="form-label">Topup</label>
                        <input asp-for="AdsTopupEditor.Amount" class="form-control" type="number" min="1000" step="1000" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AdsTopupEditor.PaymentMethod" class="form-label">Payment</label>
                        <input asp-for="AdsTopupEditor.PaymentMethod" class="form-control" placeholder="bank/manual" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AdsTopupEditor.ReferenceCode" class="form-label">Ref code</label>
                        <input asp-for="AdsTopupEditor.ReferenceCode" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="AdsTopupEditor.Notes" class="form-label">Notes</label>
                        <textarea asp-for="AdsTopupEditor.Notes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12 d-grid">
                        <button type="submit" class="btn btn-outline-primary">Nap ads wallet</button>
                    </div>
                </form>

                <form method="post" asp-action="SpendAdsWallet" asp-controller="Campaign" asp-area="Admin" class="row g-3 mb-4">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label asp-for="AdsSpendEditor.SellerId" class="form-label">Seller ID</label>
                        <input asp-for="AdsSpendEditor.SellerId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdsSpendEditor.AdsCampaignId" class="form-label">AdsCampaign ID</label>
                        <input asp-for="AdsSpendEditor.AdsCampaignId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdsSpendEditor.Amount" class="form-label">Spend</label>
                        <input asp-for="AdsSpendEditor.Amount" class="form-control" type="number" min="1000" step="1000" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AdsSpendEditor.SpendType" class="form-label">Spend type</label>
                        <input asp-for="AdsSpendEditor.SpendType" class="form-control" placeholder="click/manual_adjustment" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AdsSpendEditor.Notes" class="form-label">Notes</label>
                        <input asp-for="AdsSpendEditor.Notes" class="form-control" />
                    </div>
                    <div class="col-12 d-grid">
                        <button type="submit" class="btn btn-outline-secondary">Ghi nhan spend</button>
                    </div>
                </form>

                <form method="post" asp-action="CreateAdsCampaign" asp-controller="Campaign" asp-area="Admin" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label asp-for="AdsCampaignEditor.SellerId" class="form-label">Seller ID</label>
                        <input asp-for="AdsCampaignEditor.SellerId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdsCampaignEditor.CampaignId" class="form-label">Campaign ID</label>
                        <input asp-for="AdsCampaignEditor.CampaignId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdsCampaignEditor.Channel" class="form-label">Channel</label>
                        <input asp-for="AdsCampaignEditor.Channel" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="AdsCampaignEditor.Name" class="form-label">Ads campaign</label>
                        <input asp-for="AdsCampaignEditor.Name" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdsCampaignEditor.DailyBudget" class="form-label">Daily budget</label>
                        <input asp-for="AdsCampaignEditor.DailyBudget" class="form-control" type="number" min="0" step="1000" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdsCampaignEditor.TotalBudget" class="form-label">Total budget</label>
                        <input asp-for="AdsCampaignEditor.TotalBudget" class="form-control" type="number" min="0" step="1000" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AdsCampaignEditor.Status" class="form-label">Status</label>
                        <select asp-for="AdsCampaignEditor.Status" class="form-select">
                            <option value="draft">Draft</option>
                            <option value="scheduled">Scheduled</option>
                            <option value="running">Running</option>
                            <option value="paused">Paused</option>
                            <option value="completed">Completed</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AdsCampaignEditor.StartAt" class="form-label">Start</label>
