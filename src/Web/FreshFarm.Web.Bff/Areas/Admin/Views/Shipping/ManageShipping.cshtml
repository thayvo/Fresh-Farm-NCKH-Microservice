        <div class="card-glass ff-admin-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern">
                    <thead>
                        <tr>
                            <th class="px-4">#</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "code_asc" ? "code_desc" : "code_asc") })">
                                    <i class="bi bi-box-seam"></i> Mã đơn hàng
                                </a>
                            </th>
                            <th class="px-4"><i class="bi bi-person-badge me-1"></i> NV giao hàng</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "receiver_asc" ? "receiver_desc" : "receiver_asc") })">
                                    <i class="bi bi-person"></i> Người nhận
                                </a>
                            </th>
                            <th class="px-4"><i class="bi bi-telephone me-1"></i> SĐT</th>
                            <th class="px-4"><i class="bi bi-geo-alt me-1"></i> Địa chỉ</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "status_asc" ? "status_desc" : "status_asc") })">
                                    <i class="bi bi-info-circle"></i> Trạng thái
                                </a>
                            </th>
                            <th class="text-center px-4"><i class="bi bi-gear me-1"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (shippingRows.Any())
                            {
                                var startIndex = (currentPage - 1) * pageSize + 1;
                                var i = 0;
                                foreach (var item in shippingRows)
                                {
                                    <tr data-has-assign="@((item.Order != null && item.Order.DeliveryAssignments != null
                                                            && item.Order.DeliveryAssignments.Any(da => da.IsActive && da.AssignedToAdminID.HasValue))
                                                            .ToString().ToLower())"
                                        data-order-status="@((item.Order?.Status ?? "").ToLower())"
                                        data-ghn-order-label="@("#DH" + item.OrderID.ToString().PadLeft(5, '0'))"
                                        data-ghn-order-id="@item.OrderID"
                                        data-ghn-name="@item.FullName"
                                        data-ghn-phone="@item.Phone"
                                        data-ghn-address="@item.AddressDetail"
                                        data-ghn-province-name="@item.Province?.ProvinceName"
                                        data-ghn-commune-name="@item.Commune?.CommuneName"
                                        data-ghn-order-code="@item.GhnOrderCode"
                                        data-ghn-client-order-code="@item.GhnClientOrderCode"
                                        data-ghn-status="@item.GhnStatus"
                                        data-ghn-status-label="@item.GhnStatusLabel"
                                        data-ghn-total-fee="@((item.GhnTotalFee ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-last-synced-at="@(item.GhnLastSyncedAt?.ToString("O") ?? string.Empty)">
                                        <td class="px-4"><span class="badge bg-primary-blue text-white border">@(startIndex + i)</span></td>
                                        <td class="px-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-box-seam text-primary" style="font-size: 1.25rem;"></i>
                                                <span class="order-code">@("#DH" + item.OrderID.ToString().PadLeft(5, '0'))</span>
                                            </div>
                                        </td>
                                        <td class="px-4">
                                            @{
                                                var activeAssign = (item.Order != null && item.Order.DeliveryAssignments != null)
                                                    ? item.Order.DeliveryAssignments.Where(da => da.IsActive && da.AssignedToAdminID.HasValue)
                                                        .OrderByDescending(da => da.UpdatedAt ?? da.CreatedAt)
                                                        .FirstOrDefault()
                                                    : null;
                                                var staffName = activeAssign != null
                                                    ? (!string.IsNullOrWhiteSpace(activeAssign.UserAdmin?.FullName)
                                                        ? activeAssign.UserAdmin.FullName
                                                        : (activeAssign.AssignedToAdminID is int assignedAdminId ? $"NV #{assignedAdminId:D4}" : "Chưa phân công"))
                                                    : "Chưa phân công";
                                            }
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 rounded-3" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                                    <i class="bi bi-person text-primary"></i>
                                                </div>
                                                <span class="fw-medium">@staffName</span>
                                            </div>
                                        </td>
                                        <td class="px-4"><span class="fw-semibold text-primary-blue">@item.FullName</span></td>
                                        <td class="px-4"><div class="d-flex align-items-center gap-2"><i class="bi bi-telephone-fill text-success"></i><span class="font-monospace">@item.Phone</span></div></td>
                                        <td class="px-4">
                                            @if (item.IsStorePickup)
                                            {
                                                <div class="d-flex flex-column gap-1">
                                                    <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-shop me-1"></i> Nhận tại cửa hàng</span>
                                                    <small class="text-muted">@item.StoreAddress</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-start gap-2">
                                                    <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                                    <div class="text-truncate" style="max-width:340px">
                                                        <span class="fw-medium">@item.AddressDetail</span>
                                                        @if (item.Commune != null)
                                                        {<text>, @item.Commune.CommuneName</text>}
                                                        @if (item.Province != null)
                                                        {<text>, @item.Province.ProvinceName</text>}
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                        <td class="px-4">
                                            <div class="d-flex flex-column gap-2">
                                                @RenderStatus(item.Order)
                                                @if (!string.IsNullOrWhiteSpace(item.GhnOrderCode))
                                                {
                                                    <div class="small text-muted">
                                                        <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle mb-1">
                                                            GHN: @(item.GhnStatusLabel ?? item.GhnStatus ?? "Đã tạo vận đơn")
                                                        </span>
                                                        <div class="font-monospace">@(item.GhnOrderCode)</div>
                                                        @if (item.GhnTotalFee is decimal ghnTotalFee)
                                                        {
                                                            <div>Phí hãng: @ghnTotalFee.ToString("N0") đ</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center px-4">
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-sm btn-outline-primary btn-action btn-edit" data-id="@item.ShippingID" data-bs-toggle="modal" data-bs-target="#editShippingModal" title="Sửa"><i class="bi bi-pencil-square"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-action btn-delete" data-id="@item.ShippingID" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Xóa"><i class="bi bi-trash3"></i></button>
                                                @{ var cod = item.Order?.Payments?.FirstOrDefault(p => p.PaymentMethod == "COD"); bool codDone = cod == null ? true : (cod.PaymentDate.HasValue || (!string.IsNullOrWhiteSpace(cod.PaymentStatus) && paidStatuses.Any(s => string.Equals(s, cod.PaymentStatus, System.StringComparison.OrdinalIgnoreCase)))); }
                                                @if (item.Order?.Status == "Delivered" && !codDone)
                                                {<button type="button" class="btn btn-sm btn-outline-success btn-action btn-reconcile" data-orderid="@item.OrderID" title="Đánh dấu ĐÃ đối soát COD"><i class="bi bi-check2-circle"></i></button>}
                                                @if (item.Order?.Status == "Delivered" && codDone)
                                                {<button type="button" class="btn btn-sm btn-outline-secondary btn-action btn-unreconcile" data-orderid="@item.OrderID" title="Bỏ đối soát COD"><i class="bi bi-arrow-counterclockwise"></i></button>}
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center gap-3">
                                            <div class="p-4 rounded-circle" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                                <i class="bi bi-inbox" style="font-size: 3rem; color: #3b82f6;"></i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold mb-1 text-primary-blue">Chưa có dữ liệu</h5>
                                                <p class="text-muted mb-0">Chưa có thông tin vận chuyển nào được tìm thấy.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between px-4 py-4 border-top" style="background: linear-gradient(90deg, #f0f9ff 0%, #dbeafe 100%);">
                    <div class="text-muted mb-3 mb-md-0">
                        <i class="bi bi-journals me-2 text-primary"></i>
                        Trang <span class="fw-bold text-primary-blue">@currentPage</span> / <span class="fw-bold text-primary-blue">@totalPages</span>
                        <span class="mx-2">•</span>
                        Tổng <span class="fw-bold text-primary-blue">@totalItems</span> mục
                    </div>
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = currentPage - 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @{ int start = Math.Max(1, currentPage - 2); int end = Math.Min(totalPages, currentPage + 2); }
                        @for (int p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = p, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = currentPage + 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

