@section scripts {
    <script>
        function showNotification(message, type = 'info') {
            const old = document.querySelector('.dynamic-alert'); if (old) old.remove();
            const iconMap = { 'success': 'check-circle-fill', 'danger': 'exclamation-triangle-fill', 'info': 'info-circle-fill', 'warning': 'exclamation-circle-fill' };
            const div = document.createElement('div');
            div.className = `alert alert-${type} alert-dismissible fade show dynamic-alert`;
            div.style.cssText = 'position:fixed;top:80px;right:20px;z-index:9999;min-width:320px;max-width:500px;box-shadow:0 15px 50px rgba(0,0,0,.25);border-radius:1.25rem;animation:slideIn .4s ease-out';
            div.innerHTML = `<div class="d-flex align-items-center gap-3"><i class="bi bi-${iconMap[type]} fs-4"></i><span class="flex-grow-1">${message}</span><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
            document.body.appendChild(div);
            setTimeout(() => { div.style.animation = 'slideOut .3s ease-out'; setTimeout(() => div.remove(), 300); }, 5000);
        }
        function getToken() { const t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }

        function toggleAddFormValidation(isStorePickup) {
            const delivery = document.getElementById('deliveryInfo');
            const store = document.getElementById('storePickupInfo');
            const province = document.getElementById('ProvinceId');
            const commune = document.getElementById('CommuneId');
            const address = document.getElementById('AddressDetail');
            const storeAddr = document.getElementById('StoreAddress');
            if (!delivery || !store) return;
            if (isStorePickup) { delivery.style.display = 'none'; store.style.display = 'block'; province?.removeAttribute('required'); commune?.removeAttribute('required'); address?.removeAttribute('required'); storeAddr?.setAttribute('required', 'required'); }
            else { delivery.style.display = 'block'; store.style.display = 'none'; province?.setAttribute('required', 'required'); commune?.setAttribute('required', 'required'); address?.setAttribute('required', 'required'); storeAddr?.removeAttribute('required'); }
        }
        function toggleEditFormValidation(isStorePickup) {
            const delivery = document.getElementById('editDeliveryInfo');
            const store = document.getElementById('editStorePickupInfo');
            const province = document.getElementById('EditProvinceId');
            const commune = document.getElementById('EditCommuneId');
            const address = document.getElementById('EditAddressDetail');
            const storeAddr = document.getElementById('EditStoreAddress');
            if (!delivery || !store) return;
            if (isStorePickup) { delivery.style.display = 'none'; store.style.display = 'block'; province?.removeAttribute('required'); commune?.removeAttribute('required'); address?.removeAttribute('required'); storeAddr?.setAttribute('required', 'required'); }
            else { delivery.style.display = 'block'; store.style.display = 'none'; province?.setAttribute('required', 'required'); commune?.setAttribute('required', 'required'); address?.setAttribute('required','required'); storeAddr?.removeAttribute('required'); }
        }

        // Load danh sách xã/phường theo tỉnh được chọn
        function loadCommunes(provinceSelectId, communeSelectId, callback) {
            const provinceSelect = document.getElementById(provinceSelectId);
            const communeSelect = document.getElementById(communeSelectId);
            if (!provinceSelect || !communeSelect) return;

            const pid = provinceSelect.value;
            communeSelect.innerHTML = '<option value=\"\">-- Chọn Xã/Phường --</option>';

            if (!pid) {
                if (callback) callback();
                return;
            }

            fetch('@Url.Action("GetCommunes","Shipping", new { area = "Admin" })?provinceId=' + pid, { credentials: 'same-origin' })
                .then(r => r.json())
                .then(d => {
                    console.log('GetCommunes response for province', pid, d);
                    const list = Array.isArray(d)
                        ? d
                        : (Array.isArray(d?.data) ? d.data : (Array.isArray(d?.communes) ? d.communes : []));
                    list.forEach(x => {
                        const o = document.createElement('option');
                        o.value = x.value;
                        o.textContent = x.text;
                        communeSelect.appendChild(o);
                    });
                    if (callback) callback();
                })
                .catch(() => {
                    showNotification('Không tải được danh sách Xã/Phường','danger');
                    if (callback) callback();
                });
        }

        const addProvinceSelect = document.getElementById('ProvinceId');
        if (addProvinceSelect) {
            addProvinceSelect.addEventListener('change', function () {
                loadCommunes('ProvinceId', 'CommuneId');
            });

            // Nếu đã có sẵn tỉnh (ví dụ lấy từ địa chỉ nhận hàng)
            // thì tự động load danh sách Xã/Phường lúc mở trang.
            if (addProvinceSelect.value) {
                loadCommunes('ProvinceId', 'CommuneId');
            }
        }

        const editProvinceSelect = document.getElementById('EditProvinceId');
        if (editProvinceSelect) {
            editProvinceSelect.addEventListener('change', function () {
                loadCommunes('EditProvinceId', 'EditCommuneId');
            });
        }

        document.getElementById('status').addEventListener('change', function () {
          const wrap = document.getElementById('deliveredStateWrap');
          if (this.value === 'Delivered') {
            wrap.style.display = 'block';
          } else {
            wrap.style.display = 'none';
            const d = document.getElementById('deliveredState');
            if(d) d.value = '';
          }
        });

        document.getElementById('IsStorePickup')?.addEventListener('change', function(){ toggleAddFormValidation(this.checked); });
        document.getElementById('EditIsStorePickup')?.addEventListener('change', function(){ toggleEditFormValidation(this.checked); });

        document.getElementById('OrderID')?.addEventListener('change', function(){
          const id=this.value; if(!id) return;
          fetch('@Url.Action("GetOrderInfo","Shipping", new { area = "Admin" })?orderId='+id, { credentials:'same-origin' })
            .then(r=>r.json())
            .then(d=>{
              if(!d || !d.success) return;
              document.getElementById('FullName').value = d.fullName || '';
              document.getElementById('Phone').value    = d.phone    || '';
              document.getElementById('Email').value    = d.email    || '';
              document.getElementById('AddressDetail').value = d.address || '';
              if(d.provinceId){
                const pv = document.getElementById('ProvinceId');
                pv.value = d.provinceId;
                loadCommunes('ProvinceId', 'CommuneId', function() {
                    if(d.communeId) document.getElementById('CommuneId').value = d.communeId;
                });
              }
            });
        });

        document.getElementById('btnAddNew')?.addEventListener('click', function(){
          const f = document.getElementById('addShippingForm');
          if (f) f.reset();
          toggleAddFormValidation(false);
          const c = document.getElementById('CommuneId');
          if (c) c.innerHTML = '<option value="">-- Chọn Xã/Phường --</option>';
        });

        document.getElementById('btnSaveAdd')?.addEventListener('click', function(){
          const form=document.getElementById('addShippingForm');
          if(!form.checkValidity()){ form.reportValidity(); return; }
          const fd=new FormData(form);
          fd.set('ProvinceId', document.getElementById('ProvinceId')?.value || '');
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

          fetch('@Url.Action("Create","Shipping", new { area = "Admin" })', {
              method:'POST',
              credentials:'same-origin',
              body:fd
          })
          .then(r=>r.json())
          .then(d=>{
              showNotification(d.message, d.success?'success':'danger');
              if(d.success){
                bootstrap.Modal.getInstance(document.getElementById('addShippingModal')).hide();
                setTimeout(()=>location.reload(),800);
              }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        document.querySelectorAll('.btn-edit').forEach(b=>b.addEventListener('click', function(){
          const id=this.getAttribute('data-id');
          const modal = document.getElementById('editShippingModal');
          const body  = modal.querySelector('.modal-body');
          const bak   = body.innerHTML;
          try {
              const row = this.closest('tr');
              const hasActiveAssign = row?.getAttribute('data-has-assign') === 'true';
              const statusRaw = (row?.getAttribute('data-order-status') || '').toLowerCase();
              const isCanceled = statusRaw === 'canceled';
              if (hasActiveAssign && !isCanceled) {
                  showNotification('Đơn đã có người giao, không thể sửa (chỉ được sửa khi đơn bị hủy).', 'danger');
                  return;
              }
          } catch {}
          body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted">Đang tải dữ liệu...</p></div>';

          try { bootstrap.Modal.getOrCreateInstance(modal).show(); } catch {}
          fetch('@Url.Action("Edit","Shipping", new { area = "Admin" })?id='+id, { credentials:'same-origin' })
            .then(r=>r.json())
            .then(d=>{
              body.innerHTML = bak;
              if(!d || !d.success){ showNotification('Không tải được dữ liệu','danger'); return; }
              document.getElementById('EditShippingID').value = d.shippingID;
              const s = document.getElementById('EditDeliveryStaffId'); if(s) s.value = d.deliveryStaffId || '';
              document.getElementById('EditFullName').value   = d.fullName || '';
              document.getElementById('EditPhone').value      = d.phone    || '';
              document.getElementById('EditEmail').value      = d.email    || '';
              document.getElementById('EditIsStorePickup').checked = d.isStorePickup === true;
              toggleEditFormValidation(d.isStorePickup === true);

              if(d.isStorePickup){
                document.getElementById('EditStoreAddress').value = d.storeAddress || '';
              } else {
                if(d.provinceId){
                  const pv = document.getElementById('EditProvinceId');
                  pv.value = d.provinceId;
                  loadCommunes('EditProvinceId', 'EditCommuneId', function() {
                      if(d.communeId) document.getElementById('EditCommuneId').value = d.communeId;
                  });
                }
                document.getElementById('EditAddressDetail').value = d.addressDetail || '';
              }
            })
            .catch(()=>{ body.innerHTML = bak; showNotification('Có lỗi xảy ra khi tải dữ liệu!','danger'); });
        }));

        document.getElementById('btnSaveEdit')?.addEventListener('click', function(){
          const form=document.getElementById('editShippingForm');
          if(!form.checkValidity()){ form.reportValidity(); return; }
          const fd=new FormData(form);
          fd.set('ProvinceId', document.getElementById('EditProvinceId')?.value || '');
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

          fetch('@Url.Action("Edit","Shipping", new { area = "Admin" })', {
            method:'POST',
            credentials:'same-origin',
            body:fd
          })
          .then(r=>r.json())
          .then(d=>{
            showNotification(d.message, d.success?'success':'danger');
            if(d.success){
              bootstrap.Modal.getInstance(document.getElementById('editShippingModal')).hide();
              setTimeout(()=>location.reload(),800);
            }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        let currentDeleteId = 0;
        document.querySelectorAll('.btn-delete').forEach(b=>b.addEventListener('click', function(){
          currentDeleteId = this.getAttribute('data-id');
          document.getElementById('DeleteId').value = currentDeleteId;
        }));
        document.getElementById('btnConfirmDelete')?.addEventListener('click', function(){
          const form=document.getElementById('deleteForm');
          const fd=new FormData(form);
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang xóa...';

          fetch('@Url.Action("Delete","Shipping", new { area = "Admin" })', {
            method:'POST',
            credentials:'same-origin',
            body:fd
          })
          .then(r=>r.json())
          .then(d=>{
            showNotification(d.message, d.success?'success':'danger');
            if(d.success){
              bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
              setTimeout(()=>location.reload(),800);
            }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        document.addEventListener('click', function (e) {
          const recBtn = e.target.closest('.btn-reconcile');
          const unrecBtn = e.target.closest('.btn-unreconcile');
          if (!recBtn && !unrecBtn) return;

          const orderId = (recBtn || unrecBtn).getAttribute('data-orderid');
          const token = getToken();
          const btn = recBtn || unrecBtn;
          const old = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

          const url = recBtn
            ? '@Url.Action("ReconcileCod","Shipping", new { area = "Admin" })'
            : '@Url.Action("UnreconcileCod","Shipping", new { area = "Admin" })';

          fetch(url, {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'Accept': 'application/json',
                'RequestVerificationToken': token,
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
              },
              body: new URLSearchParams({ orderId, __RequestVerificationToken: token })
          })
          .then(r => r.json())
          .then(d => {
              showNotification(d.message, d.success ? 'success' : 'danger');
              if (d.success) setTimeout(() => location.reload(), 700);
          })
          .catch(() => showNotification('Có lỗi xảy ra!', 'danger'))
          .finally(() => { btn.disabled = false; btn.innerHTML = old; });
        });

        if (typeof bootstrap !== 'undefined') {
          [...document.querySelectorAll('[title]')].forEach(el=>{
            el.setAttribute('data-bs-toggle','tooltip'); el.setAttribute('data-bs-placement','top');
          });
          const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
          tooltipTriggerList.map(el => new bootstrap.Tooltip(el));
        }
    </script>

    <style>
        @@keyframes slideOut {
            from {
                opacity: 1;
                transform: translateX(0)
            }

            to {
                opacity: 0;
                transform: translateX(100px)
            }
        }

        .is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 4px rgba(220,53,69,.1) !important
        }

        .is-valid {
            border-color: #198754 !important;
            box-shadow: 0 0 0 4px rgba(25,135,84,.1) !important
        }

        .invalid-feedback {
            display: block;
            margin-top: .5rem;
            font-size: .875rem;
            color: #dc3545
        }
    </style>
}
