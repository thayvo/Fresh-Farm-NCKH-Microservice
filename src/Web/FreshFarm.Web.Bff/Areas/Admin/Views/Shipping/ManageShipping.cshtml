                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" id="btnUseCreatedOrderForTracking">Dùng mã vừa tạo để tra cứu</button>
                                </div>
                                <pre id="ghnCreateResult">Chưa tạo đơn GHN.</pre>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="border rounded-4 p-3 bg-white">
                                <h6 class="fw-bold text-primary-blue mb-3"><i class="bi bi-search-heart me-2"></i>Tra cứu vận đơn GHN</h6>
                                <div class="row g-2">
                                    <div class="col-12 col-md-7">
                                        <input type="text" class="form-control" id="ghnTrackingOrderCode" placeholder="Nhập orderCode GHN" />
                                    </div>
                                    <div class="col-12 col-md-5 d-grid">
                                        <button type="button" class="btn btn-outline-primary btn-pill" id="btnGhnTrackOrder">
                                            <i class="bi bi-search me-2"></i>Tra cứu
                                        </button>
                                    </div>
                                </div>
                                <div class="ghn-result-box p-3 mt-3">
                                    <pre id="ghnTrackingResult">Chưa tra cứu vận đơn.</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="filter-card ff-admin-card p-4 mb-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-3 rounded-3" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
                    <i class="bi bi-funnel text-white" style="font-size: 1.25rem;"></i>
                </div>
                <h5 class="mb-0 fw-bold text-primary-blue">Bộ lọc tìm kiếm</h5>
            </div>
            <form method="get" class="row g-4" id="filterForm">
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="sort" value="@ViewBag.CurrentSort" />

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-list-check me-2"></i> Trạng thái đơn hàng</label>
                    <select name="status" id="status" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(currentStatus)  ? "selected" : null)">Tất cả trạng thái</option>
                        <option value="Pending" selected="@(currentStatus == "Pending"  ? "selected" : null)">⏳ Chờ xử lý</option>
                        <option value="Processing" selected="@(currentStatus == "Processing"  ? "selected" : null)">⚙️ Đang xử lý</option>
                        <option value="Shipped" selected="@(currentStatus == "Shipped"  ? "selected" : null)">🚚 Đang giao hàng</option>
                        <option value="Delivered" selected="@(currentStatus == "Delivered"  ? "selected" : null)">✅ Đã giao hàng</option>
                        <option value="Canceled" selected="@(currentStatus == "Canceled"  ? "selected" : null)">❌ Đã hủy</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3" id="deliveredStateWrap" style="display:@(currentStatus == "Delivered" ? "block" : "none")">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-check2-square me-2"></i> Tình trạng đối soát</label>
                    <select name="deliveredState" id="deliveredState" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(deliveredState)  ? "selected" : null)">Tất cả</option>
                        <option value="pending" selected="@(deliveredState == "pending"  ? "selected" : null)">⏰ Chưa đối soát</option>
                        <option value="done" selected="@(deliveredState == "done"  ? "selected" : null)">✓ Đã đối soát</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person-badge me-2"></i> Nhân viên giao hàng</label>
                    @Html.DropDownList(
                        "staffId",
                        new SelectList(staffsSrc, "Value", "Text", selectedStaff),
                        "Tất cả nhân viên",
                        new { @class = "form-select" })
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-search me-2"></i> Tìm kiếm</label>
                    <div class="search-icon-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control" name="q" value="@ViewBag.CurrentQuery" placeholder="Mã đơn, người nhận, SĐT..." />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-grid-3x3 me-2"></i> Số dòng/trang</label>
                    <select name="pageSize" class="form-select">
                        <option value="10" selected="@(pageSize == 10  ? "selected" : null)">10 dòng</option>
                        <option value="20" selected="@(pageSize == 20  ? "selected" : null)">20 dòng</option>
                        <option value="50" selected="@(pageSize == 50  ? "selected" : null)">50 dòng</option>
                    </select>
                </div>

                <div class="col-12 col-lg-3 ms-auto d-grid d-lg-flex justify-content-lg-end align-items-end">
                    <button type="submit" class="btn btn-primary btn-pill px-5 d-flex align-items-center justify-content-center gap-2 hover-scale">
                        <i class="bi bi-funnel-fill"></i>
                        <span>Áp dụng</span>
                    </button>
                </div>
            </form>
        </div>

        <div class="card-glass ff-admin-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern">
                    <thead>
                        <tr>
                            <th class="px-4">#</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "code_asc" ? "code_desc" : "code_asc") })">
                                    <i class="bi bi-box-seam"></i> Mã đơn hàng
                                </a>
                            </th>
                            <th class="px-4"><i class="bi bi-person-badge me-1"></i> NV giao hàng</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "receiver_asc" ? "receiver_desc" : "receiver_asc") })">
                                    <i class="bi bi-person"></i> Người nhận
                                </a>
                            </th>
                            <th class="px-4"><i class="bi bi-telephone me-1"></i> SĐT</th>
                            <th class="px-4"><i class="bi bi-geo-alt me-1"></i> Địa chỉ</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "status_asc" ? "status_desc" : "status_asc") })">
                                    <i class="bi bi-info-circle"></i> Trạng thái
                                </a>
                            </th>
                            <th class="text-center px-4"><i class="bi bi-gear me-1"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (shippingRows.Any())
                            {
                                var startIndex = (currentPage - 1) * pageSize + 1;
                                var i = 0;
                                foreach (var item in shippingRows)
                                {
                                    <tr data-has-assign="@((item.Order != null && item.Order.DeliveryAssignments != null
                                                            && item.Order.DeliveryAssignments.Any(da => da.IsActive && da.AssignedToAdminID.HasValue))
                                                            .ToString().ToLower())"
                                        data-order-status="@((item.Order?.Status ?? "").ToLower())"
                                        data-ghn-order-label="@("#DH" + item.OrderID.ToString().PadLeft(5, '0'))"
                                        data-ghn-order-id="@item.OrderID"
                                        data-ghn-name="@item.FullName"
                                        data-ghn-phone="@item.Phone"
                                        data-ghn-address="@item.AddressDetail"
                                        data-ghn-province-name="@item.Province?.ProvinceName"
                                        data-ghn-commune-name="@item.Commune?.CommuneName">
                                        <td class="px-4"><span class="badge bg-primary-blue text-white border">@(startIndex + i)</span></td>
                                        <td class="px-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-box-seam text-primary" style="font-size: 1.25rem;"></i>
                                                <span class="order-code">@("#DH" + item.OrderID.ToString().PadLeft(5, '0'))</span>
                                            </div>
                                        </td>
                                        <td class="px-4">
                                            @{
                                                var activeAssign = (item.Order != null && item.Order.DeliveryAssignments != null)
                                                    ? item.Order.DeliveryAssignments.Where(da => da.IsActive && da.AssignedToAdminID.HasValue)
                                                        .OrderByDescending(da => da.UpdatedAt ?? da.CreatedAt)
                                                        .FirstOrDefault()
                                                    : null;
                                                var staffName = activeAssign != null
                                                    ? (!string.IsNullOrWhiteSpace(activeAssign.UserAdmin?.FullName)
                                                        ? activeAssign.UserAdmin.FullName
                                                        : ("NV #" + activeAssign.AssignedToAdminID.Value.ToString("D4")))
                                                    : "Chưa phân công";
                                            }
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 rounded-3" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                                    <i class="bi bi-person text-primary"></i>
                                                </div>
                                                <span class="fw-medium">@staffName</span>
                                            </div>
                                        </td>
                                        <td class="px-4"><span class="fw-semibold text-primary-blue">@item.FullName</span></td>
                                        <td class="px-4"><div class="d-flex align-items-center gap-2"><i class="bi bi-telephone-fill text-success"></i><span class="font-monospace">@item.Phone</span></div></td>
                                        <td class="px-4">
                                            @if (item.IsStorePickup)
                                            {
                                                <div class="d-flex flex-column gap-1">
                                                    <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-shop me-1"></i> Nhận tại cửa hàng</span>
                                                    <small class="text-muted">@item.StoreAddress</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-start gap-2">
                                                    <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                                    <div class="text-truncate" style="max-width:340px">
                                                        <span class="fw-medium">@item.AddressDetail</span>
                                                        @if (item.Commune != null)
                                                        {<text>, @item.Commune.CommuneName</text>}
                                                        @if (item.Province != null)
                                                        {<text>, @item.Province.ProvinceName</text>}
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                        <td class="px-4">@RenderStatus(item.Order)</td>
                                        <td class="text-center px-4">
                                            <div class="btn-group" role="group">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-info btn-action btn-use-ghn"
                                                        data-orderid="@item.OrderID"
                                                        title="Đổ thông tin dòng này sang bảng điều khiển GHN">
                                                    <i class="bi bi-truck-front"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-primary btn-action btn-edit" data-id="@item.ShippingID" data-bs-toggle="modal" data-bs-target="#editShippingModal" title="Sửa"><i class="bi bi-pencil-square"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-action btn-delete" data-id="@item.ShippingID" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Xóa"><i class="bi bi-trash3"></i></button>
                                                @{ var cod = item.Order?.Payments?.FirstOrDefault(p => p.PaymentMethod == "COD"); bool codDone = cod == null ? true : (cod.PaymentDate.HasValue || (!string.IsNullOrWhiteSpace(cod.PaymentStatus) && paidStatuses.Any(s => string.Equals(s, cod.PaymentStatus, System.StringComparison.OrdinalIgnoreCase)))); }
                                                @if (item.Order?.Status == "Delivered" && !codDone)
                                                {<button type="button" class="btn btn-sm btn-outline-success btn-action btn-reconcile" data-orderid="@item.OrderID" title="Đánh dấu ĐÃ đối soát COD"><i class="bi bi-check2-circle"></i></button>}
                                                @if (item.Order?.Status == "Delivered" && codDone)
                                                {<button type="button" class="btn btn-sm btn-outline-secondary btn-action btn-unreconcile" data-orderid="@item.OrderID" title="Bỏ đối soát COD"><i class="bi bi-arrow-counterclockwise"></i></button>}
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center gap-3">
                                            <div class="p-4 rounded-circle" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                                <i class="bi bi-inbox" style="font-size: 3rem; color: #3b82f6;"></i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold mb-1 text-primary-blue">Chưa có dữ liệu</h5>
                                                <p class="text-muted mb-0">Chưa có thông tin vận chuyển nào được tìm thấy.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between px-4 py-4 border-top" style="background: linear-gradient(90deg, #f0f9ff 0%, #dbeafe 100%);">
                    <div class="text-muted mb-3 mb-md-0">
                        <i class="bi bi-journals me-2 text-primary"></i>
                        Trang <span class="fw-bold text-primary-blue">@currentPage</span> / <span class="fw-bold text-primary-blue">@totalPages</span>
                        <span class="mx-2">•</span>
                        Tổng <span class="fw-bold text-primary-blue">@totalItems</span> mục
                    </div>
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = currentPage - 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @{ int start = Math.Max(1, currentPage - 2); int end = Math.Min(totalPages, currentPage + 2); }
                        @for (int p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = p, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = currentPage + 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section modal {
    <div class="modal fade" id="addShippingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2"><i class="bi bi-plus-circle"></i>Thêm thông tin vận chuyển</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="addShippingForm" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <div class="alert alert-info border-0 d-flex align-items-start gap-3" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                <i class="bi bi-info-circle-fill text-primary" style="font-size: 1.5rem;"></i>
                                <div><strong>Lưu ý:</strong> Vui lòng điền đầy đủ thông tin bắt buộc có dấu <span class="text-danger">*</span></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-cart-check me-2"></i> Đơn hàng <span class="text-danger">*</span></label>
                            @Html.DropDownList("OrderID", (SelectList)ViewBag.Orders, "-- Chọn đơn hàng --", new { @class = "form-select", id = "OrderID", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person-badge me-2"></i> Nhân viên giao hàng</label>
                            @Html.DropDownList("DeliveryStaffId", (SelectList)ViewBag.DeliveryStaffs, "-- Chọn nhân viên --", new { @class = "form-select", id = "DeliveryStaffId" })
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border" style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="IsStorePickup" name="IsStorePickup" value="true" style="width: 3rem; height: 1.5rem;">
                                    <label class="form-check-label fw-semibold ms-2" for="IsStorePickup"><i class="bi bi-shop me-1"></i> Nhận tại cửa hàng</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person me-2"></i> Người nhận <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" id="FullName" class="form-control" placeholder="Nhập họ tên người nhận" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-telephone me-2"></i> Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="Phone" id="Phone" class="form-control" placeholder="Nhập số điện thoại" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-envelope me-2"></i> Email</label>
                            <input type="email" name="Email" id="Email" class="form-control" placeholder="Nhập địa chỉ email (tùy chọn)" />
                        </div>
                        <div id="deliveryInfo" class="row g-3">
                            <div class="col-12"><div class="border-top pt-3"><h6 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary-blue"><i class="bi bi-geo-alt-fill text-danger"></i>Thông tin giao hàng</h6></div></div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-primary-blue">Tỉnh/Thành phố <span class="text-danger">*</span></label>
                                @Html.DropDownList("ProvinceId", provinces, "-- Chọn tỉnh/thành --", new { @class = "form-select", id = "ProvinceId" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-primary-blue">Xã/Phường <span class="text-danger">*</span></label>
                                <select id="CommuneId" name="CommuneId" class="form-select"><option value="">-- Chọn Xã/Phường --</option></select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-primary-blue">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                                <input type="text" id="AddressDetail" name="AddressDetail" class="form-control" placeholder="Số nhà, tên đường..." />
                            </div>
                        </div>
                        <div id="storePickupInfo" style="display:none" class="col-12">
                            <div class="border-top pt-3"><h6 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary-blue"><i class="bi bi-shop text-info"></i>Thông tin cửa hàng</h6></div>
                            <label class="form-label fw-semibold text-primary-blue">Địa chỉ cửa hàng <span class="text-danger">*</span></label>
                            <input type="text" id="StoreAddress" name="StoreAddress" class="form-control" placeholder="Nhập địa chỉ cửa hàng" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer p-4 border-top">
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal"><i class="bi bi-x-circle me-2"></i>Đóng</button>
                    <button type="button" class="btn btn-primary btn-pill px-4 hover-scale" id="btnSaveAdd"><i class="bi bi-check-circle me-2"></i>Lưu lại</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editShippingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2"><i class="bi bi-pencil-square"></i>Cập nhật thông tin vận chuyển</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="editShippingForm" class="row g-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ShippingID" id="EditShippingID" />
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person-badge me-2"></i> Nhân viên giao hàng</label>
                            @Html.DropDownList("DeliveryStaffId", (SelectList)ViewBag.DeliveryStaffs, "-- Chọn nhân viên --", new { @class = "form-select", id = "EditDeliveryStaffId" })
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border" style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="EditIsStorePickup" name="IsStorePickup" value="true" style="width: 3rem; height: 1.5rem;">
                                    <label class="form-check-label fw-semibold ms-2" for="EditIsStorePickup"><i class="bi bi-shop me-1"></i> Nhận tại cửa hàng</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person me-2"></i> Người nhận <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" id="EditFullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-telephone me-2"></i> Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="Phone" id="EditPhone" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-envelope me-2"></i> Email</label>
                            <input type="email" name="Email" id="EditEmail" class="form-control" />
                        </div>
                        <div id="editDeliveryInfo" class="row g-3">
                            <div class="col-12"><div class="border-top pt-3"><h6 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary-blue"><i class="bi bi-geo-alt-fill text-danger"></i>Thông tin giao hàng</h6></div></div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-primary-blue">Tỉnh/Thành phố <span class="text-danger">*</span></label>
                                @Html.DropDownList("EditProvinceId", provinces, "-- Chọn tỉnh/thành --", new { @class = "form-select", id = "EditProvinceId" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-primary-blue">Xã/Phường <span class="text-danger">*</span></label>
                                <select id="EditCommuneId" name="CommuneId" class="form-select"><option value="">-- Chọn Xã/Phường --</option></select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-primary-blue">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                                <input type="text" id="EditAddressDetail" name="AddressDetail" class="form-control" />
                            </div>
                        </div>
                        <div id="editStorePickupInfo" style="display:none" class="col-12">
                            <div class="border-top pt-3"><h6 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary-blue"><i class="bi bi-shop text-info"></i>Thông tin cửa hàng</h6></div>
                            <label class="form-label fw-semibold text-primary-blue">Địa chỉ cửa hàng <span class="text-danger">*</span></label>
                            <input type="text" id="EditStoreAddress" name="StoreAddress" class="form-control" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer p-4 border-top">
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal"><i class="bi bi-x-circle me-2"></i>Đóng</button>
                    <button type="button" class="btn btn-primary btn-pill px-4 hover-scale" id="btnSaveEdit"><i class="bi bi-check-circle me-2"></i>Lưu thay đổi</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger"><h5 class="modal-title fw-bold d-flex align-items-center gap-2 text-white"><i class="bi bi-exclamation-triangle"></i>Xác nhận xóa</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-4"><div class="p-4 rounded-circle d-inline-flex" style="background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);"><i class="bi bi-trash3" style="font-size: 3rem; color: #dc2626;"></i></div></div>
                    <h5 class="fw-bold mb-2">Bạn có chắc chắn muốn xóa?</h5>
                    <p class="text-muted mb-0">Hành động này không thể hoàn tác. Thông tin vận chuyển sẽ bị xóa vĩnh viễn.</p>
                </div>
                <div class="modal-footer p-4 border-top justify-content-center">
                    <form id="deleteForm">@Html.AntiForgeryToken()<input type="hidden" id="DeleteId" name="id" /></form>
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal"><i class="bi bi-x-circle me-2"></i>Hủy</button>
                    <button type="button" class="btn btn-danger btn-pill px-4" id="btnConfirmDelete"><i class="bi bi-trash3 me-2"></i>Xóa ngay</button>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        function showNotification(message, type = 'info') {
            const old = document.querySelector('.dynamic-alert'); if (old) old.remove();
            const iconMap = { 'success': 'check-circle-fill', 'danger': 'exclamation-triangle-fill', 'info': 'info-circle-fill', 'warning': 'exclamation-circle-fill' };
            const div = document.createElement('div');
            div.className = `alert alert-${type} alert-dismissible fade show dynamic-alert`;
            div.style.cssText = 'position:fixed;top:80px;right:20px;z-index:9999;min-width:320px;max-width:500px;box-shadow:0 15px 50px rgba(0,0,0,.25);border-radius:1.25rem;animation:slideIn .4s ease-out';
            div.innerHTML = `<div class="d-flex align-items-center gap-3"><i class="bi bi-${iconMap[type]} fs-4"></i><span class="flex-grow-1">${message}</span><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
            document.body.appendChild(div);
            setTimeout(() => { div.style.animation = 'slideOut .3s ease-out'; setTimeout(() => div.remove(), 300); }, 5000);
        }
        function getToken() { const t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
        function setResult(id, data) {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
        }
        function buildUrl(base, params) {
            const url = new URL(base, window.location.origin);
            Object.entries(params || {}).forEach(([key, value]) => {
                if (value !== null && value !== undefined && value !== '') {
                    url.searchParams.set(key, value);
                }
            });
            return url.toString();
        }
        function getNumericValue(id, fallback = 0) {
            const raw = document.getElementById(id)?.value;
            const parsed = Number(raw);
            return Number.isFinite(parsed) ? parsed : fallback;
        }
        function getTextValue(id) {
            return document.getElementById(id)?.value?.trim() || '';
        }
        function getSelectedText(id) {
            const select = document.getElementById(id);
            if (!select || select.selectedIndex < 0) return '';
            return select.options[select.selectedIndex]?.text?.trim() || '';
        }
        function setButtonBusy(button, busy, busyHtml) {
            if (!button) return;
            if (busy) {
                button.dataset.originalHtml = button.innerHTML;
                button.disabled = true;
                button.innerHTML = busyHtml;
                return;
            }
            button.disabled = false;
            if (button.dataset.originalHtml) {
                button.innerHTML = button.dataset.originalHtml;
            }
        }
        function ensureGhnRecipient() {
            const toName = getTextValue('ghnToName');
            const toPhone = getTextValue('ghnToPhone');
            const toAddress = getTextValue('ghnToAddress');
            const districtId = getTextValue('ghnDistrictId');
            const wardCode = getTextValue('ghnWardCode');
            if (!toName || !toPhone || !toAddress || !districtId || !wardCode) {
                showNotification('Cần điền đủ người nhận, số điện thoại, địa chỉ và quận/phường GHN.', 'warning');
                return null;
            }
            return { toName, toPhone, toAddress, districtId, wardCode };
        }
        async function fetchJson(url, options) {
            const response = await fetch(url, { credentials: 'same-origin', ...(options || {}) });
            const payload = await response.json();
            return payload;
        }
        async function loadGhnProvinces() {
            const select = document.getElementById('ghnProvinceId');
            if (!select || select.dataset.loaded === 'true') return;
            const payload = await fetchJson('@Url.Action("GetGhnProvinces", "Shipping", new { area = "Admin" })');
            const items = Array.isArray(payload?.items) ? payload.items : [];
            select.innerHTML = '<option value="">Chọn tỉnh/thành GHN</option>';
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name;
                select.appendChild(option);
            });
            select.dataset.loaded = 'true';
        }
        async function loadGhnDistricts(provinceId) {
            const districtSelect = document.getElementById('ghnDistrictId');
            const wardSelect = document.getElementById('ghnWardCode');
            if (!districtSelect || !wardSelect) return;
            districtSelect.innerHTML = '<option value="">Chọn quận/huyện GHN</option>';
            wardSelect.innerHTML = '<option value="">Chọn phường/xã GHN</option>';
            if (!provinceId) return;
            const payload = await fetchJson(buildUrl('@Url.Action("GetGhnDistricts", "Shipping", new { area = "Admin" })', { provinceId }));
            const items = Array.isArray(payload?.items) ? payload.items : [];
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name;
                districtSelect.appendChild(option);
            });
        }
        async function loadGhnWards(districtId) {
            const wardSelect = document.getElementById('ghnWardCode');
            if (!wardSelect) return;
            wardSelect.innerHTML = '<option value="">Chọn phường/xã GHN</option>';
            if (!districtId) return;
            const payload = await fetchJson(buildUrl('@Url.Action("GetGhnWards", "Shipping", new { area = "Admin" })', { districtId }));
            const items = Array.isArray(payload?.items) ? payload.items : [];
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.code || item.id;
                option.textContent = item.name;
                wardSelect.appendChild(option);
            });
        }
        function buildPreviewParams() {
            const recipient = ensureGhnRecipient();
            if (!recipient) return null;
            return {
                ToDistrictId: recipient.districtId,
                ToWardCode: recipient.wardCode,
                Weight: getNumericValue('ghnWeight', 500),
                Length: getNumericValue('ghnLength', 20),
                Width: getNumericValue('ghnWidth', 20),
                Height: getNumericValue('ghnHeight', 10),
                InsuranceValue: getNumericValue('ghnInsuranceValue', 0),
                ItemName: getTextValue('ghnItemName') || 'Nông sản FreshFarm',
                ItemQuantity: getNumericValue('ghnItemQuantity', 1)
            };
        }
        function fillGhnFormFromRow(button) {
            const row = button.closest('tr');
            if (!row) return;
            const orderLabel = row.dataset.ghnOrderLabel || 'Đơn nội bộ';
            const provinceName = row.dataset.ghnProvinceName || '';
            const communeName = row.dataset.ghnCommuneName || '';
            const addressParts = [row.dataset.ghnAddress || '', communeName, provinceName].filter(Boolean);
            document.getElementById('ghnSourceLabel').value = `${orderLabel} - ${provinceName}${provinceName && communeName ? ' / ' : ''}${communeName}`.trim();
            document.getElementById('ghnToName').value = row.dataset.ghnName || '';
            document.getElementById('ghnToPhone').value = row.dataset.ghnPhone || '';
            document.getElementById('ghnToAddress').value = addressParts.join(', ');
            document.getElementById('ghnClientOrderCode').value = `FF-ORD-${row.dataset.ghnOrderId}-${Date.now()}`;
            document.getElementById('ghnContent').value = `Đơn giao vận cho ${orderLabel}`;
            document.getElementById('ghnItemCode').value = `ORDER-${row.dataset.ghnOrderId}`;
            document.getElementById('ghnTrackingOrderCode').value = '';
            showNotification(`Đã đổ thông tin ${orderLabel} vào bảng điều khiển GHN.`, 'info');
            document.getElementById('ghnCreateOrderPanel')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        async function loadShopProfile() {
            const button = document.getElementById('btnGhnLoadShopProfile');
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tải...');
                const payload = await fetchJson('@Url.Action("GetGhnShopProfile", "Shipping", new { area = "Admin" })');
                setResult('ghnShopProfileResult', payload);
                showNotification(payload?.message || 'Đã tải thông tin shop GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                setResult('ghnShopProfileResult', 'Không tải được thông tin shop GHN.');
                showNotification('Không tải được thông tin shop GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function previewGhnFee() {
            const button = document.getElementById('btnGhnPreviewFee');
            const params = buildPreviewParams();
            if (!params) return;
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tính...');
                const payload = await fetchJson(buildUrl('@Url.Action("PreviewGhnFee", "Shipping", new { area = "Admin" })', params));
                setResult('ghnPreviewResult', payload);
                showNotification(payload?.message || 'Đã tính phí GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không tính được phí GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function previewGhnLeadTime() {
            const button = document.getElementById('btnGhnPreviewLeadTime');
            const recipient = ensureGhnRecipient();
            if (!recipient) return;
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang lấy...');
                const payload = await fetchJson(buildUrl('@Url.Action("PreviewGhnLeadTime", "Shipping", new { area = "Admin" })', {
                    ToDistrictId: recipient.districtId,
                    ToWardCode: recipient.wardCode
                }));
                setResult('ghnPreviewResult', payload);
                showNotification(payload?.message || 'Đã lấy leadtime GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không lấy được leadtime GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function createGhnOrder() {
            const button = document.getElementById('btnGhnCreateOrder');
            const recipient = ensureGhnRecipient();
            if (!recipient) return;
            const params = {
                ToName: recipient.toName,
                ToPhone: recipient.toPhone,
                ToAddress: recipient.toAddress,
                ToDistrictId: recipient.districtId,
                ToWardCode: recipient.wardCode,
                Content: getTextValue('ghnContent') || 'Đơn hàng thử nghiệm FreshFarm',
                ClientOrderCode: getTextValue('ghnClientOrderCode'),
                CodAmount: getNumericValue('ghnCodAmount', 0),
                InsuranceValue: getNumericValue('ghnInsuranceValue', 0),
                Height: getNumericValue('ghnHeight', 10),
                Length: getNumericValue('ghnLength', 20),
                Width: getNumericValue('ghnWidth', 20),
                Weight: getNumericValue('ghnWeight', 500),
                ItemName: getTextValue('ghnItemName') || 'Nông sản FreshFarm',
                ItemCode: getTextValue('ghnItemCode'),
                ItemQuantity: getNumericValue('ghnItemQuantity', 1),
                ItemPrice: getNumericValue('ghnItemPrice', 0)
            };
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo...');
                const payload = await fetchJson(buildUrl('@Url.Action("CreateGhnSandboxOrderQuick", "Shipping", new { area = "Admin" })', params));
                setResult('ghnCreateResult', payload);
                if (payload?.orderCode) {
                    document.getElementById('ghnTrackingOrderCode').value = payload.orderCode;
                }
                showNotification(payload?.message || 'Đã gọi tạo đơn GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không tạo được đơn GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function trackGhnOrder() {
            const button = document.getElementById('btnGhnTrackOrder');
            const orderCode = getTextValue('ghnTrackingOrderCode');
            if (!orderCode) {
                showNotification('Cần nhập mã vận đơn GHN để tra cứu.', 'warning');
                return;
            }
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tra...');
                const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Admin" })', {
                    orderCode
                }));
                setResult('ghnTrackingResult', payload);
                showNotification(payload?.message || 'Đã tra cứu đơn GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không tra cứu được đơn GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }

        function toggleAddFormValidation(isStorePickup) {
            const delivery = document.getElementById('deliveryInfo');
            const store = document.getElementById('storePickupInfo');
            const province = document.getElementById('ProvinceId');
            const commune = document.getElementById('CommuneId');
            const address = document.getElementById('AddressDetail');
            const storeAddr = document.getElementById('StoreAddress');
            if (!delivery || !store) return;
            if (isStorePickup) { delivery.style.display = 'none'; store.style.display = 'block'; province?.removeAttribute('required'); commune?.removeAttribute('required'); address?.removeAttribute('required'); storeAddr?.setAttribute('required', 'required'); }
            else { delivery.style.display = 'block'; store.style.display = 'none'; province?.setAttribute('required', 'required'); commune?.setAttribute('required', 'required'); address?.setAttribute('required', 'required'); storeAddr?.removeAttribute('required'); }
        }
        function toggleEditFormValidation(isStorePickup) {
            const delivery = document.getElementById('editDeliveryInfo');
            const store = document.getElementById('editStorePickupInfo');
            const province = document.getElementById('EditProvinceId');
            const commune = document.getElementById('EditCommuneId');
            const address = document.getElementById('EditAddressDetail');
            const storeAddr = document.getElementById('EditStoreAddress');
            if (!delivery || !store) return;
            if (isStorePickup) { delivery.style.display = 'none'; store.style.display = 'block'; province?.removeAttribute('required'); commune?.removeAttribute('required'); address?.removeAttribute('required'); storeAddr?.setAttribute('required', 'required'); }
            else { delivery.style.display = 'block'; store.style.display = 'none'; province?.setAttribute('required', 'required'); commune?.setAttribute('required', 'required'); address?.setAttribute('required','required'); storeAddr?.removeAttribute('required'); }
        }

        // Load danh sách xã/phường theo tỉnh được chọn
        function loadCommunes(provinceSelectId, communeSelectId, callback) {
            const provinceSelect = document.getElementById(provinceSelectId);
            const communeSelect = document.getElementById(communeSelectId);
            if (!provinceSelect || !communeSelect) return;

            const pid = provinceSelect.value;
            communeSelect.innerHTML = '<option value=\"\">-- Chọn Xã/Phường --</option>';

            if (!pid) {
                if (callback) callback();
                return;
            }

            fetch('@Url.Action("GetCommunes","Shipping", new { area = "Admin" })?provinceId=' + pid, { credentials: 'same-origin' })
                .then(r => r.json())
                .then(d => {
                    console.log('GetCommunes response for province', pid, d);
                    const list = Array.isArray(d)
                        ? d
                        : (Array.isArray(d?.data) ? d.data : (Array.isArray(d?.communes) ? d.communes : []));
                    list.forEach(x => {
                        const o = document.createElement('option');
                        o.value = x.value;
                        o.textContent = x.text;
                        communeSelect.appendChild(o);
                    });
                    if (callback) callback();
                })
                .catch(() => {
                    showNotification('Không tải được danh sách Xã/Phường','danger');
                    if (callback) callback();
                });
        }

        const addProvinceSelect = document.getElementById('ProvinceId');
        if (addProvinceSelect) {
            addProvinceSelect.addEventListener('change', function () {
                loadCommunes('ProvinceId', 'CommuneId');
            });

            // Nếu đã có sẵn tỉnh (ví dụ lấy từ địa chỉ nhận hàng)
            // thì tự động load danh sách Xã/Phường lúc mở trang.
            if (addProvinceSelect.value) {
                loadCommunes('ProvinceId', 'CommuneId');
            }
        }

        const editProvinceSelect = document.getElementById('EditProvinceId');
        if (editProvinceSelect) {
            editProvinceSelect.addEventListener('change', function () {
                loadCommunes('EditProvinceId', 'EditCommuneId');
            });
        }

        loadGhnProvinces().catch(() => {
            setResult('ghnShopProfileResult', 'Không tải được danh sách tỉnh/thành GHN.');
        });

        document.getElementById('ghnProvinceId')?.addEventListener('change', function () {
            loadGhnDistricts(this.value).catch(() => {
                showNotification('Không tải được quận/huyện GHN.', 'danger');
            });
        });

        document.getElementById('ghnDistrictId')?.addEventListener('change', function () {
            loadGhnWards(this.value).catch(() => {
                showNotification('Không tải được phường/xã GHN.', 'danger');
            });
        });

        document.getElementById('btnGhnLoadShopProfile')?.addEventListener('click', function () {
            loadShopProfile();
        });

        document.getElementById('btnGhnPreviewFee')?.addEventListener('click', function () {
            previewGhnFee();
        });

        document.getElementById('btnGhnPreviewLeadTime')?.addEventListener('click', function () {
            previewGhnLeadTime();
        });

        document.getElementById('btnGhnCreateOrder')?.addEventListener('click', function () {
            createGhnOrder();
        });

        document.getElementById('btnGhnTrackOrder')?.addEventListener('click', function () {
            trackGhnOrder();
        });

        document.getElementById('btnUseCreatedOrderForTracking')?.addEventListener('click', function () {
            const text = document.getElementById('ghnCreateResult')?.textContent || '';
            try {
                const payload = JSON.parse(text);
                if (payload?.orderCode) {
                    document.getElementById('ghnTrackingOrderCode').value = payload.orderCode;
                    trackGhnOrder();
                    return;
                }
            } catch {
                // ignore parse failure
            }
            showNotification('Chưa có mã GHN vừa tạo để tra cứu.', 'warning');
        });

        document.querySelectorAll('.btn-use-ghn').forEach(button => button.addEventListener('click', function () {
            fillGhnFormFromRow(this);
        }));

        document.getElementById('status').addEventListener('change', function () {
          const wrap = document.getElementById('deliveredStateWrap');
          if (this.value === 'Delivered') {
            wrap.style.display = 'block';
          } else {
            wrap.style.display = 'none';
            const d = document.getElementById('deliveredState');
            if(d) d.value = '';
          }
        });

        document.getElementById('IsStorePickup')?.addEventListener('change', function(){ toggleAddFormValidation(this.checked); });
        document.getElementById('EditIsStorePickup')?.addEventListener('change', function(){ toggleEditFormValidation(this.checked); });

        document.getElementById('OrderID')?.addEventListener('change', function(){
          const id=this.value; if(!id) return;
          fetch('@Url.Action("GetOrderInfo","Shipping", new { area = "Admin" })?orderId='+id, { credentials:'same-origin' })
            .then(r=>r.json())
            .then(d=>{
              if(!d || !d.success) return;
              document.getElementById('FullName').value = d.fullName || '';
              document.getElementById('Phone').value    = d.phone    || '';
              document.getElementById('Email').value    = d.email    || '';
              document.getElementById('AddressDetail').value = d.address || '';
              if(d.provinceId){
                const pv = document.getElementById('ProvinceId');
                pv.value = d.provinceId;
                loadCommunes('ProvinceId', 'CommuneId', function() {
                    if(d.communeId) document.getElementById('CommuneId').value = d.communeId;
                });
              }
            });
        });

        document.getElementById('btnAddNew')?.addEventListener('click', function(){
          const f = document.getElementById('addShippingForm');
          if (f) f.reset();
          toggleAddFormValidation(false);
          const c = document.getElementById('CommuneId');
          if (c) c.innerHTML = '<option value="">-- Chọn Xã/Phường --</option>';
        });

        document.getElementById('btnSaveAdd')?.addEventListener('click', function(){
          const form=document.getElementById('addShippingForm');
          if(!form.checkValidity()){ form.reportValidity(); return; }
          const fd=new FormData(form);
          fd.set('ProvinceId', document.getElementById('ProvinceId')?.value || '');
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

          fetch('@Url.Action("Create","Shipping", new { area = "Admin" })', {
              method:'POST',
              credentials:'same-origin',
              body:fd
          })
          .then(r=>r.json())
          .then(d=>{
              showNotification(d.message, d.success?'success':'danger');
              if(d.success){
                bootstrap.Modal.getInstance(document.getElementById('addShippingModal')).hide();
                setTimeout(()=>location.reload(),800);
              }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        document.querySelectorAll('.btn-edit').forEach(b=>b.addEventListener('click', function(){
          const id=this.getAttribute('data-id');
          const modal = document.getElementById('editShippingModal');
          const body  = modal.querySelector('.modal-body');
          const bak   = body.innerHTML;
          try {
              const row = this.closest('tr');
              const hasActiveAssign = row?.getAttribute('data-has-assign') === 'true';
              const statusRaw = (row?.getAttribute('data-order-status') || '').toLowerCase();
              const isCanceled = statusRaw === 'canceled';
              if (hasActiveAssign && !isCanceled) {
                  showNotification('Đơn đã có người giao, không thể sửa (chỉ được sửa khi đơn bị hủy).', 'danger');
                  return;
              }
          } catch {}
          body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted">Đang tải dữ liệu...</p></div>';

          try { bootstrap.Modal.getOrCreateInstance(modal).show(); } catch {}
          fetch('@Url.Action("Edit","Shipping", new { area = "Admin" })?id='+id, { credentials:'same-origin' })
            .then(r=>r.json())
            .then(d=>{
              body.innerHTML = bak;
              if(!d || !d.success){ showNotification('Không tải được dữ liệu','danger'); return; }
              document.getElementById('EditShippingID').value = d.shippingID;
              const s = document.getElementById('EditDeliveryStaffId'); if(s) s.value = d.deliveryStaffId || '';
              document.getElementById('EditFullName').value   = d.fullName || '';
              document.getElementById('EditPhone').value      = d.phone    || '';
              document.getElementById('EditEmail').value      = d.email    || '';
              document.getElementById('EditIsStorePickup').checked = d.isStorePickup === true;
              toggleEditFormValidation(d.isStorePickup === true);

              if(d.isStorePickup){
                document.getElementById('EditStoreAddress').value = d.storeAddress || '';
              } else {
                if(d.provinceId){
                  const pv = document.getElementById('EditProvinceId');
                  pv.value = d.provinceId;
                  loadCommunes('EditProvinceId', 'EditCommuneId', function() {
                      if(d.communeId) document.getElementById('EditCommuneId').value = d.communeId;
                  });
                }
                document.getElementById('EditAddressDetail').value = d.addressDetail || '';
              }
            })
            .catch(()=>{ body.innerHTML = bak; showNotification('Có lỗi xảy ra khi tải dữ liệu!','danger'); });
        }));

        document.getElementById('btnSaveEdit')?.addEventListener('click', function(){
          const form=document.getElementById('editShippingForm');
          if(!form.checkValidity()){ form.reportValidity(); return; }
          const fd=new FormData(form);
          fd.set('ProvinceId', document.getElementById('EditProvinceId')?.value || '');
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

          fetch('@Url.Action("Edit","Shipping", new { area = "Admin" })', {
            method:'POST',
            credentials:'same-origin',
            body:fd
          })
          .then(r=>r.json())
          .then(d=>{
            showNotification(d.message, d.success?'success':'danger');
            if(d.success){
              bootstrap.Modal.getInstance(document.getElementById('editShippingModal')).hide();
              setTimeout(()=>location.reload(),800);
            }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        let currentDeleteId = 0;
        document.querySelectorAll('.btn-delete').forEach(b=>b.addEventListener('click', function(){
          currentDeleteId = this.getAttribute('data-id');
          document.getElementById('DeleteId').value = currentDeleteId;
        }));
        document.getElementById('btnConfirmDelete')?.addEventListener('click', function(){
          const form=document.getElementById('deleteForm');
          const fd=new FormData(form);
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang xóa...';

          fetch('@Url.Action("Delete","Shipping", new { area = "Admin" })', {
            method:'POST',
            credentials:'same-origin',
            body:fd
          })
          .then(r=>r.json())
          .then(d=>{
            showNotification(d.message, d.success?'success':'danger');
            if(d.success){
              bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
              setTimeout(()=>location.reload(),800);
            }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        document.addEventListener('click', function (e) {
          const recBtn = e.target.closest('.btn-reconcile');
          const unrecBtn = e.target.closest('.btn-unreconcile');
          if (!recBtn && !unrecBtn) return;

          const orderId = (recBtn || unrecBtn).getAttribute('data-orderid');
          const token = getToken();
          const btn = recBtn || unrecBtn;
          const old = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

          const url = recBtn
            ? '@Url.Action("ReconcileCod","Shipping", new { area = "Admin" })'
            : '@Url.Action("UnreconcileCod","Shipping", new { area = "Admin" })';

          fetch(url, {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'Accept': 'application/json',
                'RequestVerificationToken': token,
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
              },
              body: new URLSearchParams({ orderId, __RequestVerificationToken: token })
          })
          .then(r => r.json())
          .then(d => {
              showNotification(d.message, d.success ? 'success' : 'danger');
              if (d.success) setTimeout(() => location.reload(), 700);
          })
          .catch(() => showNotification('Có lỗi xảy ra!', 'danger'))
          .finally(() => { btn.disabled = false; btn.innerHTML = old; });
        });

        if (typeof bootstrap !== 'undefined') {
          [...document.querySelectorAll('[title]')].forEach(el=>{
            el.setAttribute('data-bs-toggle','tooltip'); el.setAttribute('data-bs-placement','top');
          });
          const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
          tooltipTriggerList.map(el => new bootstrap.Tooltip(el));
        }
    </script>

    <style>
        @@keyframes slideOut {
            from {
                opacity: 1;
                transform: translateX(0)
            }

            to {
                opacity: 0;
                transform: translateX(100px)
            }
        }

        .is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 4px rgba(220,53,69,.1) !important
        }

        .is-valid {
            border-color: #198754 !important;
            box-shadow: 0 0 0 4px rgba(25,135,84,.1) !important
        }

        .invalid-feedback {
            display: block;
            margin-top: .5rem;
            font-size: .875rem;
            color: #dc3545
        }
    </style>
}
