                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person-badge me-2"></i> Nhân viên giao hàng</label>
                            @Html.DropDownList("DeliveryStaffId", (SelectList)ViewBag.DeliveryStaffs, "-- Chọn nhân viên --", new { @class = "form-select", id = "EditDeliveryStaffId" })
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border" style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="EditIsStorePickup" name="IsStorePickup" value="true" style="width: 3rem; height: 1.5rem;">
                                    <label class="form-check-label fw-semibold ms-2" for="EditIsStorePickup"><i class="bi bi-shop me-1"></i> Nhận tại cửa hàng</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person me-2"></i> Người nhận <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" id="EditFullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-telephone me-2"></i> Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="Phone" id="EditPhone" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-envelope me-2"></i> Email</label>
                            <input type="email" name="Email" id="EditEmail" class="form-control" />
                        </div>
                        <div id="editDeliveryInfo" class="row g-3">
                            <div class="col-12"><div class="border-top pt-3"><h6 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary-blue"><i class="bi bi-geo-alt-fill text-danger"></i>Thông tin giao hàng</h6></div></div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-primary-blue">Tỉnh/Thành phố <span class="text-danger">*</span></label>
                                @Html.DropDownList("EditProvinceId", provinces, "-- Chọn tỉnh/thành --", new { @class = "form-select", id = "EditProvinceId" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-primary-blue">Xã/Phường <span class="text-danger">*</span></label>
                                <select id="EditCommuneId" name="CommuneId" class="form-select"><option value="">-- Chọn Xã/Phường --</option></select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-primary-blue">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                                <input type="text" id="EditAddressDetail" name="AddressDetail" class="form-control" />
                            </div>
                        </div>
                        <div id="editStorePickupInfo" style="display:none" class="col-12">
                            <div class="border-top pt-3"><h6 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary-blue"><i class="bi bi-shop text-info"></i>Thông tin cửa hàng</h6></div>
                            <label class="form-label fw-semibold text-primary-blue">Địa chỉ cửa hàng <span class="text-danger">*</span></label>
                            <input type="text" id="EditStoreAddress" name="StoreAddress" class="form-control" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer p-4 border-top">
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal"><i class="bi bi-x-circle me-2"></i>Đóng</button>
                    <button type="button" class="btn btn-primary btn-pill px-4 hover-scale" id="btnSaveEdit"><i class="bi bi-check-circle me-2"></i>Lưu thay đổi</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger"><h5 class="modal-title fw-bold d-flex align-items-center gap-2 text-white"><i class="bi bi-exclamation-triangle"></i>Xác nhận xóa</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-4"><div class="p-4 rounded-circle d-inline-flex" style="background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);"><i class="bi bi-trash3" style="font-size: 3rem; color: #dc2626;"></i></div></div>
                    <h5 class="fw-bold mb-2">Bạn có chắc chắn muốn xóa?</h5>
                    <p class="text-muted mb-0">Hành động này không thể hoàn tác. Thông tin vận chuyển sẽ bị xóa vĩnh viễn.</p>
                </div>
                <div class="modal-footer p-4 border-top justify-content-center">
                    <form id="deleteForm">@Html.AntiForgeryToken()<input type="hidden" id="DeleteId" name="id" /></form>
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal"><i class="bi bi-x-circle me-2"></i>Hủy</button>
                    <button type="button" class="btn btn-danger btn-pill px-4" id="btnConfirmDelete"><i class="bi bi-trash3 me-2"></i>Xóa ngay</button>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        function showNotification(message, type = 'info') {
            const old = document.querySelector('.dynamic-alert'); if (old) old.remove();
            const iconMap = { 'success': 'check-circle-fill', 'danger': 'exclamation-triangle-fill', 'info': 'info-circle-fill', 'warning': 'exclamation-circle-fill' };
            const div = document.createElement('div');
            div.className = `alert alert-${type} alert-dismissible fade show dynamic-alert`;
            div.style.cssText = 'position:fixed;top:80px;right:20px;z-index:9999;min-width:320px;max-width:500px;box-shadow:0 15px 50px rgba(0,0,0,.25);border-radius:1.25rem;animation:slideIn .4s ease-out';
            div.innerHTML = `<div class="d-flex align-items-center gap-3"><i class="bi bi-${iconMap[type]} fs-4"></i><span class="flex-grow-1">${message}</span><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
            document.body.appendChild(div);
            setTimeout(() => { div.style.animation = 'slideOut .3s ease-out'; setTimeout(() => div.remove(), 300); }, 5000);
        }
        function getToken() { const t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
        function setResult(id, data) {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
        }
        function buildUrl(base, params) {
            const url = new URL(base, window.location.origin);
            Object.entries(params || {}).forEach(([key, value]) => {
                if (value !== null && value !== undefined && value !== '') {
                    url.searchParams.set(key, value);
                }
            });
            return url.toString();
        }
        function getNumericValue(id, fallback = 0) {
            const raw = document.getElementById(id)?.value;
            const parsed = Number(raw);
            return Number.isFinite(parsed) ? parsed : fallback;
        }
        function getTextValue(id) {
            return document.getElementById(id)?.value?.trim() || '';
        }
        function collectVisibleGhnRowsForSync() {
            return Array.from(document.querySelectorAll('tr[data-ghn-order-id]'))
                .map(function (row) {
                    return {
                        orderId: (row.dataset.ghnOrderId || '').trim(),
                        orderCode: (row.dataset.ghnOrderCode || '').trim(),
                        orderLabel: (row.dataset.ghnOrderLabel || '').trim(),
                        lastSyncedAt: (row.dataset.ghnLastSyncedAt || '').trim()
                    };
                })
                .filter(function (item) {
                    return item.orderId && item.orderCode;
                });
        }
        function collectAutoSyncCandidates(maxAgeMinutes = 20, maxItems = 3) {
            const now = Date.now();
            const maxAgeMs = maxAgeMinutes * 60 * 1000;
            return collectVisibleGhnRowsForSync()
                .filter(function (item) {
                    if (!item.lastSyncedAt) {
                        return true;
                    }
                    const parsed = Date.parse(item.lastSyncedAt);
                    if (!Number.isFinite(parsed)) {
                        return true;
                    }
                    return (now - parsed) >= maxAgeMs;
                })
                .slice(0, maxItems);
        }
        function buildBoundClientOrderCode(orderId) {
            const numeric = Number(orderId);
            if (!Number.isFinite(numeric) || numeric <= 0) {
                return '';
            }

            return `FF-ORD-${String(Math.trunc(numeric)).padStart(6, '0')}`;
        }
        function setBoundClientOrderCode(orderId) {
            const input = document.getElementById('ghnClientOrderCode');
            if (!input) return;
            input.value = buildBoundClientOrderCode(orderId);
        }
        function updateCreateButtonState() {
            const button = document.getElementById('btnGhnCreateOrder');
            if (!button) return;
            button.disabled = !getTextValue('ghnSelectedOrderId');
        }
        function getSelectedText(id) {
            const select = document.getElementById(id);
            if (!select || select.selectedIndex < 0) return '';
            return select.options[select.selectedIndex]?.text?.trim() || '';
        }
        function setButtonBusy(button, busy, busyHtml) {
            if (!button) return;
            if (busy) {
                button.dataset.originalHtml = button.innerHTML;
                button.disabled = true;
                button.innerHTML = busyHtml;
                return;
            }
            button.disabled = false;
            if (button.dataset.originalHtml) {
                button.innerHTML = button.dataset.originalHtml;
            }
            updateCreateButtonState();
        }
        function setGhnRecipientLocationStatus(message, tone = 'info') {
            const node = document.getElementById('ghnRecipientLocationStatus');
            if (!node) return;
            const icon = tone === 'success'
                ? 'bi-check-circle-fill'
                : tone === 'warning'
                    ? 'bi-exclamation-triangle-fill'
                    : tone === 'danger'
                        ? 'bi-x-circle-fill'
                        : 'bi-magic';
            node.innerHTML = `<i class="bi ${icon}"></i> ${message}`;
        }
        function normalizeAdministrativeName(value) {
            return (value || '')
                .toString()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .replace(/đ/g, 'd')
                .replace(/\b(tinh|thanh pho|tp|quan|huyen|thi xa|thi tran|phuong|xa)\b/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }
        function findAdministrativeOptionMatch(select, addressText) {
            if (!select) return null;
            const normalizedAddress = normalizeAdministrativeName(addressText);
            if (!normalizedAddress) return null;

            const options = Array.from(select.options || []).filter(option => option.value);
            let best = null;
            let bestScore = -1;

            options.forEach(option => {
                const normalizedName = normalizeAdministrativeName(option.textContent || '');
                if (!normalizedName) return;

                let score = -1;
                if (normalizedAddress.includes(normalizedName)) {
                    score = normalizedName.length + 100;
                } else if (normalizedName.includes(normalizedAddress)) {
                    score = normalizedAddress.length + 50;
                }

                if (score > bestScore) {
                    best = option;
                    bestScore = score;
                }
            });

            return best;
        }
        async function autoResolveGhnRecipientLocation(addressText) {
            const provinceSelect = document.getElementById('ghnProvinceId');
            const districtSelect = document.getElementById('ghnDistrictId');
            const wardSelect = document.getElementById('ghnWardCode');
            if (!provinceSelect || !districtSelect || !wardSelect) return false;

            const normalizedAddress = (addressText || '').trim();
            if (!normalizedAddress) {
                setGhnRecipientLocationStatus('Chưa có địa chỉ chi tiết để tự nhận diện địa bàn GHN.', 'warning');
                return false;
            }

            try {
                setGhnRecipientLocationStatus('Đang tự nhận diện tỉnh/quận/phường từ địa chỉ người nhận...', 'info');
                await loadGhnProvinces();

                const matchedProvince = findAdministrativeOptionMatch(provinceSelect, normalizedAddress);
                if (!matchedProvince) {
                    setGhnRecipientLocationStatus('Không tự nhận diện được tỉnh/thành từ địa chỉ này. Hãy kiểm tra lại địa chỉ.', 'warning');
                    return false;
                }

                provinceSelect.value = matchedProvince.value;
                await loadGhnDistricts(matchedProvince.value);

                const matchedDistrict = findAdministrativeOptionMatch(districtSelect, normalizedAddress);
                if (!matchedDistrict) {
                    setGhnRecipientLocationStatus('Không tự nhận diện được quận/huyện từ địa chỉ này. Hãy kiểm tra lại địa chỉ.', 'warning');
                    return false;
                }

                districtSelect.value = matchedDistrict.value;
                await loadGhnWards(matchedDistrict.value);

                const matchedWard = findAdministrativeOptionMatch(wardSelect, normalizedAddress);
                if (!matchedWard) {
                    setGhnRecipientLocationStatus('Không tự nhận diện được phường/xã từ địa chỉ này. Hãy kiểm tra lại địa chỉ.', 'warning');
                    return false;
                }

                wardSelect.value = matchedWard.value;
                setGhnRecipientLocationStatus(`Đã tự nhận diện GHN: ${matchedProvince.textContent} / ${matchedDistrict.textContent} / ${matchedWard.textContent}.`, 'success');
                return true;
            } catch {
                setGhnRecipientLocationStatus('Không tự nhận diện được địa bàn GHN lúc này.', 'danger');
                return false;
            }
        }
        function formatCurrency(value) {
            const amount = Number(value || 0);
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND',
                maximumFractionDigits: 0
            }).format(Number.isFinite(amount) ? amount : 0);
        }
        async function ensureGhnRecipient() {
            const orderId = getTextValue('ghnSelectedOrderId');
            const toName = getTextValue('ghnToName');
            const toPhone = getTextValue('ghnToPhone');
            const toAddress = getTextValue('ghnToAddress');
            if (!orderId) {
                showNotification('Cần bind một đơn hàng trước khi tạo vận đơn GHN.', 'warning');
                return null;
            }
            if (!toName || !toPhone || !toAddress) {
                showNotification('Cần điền đủ người nhận, số điện thoại và địa chỉ chi tiết.', 'warning');
                return null;
            }

            let districtId = getTextValue('ghnDistrictId');
            let wardCode = getTextValue('ghnWardCode');
            if (!districtId || !wardCode) {
                const resolved = await autoResolveGhnRecipientLocation(toAddress);
                if (!resolved) {
                    showNotification('Không tự nhận diện được quận/phường GHN từ địa chỉ này.', 'warning');
                    return null;
                }
                districtId = getTextValue('ghnDistrictId');
                wardCode = getTextValue('ghnWardCode');
            }

            return { orderId, toName, toPhone, toAddress, districtId, wardCode };
        }
        async function fetchJson(url, options) {
            const response = await fetch(url, { credentials: 'same-origin', ...(options || {}) });
            const payload = await response.json();
            return payload;
        }
        async function loadGhnProvinces() {
            const select = document.getElementById('ghnProvinceId');
            if (!select || select.dataset.loaded === 'true') return;
            const payload = await fetchJson('@Url.Action("GetGhnProvinces", "Shipping", new { area = "Admin" })');
            const items = Array.isArray(payload?.items) ? payload.items : [];
            select.innerHTML = '<option value="">Chọn tỉnh/thành GHN</option>';
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name;
                select.appendChild(option);
            });
            select.dataset.loaded = 'true';
        }
        async function loadGhnDistricts(provinceId) {
            const districtSelect = document.getElementById('ghnDistrictId');
            const wardSelect = document.getElementById('ghnWardCode');
            if (!districtSelect || !wardSelect) return;
            districtSelect.innerHTML = '<option value="">Chọn quận/huyện GHN</option>';
            wardSelect.innerHTML = '<option value="">Chọn phường/xã GHN</option>';
            if (!provinceId) return;
            const payload = await fetchJson(buildUrl('@Url.Action("GetGhnDistricts", "Shipping", new { area = "Admin" })', { provinceId }));
            const items = Array.isArray(payload?.items) ? payload.items : [];
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name;
                districtSelect.appendChild(option);
            });
        }
        async function loadGhnWards(districtId) {
            const wardSelect = document.getElementById('ghnWardCode');
            if (!wardSelect) return;
            wardSelect.innerHTML = '<option value="">Chọn phường/xã GHN</option>';
            if (!districtId) return;
            const payload = await fetchJson(buildUrl('@Url.Action("GetGhnWards", "Shipping", new { area = "Admin" })', { districtId }));
            const items = Array.isArray(payload?.items) ? payload.items : [];
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.code || item.id;
                option.textContent = item.name;
                wardSelect.appendChild(option);
            });
        }
        async function buildPreviewParams() {
            const recipient = await ensureGhnRecipient();
            if (!recipient) return null;
            return {
                ToDistrictId: recipient.districtId,
                ToWardCode: recipient.wardCode,
                Weight: getNumericValue('ghnWeight', 500),
                Length: getNumericValue('ghnLength', 20),
                Width: getNumericValue('ghnWidth', 20),
                Height: getNumericValue('ghnHeight', 10),
                InsuranceValue: getNumericValue('ghnInsuranceValue', 0),
                ItemName: getTextValue('ghnItemName') || 'Nông sản FreshFarm',
                ItemQuantity: getNumericValue('ghnItemQuantity', 1)
            };
        }
        async function bindOrderToGhnPanel(orderId, sourceLabel) {
            const payload = await fetchJson('@Url.Action("GetOrderInfo", "Shipping", new { area = "Admin" })?orderId=' + orderId);
            if (!payload?.success) {
                throw new Error(payload?.message || 'Không tải được thông tin đơn hàng để tạo vận đơn.');
            }

            const resolvedLabel = sourceLabel || `#DH${String(orderId).padStart(5, '0')}`;
            document.getElementById('ghnSelectedOrderId').value = String(orderId);
            document.getElementById('ghnSourceLabel').value = resolvedLabel;
            document.getElementById('ghnToName').value = payload.fullName || '';
            document.getElementById('ghnToPhone').value = payload.phone || '';
            document.getElementById('ghnToAddress').value = payload.address || '';
            document.getElementById('ghnProvinceId').value = '';
            document.getElementById('ghnDistrictId').innerHTML = '<option value="">Chọn quận/huyện GHN</option>';
            document.getElementById('ghnWardCode').innerHTML = '<option value="">Chọn phường/xã GHN</option>';
            setBoundClientOrderCode(orderId);
            document.getElementById('ghnContent').value = `Đơn giao vận cho ${resolvedLabel}`;
            document.getElementById('ghnItemName').value = payload.itemSummary || 'Gói hàng tổng hợp';
            document.getElementById('ghnItemCode').value = `ORDER-${orderId}`;
            document.getElementById('ghnItemQuantity').value = payload.totalQuantity && payload.totalQuantity > 0 ? String(payload.totalQuantity) : '1';
            document.getElementById('ghnItemPrice').value = payload.itemsAmount && payload.itemsAmount > 0 ? String(Math.round(payload.itemsAmount)) : '';
            document.getElementById('ghnInsuranceValue').value = payload.totalAmount && payload.totalAmount > 0 ? String(Math.round(payload.totalAmount)) : '0';
            document.getElementById('ghnCodAmount').value = payload.isCod && payload.codAmount && payload.codAmount > 0 ? String(Math.round(payload.codAmount)) : '0';
            document.getElementById('ghnTrackingOrderCode').value = '';

            const financeNote = document.getElementById('ghnOrderFinanceNote');
            if (financeNote) {
                const shippingFee = Number(payload.shippingFee || 0);
                const totalQuantity = Number(payload.totalQuantity || 0);
                financeNote.innerHTML = `<i class="bi bi-cash-stack"></i> Buyer đã chốt phí ship ${formatCurrency(shippingFee)} cho ${resolvedLabel}. Gói hàng hiện lấy ${totalQuantity > 0 ? totalQuantity : 1} sản phẩm với tên tổng hợp "${payload.itemSummary || 'Gói hàng tổng hợp'}".`;
            }

            updateCreateButtonState();
            await autoResolveGhnRecipientLocation(payload.address || '');
            return payload;
        }
        async function fillGhnFormFromRow(button) {
            const row = button.closest('tr');
            if (!row) return;
            const orderId = row.dataset.ghnOrderId || '';
            if (!orderId) {
                showNotification('Không xác định được đơn hàng để bind GHN.', 'warning');
                return;
            }

            const orderLabel = row.dataset.ghnOrderLabel || `#DH${String(orderId).padStart(5, '0')}`;
            try {
                await bindOrderToGhnPanel(orderId, orderLabel);
                showNotification(`Đã bind ${orderLabel} vào bảng điều khiển GHN.`, 'info');
                document.getElementById('ghnCreateOrderPanel')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (error) {
                const message = error instanceof Error ? error.message : 'Không tải được thông tin đơn hàng.';
                showNotification(message, 'danger');
            }
        }
        async function loadShopProfile() {
            const button = document.getElementById('btnGhnLoadShopProfile');
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tải...');
                const payload = await fetchJson('@Url.Action("GetGhnShopProfile", "Shipping", new { area = "Admin" })');
                setResult('ghnShopProfileResult', payload);
                showNotification(payload?.message || 'Đã tải thông tin shop GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                setResult('ghnShopProfileResult', 'Không tải được thông tin shop GHN.');
                showNotification('Không tải được thông tin shop GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function previewGhnFee() {
            const button = document.getElementById('btnGhnPreviewFee');
            const params = await buildPreviewParams();
            if (!params) return;
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tính...');
                const payload = await fetchJson(buildUrl('@Url.Action("PreviewGhnFee", "Shipping", new { area = "Admin" })', params));
                setResult('ghnPreviewResult', payload);
                showNotification(payload?.message || 'Đã tính phí GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không tính được phí GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function previewGhnLeadTime() {
            const button = document.getElementById('btnGhnPreviewLeadTime');
            const recipient = await ensureGhnRecipient();
            if (!recipient) return;
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang lấy...');
                const payload = await fetchJson(buildUrl('@Url.Action("PreviewGhnLeadTime", "Shipping", new { area = "Admin" })', {
                    ToDistrictId: recipient.districtId,
                    ToWardCode: recipient.wardCode
                }));
                setResult('ghnPreviewResult', payload);
                showNotification(payload?.message || 'Đã lấy leadtime GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không lấy được leadtime GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function createGhnOrder() {
            const button = document.getElementById('btnGhnCreateOrder');
            const recipient = await ensureGhnRecipient();
            if (!recipient) return;
            const params = {
                orderId: Number(recipient.orderId),
                ToName: recipient.toName,
                ToPhone: recipient.toPhone,
                ToAddress: recipient.toAddress,
                ToDistrictId: Number(recipient.districtId),
                ToWardCode: recipient.wardCode,
                Content: getTextValue('ghnContent') || `Vận đơn cho đơn #${recipient.orderId}`,
                ClientOrderCode: getTextValue('ghnClientOrderCode'),
                CodAmount: getNumericValue('ghnCodAmount', 0),
                InsuranceValue: getNumericValue('ghnInsuranceValue', 0),
                Height: getNumericValue('ghnHeight', 10),
                Length: getNumericValue('ghnLength', 20),
                Width: getNumericValue('ghnWidth', 20),
                Weight: getNumericValue('ghnWeight', 500),
                items: [
                    {
                        name: getTextValue('ghnItemName') || 'Nông sản FreshFarm',
                        code: getTextValue('ghnItemCode'),
                        quantity: getNumericValue('ghnItemQuantity', 1),
                        price: getNumericValue('ghnItemPrice', 0),
                        height: getNumericValue('ghnHeight', 10),
                        length: getNumericValue('ghnLength', 20),
                        width: getNumericValue('ghnWidth', 20),
                        weight: getNumericValue('ghnWeight', 500)
                    }
                ]
            };
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo...');
                const payload = await fetchJson('@Url.Action("CreateGhnSandboxOrder", "Shipping", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': getToken()
                    },
                    body: JSON.stringify(params)
                });
                setResult('ghnCreateResult', payload);
                if (payload?.orderCode) {
                    document.getElementById('ghnTrackingOrderCode').value = payload.orderCode;
                }
                showNotification(payload?.message || 'Đã gọi tạo đơn GHN.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không tạo được đơn GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function trackGhnOrder(options) {
            const shouldPersist = options?.persist ?? false;
            const shouldReload = options?.reloadOnSuccess ?? false;
            const button = document.getElementById(shouldPersist ? 'btnGhnSyncMetadata' : 'btnGhnTrackOrder');
            const orderCode = getTextValue('ghnTrackingOrderCode');
            if (!orderCode) {
                showNotification(`Cần nhập mã vận đơn GHN để ${shouldPersist ? 'đồng bộ' : 'tra cứu'}.`, 'warning');
                return;
            }
            const orderId = getTextValue('ghnSelectedOrderId');
            if (shouldPersist && !orderId) {
                showNotification('Cần chọn đơn hàng trong bảng trước khi đồng bộ GHN.', 'warning');
                return;
            }
            try {
                setButtonBusy(button, true, shouldPersist
                    ? '<span class="spinner-border spinner-border-sm me-2"></span>Đang đồng bộ...'
                    : '<span class="spinner-border spinner-border-sm me-2"></span>Đang tra...');
                const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Admin" })', {
                    orderCode,
                    orderId
                }));
                setResult('ghnTrackingResult', payload);
                showNotification(
                    payload?.message || (shouldPersist ? 'Đã đồng bộ metadata GHN.' : 'Đã tra cứu đơn GHN.'),
                    payload?.success ? 'success' : 'warning');
                if (payload?.success && shouldReload) {
                    window.setTimeout(function () {
                        window.location.reload();
                    }, 700);
                }
            } catch {
                showNotification(shouldPersist ? 'Không đồng bộ được metadata GHN.' : 'Không tra cứu được đơn GHN.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function syncVisibleGhnRows() {
            const button = document.getElementById('btnGhnSyncVisibleRows');
            const candidates = collectVisibleGhnRowsForSync();
            if (!candidates.length) {
                showNotification('Trang này chưa có đơn nào có mã GHN để đồng bộ.', 'warning');
                return;
            }

            const summary = {
                total: candidates.length,
                synced: 0,
                failed: 0,
                items: []
            };

            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang đồng bộ trang...');
                for (let index = 0; index < candidates.length; index += 1) {
                    const candidate = candidates[index];
                    setResult('ghnTrackingResult', {
                        message: `Đang đồng bộ ${index + 1}/${candidates.length}`,
                        current: candidate.orderLabel || `Đơn #${candidate.orderId}`,
                        orderCode: candidate.orderCode,
                        progress: `${index + 1}/${candidates.length}`
                    });

                    try {
                        const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Admin" })', {
                            orderCode: candidate.orderCode,
                            orderId: candidate.orderId
                        }));

                        if (payload?.success) {
                            summary.synced += 1;
                        } else {
                            summary.failed += 1;
                        }

                        summary.items.push({
                            orderId: candidate.orderId,
                            orderLabel: candidate.orderLabel,
                            orderCode: candidate.orderCode,
                            success: !!payload?.success,
                            statusLabel: payload?.statusLabel || payload?.status || '',
                            message: payload?.message || ''
                        });
                    } catch (error) {
                        summary.failed += 1;
                        summary.items.push({
                            orderId: candidate.orderId,
                            orderLabel: candidate.orderLabel,
                            orderCode: candidate.orderCode,
                            success: false,
                            message: error?.message || 'Không đồng bộ được đơn GHN này.'
                        });
                    }
                }

                setResult('ghnTrackingResult', {
                    message: `Đã đồng bộ ${summary.synced}/${summary.total} đơn GHN trên trang.`,
                    total: summary.total,
                    synced: summary.synced,
                    failed: summary.failed,
                    items: summary.items
                });

                showNotification(
                    summary.failed
                        ? `Đã đồng bộ ${summary.synced}/${summary.total} đơn GHN. Có ${summary.failed} đơn cần kiểm tra lại.`
                        : `Đã đồng bộ ${summary.synced} đơn GHN trên trang.`,
                    summary.failed ? 'warning' : 'success');

                if (summary.synced > 0) {
                    window.setTimeout(function () {
                        window.location.reload();
                    }, 900);
                }
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function autoSyncStaleGhnRows() {
            const candidates = collectAutoSyncCandidates();
            if (!candidates.length) {
                return;
            }

            const summary = {
                total: candidates.length,
                synced: 0,
                failed: 0
            };

            setResult('ghnTrackingResult', {
                message: `Đang tự đồng bộ ${candidates.length} đơn GHN cũ trên trang...`,
                auto: true,
                total: candidates.length
            });

            for (let index = 0; index < candidates.length; index += 1) {
                const candidate = candidates[index];
                try {
                    const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Admin" })', {
                        orderCode: candidate.orderCode,
                        orderId: candidate.orderId
                    }));
                    if (payload?.success) {
                        summary.synced += 1;
                    } else {
                        summary.failed += 1;
                    }
                } catch {
                    summary.failed += 1;
                }
            }

            if (summary.synced > 0) {
                setResult('ghnTrackingResult', {
                    message: `Đã tự đồng bộ ${summary.synced}/${summary.total} đơn GHN cũ trên trang.`,
                    auto: true,
                    total: summary.total,
                    synced: summary.synced,
                    failed: summary.failed
                });
                showNotification(`Đã tự đồng bộ ${summary.synced}/${summary.total} đơn GHN cũ trên trang.`, summary.failed ? 'warning' : 'info');
                window.setTimeout(function () {
                    window.location.reload();
                }, 900);
            }
        }

        function toggleAddFormValidation(isStorePickup) {
            const delivery = document.getElementById('deliveryInfo');
            const store = document.getElementById('storePickupInfo');
            const province = document.getElementById('ProvinceId');
            const commune = document.getElementById('CommuneId');
            const address = document.getElementById('AddressDetail');
            const storeAddr = document.getElementById('StoreAddress');
            if (!delivery || !store) return;
            if (isStorePickup) { delivery.style.display = 'none'; store.style.display = 'block'; province?.removeAttribute('required'); commune?.removeAttribute('required'); address?.removeAttribute('required'); storeAddr?.setAttribute('required', 'required'); }
            else { delivery.style.display = 'block'; store.style.display = 'none'; province?.setAttribute('required', 'required'); commune?.setAttribute('required', 'required'); address?.setAttribute('required', 'required'); storeAddr?.removeAttribute('required'); }
        }
        function toggleEditFormValidation(isStorePickup) {
            const delivery = document.getElementById('editDeliveryInfo');
            const store = document.getElementById('editStorePickupInfo');
            const province = document.getElementById('EditProvinceId');
            const commune = document.getElementById('EditCommuneId');
            const address = document.getElementById('EditAddressDetail');
            const storeAddr = document.getElementById('EditStoreAddress');
            if (!delivery || !store) return;
            if (isStorePickup) { delivery.style.display = 'none'; store.style.display = 'block'; province?.removeAttribute('required'); commune?.removeAttribute('required'); address?.removeAttribute('required'); storeAddr?.setAttribute('required', 'required'); }
            else { delivery.style.display = 'block'; store.style.display = 'none'; province?.setAttribute('required', 'required'); commune?.setAttribute('required', 'required'); address?.setAttribute('required','required'); storeAddr?.removeAttribute('required'); }
        }

        // Load danh sách xã/phường theo tỉnh được chọn
        function loadCommunes(provinceSelectId, communeSelectId, callback) {
            const provinceSelect = document.getElementById(provinceSelectId);
            const communeSelect = document.getElementById(communeSelectId);
            if (!provinceSelect || !communeSelect) return;

            const pid = provinceSelect.value;
            communeSelect.innerHTML = '<option value=\"\">-- Chọn Xã/Phường --</option>';

            if (!pid) {
                if (callback) callback();
                return;
            }

            fetch('@Url.Action("GetCommunes","Shipping", new { area = "Admin" })?provinceId=' + pid, { credentials: 'same-origin' })
                .then(r => r.json())
                .then(d => {
                    console.log('GetCommunes response for province', pid, d);
                    const list = Array.isArray(d)
                        ? d
                        : (Array.isArray(d?.data) ? d.data : (Array.isArray(d?.communes) ? d.communes : []));
                    list.forEach(x => {
                        const o = document.createElement('option');
                        o.value = x.value;
                        o.textContent = x.text;
                        communeSelect.appendChild(o);
                    });
                    if (callback) callback();
                })
                .catch(() => {
                    showNotification('Không tải được danh sách Xã/Phường','danger');
                    if (callback) callback();
                });
        }

        const addProvinceSelect = document.getElementById('ProvinceId');
        if (addProvinceSelect) {
            addProvinceSelect.addEventListener('change', function () {
                loadCommunes('ProvinceId', 'CommuneId');
            });

            // Nếu đã có sẵn tỉnh (ví dụ lấy từ địa chỉ nhận hàng)
            // thì tự động load danh sách Xã/Phường lúc mở trang.
            if (addProvinceSelect.value) {
                loadCommunes('ProvinceId', 'CommuneId');
            }
        }

        const editProvinceSelect = document.getElementById('EditProvinceId');
        if (editProvinceSelect) {
            editProvinceSelect.addEventListener('change', function () {
                loadCommunes('EditProvinceId', 'EditCommuneId');
            });
        }

        document.getElementById('status').addEventListener('change', function () {
          const wrap = document.getElementById('deliveredStateWrap');
          if (this.value === 'Delivered') {
            wrap.style.display = 'block';
          } else {
            wrap.style.display = 'none';
            const d = document.getElementById('deliveredState');
            if(d) d.value = '';
          }
        });

        document.getElementById('IsStorePickup')?.addEventListener('change', function(){ toggleAddFormValidation(this.checked); });
        document.getElementById('EditIsStorePickup')?.addEventListener('change', function(){ toggleEditFormValidation(this.checked); });

        document.getElementById('OrderID')?.addEventListener('change', function(){
          const id=this.value;
          if(!id) {
            document.getElementById('ghnSelectedOrderId').value = '';
            updateCreateButtonState();
            return;
          }
          fetch('@Url.Action("GetOrderInfo","Shipping", new { area = "Admin" })?orderId='+id, { credentials:'same-origin' })
            .then(r=>r.json())
            .then(d=>{
              if(!d || !d.success) return;
              document.getElementById('FullName').value = d.fullName || '';
              document.getElementById('Phone').value    = d.phone    || '';
              document.getElementById('Email').value    = d.email    || '';
              document.getElementById('AddressDetail').value = d.address || '';
              if(d.provinceId){
                const pv = document.getElementById('ProvinceId');
                pv.value = d.provinceId;
                loadCommunes('ProvinceId', 'CommuneId', function() {
                    if(d.communeId) document.getElementById('CommuneId').value = d.communeId;
                });
              }
              document.getElementById('ghnSelectedOrderId').value = id;
              document.getElementById('ghnSourceLabel').value = `#DH${String(id).padStart(5, '0')}`;
              document.getElementById('ghnToName').value = d.fullName || '';
              document.getElementById('ghnToPhone').value = d.phone || '';
              document.getElementById('ghnToAddress').value = d.address || '';
              document.getElementById('ghnProvinceId').value = '';
              document.getElementById('ghnDistrictId').innerHTML = '<option value="">Chọn quận/huyện GHN</option>';
              document.getElementById('ghnWardCode').innerHTML = '<option value="">Chọn phường/xã GHN</option>';
              setBoundClientOrderCode(id);
              document.getElementById('ghnContent').value = `Đơn giao vận cho #DH${String(id).padStart(5, '0')}`;
              document.getElementById('ghnItemName').value = d.itemSummary || 'Gói hàng tổng hợp';
              document.getElementById('ghnItemCode').value = `ORDER-${id}`;
              document.getElementById('ghnItemQuantity').value = d.totalQuantity && d.totalQuantity > 0 ? String(d.totalQuantity) : '1';
              document.getElementById('ghnItemPrice').value = d.itemsAmount && d.itemsAmount > 0 ? String(Math.round(d.itemsAmount)) : '';
              document.getElementById('ghnInsuranceValue').value = d.totalAmount && d.totalAmount > 0 ? String(Math.round(d.totalAmount)) : '0';
              document.getElementById('ghnCodAmount').value = d.isCod && d.codAmount && d.codAmount > 0 ? String(Math.round(d.codAmount)) : '0';
              document.getElementById('ghnTrackingOrderCode').value = payload.ghnOrderCode || '';
              const financeNote = document.getElementById('ghnOrderFinanceNote');
              if (financeNote) {
                const shippingFee = Number(d.shippingFee || 0);
                const totalQuantity = Number(d.totalQuantity || 0);
                financeNote.innerHTML = `<i class="bi bi-cash-stack"></i> Buyer đã chốt phí ship ${formatCurrency(shippingFee)} cho #DH${String(id).padStart(5, '0')}. Gói hàng hiện lấy ${totalQuantity > 0 ? totalQuantity : 1} sản phẩm với tên tổng hợp "${d.itemSummary || 'Gói hàng tổng hợp'}".`;
              }
              updateCreateButtonState();
              void autoResolveGhnRecipientLocation(d.address || '');
            });
        });

        document.getElementById('btnAddNew')?.addEventListener('click', function(){
          const f = document.getElementById('addShippingForm');
          if (f) f.reset();
          toggleAddFormValidation(false);
          const c = document.getElementById('CommuneId');
          if (c) c.innerHTML = '<option value="">-- Chọn Xã/Phường --</option>';
        });

        document.getElementById('btnSaveAdd')?.addEventListener('click', function(){
          const form=document.getElementById('addShippingForm');
          if(!form.checkValidity()){ form.reportValidity(); return; }
          const fd=new FormData(form);
          fd.set('ProvinceId', document.getElementById('ProvinceId')?.value || '');
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

          fetch('@Url.Action("Create","Shipping", new { area = "Admin" })', {
              method:'POST',
              credentials:'same-origin',
              body:fd
          })
          .then(r=>r.json())
          .then(d=>{
              showNotification(d.message, d.success?'success':'danger');
              if(d.success){
                bootstrap.Modal.getInstance(document.getElementById('addShippingModal')).hide();
                setTimeout(()=>location.reload(),800);
              }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        document.querySelectorAll('.btn-edit').forEach(b=>b.addEventListener('click', function(){
          const id=this.getAttribute('data-id');
          const modal = document.getElementById('editShippingModal');
          const body  = modal.querySelector('.modal-body');
          const bak   = body.innerHTML;
          try {
              const row = this.closest('tr');
              const hasActiveAssign = row?.getAttribute('data-has-assign') === 'true';
              const statusRaw = (row?.getAttribute('data-order-status') || '').toLowerCase();
              const isCanceled = statusRaw === 'canceled';
              if (hasActiveAssign && !isCanceled) {
                  showNotification('Đơn đã có người giao, không thể sửa (chỉ được sửa khi đơn bị hủy).', 'danger');
                  return;
              }
          } catch {}
          body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted">Đang tải dữ liệu...</p></div>';

          try { bootstrap.Modal.getOrCreateInstance(modal).show(); } catch {}
          fetch('@Url.Action("Edit","Shipping", new { area = "Admin" })?id='+id, { credentials:'same-origin' })
            .then(r=>r.json())
            .then(d=>{
              body.innerHTML = bak;
              if(!d || !d.success){ showNotification('Không tải được dữ liệu','danger'); return; }
              document.getElementById('EditShippingID').value = d.shippingID;
              const s = document.getElementById('EditDeliveryStaffId'); if(s) s.value = d.deliveryStaffId || '';
              document.getElementById('EditFullName').value   = d.fullName || '';
              document.getElementById('EditPhone').value      = d.phone    || '';
              document.getElementById('EditEmail').value      = d.email    || '';
              document.getElementById('EditIsStorePickup').checked = d.isStorePickup === true;
              toggleEditFormValidation(d.isStorePickup === true);

              if(d.isStorePickup){
                document.getElementById('EditStoreAddress').value = d.storeAddress || '';
              } else {
                if(d.provinceId){
                  const pv = document.getElementById('EditProvinceId');
                  pv.value = d.provinceId;
                  loadCommunes('EditProvinceId', 'EditCommuneId', function() {
                      if(d.communeId) document.getElementById('EditCommuneId').value = d.communeId;
                  });
                }
                document.getElementById('EditAddressDetail').value = d.addressDetail || '';
              }
            })
            .catch(()=>{ body.innerHTML = bak; showNotification('Có lỗi xảy ra khi tải dữ liệu!','danger'); });
        }));

        document.getElementById('btnSaveEdit')?.addEventListener('click', function(){
          const form=document.getElementById('editShippingForm');
          if(!form.checkValidity()){ form.reportValidity(); return; }
          const fd=new FormData(form);
          fd.set('ProvinceId', document.getElementById('EditProvinceId')?.value || '');
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

          fetch('@Url.Action("Edit","Shipping", new { area = "Admin" })', {
            method:'POST',
            credentials:'same-origin',
            body:fd
          })
          .then(r=>r.json())
          .then(d=>{
            showNotification(d.message, d.success?'success':'danger');
            if(d.success){
              bootstrap.Modal.getInstance(document.getElementById('editShippingModal')).hide();
              setTimeout(()=>location.reload(),800);
            }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        let currentDeleteId = 0;
        document.querySelectorAll('.btn-delete').forEach(b=>b.addEventListener('click', function(){
          currentDeleteId = this.getAttribute('data-id');
          document.getElementById('DeleteId').value = currentDeleteId;
        }));
        document.getElementById('btnConfirmDelete')?.addEventListener('click', function(){
          const form=document.getElementById('deleteForm');
          const fd=new FormData(form);
          const btn=this, old=btn.innerHTML;
          btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang xóa...';

          fetch('@Url.Action("Delete","Shipping", new { area = "Admin" })', {
            method:'POST',
            credentials:'same-origin',
            body:fd
          })
          .then(r=>r.json())
          .then(d=>{
            showNotification(d.message, d.success?'success':'danger');
            if(d.success){
              bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
              setTimeout(()=>location.reload(),800);
            }
          })
          .catch(()=>showNotification('Có lỗi xảy ra!','danger'))
          .finally(()=>{ btn.disabled=false; btn.innerHTML=old; });
        });

        document.addEventListener('click', function (e) {
          const recBtn = e.target.closest('.btn-reconcile');
          const unrecBtn = e.target.closest('.btn-unreconcile');
          if (!recBtn && !unrecBtn) return;

          const orderId = (recBtn || unrecBtn).getAttribute('data-orderid');
          const token = getToken();
          const btn = recBtn || unrecBtn;
          const old = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

          const url = recBtn
            ? '@Url.Action("ReconcileCod","Shipping", new { area = "Admin" })'
            : '@Url.Action("UnreconcileCod","Shipping", new { area = "Admin" })';

          fetch(url, {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'Accept': 'application/json',
                'RequestVerificationToken': token,
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
              },
              body: new URLSearchParams({ orderId, __RequestVerificationToken: token })
          })
          .then(r => r.json())
          .then(d => {
              showNotification(d.message, d.success ? 'success' : 'danger');
              if (d.success) setTimeout(() => location.reload(), 700);
          })
          .catch(() => showNotification('Có lỗi xảy ra!', 'danger'))
          .finally(() => { btn.disabled = false; btn.innerHTML = old; });
        });

        if (typeof bootstrap !== 'undefined') {
          [...document.querySelectorAll('[title]')].forEach(el=>{
            el.setAttribute('data-bs-toggle','tooltip'); el.setAttribute('data-bs-placement','top');
          });
          const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
          tooltipTriggerList.map(el => new bootstrap.Tooltip(el));
        }
    </script>

