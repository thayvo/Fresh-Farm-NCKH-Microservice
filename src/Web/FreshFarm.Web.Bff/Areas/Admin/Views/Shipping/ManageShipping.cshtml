@model IEnumerable<FreshFarm.Web.Bff.Areas.Seller.Models.Shipping>
@using Microsoft.AspNetCore.Html
@using System.Linq

@{
    ViewBag.Title = "Quản Lý Vận Chuyển";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var provinces = ViewBag.Provinces as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    string deliveredState = (string)(ViewBag.DeliveredState ?? "");
    string currentStatus = ViewBag.CurrentStatus as string ?? "";

    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int pageSize = ViewBag.PageSize is int ps ? ps : 10;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : 0;
    bool ghnSandboxConfigured = ViewBag.GhnSandboxConfigured is bool ghnConfigured && ghnConfigured;
    string ghnShopId = ViewBag.GhnSandboxShopId?.ToString() ?? "Chưa có";
    var shippingRows = Model?.ToList() ?? new List<FreshFarm.Web.Bff.Areas.Seller.Models.Shipping>();

    var staffsSrc = ViewBag.DeliveryStaffs as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var selectedStaff = ViewBag.CurrentStaffId != null ? ViewBag.CurrentStaffId.ToString() : null;

    Func<string, string, IHtmlContent> SoftBadge = (text, cls) =>
        new HtmlString($"<span class='px-3 py-1 rounded-pill border text-nowrap {cls}' style='font-size:.8rem'>{text}</span>");

    var paidStatuses = new[] { "Đã thanh toán", "Da thanh toan", "Hoàn tất", "Hoan tat" };

    Func<FreshFarm.Web.Bff.Areas.Seller.Models.Order, IHtmlContent> RenderStatus = (o) =>
    {
        if (o == null) return SoftBadge("N/A", "bg-light text-secondary border-secondary-subtle");
        switch (o.Status)
        {
            case "Pending": return SoftBadge("Chờ xử lý", "bg-body-tertiary text-secondary border-secondary-subtle");
            case "Processing": return SoftBadge("Đang xử lý", "bg-warning-subtle text-warning-emphasis border-warning-subtle");
            case "Ready": return SoftBadge("Đã xử lý", "bg-primary-subtle text-primary-emphasis border-primary-subtle");
            case "Shipped": return SoftBadge("Đang giao", "bg-info-subtle text-info-emphasis border-info-subtle");
            case "Delivered":
                var pay = o.Payments?.FirstOrDefault(p => p.PaymentMethod == "COD");
                if (pay == null) return SoftBadge("Đã giao / Đã đối soát", "bg-success-subtle text-success-emphasis border-success-subtle");
                bool isReconciled = (pay.PaymentDate.HasValue) || (!string.IsNullOrWhiteSpace(pay.PaymentStatus) && paidStatuses.Any(s => string.Equals(s, pay.PaymentStatus, System.StringComparison.OrdinalIgnoreCase)));
                return isReconciled
                    ? SoftBadge("Đã giao / Đã đối soát", "bg-success-subtle text-success-emphasis border-success-subtle")
                    : SoftBadge("Đã giao / Chưa đối soát", "bg-warning-subtle text-warning-emphasis border-warning-subtle");
            case "Canceled": return SoftBadge("Đã hủy", "bg-danger-subtle text-danger-emphasis border-danger-subtle");
            default: return SoftBadge(o.Status ?? "", "bg-body-tertiary text-secondary border-secondary-subtle");
        }
    };
}

@Html.AntiForgeryToken()

<style>
    :root {
        --primary-blue: #1e40af;
        --primary-blue-light: #3b82f6;
        --primary-blue-dark: #1e3a8a;
        --accent-blue: #0ea5e9;
        --bg-blue-light: #eff6ff;
        --bg-blue-lighter: #dbeafe;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -1000px 0
        }

        100% {
            background-position: 1000px 0
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-10px)
        }
    }

    .card-glass {
        border: 1px solid var(--ff-border);
        animation: fadeInUp .6s ease-out;
    }

    .grad-header {
        animation: fadeInUp .5s ease-out;
        position: relative;
        overflow: hidden;
    }

        .grad-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
            animation: rotate 25s linear infinite;
        }

        .grad-header::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }

    @@keyframes rotate {
        from {
            transform: rotate(0)
        }

        to {
            transform: rotate(360deg)
        }
    }

    .icon-gradient {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        box-shadow: 0 10px 30px rgba(30, 64, 175, 0.5);
    }

    .table-modern {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-modern thead th {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-bottom: 3px solid #3b82f6;
            font-weight: 600;
            color: #1e3a8a;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .5px;
            padding: 1.25rem 1rem;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            .table-modern thead th a {
                color: #1e3a8a;
                transition: all .3s ease;
            }

                .table-modern thead th a:hover {
                    color: #1e40af;
                    text-shadow: 0 2px 8px rgba(30, 64, 175, 0.3);
                }

        .table-modern tbody tr {
            transition: all .3s cubic-bezier(.4,0,.2,1);
            animation: slideIn .4s ease-out backwards;
            border-bottom: 1px solid #e5e7eb;
        }

            .table-modern tbody tr:hover {
                background: linear-gradient(90deg, rgba(59, 130, 246, 0.08) 0%, rgba(147, 197, 253, 0.08) 100%);
                transform: translateY(-2px);
                box-shadow: -5px 0 0 0 #3b82f6;
            }

        .table-modern tbody td {
            padding: 1.25rem 1rem;
            vertical-align: middle;
        }

            .table-modern tbody td:nth-child(6) {
                max-width: 200px;
            }

    .btn-pill {
        border-radius: 2rem;
        padding: .75rem 2rem;
        font-weight: 600;
        transition: all .3s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
        border: none;
    }

        .btn-pill:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(0,0,0,.2);
        }

    .btn-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
        }

    .btn-primary {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        }

    .form-select, .form-control {
        border: 2px solid #bfdbfe;
        border-radius: 1rem;
        padding: .875rem 1.25rem;
        transition: all .3s ease;
        background: #fff;
    }

        .form-select:focus, .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 5px rgba(59, 130, 246, 0.15);
            background: #fff;
        }

    .filter-card {
        border: 1px solid var(--ff-border);
        animation: fadeInUp .6s ease-out .1s backwards;
    }

    .ghn-panel {
        border: 1px solid var(--ff-border);
        animation: fadeInUp .6s ease-out .15s backwards;
    }

    .ghn-result-box {
        border: 1px dashed #93c5fd;
        border-radius: 1rem;
        background: linear-gradient(135deg, rgba(219, 234, 254, 0.45) 0%, rgba(239, 246, 255, 0.9) 100%);
        min-height: 132px;
    }

    .ghn-result-box pre {
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
        font-size: .875rem;
        color: #1e3a8a;
    }

    .ghn-field-note {
        font-size: .8rem;
        color: #64748b;
    }

    .ghn-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .75rem;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
    }

    .order-code {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
        font-size: .9375rem;
    }

    .btn-action {
        width: 38px;
        height: 38px;
        border-radius: .875rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .3s ease;
        border: 2px solid;
    }

        .btn-action:hover {
            transform: scale(1.1);
        }

    .page-link {
        border-radius: .875rem;
        margin: 0 .375rem;
        border: 2px solid #bfdbfe;
        color: #1e40af;
        transition: all .3s ease;
        font-weight: 600;
    }

        .page-link:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
            color: #fff;
            border-color: #3b82f6;
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
        }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-color: #1e40af;
    }

    .alert {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .search-icon-wrapper {
        position: relative;
    }

        .search-icon-wrapper i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #60a5fa;
            font-size: 1.125rem;
        }

        .search-icon-wrapper input {
            padding-left: 3.25rem;
        }

    .hover-scale {
        transition: transform .3s ease;
    }

        .hover-scale:hover {
            transform: scale(1.05);
        }

    .modal-content {
        border-radius: 1.5rem;
        border: none;
        box-shadow: 0 25px 60px rgba(30, 64, 175, 0.3);
    }

    .modal-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        color: white;
        border-radius: 1.5rem 1.5rem 0 0;
        padding: 1.5rem 2rem;
    }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

    .badge {
        font-weight: 600;
        padding: .5rem 1rem;
    }

    .text-primary-blue {
        color: #1e40af !important;
    }

    .bg-primary-blue {
        background-color: #1e40af !important;
    }

    @@media (max-width:768px) {
        .grad-header {
            padding: 2rem 1.5rem !important;
        }

        .table-modern {
            font-size: .875rem;
        }

        .btn-pill {
            padding: .625rem 1.5rem;
        }
    }
</style>

<div class="min-vh-100 ff-admin-shell">
