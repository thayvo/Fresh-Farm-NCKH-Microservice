@model IEnumerable<FreshFarm.Web.Bff.Areas.Seller.Models.Shipping>
@using Microsoft.AspNetCore.Html
@using System.Linq

@{
    ViewBag.Title = "Quản Lý Vận Chuyển";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var provinces = ViewBag.Provinces as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    string deliveredState = (string)(ViewBag.DeliveredState ?? "");
    string currentStatus = ViewBag.CurrentStatus as string ?? "";

    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int pageSize = ViewBag.PageSize is int ps ? ps : 10;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : 0;

    var staffsSrc = ViewBag.DeliveryStaffs as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var selectedStaff = ViewBag.CurrentStaffId != null ? ViewBag.CurrentStaffId.ToString() : null;

    Func<string, string, IHtmlContent> SoftBadge = (text, cls) =>
        new HtmlString($"<span class='px-3 py-1 rounded-pill border text-nowrap {cls}' style='font-size:.8rem'>{text}</span>");

    var paidStatuses = new[] { "Đã thanh toán", "Da thanh toan", "Hoàn tất", "Hoan tat" };

    Func<FreshFarm.Web.Bff.Areas.Seller.Models.Order, IHtmlContent> RenderStatus = (o) =>
    {
        if (o == null) return SoftBadge("N/A", "bg-light text-secondary border-secondary-subtle");
        switch (o.Status)
        {
            case "Pending": return SoftBadge("Chờ xử lý", "bg-body-tertiary text-secondary border-secondary-subtle");
            case "Processing": return SoftBadge("Đang xử lý", "bg-warning-subtle text-warning-emphasis border-warning-subtle");
            case "Ready": return SoftBadge("Đã xử lý", "bg-primary-subtle text-primary-emphasis border-primary-subtle");
            case "Shipped": return SoftBadge("Đang giao", "bg-info-subtle text-info-emphasis border-info-subtle");
            case "Delivered":
                var pay = o.Payments?.FirstOrDefault(p => p.PaymentMethod == "COD");
                if (pay == null) return SoftBadge("Đã giao / Đã đối soát", "bg-success-subtle text-success-emphasis border-success-subtle");
                bool isReconciled = (pay.PaymentDate.HasValue) || (!string.IsNullOrWhiteSpace(pay.PaymentStatus) && paidStatuses.Any(s => string.Equals(s, pay.PaymentStatus, System.StringComparison.OrdinalIgnoreCase)));
                return isReconciled
                    ? SoftBadge("Đã giao / Đã đối soát", "bg-success-subtle text-success-emphasis border-success-subtle")
                    : SoftBadge("Đã giao / Chưa đối soát", "bg-warning-subtle text-warning-emphasis border-warning-subtle");
            case "Canceled": return SoftBadge("Đã hủy", "bg-danger-subtle text-danger-emphasis border-danger-subtle");
            default: return SoftBadge(o.Status ?? "", "bg-body-tertiary text-secondary border-secondary-subtle");
        }
    };
}

@Html.AntiForgeryToken()

<style>
    :root {
        --primary-blue: #1e40af;
        --primary-blue-light: #3b82f6;
        --primary-blue-dark: #1e3a8a;
        --accent-blue: #0ea5e9;
        --bg-blue-light: #eff6ff;
        --bg-blue-lighter: #dbeafe;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -1000px 0
        }

        100% {
            background-position: 1000px 0
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-10px)
        }
    }

    .card-glass {
        border: 1px solid var(--ff-border);
        animation: fadeInUp .6s ease-out;
    }

    .grad-header {
        animation: fadeInUp .5s ease-out;
        position: relative;
        overflow: hidden;
    }

        .grad-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
            animation: rotate 25s linear infinite;
        }

        .grad-header::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }

    @@keyframes rotate {
        from {
            transform: rotate(0)
        }

        to {
            transform: rotate(360deg)
        }
    }

    .icon-gradient {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        box-shadow: 0 10px 30px rgba(30, 64, 175, 0.5);
    }

    .table-modern {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-modern thead th {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-bottom: 3px solid #3b82f6;
            font-weight: 600;
            color: #1e3a8a;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .5px;
            padding: 1.25rem 1rem;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            .table-modern thead th a {
                color: #1e3a8a;
                transition: all .3s ease;
            }

                .table-modern thead th a:hover {
                    color: #1e40af;
                    text-shadow: 0 2px 8px rgba(30, 64, 175, 0.3);
                }

        .table-modern tbody tr {
            transition: all .3s cubic-bezier(.4,0,.2,1);
            animation: slideIn .4s ease-out backwards;
            border-bottom: 1px solid #e5e7eb;
        }

            .table-modern tbody tr:hover {
                background: linear-gradient(90deg, rgba(59, 130, 246, 0.08) 0%, rgba(147, 197, 253, 0.08) 100%);
                transform: translateY(-2px);
                box-shadow: -5px 0 0 0 #3b82f6;
            }

        .table-modern tbody td {
            padding: 1.25rem 1rem;
            vertical-align: middle;
        }

            .table-modern tbody td:nth-child(6) {
                max-width: 200px;
            }

    .btn-pill {
        border-radius: 2rem;
        padding: .75rem 2rem;
        font-weight: 600;
        transition: all .3s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
        border: none;
    }

        .btn-pill:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(0,0,0,.2);
        }

    .btn-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
        }

    .btn-primary {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        }

    .form-select, .form-control {
        border: 2px solid #bfdbfe;
        border-radius: 1rem;
        padding: .875rem 1.25rem;
        transition: all .3s ease;
        background: #fff;
    }

        .form-select:focus, .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 5px rgba(59, 130, 246, 0.15);
            background: #fff;
        }

    .filter-card {
        border: 1px solid var(--ff-border);
        animation: fadeInUp .6s ease-out .1s backwards;
    }

    .order-code {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
        font-size: .9375rem;
    }

    .btn-action {
        width: 38px;
        height: 38px;
        border-radius: .875rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .3s ease;
        border: 2px solid;
    }

        .btn-action:hover {
            transform: scale(1.1);
        }

    .page-link {
        border-radius: .875rem;
        margin: 0 .375rem;
        border: 2px solid #bfdbfe;
        color: #1e40af;
        transition: all .3s ease;
        font-weight: 600;
    }

        .page-link:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
            color: #fff;
            border-color: #3b82f6;
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
        }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-color: #1e40af;
    }

    .alert {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .search-icon-wrapper {
        position: relative;
    }

        .search-icon-wrapper i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #60a5fa;
            font-size: 1.125rem;
        }

        .search-icon-wrapper input {
            padding-left: 3.25rem;
        }

    .hover-scale {
        transition: transform .3s ease;
    }

        .hover-scale:hover {
            transform: scale(1.05);
        }

    .modal-content {
        border-radius: 1.5rem;
        border: none;
        box-shadow: 0 25px 60px rgba(30, 64, 175, 0.3);
    }

    .modal-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        color: white;
        border-radius: 1.5rem 1.5rem 0 0;
        padding: 1.5rem 2rem;
    }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

    .badge {
        font-weight: 600;
        padding: .5rem 1rem;
    }

    .text-primary-blue {
        color: #1e40af !important;
    }

    .bg-primary-blue {
        background-color: #1e40af !important;
    }

    @@media (max-width:768px) {
        .grad-header {
            padding: 2rem 1.5rem !important;
        }

        .table-modern {
            font-size: .875rem;
        }

        .btn-pill {
            padding: .625rem 1.5rem;
        }
    }
</style>

<div class="min-vh-100 ff-admin-shell">
    <div class="container-fluid py-4">

        <div class="grad-header ff-admin-hero p-4 p-md-5 mb-4 position-relative">
            <div class="position-relative" style="z-index: 1;">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="p-3 rounded-4 icon-gradient">
                                <i class="bi bi-truck text-white" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h1 class="fw-bold mb-1 text-white" style="font-size: 2.5rem; text-shadow: 0 4px 12px rgba(0,0,0,0.3);">Quản Lý Vận Chuyển</h1>
                                <p class="mb-0 text-white opacity-90" style="font-size: 1.125rem; text-shadow: 0 2px 8px rgba(0,0,0,0.2);">Theo dõi và quản lý đơn hàng vận chuyển hiệu quả</p>
                            </div>
                        </div>
                    </div>
                    @*<button type="button" class="btn btn-success btn-pill shadow-lg d-flex align-items-center gap-2 hover-scale" id="btnAddNew" data-bs-toggle="modal" data-bs-target="#addShippingModal" style="font-size: 1.125rem; white-space: nowrap;">
                        <i class="bi bi-plus-circle" style="font-size: 1.5rem;"></i>
                        <span>Thêm vận chuyển</span>
                    </button>*@
                </div>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card ff-admin-card p-4 mb-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-3 rounded-3" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
                    <i class="bi bi-funnel text-white" style="font-size: 1.25rem;"></i>
                </div>
                <h5 class="mb-0 fw-bold text-primary-blue">Bộ lọc tìm kiếm</h5>
            </div>
            <form method="get" class="row g-4" id="filterForm">
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="sort" value="@ViewBag.CurrentSort" />

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-list-check me-2"></i> Trạng thái đơn hàng</label>
                    <select name="status" id="status" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(currentStatus)  ? "selected" : null)">Tất cả trạng thái</option>
                        <option value="Pending" selected="@(currentStatus == "Pending"  ? "selected" : null)">⏳ Chờ xử lý</option>
                        <option value="Processing" selected="@(currentStatus == "Processing"  ? "selected" : null)">⚙️ Đang xử lý</option>
                        <option value="Shipped" selected="@(currentStatus == "Shipped"  ? "selected" : null)">🚚 Đang giao hàng</option>
                        <option value="Delivered" selected="@(currentStatus == "Delivered"  ? "selected" : null)">✅ Đã giao hàng</option>
                        <option value="Canceled" selected="@(currentStatus == "Canceled"  ? "selected" : null)">❌ Đã hủy</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3" id="deliveredStateWrap" style="display:@(currentStatus == "Delivered" ? "block" : "none")">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-check2-square me-2"></i> Tình trạng đối soát</label>
                    <select name="deliveredState" id="deliveredState" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(deliveredState)  ? "selected" : null)">Tất cả</option>
                        <option value="pending" selected="@(deliveredState == "pending"  ? "selected" : null)">⏰ Chưa đối soát</option>
                        <option value="done" selected="@(deliveredState == "done"  ? "selected" : null)">✓ Đã đối soát</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-person-badge me-2"></i> Nhân viên giao hàng</label>
                    @Html.DropDownList(
                        "staffId",
                        new SelectList(staffsSrc, "Value", "Text", selectedStaff),
                        "Tất cả nhân viên",
                        new { @class = "form-select" })
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-search me-2"></i> Tìm kiếm</label>
                    <div class="search-icon-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control" name="q" value="@ViewBag.CurrentQuery" placeholder="Mã đơn, người nhận, SĐT..." />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-grid-3x3 me-2"></i> Số dòng/trang</label>
                    <select name="pageSize" class="form-select">
                        <option value="10" selected="@(pageSize == 10  ? "selected" : null)">10 dòng</option>
                        <option value="20" selected="@(pageSize == 20  ? "selected" : null)">20 dòng</option>
                        <option value="50" selected="@(pageSize == 50  ? "selected" : null)">50 dòng</option>
                    </select>
                </div>

                <div class="col-12 col-lg-3 ms-auto d-grid d-lg-flex justify-content-lg-end align-items-end">
                    <button type="submit" class="btn btn-primary btn-pill px-5 d-flex align-items-center justify-content-center gap-2 hover-scale">
                        <i class="bi bi-funnel-fill"></i>
                        <span>Áp dụng</span>
                    </button>
                </div>
            </form>
        </div>

        <div class="card-glass ff-admin-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern">
                    <thead>
                        <tr>
                            <th class="px-4">#</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "code_asc" ? "code_desc" : "code_asc") })">
                                    <i class="bi bi-box-seam"></i> Mã đơn hàng
                                </a>
                            </th>
                            <th class="px-4"><i class="bi bi-person-badge me-1"></i> NV giao hàng</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "receiver_asc" ? "receiver_desc" : "receiver_asc") })">
                                    <i class="bi bi-person"></i> Người nhận
                                </a>
                            </th>
                            <th class="px-4"><i class="bi bi-telephone me-1"></i> SĐT</th>
                            <th class="px-4"><i class="bi bi-geo-alt me-1"></i> Địa chỉ</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "status_asc" ? "status_desc" : "status_asc") })">
                                    <i class="bi bi-info-circle"></i> Trạng thái
                                </a>
                            </th>
                            <th class="text-center px-4"><i class="bi bi-gear me-1"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var list = Model?.ToList() ?? new List<FreshFarm.Web.Bff.Areas.Seller.Models.Shipping>();
                            if (list.Any())
                            {
                                var startIndex = (currentPage - 1) * pageSize + 1;
                                var i = 0;
                                foreach (var item in list)
                                {
                                    <tr data-has-assign="@((item.Order != null && item.Order.DeliveryAssignments != null
                                                            && item.Order.DeliveryAssignments.Any(da => da.IsActive && da.AssignedToAdminID.HasValue))
                                                            .ToString().ToLower())"
                                        data-order-status="@((item.Order?.Status ?? "").ToLower())">
                                        <td class="px-4"><span class="badge bg-primary-blue text-white border">@(startIndex + i)</span></td>
                                        <td class="px-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-box-seam text-primary" style="font-size: 1.25rem;"></i>
                                                <span class="order-code">@("#DH" + item.OrderID.ToString().PadLeft(5, '0'))</span>
                                            </div>
                                        </td>
                                        <td class="px-4">
                                            @{
                                                var activeAssign = (item.Order != null && item.Order.DeliveryAssignments != null)
                                                    ? item.Order.DeliveryAssignments.Where(da => da.IsActive && da.AssignedToAdminID.HasValue)
                                                        .OrderByDescending(da => da.UpdatedAt ?? da.CreatedAt)
                                                        .FirstOrDefault()
                                                    : null;
                                                var staffName = activeAssign != null
                                                    ? (!string.IsNullOrWhiteSpace(activeAssign.UserAdmin?.FullName)
                                                        ? activeAssign.UserAdmin.FullName
                                                        : ("NV #" + activeAssign.AssignedToAdminID.Value.ToString("D4")))
                                                    : "Chưa phân công";
                                            }
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 rounded-3" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                                    <i class="bi bi-person text-primary"></i>
                                                </div>
                                                <span class="fw-medium">@staffName</span>
                                            </div>
                                        </td>
                                        <td class="px-4"><span class="fw-semibold text-primary-blue">@item.FullName</span></td>
                                        <td class="px-4"><div class="d-flex align-items-center gap-2"><i class="bi bi-telephone-fill text-success"></i><span class="font-monospace">@item.Phone</span></div></td>
                                        <td class="px-4">
                                            @if (item.IsStorePickup)
                                            {
                                                <div class="d-flex flex-column gap-1">
                                                    <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-shop me-1"></i> Nhận tại cửa hàng</span>
                                                    <small class="text-muted">@item.StoreAddress</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-start gap-2">
                                                    <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                                    <div class="text-truncate" style="max-width:340px">
                                                        <span class="fw-medium">@item.AddressDetail</span>
                                                        @if (item.Commune != null)
                                                        {<text>, @item.Commune.CommuneName</text>}
                                                        @if (item.Province != null)
                                                        {<text>, @item.Province.ProvinceName</text>}
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                        <td class="px-4">@RenderStatus(item.Order)</td>
                                        <td class="text-center px-4">
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-sm btn-outline-primary btn-action btn-edit" data-id="@item.ShippingID" data-bs-toggle="modal" data-bs-target="#editShippingModal" title="Sửa"><i class="bi bi-pencil-square"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-action btn-delete" data-id="@item.ShippingID" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Xóa"><i class="bi bi-trash3"></i></button>
                                                @{ var cod = item.Order?.Payments?.FirstOrDefault(p => p.PaymentMethod == "COD"); bool codDone = cod == null ? true : (cod.PaymentDate.HasValue || (!string.IsNullOrWhiteSpace(cod.PaymentStatus) && paidStatuses.Any(s => string.Equals(s, cod.PaymentStatus, System.StringComparison.OrdinalIgnoreCase)))); }
                                                @if (item.Order?.Status == "Delivered" && !codDone)
                                                {<button type="button" class="btn btn-sm btn-outline-success btn-action btn-reconcile" data-orderid="@item.OrderID" title="Đánh dấu ĐÃ đối soát COD"><i class="bi bi-check2-circle"></i></button>}
                                                @if (item.Order?.Status == "Delivered" && codDone)
                                                {<button type="button" class="btn btn-sm btn-outline-secondary btn-action btn-unreconcile" data-orderid="@item.OrderID" title="Bỏ đối soát COD"><i class="bi bi-arrow-counterclockwise"></i></button>}
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center gap-3">
                                            <div class="p-4 rounded-circle" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                                <i class="bi bi-inbox" style="font-size: 3rem; color: #3b82f6;"></i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold mb-1 text-primary-blue">Chưa có dữ liệu</h5>
                                                <p class="text-muted mb-0">Chưa có thông tin vận chuyển nào được tìm thấy.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between px-4 py-4 border-top" style="background: linear-gradient(90deg, #f0f9ff 0%, #dbeafe 100%);">
                    <div class="text-muted mb-3 mb-md-0">
                        <i class="bi bi-journals me-2 text-primary"></i>
                        Trang <span class="fw-bold text-primary-blue">@currentPage</span> / <span class="fw-bold text-primary-blue">@totalPages</span>
                        <span class="mx-2">•</span>
                        Tổng <span class="fw-bold text-primary-blue">@totalItems</span> mục
                    </div>
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = currentPage - 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @{ int start = Math.Max(1, currentPage - 2); int end = Math.Min(totalPages, currentPage + 2); }
                        @for (int p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = p, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Admin", page = currentPage + 1, status = currentStatus, deliveredState = deliveredState, staffId = ViewBag.CurrentStaffId, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

