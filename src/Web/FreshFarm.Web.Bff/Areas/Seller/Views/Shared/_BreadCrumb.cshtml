@{
    string parentTitle = ViewBag.BreadcrumbParentTitle ?? "Trang chính";
    string parentUrl = ViewBag.BreadcrumbParentUrl ?? "#";
    string currentTitle = ViewBag.BreadcrumbCurrentTitle ?? "Trang hiện tại";
}

<nav style="--bs-breadcrumb-divider: '>'" aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@parentUrl">@parentTitle</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            @currentTitle
        </li>
    </ol>
</nav>
