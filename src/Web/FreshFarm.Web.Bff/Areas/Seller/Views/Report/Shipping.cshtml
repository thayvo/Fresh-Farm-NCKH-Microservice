@model FreshFarm.Web.Bff.Areas.Seller.Models.ShippingReportViewModel
@using System.Linq
@{
    ViewBag.Title = "Báo Cáo Vận Chuyển";
    Layout = (string?)ViewData["LayoutPath"] ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    var staffOptions = ViewBag.DeliveryStaffs as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<style>
    :root {
        --primary-blue: #1e40af;
        --primary-blue-light: #3b82f6;
        --primary-blue-dark: #1e3a8a;
        --accent-blue: #0ea5e9;
        --bg-blue-light: #eff6ff;
        --bg-blue-lighter: #dbeafe;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -1000px 0
        }

        100% {
            background-position: 1000px 0
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-10px)
        }
    }

    @@keyframes rotate {
        from {
            transform: rotate(0)
        }

        to {
            transform: rotate(360deg)
        }
    }

    body {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 50%, #bfdbfe 100%);
        min-height: 100vh;
    }

    .card-glass {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(30, 64, 175, 0.1);
        box-shadow: 0 20px 60px rgba(30, 64, 175, 0.15);
        border-radius: 1.5rem;
        animation: fadeInUp .6s ease-out;
    }

    .grad-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #60a5fa 100%);
        border-radius: 1.5rem;
        box-shadow: 0 20px 50px rgba(30, 64, 175, 0.4);
        animation: fadeInUp .5s ease-out;
        position: relative;
        overflow: hidden;
    }

        .grad-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
            animation: rotate 25s linear infinite;
        }

        .grad-header::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }

    .icon-gradient {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        box-shadow: 0 10px 30px rgba(30, 64, 175, 0.5);
        border-radius: 1.25rem;
    }

    .filter-card {
        background: linear-gradient(135deg, #fff 0%, #f0f9ff 100%);
        border: 2px solid #bfdbfe;
        border-radius: 1.5rem;
        box-shadow: 0 15px 40px rgba(30, 64, 175, 0.1);
        animation: fadeInUp .6s ease-out .1s backwards;
    }

    .form-select, .form-control {
        border: 2px solid #bfdbfe;
        border-radius: 1rem;
        padding: .875rem 1.25rem;
        transition: all .3s ease;
        background: #fff;
    }

        .form-select:focus, .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 5px rgba(59, 130, 246, 0.15);
            background: #fff;
        }

    .btn-pill {
        border-radius: 2rem;
        padding: .75rem 2rem;
        font-weight: 600;
        transition: all .3s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
        border: none;
    }

        .btn-pill:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(0,0,0,.2);
        }

    .btn-primary {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        }

    .btn-outline-success {
        border-radius: 999px;
        border-width: 2px;
    }

    .stat-card {
        border: none;
        border-radius: 1.5rem;
        background: linear-gradient(135deg, #ffffff 0%, #e0f2fe 100%);
        box-shadow: 0 15px 40px rgba(15, 23, 42, 0.12);
        animation: fadeInUp .6s ease-out .1s backwards;
    }

        .stat-card .icon-wrapper {
            width: 56px;
            height: 56px;
            border-radius: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            box-shadow: 0 12px 30px rgba(37, 99, 235, 0.5);
            color: #fff;
            margin-left: 3%;
        }

    .table-modern {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-modern thead th {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-bottom: 3px solid #3b82f6;
            font-weight: 600;
            color: #1e3a8a;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .5px;
            padding: 1.1rem .9rem;
        }

            .table-modern thead th a {
                color: #1e3a8a;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: .25rem;
                transition: all .3s ease;
            }

                .table-modern thead th a:hover {
                    color: #1e40af;
                    text-shadow: 0 2px 8px rgba(30, 64, 175, 0.3);
                }

        .table-modern tbody tr {
            transition: all .3s cubic-bezier(.4,0,.2,1);
            animation: slideIn .4s ease-out backwards;
            border-bottom: 1px solid #e5e7eb;
        }

            .table-modern tbody tr:hover {
                background: linear-gradient(90deg, rgba(59, 130, 246, 0.06) 0%, rgba(147, 197, 253, 0.06) 100%);
                transform: translateY(-2px);
                box-shadow: -5px 0 0 0 #3b82f6;
            }

        .table-modern tbody td {
            padding: 1rem .9rem;
            vertical-align: middle;
        }

    .page-link {
        border-radius: .875rem;
        margin: 0 .375rem;
        border: 2px solid #bfdbfe;
        color: #1e40af;
        transition: all .3s ease;
        font-weight: 600;
    }

        .page-link:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
            color: #fff;
            border-color: #3b82f6;
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
        }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-color: #1e40af;
        color: #fff;
    }

    .alert {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .text-primary-blue {
        color: #1e40af !important;
    }

    .search-icon-wrapper {
        position: relative;
    }

        .search-icon-wrapper i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #60a5fa;
            font-size: 1.125rem;
        }

        .search-icon-wrapper input {
            padding-left: 3.25rem;
        }

    .hover-scale {
        transition: transform .3s ease;
    }

        .hover-scale:hover {
            transform: scale(1.05);
        }

    .card-header-soft {
        border-bottom: 1px solid #e5e7eb;
        background: linear-gradient(90deg, #eff6ff 0%, #e0f2fe 100%);
        border-radius: 1.5rem 1.5rem 0 0 !important;
    }

    @@media (max-width: 768px) {
        .grad-header {
            padding: 2rem 1.5rem !important;
        }

        .table-modern {
            font-size: .875rem;
        }

        .btn-pill {
            padding: .625rem 1.5rem;
        }
    }
</style>

<main class="min-vh-100">
    <div class="container-fluid py-4">

        <!-- HEADER -->
        <div class="grad-header p-4 p-md-5 mb-4 position-relative">
            <div class="position-relative" style="z-index:1;">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="p-3 icon-gradient d-flex align-items-center justify-content-center">
                                <i class="bi bi-truck text-white" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h1 class="fw-bold mb-1 text-white" style="font-size:2.2rem;text-shadow:0 4px 12px rgba(0,0,0,.3);">
                                    Báo Cáo Vận Chuyển
                                </h1>
                                <p class="mb-0 text-white opacity-90" style="font-size:1.05rem;text-shadow:0 2px 8px rgba(0,0,0,.2);">
                                    Tổng quan hiệu suất giao hàng, chi phí và tỉ lệ chuyển hoàn theo thời gian.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-sm-row align-items-stretch gap-2">
                        <a href="@Url.Action("ExportShippingExcel", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query })"
                           class="btn btn-success btn-pill d-flex align-items-center justify-content-center gap-2 hover-scale">
                            <i class="bi bi-file-earmark-excel"></i>
                            <span>Xuất Excel</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @ViewBag.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- FILTER -->
        <div class="filter-card p-4 mb-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-3 rounded-3" style="background: linear-gradient(135deg,#1e40af 0%,#3b82f6 100%);">
                    <i class="bi bi-funnel text-white" style="font-size:1.25rem;"></i>
                </div>
                <h5 class="mb-0 fw-bold text-primary-blue">Bộ lọc báo cáo vận chuyển</h5>
            </div>

            <form method="get" action="@Url.Action("Shipping", "Report")">
                <div class="row g-4 align-items-end">
                    <div class="col-md-4 col-lg-3">
                        <label for="fromDate" class="form-label fw-semibold text-primary-blue">
                            <i class="bi bi-calendar-date me-1"></i> Từ ngày
                        </label>
                        <input type="date" id="fromDate" name="fromDate" class="form-control"
                               value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4 col-lg-3">
                        <label for="toDate" class="form-label fw-semibold text-primary-blue">
                            <i class="bi bi-calendar-date-fill me-1"></i> Đến ngày
                        </label>
                        <input type="date" id="toDate" name="toDate" class="form-control"
                               value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4 col-lg-3">
                        <label for="staffId" class="form-label fw-semibold text-primary-blue">
                            <i class="bi bi-person-badge me-1"></i> Nhân viên giao hàng
                        </label>
                        <select id="staffId" name="staffId" class="form-select">
                            <option value="" selected="@(Model.SelectedStaffId.HasValue  ? null : "selected")">Tất cả nhân viên</option>
                            @foreach (var staff in staffOptions)
                            {
                                var isSelected = Model.SelectedStaffId.HasValue && staff.Value == Model.SelectedStaffId.Value.ToString();
                                <option value="@staff.Value" selected="@(isSelected  ? "selected" : null)">@staff.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 col-lg-3">
                        <label for="status" class="form-label fw-semibold text-primary-blue">
                            <i class="bi bi-sliders me-1"></i> Trạng thái
                        </label>
                        <select id="status" name="status" class="form-select">
                            @{ var st = string.IsNullOrWhiteSpace(Model.Status) ? "all" : Model.Status.ToLower(); }
                            <option value="all" selected="@(st == "all"  ? "selected" : null)">Tất cả</option>
                            <option value="pending" selected="@(st == "pending"  ? "selected" : null)">Chờ xử lý</option>
                            <option value="processing" selected="@(st == "processing"  ? "selected" : null)">Đang xử lý</option>
                            <option value="ready" selected="@(st == "ready"  ? "selected" : null)">Sẵn sàng giao</option>
                            <option value="shipped" selected="@(st == "shipped"  ? "selected" : null)">Đang vận chuyển</option>
                            <option value="delivered" selected="@(st == "delivered" || st == "completed"  ? "selected" : null)">Đã giao hàng</option>
                            <option value="canceled" selected="@(st == "canceled" || st == "cancelled"  ? "selected" : null)">Đã hủy / Chuyển hoàn</option>
                        </select>
                    </div>
                    <div class="col-md-8 col-lg-6">
                        <label for="q" class="form-label fw-semibold text-primary-blue">
                            <i class="bi bi-search me-1"></i> Tìm kiếm
                        </label>
                        <div class="search-icon-wrapper">
                            <i class="bi bi-search"></i>
                            <input type="text" id="q" name="q" class="form-control" value="@Model.Query"
                                   placeholder="Mã đơn, tên khách, số điện thoại, địa chỉ" />
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-3 ms-auto">
                        <button type="submit"
                                class="btn btn-primary btn-pill w-100 d-flex align-items-center justify-content-center gap-2 hover-scale">
                            <i class="bi bi-funnel-fill"></i>
                            <span>Lọc dữ liệu</span>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="page" value="@Model.CurrentPage" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
            </form>
        </div>

        <!-- STATS -->
        <div class="row g-4 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-wrapper">
                                <i class="bi bi-truck fs-3"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="text-muted text-uppercase mb-1">Đơn Đã Giao</h6>
                                <h3 class="fw-bold mb-0 text-primary-blue">@Model.DeliveredOrders.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-wrapper" style="background:linear-gradient(135deg,#16a34a 0%,#22c55e 100%);box-shadow:0 12px 30px rgba(34,197,94,.5);">
                                <i class="bi bi-cash-coin fs-3"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="text-muted text-uppercase mb-1">Tổng Phí Vận Chuyển</h6>
                                <h3 class="fw-bold mb-0 text-success">@Model.TotalShippingFee.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-wrapper" style="background:linear-gradient(135deg,#0ea5e9 0%,#38bdf8 100%);box-shadow:0 12px 30px rgba(14,165,233,.5);">
                                <i class="bi bi-clock-history fs-3"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="text-muted text-uppercase mb-1">Thời Gian Giao TB</h6>
                                <h3 class="fw-bold mb-0">@Model.AverageDeliveryTime.ToString("F1") ngày</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-wrapper" style="background:linear-gradient(135deg,#f97316 0%,#ef4444 100%);box-shadow:0 12px 30px rgba(239,68,68,.5);">
                                <i class="bi bi-box-arrow-in-left fs-3"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="text-muted text-uppercase mb-1">Tỉ Lệ Chuyển Hoàn</h6>
                                <h3 class="fw-bold mb-0">@Model.ReturnRate.ToString("F1")%</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHARTS -->
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="card-glass h-100">
                    <div class="card-header card-header-soft d-flex align-items-center justify-content-between">
                        <h5 class="fw-bold mb-0 text-primary-blue">
                            <i class="bi bi-bar-chart-fill me-2"></i> Hiệu suất nhân viên giao hàng
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="staffPerformanceChart" style="height: 300px;"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card-glass h-100">
                    <div class="card-header card-header-soft d-flex align-items-center justify-content-between">
                        <h5 class="fw-bold mb-0 text-primary-blue">
                            <i class="bi bi-distribute-vertical me-2"></i> Phân bố thời gian giao hàng
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="deliveryTimeDistributionChart" style="height: 300px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLE -->
        <div class="card-glass">
            <div class="card-header card-header-soft d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary-blue">
                    <i class="bi bi-table me-2"></i> Lịch sử giao hàng
                </h5>
                <a href="@Url.Action("ExportShippingExcel", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query })"
                   class="btn btn-outline-success btn-sm d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern">
                    <thead>
                        <tr>
                            <th>
                                <a href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = (Model.Sort == "code_asc" ? "code_desc" : "code_asc"), page = 1, pageSize = Model.PageSize })">
                                    <i class="bi bi-box-seam"></i> Mã đơn hàng
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = (Model.Sort == "customer_asc" ? "customer_desc" : "customer_asc"), page = 1, pageSize = Model.PageSize })">
                                    <i class="bi bi-person"></i> Khách hàng
                                </a>
                            </th>
                            <th><i class="bi bi-telephone"></i> SĐT</th>
                            <th>
                                <a href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = (Model.Sort == "staff_asc" ? "staff_desc" : "staff_asc"), page = 1, pageSize = Model.PageSize })">
                                    <i class="bi bi-person-badge"></i> Nhân viên giao
                                </a>
                            </th>
                            <th><i class="bi bi-geo-alt"></i> Địa chỉ giao hàng</th>
                            <th>
                                <a href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = (Model.Sort == "date_asc" ? "date_desc" : "date_asc"), page = 1, pageSize = Model.PageSize })">
                                    <i class="bi bi-calendar"></i> Ngày đặt
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = (Model.Sort == "expected_asc" ? "expected_desc" : "expected_asc"), page = 1, pageSize = Model.PageSize })">
                                    <i class="bi bi-calendar-event"></i> Ngày dự kiến
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = (Model.Sort == "status_asc" ? "status_desc" : "status_asc"), page = 1, pageSize = Model.PageSize })">
                                    <i class="bi bi-info-circle"></i> Trạng thái
                                </a>
                            </th>
                            <th><i class="bi bi-stopwatch"></i> Thời gian giao</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentShippings != null && Model.RecentShippings.Any())
                        {
                            foreach (var item in Model.RecentShippings)
                            {
                                <tr>
                                    <td class="fw-semibold text-primary-blue">@item.OrderCode</td>
                                    <td>@item.CustomerName</td>
                                    <td><span class="font-monospace">@item.CustomerPhone</span></td>
                                    <td>@item.DeliveryStaffName</td>
                                    <td>@item.DeliveryAddress</td>
                                    <td>@item.ShippingDateFormatted</td>
                                    <td>@item.ExpectedDeliveryDateFormatted</td>
                                    <td>
                                        <span class="badge @item.StatusBadgeClass">@item.StatusText</span>
                                    </td>
                                    <td>
                                        @if (item.ActualDeliveryDays.HasValue)
                                        {
                                            @item.ActualDeliveryDays.Value @: ngày
                                        }
                                        else
                                        {
                                            @:Đang giao
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4">
                                    <div class="d-flex flex-column align-items-center gap-3">
                                        <div class="p-4 rounded-circle" style="background: linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%);">
                                            <i class="bi bi-inbox" style="font-size:2.5rem;color:#3b82f6;"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-primary-blue">Không có dữ liệu</h5>
                                            <p class="text-muted mb-0">Không tìm thấy lịch sử giao hàng theo điều kiện lọc hiện tại.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
                var current = Model.CurrentPage <= 0 ? 1 : Model.CurrentPage;
                var start = Math.Max(1, current - 3);
                var end = Math.Min(totalPages, current + 3);
            }
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 px-4 py-3"
                 style="background: linear-gradient(90deg,#f0f9ff 0%,#dbeafe 100%);border-top:1px solid #e5e7eb;">
                <small class="text-muted">
                    <i class="bi bi-journals me-1 text-primary-blue"></i>
                    Trang <span class="fw-bold text-primary-blue">@current</span> / <span class="fw-bold text-primary-blue">@totalPages</span>
                    <span class="mx-2">•</span>
                    Tổng <span class="fw-bold text-primary-blue">@Model.TotalRecords</span> kết quả
                </small>
                <nav aria-label="Shipping pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(current == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = Model.Sort, page = current - 1, pageSize = Model.PageSize })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = start; i <= end; i++)
                        {
                            <li class="page-item @(i == current ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = Model.Sort, page = i, pageSize = Model.PageSize })">@i</a>
                            </li>
                        }
                        <li class="page-item @(current >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Shipping", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, staffId = Model.SelectedStaffId, status = Model.Status, q = Model.Query, sort = Model.Sort, page = current + 1, pageSize = Model.PageSize })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var staffNames = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.StaffPerformances.Select(s => s.StaffName)));
        var staffOrders = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.StaffPerformances.Select(s => s.TotalOrders)));
        var staffSuccessRates = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.StaffPerformances.Select(s => s.SuccessRate)));

        var timeRanges = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DeliveryTimeDistributions.Select(d => d.TimeRange)));
        var timeRangeCounts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DeliveryTimeDistributions.Select(d => d.OrderCount)));

        const staffPerformanceCtx = document.getElementById("staffPerformanceChart");
        if (staffPerformanceCtx) {
          new Chart(staffPerformanceCtx, {
            type: "bar",
            data: {
              labels: staffNames,
              datasets: [
                {
                  label: "Số lượng đơn",
                  data: staffOrders,
                  backgroundColor: "rgba(37, 99, 235, 0.8)",
                  borderRadius: 5,
                },
                {
                  label: "Tỉ lệ giao thành công (%)",
                  data: staffSuccessRates,
                  backgroundColor: "rgba(16, 185, 129, 0.8)",
                  borderRadius: 5,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: { beginAtZero: true }
              },
              plugins: {
                tooltip: {
                  callbacks: {
                    label: function (context) {
                      if (context.datasetIndex === 1) {
                        return context.dataset.label + ": " + context.parsed.y.toFixed(2) + "%";
                      }
                      return context.dataset.label + ": " + context.parsed.y;
                    }
                  }
                }
              }
            },
          });
        }

        const deliveryTimeCtx = document.getElementById("deliveryTimeDistributionChart");
        if (deliveryTimeCtx) {
          new Chart(deliveryTimeCtx, {
            type: "bar",
            data: {
              labels: timeRanges,
              datasets: [
                {
                  label: "Số lượng đơn",
                  data: timeRangeCounts,
                  backgroundColor: [
                    "rgba(34, 197, 94, 0.85)",
                    "rgba(59, 130, 246, 0.85)",
                    "rgba(234, 179, 8, 0.85)",
                    "rgba(239, 68, 68, 0.85)",
                  ],
                  borderRadius: 5,
                },
              ],
            },
            options: {
              indexAxis: "y",
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false } },
            },
          });
        }
      });
    </script>
}
