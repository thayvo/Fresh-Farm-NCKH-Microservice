@model FreshFram.Areas.Admin.Data.ReviewReportViewModel
@{
    ViewBag.Title = "Quản Lý Đánh Giá";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    Func<string, string> imgUrl = f => Url.Content("~/Images/" + (string.IsNullOrWhiteSpace(f) ? "no-image.png" : f));
}

<main class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Quản Lý Đánh Giá</h2>
        <a href="@Url.Action("ExportReviewExcel", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, starRating = Model.StarRating })"
           class="btn btn-success text-white">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Review", "Report", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-4 col-lg-3">
                    <label for="fromDate" class="form-label fw-semibold">Từ ngày</label>
                    @Html.TextBox("fromDate", Model.FromDate?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-4 col-lg-3">
                    <label for="toDate" class="form-label fw-semibold">Đến ngày</label>
                    @Html.TextBox("toDate", Model.ToDate?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-4 col-lg-3">
                    <label for="starRating" class="form-label fw-semibold">Xếp hạng</label>
                    @Html.DropDownList("starRating", new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Tất cả", Value = "all", Selected = Model.StarRating == "all" },
                        new SelectListItem { Text = "5 sao", Value = "5", Selected = Model.StarRating == "5" },
                        new SelectListItem { Text = "4 sao", Value = "4", Selected = Model.StarRating == "4" },
                        new SelectListItem { Text = "3 sao", Value = "3", Selected = Model.StarRating == "3" },
                        new SelectListItem { Text = "2 sao", Value = "2", Selected = Model.StarRating == "2" },
                        new SelectListItem { Text = "1 sao", Value = "1", Selected = Model.StarRating == "1" }
                    }, new { @class = "form-select" })
                </div>
                <div class="col-md-12 col-lg-3">
                    <button type="submit" class="btn w-100 text-white" style="background-color: #6f42c1">
                        <i class="bi bi-funnel-fill"></i> Lọc dữ liệu
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Thống kê tổng quan -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card h-100" style="border-color: #6f42c1">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-chat-quote-fill fs-1 opacity-75" style="color: #6f42c1"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">Tổng Đánh Giá</h6>
                            <h3 class="fw-bold">@Model.TotalReviews.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card border-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-star-half fs-1 text-warning opacity-75"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">Xếp Hạng Trung Bình</h6>
                            <h3 class="fw-bold d-flex align-items-center">
                                @Model.AverageRating.ToString("F1")
                                <i class="bi bi-star-fill text-warning ms-1"></i>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card border-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-hand-thumbs-up-fill fs-1 text-success opacity-75"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">Đánh Giá Tích Cực</h6>
                            <h3 class="fw-bold">@Model.PositiveReviews.ToString("N0") (@Model.PositivePercentage.ToString("F1")%)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card border-danger h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-hand-thumbs-down-fill fs-1 text-danger opacity-75"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">Đánh Giá Tiêu Cực</h6>
                            <h3 class="fw-bold">@Model.NegativeReviews.ToString("N0") (@Model.NegativePercentage.ToString("F1")%)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ và chủ đề -->
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-bar-chart-fill"></i> Phân bổ xếp hạng sao
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="ratingDistributionChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-tags-fill"></i> Chủ đề được nhắc đến nhiều
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.TopMentionedTopics.Any())
                    {
                        foreach (var topic in Model.TopMentionedTopics)
                        {
                            var badgeClass = "";
                            if (topic.Contains("tốt") || topic.Contains("ngon") || topic.Contains("nhanh") || topic.Contains("tươi") || topic.Contains("ủng hộ") || topic.Contains("đúng"))
                            { badgeClass = "bg-success"; }
                            else if (topic.Contains("chậm") || topic.Contains("nhỏ"))
                            { badgeClass = "bg-warning text-dark"; }
                            else { badgeClass = "bg-primary"; }

                            <span class="badge fs-6 @badgeClass m-1">@topic</span>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Chưa có dữ liệu</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng đánh giá: Chỉ còn nút XÓA -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0">
                <i class="bi bi-table"></i> Các đánh giá gần đây
            </h5>
            <a href="@Url.Action("ExportReviewExcel", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, starRating = Model.StarRating })"
               class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> Xuất Excel
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Khách hàng</th>
                        <th>Sản phẩm</th>
                        <th>Ảnh</th>
                        <th class="text-center">Xếp hạng</th>
                        <th>Nội dung</th>
                        <th>Ngày</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentReviews.Any())
                    {
                        foreach (var review in Model.RecentReviews)
                        {
                            var img = imgUrl(review.ProductImageFileName);
                            <tr id="review-row-@review.ReviewID">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@Url.Action("AvatarById","Account", new { area = "", id = (review.UserID ?? 0) })"
                                             alt="avatar" class="rounded-circle me-2"
                                             style="width:36px;height:36px;object-fit:cover" />
                                        <span>@review.CustomerName</span>
                                    </div>
                                </td>
                                <td>@review.ProductName</td>
                                <td>
                                    <img src="@img" alt="img"
                                         style="width:56px;height:56px;object-fit:cover;border-radius:8px" />
                                </td>
                                <td class="text-center text-warning">
                                    @Html.Raw(review.StarDisplay)
                                </td>
                                <td class="small">
                                    @(string.IsNullOrEmpty(review.Comment)
                ? "Không có bình luận"
                : (review.Comment.Length > 80 ? review.Comment.Substring(0, 80) + "..." : review.Comment))
                                </td>
                                <td>@review.CreatedAtFormatted</td>
                                <td class="text-center">
                                    <form class="d-inline delete-review-form" data-id="@review.ReviewID"
                                          onsubmit="return confirm('Xóa bình luận này? Hành động không thể hoàn tác.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không có đánh giá nào trong khoảng thời gian này
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.RecentReviews.Any())
        {
            <div class="card-footer">
                <div class="text-muted small">
                    Hiển thị @Model.RecentReviews.Count đánh giá gần nhất
                </div>
            </div>
        }

        @{ var page = (int)(ViewBag.Page ?? 1); var totalPages = (int)(ViewBag.TotalPages ?? 1); var pageSize = (int)(ViewBag.PageSize ?? 10); }
        @if (Model.RecentReviews.Any() && totalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                <div class="text-muted small">Trang @page/@totalPages · Tổng @((int)(ViewBag.Total ?? 0)) đánh giá</div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Review","Report", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), starRating = Model.StarRating, page = page - 1, pageSize = pageSize })">Trước</a>
                        </li>
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Review","Report", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), starRating = Model.StarRating, page = page + 1, pageSize = pageSize })">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var starLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StarDistributions.Select(s => s.Label)));
            var starData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StarDistributions.Select(s => s.Count)));

            const ctx = document.getElementById("ratingDistributionChart");
            if (ctx) {
                new Chart(ctx, {
                    type: "bar",
                    data: {
                        labels: starLabels,
                        datasets: [{
                            label: "Số lượng đánh giá",
                            data: starData,
                            backgroundColor: [
                                "rgba(25, 135, 84, 0.8)",
                                "rgba(13, 202, 240, 0.8)",
                                "rgba(255, 193, 7, 0.8)",
                                "rgba(255, 128, 0, 0.8)",
                                "rgba(220, 53, 69, 0.8)"
                            ],
                            borderRadius: 5
                        }]
                    },
                    options: {
                        indexAxis: "y",
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            }
        });
        $(document).ready(function () {
    $(".delete-review-form").submit(function (e) {
        e.preventDefault(); // chặn submit mặc định (ngăn reload / hiển thị JSON)

        var form = $(this);
        var id = form.data("id");
        var token = form.find('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("DeleteReview", "Report", new { area = "Seller" })', // hoặc "Review" nếu bạn đã chuyển action
            type: 'POST',
            data: {
                __RequestVerificationToken: token,
                id: id
            },
            success: function (res) {
                if (res.success) {
                    alert(res.message); // ✅ hiện thông báo đẹp
                    $("#review-row-" + id).fadeOut(300, function () {
                        $(this).remove();
                    });
                } else {
                    alert(res.message);
                }
            },
            error: function (xhr) {
                alert("Lỗi khi xóa bình luận: " + xhr.statusText);
            }
        });
    });
});
    </script>
}

<style>
    .stat-card {
        transition: transform .2s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    #ratingDistributionChart {
        height: 300px !important;
    }
</style>

