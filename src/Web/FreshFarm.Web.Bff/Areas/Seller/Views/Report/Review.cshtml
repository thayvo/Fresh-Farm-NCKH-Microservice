@model FreshFarm.Web.Bff.Areas.Seller.Models.ReviewReportViewModel
@{
    ViewBag.Title = "Quản Lý Đánh Giá";
    var currentArea = (string?)ViewData["AreaName"] ?? "Seller";
    Layout = (string?)ViewData["LayoutPath"] ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
Func<string?, string> imgUrl = f => ProductImagePaths.ResolveRequestPath(f);
}

<main class="container-fluid py-4 min-vh-100">
    <!-- HEADER GRADIENT + HIỆU ỨNG QUÉT ÁNH SÁNG -->
    <div class="grad-header p-4 p-md-5 mb-4 position-relative">
        <div class="position-relative" style="z-index:1;">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="p-3 rounded-4 icon-gradient d-flex align-items-center justify-content-center">
                            <i class="bi bi-star-half text-white" style="font-size:2.5rem;"></i>
                        </div>
                        <div>
                            <h1 class="fw-bold mb-1 text-white" style="font-size:2.3rem; text-shadow:0 4px 12px rgba(0,0,0,0.3);">
                                Quản Lý Đánh Giá
                            </h1>
                            <p class="mb-0 text-white opacity-90" style="font-size:1.05rem; text-shadow:0 2px 8px rgba(0,0,0,0.2);">
                                Theo dõi chất lượng phản hồi & trải nghiệm khách hàng theo thời gian
                            </p>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("ExportReviewExcel", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, starRating = Model.StarRating })"
                   class="btn btn-success btn-pill shadow-lg d-flex align-items-center gap-2 hover-scale"
                   style="font-size:1.05rem; white-space:nowrap;">
                    <i class="bi bi-file-earmark-excel" style="font-size:1.4rem;"></i>
                    <span>Xuất Excel</span>
                </a>
            </div>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BỘ LỌC - FILTER CARD -->
    <div class="filter-card p-4 mb-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="p-3 rounded-3" style="background: linear-gradient(135deg,#1e40af 0%,#3b82f6 100%);">
                <i class="bi bi-funnel text-white" style="font-size:1.25rem;"></i>
            </div>
            <h5 class="mb-0 fw-bold text-primary-blue">Bộ lọc thống kê đánh giá</h5>
        </div>
        @using (Html.BeginForm("Review", "Report", FormMethod.Get, new { @class = "row g-4 align-items-end" }))
        {
            <div class="col-md-4 col-lg-3">
                <label for="fromDate" class="form-label fw-semibold text-primary-blue">
                    <i class="bi bi-calendar-event me-2"></i> Từ ngày
                </label>
                @Html.TextBox("fromDate", Model.FromDate?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-4 col-lg-3">
                <label for="toDate" class="form-label fw-semibold text-primary-blue">
                    <i class="bi bi-calendar-check me-2"></i> Đến ngày
                </label>
                @Html.TextBox("toDate", Model.ToDate?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-4 col-lg-3">
                <label for="starRating" class="form-label fw-semibold text-primary-blue">
                    <i class="bi bi-star-fill me-2"></i> Xếp hạng
                </label>
                @Html.DropDownList("starRating", new List<SelectListItem>
                {
                    new SelectListItem { Text = "Tất cả", Value = "all", Selected = Model.StarRating == "all" },
                    new SelectListItem { Text = "5 sao", Value = "5", Selected = Model.StarRating == "5" },
                    new SelectListItem { Text = "4 sao", Value = "4", Selected = Model.StarRating == "4" },
                    new SelectListItem { Text = "3 sao", Value = "3", Selected = Model.StarRating == "3" },
                    new SelectListItem { Text = "2 sao", Value = "2", Selected = Model.StarRating == "2" },
                    new SelectListItem { Text = "1 sao", Value = "1", Selected = Model.StarRating == "1" }
                }, new { @class = "form-select" })
            </div>
            <div class="col-md-12 col-lg-3">
                <button type="submit" class="btn btn-primary btn-pill w-100 d-flex align-items-center justify-content-center gap-2 hover-scale">
                    <i class="bi bi-funnel-fill"></i>
                    <span>Lọc dữ liệu</span>
                </button>
            </div>
        }
    </div>

    <!-- THỐNG KÊ TỔNG QUAN - GLASS CARDS -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card-glass h-100 p-3 stats-card primary">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="p-3 rounded-4 icon-soft">
                            <i class="bi bi-chat-quote-fill fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-uppercase text-white-50 mb-1">Tổng Đánh Giá</h6>
                        <h3 class="fw-bold text-white mb-0">@Model.TotalReviews.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card-glass h-100 p-3 stats-card info">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="p-3 rounded-4 icon-soft">
                            <i class="bi bi-star-half fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-uppercase text-white-50 mb-1">Xếp Hạng Trung Bình</h6>
                        <h3 class="fw-bold d-flex align-items-center text-white mb-0">
                            @Model.AverageRating.ToString("F1")
                            <i class="bi bi-star-fill ms-2"></i>
                        </h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card-glass h-100 p-3 stats-card success">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="p-3 rounded-4 icon-soft">
                            <i class="bi bi-hand-thumbs-up-fill fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-uppercase text-white-50 mb-1">Đánh Giá Tích Cực</h6>
                        <h3 class="fw-bold text-white mb-0">
                            @Model.PositiveReviews.ToString("N0") (@Model.PositivePercentage.ToString("F1")%)
                        </h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card-glass h-100 p-3 stats-card danger">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="p-3 rounded-4 icon-soft">
                            <i class="bi bi-hand-thumbs-down-fill fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-uppercase text-white-50 mb-1">Đánh Giá Tiêu Cực</h6>
                        <h3 class="fw-bold text-white mb-0">
                            @Model.NegativeReviews.ToString("N0") (@Model.NegativePercentage.ToString("F1")%)
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BIỂU ĐỒ + CHỦ ĐỀ -->
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card-glass h-100">
                <div class="d-flex align-items-center justify-content-between px-4 pt-4 pb-2 border-bottom-0">
                    <h5 class="fw-bold mb-0 text-primary-blue d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart-fill"></i> Phân bổ xếp hạng sao
                    </h5>
                </div>
                <div class="px-4 pb-4">
                    <div class="chart-wrapper">
                        <canvas id="ratingDistributionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card-glass h-100">
                <div class="d-flex align-items-center justify-content-between px-4 pt-4 pb-2 border-bottom-0">
                    <h5 class="fw-bold mb-0 text-primary-blue d-flex align-items-center gap-2">
                        <i class="bi bi-tags-fill"></i> Chủ đề được nhắc đến nhiều
                    </h5>
                </div>
                <div class="px-4 pb-4">
                    @if (Model.TopMentionedTopics.Any())
                    {
                        <div class="d-flex flex-wrap">
                            @foreach (var topic in Model.TopMentionedTopics)
                            {
                                var badgeClass = "";
                                if (topic.Contains("tốt") || topic.Contains("ngon") || topic.Contains("nhanh") || topic.Contains("tươi") || topic.Contains("ủng hộ") || topic.Contains("đúng"))
                                { badgeClass = "bg-success"; }
                                else if (topic.Contains("chậm") || topic.Contains("nhỏ"))
                                { badgeClass = "bg-warning text-dark"; }
                                else { badgeClass = "bg-primary"; }

                                <span class="badge fs-6 @badgeClass m-1 px-3 py-2 rounded-pill shadow-sm">@topic</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG ĐÁNH GIÁ -->
    <div class="card-glass overflow-hidden">
        <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-3 border-bottom">
            <h5 class="card-title fw-bold mb-0 text-primary-blue d-flex align-items-center gap-2">
                <i class="bi bi-table"></i> Các đánh giá gần đây
            </h5>
            <a href="@Url.Action("ExportReviewExcel", "Report", new { fromDate = Model.FromDate, toDate = Model.ToDate, starRating = Model.StarRating })"
               class="btn btn-outline-success btn-pill btn-sm d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-excel"></i> Xuất Excel
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-modern">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Sản phẩm</th>
                        <th>Ảnh</th>
                        <th class="text-center">Xếp hạng</th>
                        <th>Nội dung</th>
                        <th>Ngày</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentReviews.Any())
                    {
                        foreach (var review in Model.RecentReviews)
                        {
                            var img = imgUrl(review.ProductImageFileName);
                            <tr id="review-row-@review.ReviewID">
                                <td class="px-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-wrapper">
                                            <img src="@Url.Action("AvatarById","Account", new { area = "", id = (review.UserID ?? 0) })"
                                                 alt="avatar" class="rounded-circle"
                                                 style="width:40px;height:40px;object-fit:cover" />
                                        </div>
                                        <div class="fw-semibold text-primary-blue">@review.CustomerName</div>
                                    </div>
                                </td>
                                <td class="px-4">@review.ProductName</td>
                                <td class="px-4">
                                    <img src="@img" alt="img"
                                         style="width:56px;height:56px;object-fit:cover;border-radius:12px;box-shadow:0 6px 16px rgba(15,23,42,0.2);" />
                                </td>
                                <td class="text-center text-warning px-4">
                                    @Html.Raw(review.StarDisplay)
                                </td>
                                <td class="small px-4">
                                    @(string.IsNullOrEmpty(review.Comment)
                                        ? "Không có bình luận"
                                        : (review.Comment.Length > 80 ? review.Comment.Substring(0, 80) + "..." : review.Comment))
                                </td>
                                <td class="px-4">@review.CreatedAtFormatted</td>
                                <td class="text-center px-4">
                                    <form class="d-inline delete-review-form" data-id="@review.ReviewID"
                                          onsubmit="return confirm('Xóa bình luận này? Hành động không thể hoàn tác.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm btn-action">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center gap-3">
                                    <div class="p-4 rounded-circle" style="background: linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%);">
                                        <i class="bi bi-inbox fs-1" style="color:#3b82f6;"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1 text-primary-blue">Không có đánh giá nào</h5>
                                        <p class="text-muted mb-0">Không có đánh giá trong khoảng thời gian đã chọn.</p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{ var currentPage = (int)(ViewBag.Page ?? 1); var totalPages = (int)(ViewBag.TotalPages ?? 1); var pageSize = (int)(ViewBag.PageSize ?? 10); }
        @if (Model.RecentReviews.Any())
        {
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between px-4 py-3 border-top"
                 style="background: linear-gradient(90deg,#f0f9ff 0%,#dbeafe 100%);">
                <div class="text-muted small mb-2 mb-md-0">
                    <i class="bi bi-journals me-2 text-primary"></i>
                    Trang <span class="fw-bold text-primary-blue">@currentPage</span> / <span class="fw-bold text-primary-blue">@totalPages</span>
                    <span class="mx-1">•</span>
                    Tổng <span class="fw-bold text-primary-blue">@((int)(ViewBag.Total ?? 0))</span> đánh giá
                </div>

                @if (totalPages > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Review","Report", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), starRating = Model.StarRating, page = currentPage - 1, pageSize = pageSize })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Review","Report", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), starRating = Model.StarRating, page = currentPage + 1, pageSize = pageSize })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</main>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // TOAST THÔNG BÁO ĐỒNG BỘ VỚI TRANG VẬN CHUYỂN
        function showNotification(message, type = 'info') {
            const old = document.querySelector('.dynamic-alert');
            if (old) old.remove();
            const iconMap = {
                'success': 'check-circle-fill',
                'danger': 'exclamation-triangle-fill',
                'info': 'info-circle-fill',
                'warning': 'exclamation-circle-fill'
            };
            const div = document.createElement('div');
            div.className = `alert alert-${type} alert-dismissible fade show dynamic-alert`;
            div.style.cssText = 'position:fixed;top:80px;right:20px;z-index:9999;min-width:320px;max-width:500px;' +
                'box-shadow:0 15px 50px rgba(0,0,0,.25);border-radius:1.25rem;animation:slideIn .4s ease-out';
            div.innerHTML = `<div class="d-flex align-items-center gap-3">
                                <i class="bi bi-${iconMap[type]} fs-4"></i>
                                <span class="flex-grow-1">${message}</span>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                             </div>`;
            document.body.appendChild(div);
            setTimeout(() => {
                div.style.animation = 'slideOut .3s ease-out';
                setTimeout(() => div.remove(), 300);
            }, 4000);
        }

        document.addEventListener("DOMContentLoaded", function () {
            var starLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StarDistributions.Select(s => s.Label)));
            var starData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StarDistributions.Select(s => s.Count)));

            const ctx = document.getElementById("ratingDistributionChart");
            if (ctx) {
                new Chart(ctx, {
                    type: "bar",
                    data: {
                        labels: starLabels,
                        datasets: [{
                            label: "Số lượng đánh giá",
                            data: starData,
                            backgroundColor: [
                                "rgba(25, 135, 84, 0.8)",
                                "rgba(13, 202, 240, 0.8)",
                                "rgba(255, 193, 7, 0.8)",
                                "rgba(255, 128, 0, 0.8)",
                                "rgba(220, 53, 69, 0.8)"
                            ],
                            borderRadius: 5
                        }]
                    },
                    options: {
                        indexAxis: "y",
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            }
        });

        $(document).ready(function () {
            $(".delete-review-form").submit(function (e) {
                e.preventDefault();

                var form = $(this);
                var id = form.data("id");
                var token = form.find('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeleteReview", "Report", new { area = currentArea })',
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: token,
                        id: id
                    },
                    success: function (res) {
                        if (res.success) {
                            showNotification(res.message, 'success');
                            $("#review-row-" + id).fadeOut(300, function () {
                                $(this).remove();
                            });
                        } else {
                            showNotification(res.message, 'danger');
                        }
                    },
                    error: function (xhr) {
                        showNotification("Lỗi khi xóa bình luận: " + xhr.statusText, 'danger');
                    }
                });
            });
        });
    </script>

    <style>
        :root {
            --primary-blue: #1e40af;
            --primary-blue-light: #3b82f6;
            --primary-blue-dark: #1e3a8a;
            --accent-blue: #0ea5e9;
            --bg-blue-light: #eff6ff;
            --bg-blue-lighter: #dbeafe;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(40px)
            }

            to {
                opacity: 1;
                transform: translateX(0)
            }
        }

        @@keyframes slideOut {
            from {
                opacity: 1;
                transform: translateX(0)
            }

            to {
                opacity: 0;
                transform: translateX(100px)
            }
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-10px)
            }
        }

        @@keyframes rotate {
            from {
                transform: rotate(0)
            }

            to {
                transform: rotate(360deg)
            }
        }

        body {
            background: linear-gradient(135deg,#eff6ff 0%,#dbeafe 50%,#bfdbfe 100%);
            min-height: 100vh;
        }

        .grad-header {
            background: linear-gradient(135deg,#1e40af 0%,#3b82f6 50%,#60a5fa 100%);
            border-radius: 1.5rem;
            box-shadow: 0 20px 50px rgba(30,64,175,0.4);
            animation: fadeInUp .5s ease-out;
            position: relative;
            overflow: hidden;
        }

            .grad-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle,rgba(255,255,255,0.18) 0%,transparent 70%);
                animation: rotate 25s linear infinite;
            }

            .grad-header::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 400px;
                height: 400px;
                background: radial-gradient(circle,rgba(255,255,255,0.12) 0%,transparent 70%);
                border-radius: 50%;
                animation: float 6s ease-in-out infinite;
            }

        .icon-gradient {
            background: linear-gradient(135deg,#1e40af 0%,#3b82f6 100%);
            box-shadow: 0 10px 30px rgba(30,64,175,0.6);
        }

        .card-glass {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(30,64,175,0.08);
            box-shadow: 0 18px 50px rgba(15,23,42,0.18);
            border-radius: 1.5rem;
            animation: fadeInUp .6s ease-out;
        }

        .filter-card {
            background: linear-gradient(135deg,#ffffff 0%,#f0f9ff 100%);
            border: 2px solid #bfdbfe;
            border-radius: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,64,175,0.1);
            animation: fadeInUp .6s ease-out .05s backwards;
        }

        .stats-card {
            position: relative;
            overflow: hidden;
        }

            .stats-card.primary {
                background: radial-gradient(circle at top left,#3b82f6 0%,#1e40af 55%,#0f172a 100%);
            }

            .stats-card.info {
                background: radial-gradient(circle at top left,#38bdf8 0%,#1d4ed8 60%,#020617 100%);
            }

            .stats-card.success {
                background: radial-gradient(circle at top left,#22c55e 0%,#15803d 55%,#052e16 100%);
            }

            .stats-card.danger {
                background: radial-gradient(circle at top left,#f97373 0%,#b91c1c 55%,#450a0a 100%);
            }

            .stats-card .icon-soft {
                background: linear-gradient(135deg,rgba(255,255,255,0.4),rgba(255,255,255,0.1));
                box-shadow: 0 12px 30px rgba(15,23,42,0.5);
            }

            .stats-card:hover {
                transform: translateY(-4px);
                transition: transform .2s ease, box-shadow .2s ease;
                box-shadow: 0 22px 60px rgba(15,23,42,0.35);
            }

        .table-modern {
            border-collapse: separate;
