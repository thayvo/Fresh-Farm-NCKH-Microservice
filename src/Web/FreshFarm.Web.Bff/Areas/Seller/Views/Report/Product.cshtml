@model FreshFarm.Web.Bff.Areas.Seller.Models.ProductReportViewModel
@{
    ViewBag.Title = "Báo Cáo Sản Phẩm";
    Layout = (string?)ViewData["LayoutPath"] ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    // Helper tạo URL ảnh sản phẩm, dùng chung logic với các trang khác
Func<string?, string> productImg = f => ProductImagePaths.ResolveRequestPath(f);
}

<style>
    :root {
        --primary-blue: #1e40af;
        --primary-blue-light: #3b82f6;
        --primary-blue-dark: #1e3a8a;
        --accent-blue: #0ea5e9;
        --bg-blue-light: #eff6ff;
        --bg-blue-lighter: #dbeafe;
    }

    body {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 50%, #bfdbfe 100%);
        min-height: 100vh;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-10px)
        }
    }

    @@keyframes rotate {
        from {
            transform: rotate(0)
        }

        to {
            transform: rotate(360deg)
        }
    }

    .grad-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #60a5fa 100%);
        border-radius: 1.5rem;
        box-shadow: 0 20px 50px rgba(30, 64, 175, 0.4);
        animation: fadeInUp .5s ease-out;
        position: relative;
        overflow: hidden;
    }

        .grad-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
            animation: rotate 25s linear infinite;
        }

        .grad-header::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }

    .grad-header-inner {
        position: relative;
        z-index: 1;
    }

    .icon-gradient {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        box-shadow: 0 10px 30px rgba(30, 64, 175, 0.5);
    }

    .card-glass {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(30, 64, 175, 0.1);
        box-shadow: 0 20px 60px rgba(30, 64, 175, 0.15);
        border-radius: 1.5rem;
        animation: fadeInUp .6s ease-out;
    }

    .filter-card {
        background: linear-gradient(135deg, #fff 0%, #f0f9ff 100%);
        border: 2px solid #bfdbfe;
        border-radius: 1.5rem;
        box-shadow: 0 15px 40px rgba(30, 64, 175, 0.1);
        animation: fadeInUp .6s ease-out .1s backwards;
    }

    .btn-pill {
        border-radius: 2rem;
        padding: .75rem 2rem;
        font-weight: 600;
        transition: all .3s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
        border: none;
    }

        .btn-pill:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(0,0,0,.2);
        }

    .btn-primary {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        }

    .btn-outline-success {
        border-radius: 999px;
        border-width: 2px;
        font-weight: 600;
    }

    .form-select, .form-control {
        border: 2px solid #bfdbfe;
        border-radius: 1rem;
        padding: .75rem 1.25rem;
        transition: all .3s ease;
        background: #fff;
    }

        .form-select:focus, .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 5px rgba(59, 130, 246, 0.15);
            background: #fff;
        }

    .text-primary-blue {
        color: #1e40af !important;
    }

    .stat-card {
        border-radius: 1.5rem;
        border: none;
        background: linear-gradient(135deg, #ffffff 0%, #e0f2fe 100%);
        box-shadow: 0 18px 40px rgba(30, 64, 175, 0.18);
        position: relative;
        overflow: hidden;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(59,130,246,0.25), transparent 55%);
            opacity: .8;
            pointer-events: none;
        }

        .stat-card .card-body {
            position: relative;
            z-index: 1;
        }

    .table-modern {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-modern thead th {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-bottom: 3px solid #3b82f6;
            font-weight: 600;
            color: #1e3a8a;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .5px;
            padding: 1.25rem 1rem;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .table-modern tbody tr {
            transition: all .3s cubic-bezier(.4,0,.2,1);
            animation: slideIn .4s ease-out backwards;
            border-bottom: 1px solid #e5e7eb;
        }

            .table-modern tbody tr:hover {
                background: linear-gradient(90deg, rgba(59, 130, 246, 0.08) 0%, rgba(147, 197, 253, 0.08) 100%);
                transform: translateY(-2px);
                box-shadow: -5px 0 0 0 #3b82f6;
            }

        .table-modern tbody td {
            padding: 1.1rem 1rem;
            vertical-align: middle;
        }

    .page-link {
        border-radius: .875rem;
        margin: 0 .375rem;
        border: 2px solid #bfdbfe;
        color: #1e40af;
        transition: all .3s ease;
        font-weight: 600;
    }

        .page-link:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
            color: #fff;
            border-color: #3b82f6;
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
        }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-color: #1e40af;
        color: #fff;
    }

    .alert {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .chart-card {
        border-radius: 1.5rem;
        background: rgba(255, 255, 255, 0.98);
        border: 1px solid rgba(191, 219, 254, 0.9);
        box-shadow: 0 18px 44px rgba(30, 64, 175, 0.18);
        backdrop-filter: blur(16px);
    }

        .chart-card .card-header {
            border-bottom: 1px solid rgba(191, 219, 254, 0.9);
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
/*            border-radius: 1.5rem 1.5rem 0 0 !important;*/
        }

    .chart-container {
        position: relative;
        height: 320px;
    }

    @@media (max-width: 768px) {
        .grad-header {
            padding: 2rem 1.5rem !important;
        }

        .chart-container {
            height: 260px;
        }
    }
</style>

<main class="min-vh-100">
    <div class="container-fluid py-4">

        <!-- HEADER -->
        <div class="grad-header p-4 p-md-5 mb-4">
            <div class="grad-header-inner">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-4 icon-gradient">
                            <i class="bi bi-clipboard-data text-white" style="font-size: 2.5rem;"></i>
                        </div>
                        <div>
                            <h1 class="fw-bold mb-1 text-white" style="font-size: 2.3rem; text-shadow: 0 4px 12px rgba(0,0,0,0.3);">
                                Báo Cáo Sản Phẩm
                            </h1>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.05rem;">
                                Phân tích hiệu suất bán hàng và doanh thu theo sản phẩm
                            </p>
                        </div>
                    </div>
                    <a href="@Url.Action("ExportProductExcel", "Report", new {
                            fromDate = Model.FromDate,
                            toDate = Model.ToDate,
                            productCategory = Model.ProductCategory
                        })"
                       class="btn btn-success btn-pill d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-excel" style="font-size: 1.3rem;"></i>
                        <span>Xuất Excel</span>
                    </a>
                </div>
            </div>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @ViewBag.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- FILTER -->
        @using (Html.BeginForm("Product", "Report", FormMethod.Get, new { @class = "mb-4" }))
        {
            <div class="filter-card p-4 mb-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="p-3 rounded-3" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
                        <i class="bi bi-funnel text-white" style="font-size: 1.25rem;"></i>
                    </div>
                    <h5 class="mb-0 fw-bold text-primary-blue">Bộ lọc báo cáo sản phẩm</h5>
                </div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6 col-lg-3">
                        <label for="fromDate" class="form-label fw-semibold text-primary-blue">Từ ngày</label>
                        <input type="date" id="fromDate" name="fromDate" class="form-control"
                               value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label for="toDate" class="form-label fw-semibold text-primary-blue">Đến ngày</label>
                        <input type="date" id="toDate" name="toDate" class="form-control"
                               value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label for="productCategory" class="form-label fw-semibold text-primary-blue">Danh mục sản phẩm</label>
                        <select id="productCategory" name="productCategory" class="form-select">
                            <option value="all" selected="@(Model.ProductCategory == "all"  ? "selected" : null)">Tất cả danh mục</option>
                            <option value="Rau lá" selected="@(Model.ProductCategory == "Rau lá"  ? "selected" : null)">Rau lá</option>
                            <option value="Rau ăn hoa / thân / mầm" selected="@(Model.ProductCategory == "Rau ăn hoa / thân / mầm"  ? "selected" : null)">Rau ăn hoa / thân / mầm</option>
                            <option value="Rau ăn quả" selected="@(Model.ProductCategory == "Rau ăn quả"  ? "selected" : null)">Rau ăn quả</option>
                            <option value="Củ & rễ" selected="@(Model.ProductCategory == "Củ & rễ"  ? "selected" : null)">Củ & rễ</option>
                            <option value="Nấm" selected="@(Model.ProductCategory == "Nấm"  ? "selected" : null)">Nấm</option>
                            <option value="Rau thơm & gia vị" selected="@(Model.ProductCategory == "Rau thơm & gia vị"  ? "selected" : null)">Rau thơm & gia vị</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <button type="submit" class="btn btn-primary btn-pill w-100 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-funnel-fill"></i> <span>Lọc dữ liệu</span>
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- STAT CARDS -->
        <div class="row g-4 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="p-3 rounded-4 icon-gradient d-flex align-items-center justify-content-center">
                                    <i class="bi bi-trophy-fill fs-3 text-warning"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted text-uppercase mb-1">Bán Chạy Nhất</h6>
                                <h5 class="fw-bold mb-0 text-primary-blue">@Model.BestSellingProduct</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="p-3 rounded-4 icon-gradient d-flex align-items-center justify-content-center">
                                    <i class="bi bi-box-seam fs-3 text-white"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted text-uppercase mb-1">Tổng SP Đã Bán</h6>
                                <h3 class="fw-bold mb-0 text-primary-blue">@Model.TotalProductsSold.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="p-3 rounded-4 icon-gradient d-flex align-items-center justify-content-center">
                                    <i class="bi bi-cash-stack fs-3 text-white"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted text-uppercase mb-1">Doanh Thu TB/SP</h6>
                                <h3 class="fw-bold mb-0 text-success">@Model.AverageRevenuePerProduct.ToString("N0")₫</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="p-3 rounded-4 icon-gradient d-flex align-items-center justify-content-center">
                                    <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted text-uppercase mb-1">SP Sắp Hết Hàng</h6>
                                <h3 class="fw-bold mb-0 text-danger">@Model.LowStockProducts</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHARTS -->
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="chart-card h-100">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h5 class="card-title fw-bold mb-0 text-primary-blue">
                            <i class="bi bi-bar-chart-steps me-2"></i>Top 10 sản phẩm bán chạy (số lượng)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="topSellingProductsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="chart-card h-100">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h5 class="card-title fw-bold mb-0 text-primary-blue">
                            <i class="bi bi-pie-chart-fill me-2"></i>Tỷ trọng doanh thu theo danh mục
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="revenueByCategoryChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLE -->
        <div class="card-glass overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Danh mục</th>
                            <th class="text-center">Đã bán</th>
                            <th class="text-center">Tồn kho</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProductPerformances.Any())
                        {
                            foreach (var product in Model.ProductPerformances)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@productImg(product.ImageFileName)"
                                                 alt="@product.ProductName"
                                                 class="rounded me-3"
                                                 width="48"
                                                 height="48"
                                     onerror="this.src='@ProductImagePaths.FallbackImageRequestPath'" />
                                            <div>
                                                <h6 class="mb-0 fw-bold text-primary-blue">@product.ProductName</h6>
                                                <small class="text-muted">SKU: @product.Sku</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@product.CategoryName</td>
                                    <td class="text-center">@product.QuantitySold.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge @product.StockBadgeClass">@product.StockStatus</span>
                                    </td>
                                    <td class="fw-bold text-success">@product.TotalRevenue.ToString("N0")₫</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center gap-3">
                                        <div class="p-4 rounded-circle" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                            <i class="bi bi-inbox fs-1 text-primary-blue"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-primary-blue">Không có dữ liệu sản phẩm</h5>
                                            <p class="text-muted mb-0">Hãy thay đổi bộ lọc để xem dữ liệu phù hợp.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between px-4 py-4 border-top"
                     style="background: linear-gradient(90deg, #f0f9ff 0%, #dbeafe 100%);">
                    <div class="text-muted mb-3 mb-md-0">
                        <i class="bi bi-journals me-2 text-primary"></i>
                        Trang <span class="fw-bold text-primary-blue">@Model.CurrentPage</span> / <span class="fw-bold text-primary-blue">@Model.TotalPages</span>
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-end mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Product", new {
                                        fromDate = Model.FromDate,
                                        toDate = Model.ToDate,
                                        productCategory = Model.ProductCategory,
                                        page = Model.CurrentPage - 1
                                   })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                var startPage = Math.Max(1, Model.CurrentPage - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Product", new {
                                                fromDate = Model.FromDate,
                                                toDate = Model.ToDate,
                                                productCategory = Model.ProductCategory,
                                                page = i
                                           })">@i</a>
                                    </li>
                                }
                            }

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Product", new {
                                        fromDate = Model.FromDate,
                                        toDate = Model.ToDate,
                                        productCategory = Model.ProductCategory,
                                        page = Model.CurrentPage + 1
                                   })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</main>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // --- Biểu đồ Top Sản phẩm (Bar Chart) ---
        const topSellingProductsCtx = document.getElementById("topSellingProductsChart");
        if (topSellingProductsCtx) {
          var topProductLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.ProductName).ToList()));
          var topProductData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.QuantitySold).ToList()));

          new Chart(topSellingProductsCtx, {
            type: "bar",
            data: {
              labels: topProductLabels,
              datasets: [
                {
                  label: "Số lượng đã bán",
                  data: topProductData,
                  backgroundColor: "rgba(59, 130, 246, 0.8)",
                  borderColor: "rgba(37, 99, 235, 1)",
                  borderWidth: 1,
                  borderRadius: 5,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  display: false,
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      return 'Đã bán: ' + context.parsed.y.toLocaleString('vi-VN');
                    }
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: {
                    callback: function(value) {
                      return value.toLocaleString('vi-VN');
                    }
                  }
                }
              }
            },
          });
        }

        // --- Biểu đồ Tỷ trọng doanh thu (Doughnut Chart) ---
        const revenueByCategoryCtx = document.getElementById("revenueByCategoryChart");
        if (revenueByCategoryCtx) {
          var categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.CategoryName).ToList()));
          var categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.Revenue / 1000000).ToList()));

          new Chart(revenueByCategoryCtx, {
            type: "doughnut",
            data: {
              labels: categoryLabels,
              datasets: [
                {
                  label: "Doanh thu (triệu)",
                  data: categoryData,
                  backgroundColor: [
                    "rgba(59, 130, 246, 0.85)",
                    "rgba(37, 99, 235, 0.85)",
                    "rgba(56, 189, 248, 0.85)",
                    "rgba(16, 185, 129, 0.85)",
                    "rgba(129, 140, 248, 0.85)",
                    "rgba(96, 165, 250, 0.85)",
                  ],
                  borderColor: "#fff",
                  borderWidth: 2,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      var value = context.parsed;
                      return context.label + ': ' + value.toFixed(2) + ' triệu ₫';
                    }
                  }
                }
              }
            },
          });
        }
      });
    </script>
}

