@model FreshFram.Areas.Admin.Data.ProductReportViewModel
@{
    ViewBag.Title = "Báo Cáo Sản Phẩm";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
}

<main class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            Báo Cáo Sản Phẩm
        </h2>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @using (Html.BeginForm("Product", "Report", FormMethod.Get, new { @class = "mb-4" }))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6 col-lg-3">
                        <label for="fromDate" class="form-label fw-semibold">Từ ngày</label>
                        <input type="date" id="fromDate" name="fromDate" class="form-control"
                               value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label for="toDate" class="form-label fw-semibold">Đến ngày</label>
                        <input type="date" id="toDate" name="toDate" class="form-control"
                               value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label for="productCategory" class="form-label fw-semibold">Danh mục sản phẩm</label>
                        <select id="productCategory" name="productCategory" class="form-select">
                            <option value="all" @(Model.ProductCategory == "all" ? "selected" : "")>Tất cả danh mục</option>
                            <option value="Rau lá" @(Model.ProductCategory == "Rau lá" ? "selected" : "")>Rau lá</option>
                            <option value="Rau ăn hoa / thân / mầm" @(Model.ProductCategory == "Rau ăn hoa / thân / mầm" ? "selected" : "")>Rau ăn hoa / thân / mầm</option>
                            <option value="Rau ăn quả" @(Model.ProductCategory == "Rau ăn quả" ? "selected" : "")>Rau ăn quả</option>
                            <option value="Củ & rễ" @(Model.ProductCategory == "Củ & rễ" ? "selected" : "")>Củ & rễ</option>
                            <option value="Nấm" @(Model.ProductCategory == "Nấm" ? "selected" : "")>Nấm</option>
                            <option value="Rau thơm & gia vị" @(Model.ProductCategory == "Rau thơm & gia vị" ? "selected" : "")>Rau thơm & gia vị</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <button type="submit" class="btn btn-warning w-100 text-dark">
                            <i class="bi bi-funnel-fill"></i> Lọc dữ liệu
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card border-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-trophy-fill fs-1 text-warning opacity-75"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">Bán Chạy Nhất</h6>
                            <h3 class="fw-bold">@Model.BestSellingProduct</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card border-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-box-seam fs-1 text-primary opacity-75"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">Tổng SP Đã Bán</h6>
                            <h3 class="fw-bold">@Model.TotalProductsSold.ToString("N0")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card border-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-cash-stack fs-1 text-success opacity-75"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">Doanh Thu TB/SP</h6>
                            <h3 class="fw-bold">@Model.AverageRevenuePerProduct.ToString("N0")₫</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm stat-card border-danger h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-danger opacity-75"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted text-uppercase">SP Sắp Hết Hàng</h6>
                            <h3 class="fw-bold">@Model.LowStockProducts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-bar-chart-steps"></i> Top 10 sản phẩm bán
                        chạy (số lượng)
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="topSellingProductsChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-pie-chart-fill"></i> Tỷ trọng doanh thu theo
                        danh mục
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueByCategoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0">
                <i class="bi bi-table"></i> Chi tiết hiệu suất sản phẩm
            </h5>
            <a href="@Url.Action("ExportProductExcel", "Report", new {
                fromDate = Model.FromDate,
                toDate = Model.ToDate,
                productCategory = Model.ProductCategory
            })" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> Xuất Excel
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Danh mục</th>
                        <th class="text-center">Đã bán</th>
                        <th class="text-center">Tồn kho</th>
                        <th>Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProductPerformances.Any())
                    {
                        foreach (var product in Model.ProductPerformances)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@Url.Content("~/Content/images/products/" + product.ImageFileName)"
                                             alt="@product.ProductName"
                                             class="rounded me-3"
                                             width="48"
                                             height="48"
                                             onerror="this.src='https://via.placeholder.com/64x64/008a4f/fff?text=SP'" />
                                        <div>
                                            <h6 class="mb-0 fw-bold">@product.ProductName</h6>
                                            <small class="text-muted">SKU: @product.Sku</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@product.CategoryName</td>
                                <td class="text-center">@product.QuantitySold.ToString("N0")</td>
                                <td class="text-center">
                                    <span class="badge @product.StockBadgeClass">@product.StockStatus</span>
                                </td>
                                <td class="fw-bold">@product.TotalRevenue.ToString("N0")₫</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                                <span class="text-muted">Không có dữ liệu sản phẩm</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-end mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Product", new {
                                   fromDate = Model.FromDate,
                                   toDate = Model.ToDate,
                                   productCategory = Model.ProductCategory,
                                   page = Model.CurrentPage - 1
                               })"
                               tabindex="-1"
                               aria-disabled="@(Model.CurrentPage <= 1)">Trước</a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")"
                                    aria-current="@(Model.CurrentPage == i ? "page" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Product", new {
                                           fromDate = Model.FromDate,
                                           toDate = Model.ToDate,
                                           productCategory = Model.ProductCategory,
                                           page = i
                                       })">@i</a>
                                </li>
                            }
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Product", new {
                                   fromDate = Model.FromDate,
                                   toDate = Model.ToDate,
                                   productCategory = Model.ProductCategory,
                                   page = Model.CurrentPage + 1
                               })">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</main>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // --- Biểu đồ Top Sản phẩm (Bar Chart) ---
        const topSellingProductsCtx = document.getElementById("topSellingProductsChart");
        if (topSellingProductsCtx) {
          var topProductLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.ProductName).ToList()));
          var topProductData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.QuantitySold).ToList()));

          new Chart(topSellingProductsCtx, {
            type: "bar",
            data: {
              labels: topProductLabels,
              datasets: [
                {
                  label: "Số lượng đã bán",
                  data: topProductData,
                  backgroundColor: "rgba(255, 193, 7, 0.8)",
                  borderColor: "rgba(255, 193, 7, 1)",
                  borderWidth: 1,
                  borderRadius: 5,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  display: false,
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      return 'Đã bán: ' + context.parsed.y.toLocaleString('vi-VN');
                    }
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: {
                    callback: function(value) {
                      return value.toLocaleString('vi-VN');
                    }
                  }
                }
              }
            },
          });
        }

        // --- Biểu đồ Tỷ trọng doanh thu (Doughnut Chart) ---
        const revenueByCategoryCtx = document.getElementById("revenueByCategoryChart");
        if (revenueByCategoryCtx) {
          var categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.CategoryName).ToList()));
          var categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.Revenue / 1000000).ToList()));

          new Chart(revenueByCategoryCtx, {
            type: "doughnut",
            data: {
              labels: categoryLabels,
              datasets: [
                {
                  label: "Doanh thu (triệu)",
                  data: categoryData,
                  backgroundColor: [
                    "rgba(255, 193, 7, 0.8)",
                    "rgba(13, 110, 253, 0.8)",
                    "rgba(25, 135, 84, 0.8)",
                    "rgba(220, 53, 69, 0.8)",
                    "rgba(23, 162, 184, 0.8)",
                    "rgba(108, 117, 125, 0.8)",
                  ],
                  borderColor: "#fff",
                  borderWidth: 2,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      var value = context.parsed;
                      return context.label + ': ' + value.toFixed(2) + ' triệu ₫';
                    }
                  }
                }
              }
            },
          });
        }
      });
    </script>
}