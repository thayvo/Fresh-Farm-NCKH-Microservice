@model IEnumerable<FreshFarm.Web.Bff.Areas.Seller.Models.Coupon>
@using System.Linq
@{
    ViewBag.Title = "Quản Lý Mã Giảm Giá";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --primary-blue: #1e40af;
        --primary-blue-light: #3b82f6;
        --primary-blue-dark: #1e3a8a;
        --accent-blue: #0ea5e9;
        --bg-blue-light: #eff6ff;
        --bg-blue-lighter: #dbeafe;
    }

    body {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 50%, #bfdbfe 100%);
        min-height: 100vh;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@keyframes rotate {
        from {
            transform: rotate(0);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes slideOut {
        from {
            opacity: 1;
            transform: translateX(0);
        }

        to {
            opacity: 0;
            transform: translateX(100px);
        }
    }

    .grad-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #60a5fa 100%);
        border-radius: 1.5rem;
        padding: 2.25rem 2rem;
        box-shadow: 0 20px 50px rgba(30, 64, 175, 0.45);
        position: relative;
        overflow: hidden;
        color: #fff;
        animation: fadeInUp .5s ease-out;
    }

        .grad-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, transparent 70%);
            animation: rotate 26s linear infinite;
        }

        .grad-header::after {
            content: '';
            position: absolute;
            bottom: -40px;
            right: -40px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(191, 219, 254, 0.35) 0%, transparent 70%);
            animation: float 6s ease-in-out infinite;
        }

    .grad-header-content {
        position: relative;
        z-index: 1;
    }

    .grad-header .icon-wrapper {
        background: rgba(15, 23, 42, 0.25);
        border-radius: 1.5rem;
        padding: 1.25rem;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.5);
    }

    .btn-pill {
        border-radius: 999px;
        padding: .7rem 1.8rem;
        font-weight: 600;
        border: none;
        transition: all .3s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 8px 20px rgba(0, 0, 0, .18);
    }

        .btn-pill:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(0, 0, 0, .25);
        }

    .btn-primary {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        }

    .btn-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
        }

    .card-glass {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border-radius: 1.5rem;
        border: 1px solid rgba(148, 163, 184, 0.3);
        box-shadow: 0 18px 55px rgba(30, 64, 175, 0.18);
        animation: fadeInUp .6s ease-out;
    }

    .table-modern {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        .table-modern thead th {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-bottom: 3px solid #3b82f6;
            font-weight: 600;
            color: #1e3a8a;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .06em;
            padding: 1rem 1rem;
            position: sticky;
            top: 0;
            z-index: 5;
        }

        .table-modern tbody tr {
            transition: all .25s cubic-bezier(.4,0,.2,1);
            border-bottom: 1px solid #e5e7eb;
            animation: slideIn .35s ease-out backwards;
        }

            .table-modern tbody tr:hover {
                background: linear-gradient(90deg, rgba(59, 130, 246, 0.08) 0%, rgba(147, 197, 253, 0.08) 100%);
                transform: translateY(-2px);
                box-shadow: -4px 0 0 0 #3b82f6;
            }

        .table-modern tbody td {
            padding: .9rem 1rem;
            vertical-align: middle;
            font-size: .9rem;
        }

    .badge-status {
        border-radius: 999px;
        padding: .35rem .85rem;
        font-size: .75rem;
        font-weight: 600;
    }

    .btn-action {
        width: 38px;
        height: 38px;
        border-radius: .875rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .3s ease;
        border: 2px solid;
    }

        .btn-action:hover {
            transform: scale(1.1);
        }

    .alert {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .modal-content {
        border-radius: 1.5rem;
        border: none;
        box-shadow: 0 25px 60px rgba(30, 64, 175, 0.3);
    }

    .modal-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        color: white;
        border-radius: 1.5rem 1.5rem 0 0;
    }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

    .form-control,
    .form-select {
        border-radius: 1rem;
        border: 2px solid #bfdbfe;
        padding: .7rem 1rem;
        transition: all .2s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
        }

    .is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 4px rgba(220,53,69,.1) !important;
    }

    .is-valid {
        border-color: #198754 !important;
        box-shadow: 0 0 0 4px rgba(25,135,84,.1) !important;
    }

    .invalid-feedback {
        display: block;
        margin-top: .5rem;
        font-size: .875rem;
        color: #dc3545;
    }

    @@media (max-width: 768px) {
        .grad-header {
            padding: 1.8rem 1.4rem;
        }
    }
</style>

<div class="min-vh-100">
    <main class="container-fluid py-4">

        <!-- HEADER -->
        <div class="grad-header mb-4">
            <div class="grad-header-content">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="icon-wrapper d-flex align-items-center justify-content-center">
                                <i class="bi bi-ticket-perforated-fill text-white" style="font-size: 2.2rem;"></i>
                            </div>
                            <div>
                                <h1 class="fw-bold mb-1" style="font-size: 2.1rem; text-shadow: 0 4px 12px rgba(0,0,0,0.35);">
                                    Quản Lý Mã Giảm Giá
                                </h1>
                                <p class="mb-0 opacity-90" style="font-size: 1rem;">
                                    Tạo, quản lý và gửi mã khuyến mãi đến khách hàng của bạn
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="text-md-end">
                        <button class="btn btn-success btn-pill d-inline-flex align-items-center gap-2"
                                data-bs-toggle="modal"
                                data-bs-target="#couponModal"
                                id="btnCreateNew">
                            <i class="bi bi-plus-circle"></i>
                            <span>Tạo mã mới</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ALERTS -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- TABLE -->
        <div class="card-glass">
            <div class="table-responsive" style="max-height: 520px;">
                <table class="table table-modern align-middle mb-0">
                    <thead>
                        <tr>
                            <th><i class="bi bi-ticket-perforated me-1"></i> Mã giảm giá</th>
                            <th><i class="bi bi-diagram-3 me-1"></i> Loại</th>
                            <th><i class="bi bi-123 me-1"></i> Giá trị</th>
                            <th><i class="bi bi-calendar-event me-1"></i> Ngày kết thúc</th>
                            <th><i class="bi bi-hash me-1"></i> Sử dụng</th>
                            <th><i class="bi bi-check2-circle me-1"></i> Trạng thái</th>
                            <th class="text-end"><i class="bi bi-gear me-1"></i> Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="coupons-table-body">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr data-id="@item.CouponID">
                                    <td class="fw-bold">
                                        <div class="d-flex flex-column">
                                            <span class="text-primary">@item.Code</span>
                                            @if (!string.IsNullOrEmpty(item.Description))
                                            {
                                                <small class="text-muted">@item.Description</small>
                                            }
                                        </div>
                                    </td>
                                    <td>@item.DiscountTypeDisplay</td>
                                    <td>
                                        <span>@item.DiscountDisplay</span>
                                        @if (!string.IsNullOrEmpty(item.MaxDiscountDisplay))
                                        {
                                            <br />
                                            <small class="text-muted">@item.MaxDiscountDisplay</small>
                                        }
                                    </td>
                                    <td>@item.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                    <td><small class="text-muted">@item.UsageLimitDisplay</small></td>
                                    <td>
                                        <span class="badge badge-status @item.StatusBadgeClass">
                                            @item.StatusDisplayDetailed
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-info btn-action btn-send-all me-1"
                                                    title="Gửi cho tất cả khách hàng"
                                                    data-coupon-code="@item.Code">
                                                <i class="bi bi-broadcast"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary btn-action btn-send me-1"
                                                    title="Gửi mã"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#sendCouponModal"
                                                    data-coupon-code="@item.Code">
                                                <i class="bi bi-send-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-success btn-action btn-edit me-1"
                                                    title="Sửa"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#couponModal"
                                                    data-id="@item.CouponID">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger btn-action btn-delete"
                                                    title="Xóa"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-id="@item.CouponID">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center gap-3">
                                        <div class="p-4 rounded-circle"
                                             style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                            <i class="bi bi-inbox" style="font-size: 2.8rem; color: #3b82f6;"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1 text-primary">Chưa có mã giảm giá nào</h6>
                                            <p class="text-muted mb-0">Hãy tạo mã đầu tiên để bắt đầu chương trình khuyến mãi.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>

@section modal{
    <!-- Modal Thêm/Sửa -->
    <div class="modal fade" id="couponModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title d-flex align-items-center gap-2" id="couponModalLabel">
                        <i class="bi bi-ticket-detailed"></i> Tạo mã giảm giá mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form class="row g-3" id="couponForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="CouponID" name="CouponID" value="0" />
                        <input type="hidden" id="IsActive" name="IsActive" value="true" />

                        <div class="col-md-8">
                            <label class="form-label fw-semibold text-primary">Mã giảm giá</label>
                            <input type="text" class="form-control" id="Code" name="Code" placeholder="Ví dụ: SALE20" required />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary w-100"
                                    id="generateCodeBtn">
                                <i class="bi bi-shuffle me-2"></i>Tạo mã ngẫu nhiên
                            </button>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary">Loại giảm giá</label>
                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="DiscountType" id="typePercent" value="percent" />
                                    <label class="form-check-label" for="typePercent">Phần trăm (%)</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="DiscountType" id="typeFixed" value="fixed" checked />
                                    <label class="form-check-label" for="typeFixed">Số tiền cố định (₫)</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary">
                                Giá trị <span id="valueUnit">(₫)</span>
                            </label>
                            <input type="text" class="form-control" id="DiscountValue" name="DiscountValue" placeholder="Nhập giá trị" required />
                            <small class="text-muted" id="valueHint">Nhập số tiền cố định (VD: 10000)</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary">Giá trị đơn hàng tối thiểu (₫)</label>
                            <input type="text" class="form-control" id="MinOrderValue" name="MinOrderValue" placeholder="Để trống nếu không giới hạn" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary">Giảm tối đa (cho loại %)</label>
                            <input type="text" class="form-control" id="MaxDiscountAmount" name="MaxDiscountAmount" placeholder="VD: 50000" />
                            <small class="text-muted">Áp dụng khi loại giảm là %</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary">Ngày kết thúc</label>
                            <input type="date" class="form-control" id="ExpiryDate" name="ExpiryDate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-primary">Giới hạn số lần sử dụng</label>
                            <input type="number" class="form-control" id="UsageLimit" name="UsageLimit" placeholder="Để trống = không giới hạn" min="1" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-primary">Mô tả</label>
                            <textarea class="form-control" id="Description" name="Description" rows="2" placeholder="Mô tả về mã giảm giá..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="couponStatus" checked />
                                <label class="form-check-label fw-semibold" for="couponStatus">Kích hoạt mã</label>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer p-4 border-top">
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-primary btn-pill px-4" id="btnSaveCoupon">
                        <i class="bi bi-check-circle me-1"></i>Lưu mã
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Xóa -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger">
                    <h5 class="modal-title text-white d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle"></i>Xác nhận xóa
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <div class="p-4 rounded-circle d-inline-flex"
                             style="background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);">
                            <i class="bi bi-trash3" style="font-size: 2.5rem; color: #dc2626;"></i>
                        </div>
                    </div>
                    <p class="mb-0">Bạn có chắc chắn muốn xóa mã giảm giá này không?</p>
                </div>
                <div class="modal-footer justify-content-center p-4 border-top">
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-danger btn-pill px-4" id="btnConfirmDelete">
                        <i class="bi bi-trash3 me-1"></i>Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Gửi mã -->
    <div class="modal fade" id="sendCouponModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-send-check"></i>Gửi mã giảm giá cho khách hàng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">
                        Bạn đang gửi mã:
                        <strong id="couponCodeToSend" class="text-danger"></strong>
                    </p>
                    <div class="mb-3">
                        <label for="customerSearch" class="form-label fw-semibold text-primary">Tìm kiếm khách hàng</label>
                        <input type="search" class="form-control" id="customerSearch" placeholder="Nhập tên hoặc email..." />
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0 fw-semibold text-primary">Chọn khách hàng:</label>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnSelectAll">
                                <i class="bi bi-check-all me-1"></i>Chọn tất cả
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" id="btnDeselectAll">
                                <i class="bi bi-x-circle me-1"></i>Bỏ chọn
                            </button>
                        </div>
                    </div>
                    <div id="customer-list-container"
                         style="max-height: 200px; overflow-y: auto"
                         class="border rounded p-2 bg-white">
                        <div class="text-center text-muted py-3">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span class="ms-2">Đang tải...</span>
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i>
                            Đã chọn: <strong id="selectedCount">0</strong> khách hàng
                        </small>
                    </div>
                </div>
                <div class="modal-footer p-4 border-top">
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary btn-pill px-4" id="btnSendToCustomers">
                        <i class="bi bi-send-fill me-1"></i>Gửi
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section scripts{
    <script>
        // Toast mini giống view Vận Chuyển
        function showNotification(message, type = 'info') {
            const old = document.querySelector('.dynamic-alert');
            if (old) old.remove();
            const iconMap = {
                'success': 'check-circle-fill',
                'danger': 'exclamation-triangle-fill',
                'info': 'info-circle-fill',
                'warning': 'exclamation-circle-fill'
            };
            const div = document.createElement('div');
            div.className = `alert alert-${type} alert-dismissible fade show dynamic-alert`;
            div.style.cssText = 'position:fixed;top:80px;right:20px;z-index:9999;min-width:320px;max-width:480px;box-shadow:0 15px 50px rgba(0,0,0,.25);border-radius:1.25rem;animation:slideIn .4s ease-out';
            div.innerHTML =
                `<div class="d-flex align-items-center gap-3">
                    <i class="bi bi-${iconMap[type]} fs-4"></i>
                    <span class="flex-grow-1">${message}</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                 </div>`;
            document.body.appendChild(div);
            setTimeout(() => {
                div.style.animation = 'slideOut .3s ease-out';
                setTimeout(() => div.remove(), 300);
            }, 5000);
        }

        (function () {
            const couponModalEl      = document.getElementById("couponModal");
            const deleteModalEl      = document.getElementById("deleteModal");
            const sendCouponModalEl  = document.getElementById("sendCouponModal");
            const form               = document.getElementById("couponForm");

            let currentDeleteId = 0;
            let currentCouponCode = '';
            let selectedCustomers = [];

            // ---- helpers ----
            function formatNumberInput(input, allowDecimal = false, enforceDiscountRules = false) {
                if (!input) return;
                input.oninput = function () {
                    let value = this.value || '';

                    if (allowDecimal) {
                        value = value.replace(/[^0-9.]/g, '');
                        const parts = value.split('.');
                        if (parts.length > 2) value = parts[0] + '.' + parts.slice(1).join('');
                        if (parts[1] && parts[1].length > 2) value = parts[0] + '.' + parts[1].substring(0, 2);
                    } else {
                        value = value.replace(/[^0-9]/g, '');
                    }

                    this.value = value;

                    if (!enforceDiscountRules) return;

                    const numValue = parseFloat(this.value || '0');
                    const discountType = document.querySelector('input[name="DiscountType"]:checked')?.value;

                    if (discountType === 'percent') {
                        if (numValue > 100) { showNotification('Giá trị % không vượt quá 100', 'warning'); this.value = '100'; }
                        if (numValue <= 0)   { showNotification('Giá trị % phải > 0', 'warning'); this.value = ''; }
                    } else {
                        if (numValue && numValue < 1000) { showNotification('Giá trị giảm tối thiểu là 1,000đ', 'warning'); this.value = '1000'; }
                    }
                };
            }

            const discountValueInput     = document.getElementById('DiscountValue');
            const minOrderValueInput     = document.getElementById('MinOrderValue');
            const maxDiscountAmountInput = document.getElementById('MaxDiscountAmount');
            const valueUnit              = document.getElementById('valueUnit');
            const valueHint              = document.getElementById('valueHint');

            formatNumberInput(minOrderValueInput, false, false);
            formatNumberInput(maxDiscountAmountInput, false, false);
            formatNumberInput(discountValueInput, false, true); // mặc định: fixed

            document.querySelectorAll('input[name="DiscountType"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    const isPercent = this.value === 'percent';
                    valueUnit.textContent = isPercent ? '(%)' : '(₫)';
                    valueHint.textContent = isPercent
                        ? 'Nhập phần trăm từ 0.01 đến 100 (VD: 15.5)'
                        : 'Nhập số tiền cố định (VD: 10000)';
                    discountValueInput.placeholder = isPercent ? 'VD: 15.5' : 'VD: 10000';
                    discountValueInput.value = '';
                    formatNumberInput(discountValueInput, isPercent, true);
                });
            });

            // Tạo code ngẫu nhiên
            document.getElementById("generateCodeBtn").addEventListener("click", () => {
                fetch('@Url.Action("GenerateCode", "Coupon")', { credentials: 'same-origin' })
                    .then(res => res.json())
                    .then(data => { document.getElementById('Code').value = data.code; })
                    .catch(err => {
                        console.error('Error generating code:', err);
                        showNotification('Không thể tạo mã tự động', 'danger');
                    });
            });

            // Nút tạo mới
            document.getElementById('btnCreateNew').addEventListener('click', () => {
                document.getElementById('couponModalLabel').textContent = 'Tạo mã giảm giá mới';
                form.reset();
                document.getElementById('CouponID').value = '0';
                document.getElementById('Code').readOnly = false;
                document.getElementById('typeFixed').checked = true;
                document.getElementById('couponStatus').checked = true;
                document.getElementById('IsActive').value = 'true';
                valueUnit.textContent = '(₫)';
                valueHint.textContent = 'Nhập số tiền cố định (VD: 10000)';
                formatNumberInput(discountValueInput, false, true);
            });

            // Edit
            document.querySelectorAll('.btn-edit').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    fetch('@Url.Action("Edit", "Coupon")/' + id, { credentials: 'same-origin' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.error) {
                                showNotification('Lỗi: ' + data.error, 'danger');
                                return;
                            }

                            document.getElementById('couponModalLabel').textContent = 'Chỉnh sửa mã giảm giá';
                            document.getElementById('CouponID').value = data.couponID;
                            document.getElementById('Code').value = data.code;
                            document.getElementById('Code').readOnly = true;
                            document.getElementById('DiscountValue').value = data.discountValue;
                            document.getElementById('ExpiryDate').value = data.expiryDate;
                            document.getElementById('MinOrderValue').value = data.minOrderValue || '';
                            document.getElementById('UsageLimit').value = data.usageLimit || '';
                            document.getElementById('Description').value = data.description || '';
                            document.getElementById('MaxDiscountAmount').value = data.maxDiscountAmount || '';
                            document.getElementById('couponStatus').checked = !!data.isActive;
                            document.getElementById('IsActive').value = data.isActive ? 'true' : 'false';

                            const isPercent = data.discountType === 'percent';
                            document.getElementById(isPercent ? 'typePercent' : 'typeFixed').checked = true;
                            valueUnit.textContent = isPercent ? '(%)' : '(₫)';
                            valueHint.textContent = isPercent
                                ? 'Nhập phần trăm từ 0.01 đến 100 (VD: 15.5)'
                                : 'Nhập số tiền cố định (VD: 10000)';
                            formatNumberInput(discountValueInput, isPercent, true);

                            // Đảm bảo modal được mở sau khi load dữ liệu
                            if (couponModalEl && window.bootstrap) {
                                var modal = bootstrap.Modal.getOrCreateInstance(couponModalEl);
                                modal.show();
                            }
                        })
                        .catch(err => {
                            console.error('Error loading coupon:', err);
                            showNotification('Không thể tải thông tin mã giảm giá', 'danger');
                        });
                });
            });

            // Toggle kích hoạt
            document.getElementById('couponStatus').addEventListener('change', function() {
                document.getElementById('IsActive').value = this.checked ? 'true' : 'false';
            });

            // Lưu
            document.getElementById('btnSaveCoupon').addEventListener('click', function() {
                if (!form.checkValidity()) { form.reportValidity(); return; }

                const discountValue = parseFloat(document.getElementById('DiscountValue').value);
                const discountType = document.querySelector('input[name="DiscountType"]:checked').value;

                if (isNaN(discountValue) || discountValue <= 0) {
                    showNotification('Vui lòng nhập giá trị giảm hợp lệ!', 'warning');
                    return;
                }
                if (discountType === 'percent' && discountValue > 100) {
                    showNotification('Giá trị phần trăm không được vượt quá 100%!', 'warning');
                    return;
                }
                if (discountType === 'fixed' && discountValue < 1000) {
                    showNotification('Giá trị giảm tối thiểu là 1,000₫!', 'warning');
                    return;
                }

                const formData = new FormData(form);
                const id = document.getElementById('CouponID').value;
                const url = id === '0' ? '@Url.Action("Create", "Coupon")' : '@Url.Action("Edit", "Coupon")';

                const btn = this;
                const old = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

                fetch(url, { method: 'POST', credentials: 'same-origin', body: formData })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showNotification(data.message || 'Lưu mã thành công', 'success');
                            bootstrap.Modal.getInstance(couponModalEl).hide();
                            setTimeout(() => location.reload(), 700);
                        } else {
                            showNotification(data.message || 'Không thể lưu mã', 'danger');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showNotification('Có lỗi xảy ra khi lưu mã', 'danger');
                    })
                    .finally(() => {
                        btn.disabled = false;
                        btn.innerHTML = old;
                    });
            });

            // Xóa
            document.querySelectorAll('.btn-delete').forEach(btn => {
                btn.addEventListener('click', function() { currentDeleteId = this.dataset.id; });
            });

            document.getElementById('btnConfirmDelete').addEventListener('click', function() {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const btn = this;
                const old = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xóa...';

                fetch('@Url.Action("Delete", "Coupon")/' + currentDeleteId, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: '__RequestVerificationToken=' + encodeURIComponent(token)
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showNotification(data.message || 'Xóa thành công', 'success');
                        bootstrap.Modal.getInstance(deleteModalEl).hide();
                        const row = document.querySelector(`tr[data-id="${currentDeleteId}"]`);
                        if (row) row.remove();

                        const tbody = document.getElementById('coupons-table-body');
                        if (!tbody.querySelector('tr')) {
                            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Chưa có mã giảm giá nào</td></tr>';
                        }
                    } else {
                        showNotification(data.message || 'Không thể xóa', 'danger');
                    }
                })
                .catch(err => {
                    console.error(err);
                    showNotification('Có lỗi xảy ra khi xóa mã', 'danger');
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = old;
                });
            });

            // Gửi mã
            const customerSearchInput   = document.getElementById("customerSearch");
            const customerListContainer = document.getElementById("customer-list-container");

            // Mở modal gửi mã khi bấm nút "Gửi mã" trên từng dòng
            document.querySelectorAll('.btn-send').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const code = this.dataset.couponCode;
                    currentCouponCode = code || '';
                    document.getElementById("couponCodeToSend").textContent = currentCouponCode;
                    selectedCustomers = [];
                    customerSearchInput.value = '';

                    if (sendCouponModalEl && window.bootstrap) {
                        const modal = bootstrap.Modal.getOrCreateInstance(sendCouponModalEl);
                        modal.show();
                    }
                    loadCustomers();
                });
            });

            function loadCustomers(search = '') {
                customerListContainer.innerHTML =
                    '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm" role="status"></div><span class="ms-2">Đang tải...</span></div>';

                fetch('@Url.Action("GetCustomers", "Coupon")?search=' + encodeURIComponent(search), { credentials: 'same-origin' })
                    .then(res => res.json())
                    .then(data => {
                        customerListContainer.innerHTML = '';

                        if (data.error) {
                            customerListContainer.innerHTML = '<p class="text-center text-danger py-3">Lỗi: ' + data.error + '</p>';
                            return;
                        }

                        if (!Array.isArray(data) || data.length === 0) {
                            customerListContainer.innerHTML = '<p class="text-center text-muted py-3">Không tìm thấy khách hàng</p>';
                            updateSelectedCount();
                            return;
                        }

                        data.forEach(customer => {
                            const div = document.createElement('div');
                            div.className = 'form-check list-group-item-customer';
                            const isChecked = selectedCustomers.includes(customer.userID) ? 'checked' : '';
                            div.innerHTML = `
                                <input class="form-check-input customer-checkbox" type="checkbox" value="${customer.userID}" id="cust${customer.userID}" ${isChecked}>
                                <label class="form-check-label" for="cust${customer.userID}">
                                    ${customer.fullName} (${customer.email})
                                </label>
                            `;
                            customerListContainer.appendChild(div);
                        });

                        document.querySelectorAll('.customer-checkbox').forEach(cb => {
                            cb.addEventListener('change', function() {
                                const id = parseInt(this.value);
                                if (this.checked) {
                                    if (!selectedCustomers.includes(id)) selectedCustomers.push(id);
                                } else {
                                    selectedCustomers = selectedCustomers.filter(x => x !== id);
                                }
                                updateSelectedCount();
                            });
                        });

                        updateSelectedCount();
                    })
                    .catch(err => {
                        console.error('Error loading customers:', err);
                        customerListContainer.innerHTML = '<p class="text-center text-danger py-3">Không thể tải danh sách khách hàng</p>';
                    });
            }

            function updateSelectedCount() {
                document.getElementById('selectedCount').textContent = selectedCustomers.length;
            }

            document.getElementById('btnSelectAll').addEventListener('click', function() {
                document.querySelectorAll('.customer-checkbox').forEach(cb => {
                    cb.checked = true;
                    const id = parseInt(cb.value);
                    if (!selectedCustomers.includes(id)) selectedCustomers.push(id);
                });
                updateSelectedCount();
            });

            document.getElementById('btnDeselectAll').addEventListener('click', function() {
                document.querySelectorAll('.customer-checkbox').forEach(cb => cb.checked = false);
                selectedCustomers = [];
                updateSelectedCount();
            });

            let searchTimeout;
            customerSearchInput.addEventListener("input", function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => loadCustomers(this.value), 500);
            });

            document.getElementById('btnSendToCustomers').addEventListener('click', function() {
                if (selectedCustomers.length === 0) {
                    showNotification('Vui lòng chọn ít nhất 1 khách hàng!', 'warning');
                    return;
                }
                sendCouponToCustomers(currentCouponCode, selectedCustomers);
            });

            document.querySelectorAll('.btn-send-all').forEach(btn => {
                btn.addEventListener('click', function() {
                    const code = this.dataset.couponCode;
                    if (!confirm(`Bạn có chắc muốn gửi mã "${code}" cho TẤT CẢ khách hàng?`)) return;
                    sendCouponToCustomers(code, null, true);
                });
            });

            function sendCouponToCustomers(couponCode, customerIds, sendToAll = false) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('couponCode', couponCode);

                if (sendToAll) {
                    formData.append('sendToAll', 'true');
                } else if (customerIds && customerIds.length > 0) {
                    customerIds.forEach(id => formData.append('customerIds', id));
                }

                const sendBtn = document.getElementById('btnSendToCustomers');
                const originalText = sendBtn.innerHTML;
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi...';

                fetch('@Url.Action("SendToCustomers", "Coupon")', {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showNotification(data.message || 'Gửi mã thành công', 'success');
                        if (sendCouponModalEl.classList.contains('show')) {
                            bootstrap.Modal.getInstance(sendCouponModalEl).hide();
                        }
                        selectedCustomers = [];
                    } else {
                        showNotification(data.message || 'Không thể gửi mã', 'danger');
                    }
                })
                .catch(err => {
                    console.error(err);
                    showNotification('Có lỗi xảy ra khi gửi mã', 'danger');
                })
                .finally(() => {
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = originalText;
                });
            }

            // Min date = hôm nay
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('ExpiryDate').setAttribute('min', today);

            // Auto uppercase cho Code
            document.getElementById('Code').addEventListener('input', function() {
                this.value = (this.value || '').toUpperCase();
            });

            // Tooltip cho các nút có title
            if (typeof bootstrap !== 'undefined') {
                [...document.querySelectorAll('[title]')].forEach(el => {
                    el.setAttribute('data-bs-toggle', 'tooltip');
                    el.setAttribute('data-bs-placement', 'top');
                });
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(el => new bootstrap.Tooltip(el));
            }
        })();
    </script>
}
