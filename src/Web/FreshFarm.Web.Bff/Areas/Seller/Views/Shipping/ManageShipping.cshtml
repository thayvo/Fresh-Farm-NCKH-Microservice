            <div>
                <div class="small text-white-50 fw-bold text-uppercase">Seller Shipping</div>
                <h5 class="fw-bold mb-0" id="shippingHelpTitle">Hướng dẫn sử dụng</h5>
            </div>
            <button type="button" class="btn-close btn-close-white" id="shippingHelpClose" aria-label="Đóng hướng dẫn"></button>
        </div>
        <div class="shipping-help-panel-body">
            <div class="shipping-help-item">
                <div class="fw-bold text-primary-blue mb-1">Bản ghi vận chuyển đã được tạo tự động theo đơn hàng</div>
                <div class="text-muted">Trang này chỉ dùng để xác nhận shop đã chuẩn bị hàng và sẵn sàng bàn giao cho đơn vị vận chuyển.</div>
            </div>
            <div class="shipping-help-item">
                <div class="text-uppercase small fw-bold text-muted mb-1">Phạm vi trang</div>
                <h6 class="fw-bold text-primary-blue mb-2">Sau khi đơn đã chốt</h6>
                <p class="text-muted mb-0">Không xử lý thanh toán, hủy đơn hoặc sửa địa chỉ tại đây. Những việc đó thuộc Quản lý đơn hàng.</p>
            </div>
            <div class="shipping-help-item">
                <div class="text-uppercase small fw-bold text-muted mb-1">Seller cần làm gì</div>
                <h6 class="fw-bold text-success mb-2">Đóng gói và bàn giao</h6>
                <p class="text-muted mb-0">Kiểm tra thông tin giao hàng đã chốt, chuẩn bị hàng, rồi bấm xác nhận sẵn sàng bàn giao.</p>
            </div>
        </div>
    </aside>

    <div class="container-fluid py-4">

        <div class="grad-header p-4 p-md-5 mb-4 position-relative">
            <div class="position-relative" style="z-index: 1;">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="p-3 rounded-4 icon-gradient">
                                <i class="bi bi-box-seam text-white" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h1 class="fw-bold mb-1 text-white" style="font-size: 2.5rem; text-shadow: 0 4px 12px rgba(0,0,0,0.3);">Vận chuyển & bàn giao</h1>
                                <p class="mb-0 text-white opacity-90" style="font-size: 1.125rem; text-shadow: 0 2px 8px rgba(0,0,0,0.2);">Không trùng Quản lý đơn hàng: chỉ bàn giao, theo dõi vận chuyển và đối chiếu GHN</p>
                            </div>
                        </div>
                    </div>
                    @*<button type="button" class="btn btn-success btn-pill shadow-lg d-flex align-items-center gap-2 hover-scale" id="btnAddNew" data-bs-toggle="modal" data-bs-target="#addShippingModal" style="font-size: 1.125rem; white-space: nowrap;">
                        <i class="bi bi-plus-circle" style="font-size: 1.5rem;"></i>
                        <span>Thêm vận chuyển</span>
                    </button>*@
                </div>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="handoff-kpi-row mb-4">
            <div class="handoff-kpi">
                <div class="text-muted small fw-bold mb-2">Cần chuẩn bị</div>
                <div class="kpi-value">@needPrepareCount</div>
            </div>
            <div class="handoff-kpi">
                <div class="text-muted small fw-bold mb-2">Chờ shipper lấy</div>
                <div class="kpi-value text-primary">@waitingPickupCount</div>
            </div>
            <div class="handoff-kpi">
                <div class="text-muted small fw-bold mb-2">Đang vận chuyển</div>
                <div class="kpi-value text-info">@inTransitCount</div>
            </div>
            <div class="handoff-kpi">
                <div class="text-muted small fw-bold mb-2">Có mã GHN</div>
                <div class="kpi-value text-success">@ghnTrackedCount</div>
            </div>
        </div>

        <div class="filter-card p-4 mb-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-3 rounded-3" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
                    <i class="bi bi-funnel text-white" style="font-size: 1.25rem;"></i>
                </div>
                <h5 class="mb-0 fw-bold text-primary-blue">Bộ lọc bàn giao</h5>
            </div>
            <form method="get" class="row g-4" id="filterForm">
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="sort" value="@ViewBag.CurrentSort" />

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-list-check me-2"></i> Trạng thái vận hành</label>
                    <select name="status" id="status" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(currentStatus)  ? "selected" : null)">Tất cả trạng thái</option>
                        <option value="Pending" selected="@(currentStatus == "Pending"  ? "selected" : null)">Chờ xử lý</option>
                        <option value="Processing" selected="@(currentStatus == "Processing"  ? "selected" : null)">Đang xử lý</option>
                        <option value="Ready" selected="@(currentStatus == "Ready"  ? "selected" : null)">Chờ shipper lấy</option>
                        <option value="Shipped" selected="@(currentStatus == "Shipped"  ? "selected" : null)">Đang giao hàng</option>
                        <option value="Delivered" selected="@(currentStatus == "Delivered"  ? "selected" : null)">Đã giao hàng</option>
                        <option value="Canceled" selected="@(currentStatus == "Canceled"  ? "selected" : null)">Đã hủy</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3" id="deliveredStateWrap" style="display:@(currentStatus == "Delivered" ? "block" : "none")">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-check2-square me-2"></i> Tình trạng đối soát</label>
                    <select name="deliveredState" id="deliveredState" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(deliveredState)  ? "selected" : null)">Tất cả</option>
                        <option value="pending" selected="@(deliveredState == "pending"  ? "selected" : null)">⏰ Chưa đối soát</option>
                        <option value="done" selected="@(deliveredState == "done"  ? "selected" : null)">✓ Đã đối soát</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-search me-2"></i> Tìm kiếm</label>
                    <div class="search-icon-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control" name="q" value="@ViewBag.CurrentQuery" placeholder="Mã đơn, người nhận, SĐT..." />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label fw-semibold text-primary-blue"><i class="bi bi-grid-3x3 me-2"></i> Số dòng/trang</label>
                    <select name="pageSize" class="form-select">
                        <option value="10" selected="@(pageSize == 10  ? "selected" : null)">10 dòng</option>
                        <option value="20" selected="@(pageSize == 20  ? "selected" : null)">20 dòng</option>
                        <option value="50" selected="@(pageSize == 50  ? "selected" : null)">50 dòng</option>
                    </select>
                </div>

                <div class="col-12 col-lg-3 ms-auto d-grid d-lg-flex justify-content-lg-end align-items-end">
                    <button type="submit" class="btn btn-primary btn-pill px-5 d-flex align-items-center justify-content-center gap-2 hover-scale">
                        <i class="bi bi-funnel-fill"></i>
                        <span>Áp dụng</span>
                    </button>
                </div>
            </form>
        </div>

        <div class="card-glass overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern">
                    <thead>
                        <tr>
                            <th class="px-4">#</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Seller", page = 1, status = currentStatus, deliveredState = deliveredState, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "code_asc" ? "code_desc" : "code_asc") })">
                                    <i class="bi bi-box-seam"></i> Mã đơn hàng
                                </a>
                            </th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Seller", page = 1, status = currentStatus, deliveredState = deliveredState, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "receiver_asc" ? "receiver_desc" : "receiver_asc") })">
                                    <i class="bi bi-person"></i> Người nhận
                                </a>
                            </th>
                            <th class="px-4"><i class="bi bi-telephone me-1"></i> SĐT</th>
                            <th class="px-4"><i class="bi bi-geo-alt me-1"></i> Địa chỉ</th>
                            <th class="px-4">
                                <a class="text-decoration-none d-flex align-items-center gap-2" href="@Url.Action("ManageShipping", "Shipping", new { area = "Seller", page = 1, status = currentStatus, deliveredState = deliveredState, q = ViewBag.CurrentQuery, pageSize = pageSize, sort = (ViewBag.CurrentSort == "status_asc" ? "status_desc" : "status_asc") })">
                                    <i class="bi bi-info-circle"></i> Bàn giao / GHN
                                </a>
                            </th>
                            <th class="text-center px-4"><i class="bi bi-gear me-1"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var list = shippingRows;
                            if (list.Any())
                            {
                                var startIndex = (currentPage - 1) * pageSize + 1;
                                var i = 0;
                                foreach (var item in list)
                                {
                                    var hasGhnTrackingCode = !string.IsNullOrWhiteSpace(item.GhnOrderCode) || !string.IsNullOrWhiteSpace(item.GhnClientOrderCode);
                                    <tr data-order-status="@((item.Order?.Status ?? "").ToLower())"
                                        data-ghn-order-label="@("#DH" + item.OrderID.ToString().PadLeft(5, '0'))"
                                        data-ghn-order-id="@item.OrderID"
                                        data-ghn-name="@item.FullName"
                                        data-ghn-phone="@item.Phone"
                                        data-ghn-address="@item.AddressDetail"
                                        data-ghn-province-name="@item.Province?.ProvinceName"
                                        data-ghn-commune-name="@item.Commune?.CommuneName"
                                        data-ghn-shipping-fee="@((item.Order?.ShippingFee ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-items-amount="@((item.Order?.ItemsAmount ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-total-amount="@((item.Order?.TotalAmount ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-total-quantity="@((item.Order?.TotalQuantity ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-item-summary="@item.Order?.ItemSummary"
                                        data-ghn-package-weight="@((item.Order?.PackageWeight ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-package-length="@((item.Order?.PackageLength ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-package-width="@((item.Order?.PackageWidth ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-package-height="@((item.Order?.PackageHeight ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-is-cod="@((item.Order?.Payments?.Any(p => p.PaymentMethod == "COD") ?? false).ToString().ToLower())"
                                        data-ghn-order-code="@item.GhnOrderCode"
                                        data-ghn-client-order-code="@item.GhnClientOrderCode"
                                        data-ghn-status="@item.GhnStatus"
                                        data-ghn-status-label="@item.GhnStatusLabel"
                                        data-ghn-total-fee="@((item.GhnTotalFee ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                        data-ghn-expected-delivery-at="@(item.GhnExpectedDeliveryTime?.ToString("O") ?? string.Empty)"
                                        data-ghn-last-synced-at="@(item.GhnLastSyncedAt?.ToString("O") ?? string.Empty)">
                                        <td class="px-4"><span class="badge bg-primary-blue text-white border">@(startIndex + i)</span></td>
                                        <td class="px-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-box-seam text-primary" style="font-size: 1.25rem;"></i>
                                                <span class="order-code">@("#DH" + item.OrderID.ToString().PadLeft(5, '0'))</span>
                                            </div>
                                        </td>
                                        <td class="px-4"><span class="fw-semibold text-primary-blue">@item.FullName</span></td>
                                        <td class="px-4"><div class="d-flex align-items-center gap-2"><i class="bi bi-telephone-fill text-success"></i><span class="font-monospace">@item.Phone</span></div></td>
                                        <td class="px-4">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                                <div class="text-truncate" style="max-width:340px">
                                                    <span class="fw-medium">@(!string.IsNullOrWhiteSpace(item.AddressDetail) ? item.AddressDetail : "Chưa có địa chỉ giao hàng")</span>
                                                    @if (item.Commune != null)
                                                    {<text>, @item.Commune.CommuneName</text>}
                                                    @if (item.Province != null)
                                                    {<text>, @item.Province.ProvinceName</text>}
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-4">
                                            <div class="d-flex flex-column gap-2">
                                                @RenderStatus(item.Order)
                                                @if (hasGhnTrackingCode)
                                                {
                                                    <div class="small text-muted">
                                                        <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle mb-1">
                                                            GHN: @(item.GhnStatusLabel ?? item.GhnStatus ?? "Đã tạo vận đơn")
                                                        </span>
                                                        <div class="font-monospace">@(!string.IsNullOrWhiteSpace(item.GhnOrderCode) ? item.GhnOrderCode : item.GhnClientOrderCode)</div>
                                                        @if (item.GhnTotalFee is decimal ghnTotalFee)
                                                        {
                                                            <div>Phí hãng: @ghnTotalFee.ToString("N0") đ</div>
                                                        }
                                                        @if (item.GhnExpectedDeliveryTime is DateTime expectedDelivery)
                                                        {
                                                            <div>Thời gian dự kiến: @expectedDelivery.ToString("dd/MM/yyyy HH:mm")</div>
                                                        }
                                                        @if (item.GhnLastSyncedAt is DateTime lastSynced)
                                                        {
                                                            <div>Đồng bộ: @lastSynced.ToString("dd/MM/yyyy HH:mm")</div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="tracking-note">
                                                        <i class="bi bi-broadcast"></i>
                                                        Chưa có mã GHN
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center px-4">
                                            <div class="d-flex justify-content-center gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-success btn-action btn-mark-ready-row" data-orderid="@item.OrderID" title="Xác nhận sẵn sàng bàn giao" aria-label="Xác nhận sẵn sàng bàn giao"><i class="bi bi-box-seam"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-primary btn-action btn-ghn-tracking-row" data-orderid="@item.OrderID" title="Xem chi tiết vận đơn GHN" aria-label="Xem chi tiết vận đơn GHN" disabled="@(!hasGhnTrackingCode)">
                                                    <i class="bi bi-clock-history"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center gap-3">
                                            <div class="p-4 rounded-circle" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);">
                                                <i class="bi bi-inbox" style="font-size: 3rem; color: #3b82f6;"></i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold mb-1 text-primary-blue">Chưa có dữ liệu</h5>
                                                <p class="text-muted mb-0">Chưa có thông tin vận chuyển nào được tìm thấy.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between px-4 py-4 border-top" style="background: linear-gradient(90deg, #f0f9ff 0%, #dbeafe 100%);">
                    <div class="text-muted mb-3 mb-md-0">
                        <i class="bi bi-journals me-2 text-primary"></i>
                        Trang <span class="fw-bold text-primary-blue">@currentPage</span> / <span class="fw-bold text-primary-blue">@totalPages</span>
                        <span class="mx-2">•</span>
                        Tổng <span class="fw-bold text-primary-blue">@totalItems</span> mục
                    </div>
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Seller", page = currentPage - 1, status = currentStatus, deliveredState = deliveredState, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @{ int start = Math.Max(1, currentPage - 2); int end = Math.Min(totalPages, currentPage + 2); }
                        @for (int p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Seller", page = p, status = currentStatus, deliveredState = deliveredState, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ManageShipping", "Shipping", new { area = "Seller", page = currentPage + 1, status = currentStatus, deliveredState = deliveredState, q = ViewBag.CurrentQuery, sort = ViewBag.CurrentSort, pageSize = pageSize })"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="confirmReadyHandoffModal" tabindex="-1" aria-labelledby="confirmReadyHandoffTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0">
                <div>
                    <div class="text-uppercase small fw-bold text-white-50 mb-1">Xác nhận bàn giao</div>
                    <h5 class="modal-title fw-bold text-white" id="confirmReadyHandoffTitle">Đơn hàng đã sẵn sàng cho shipper lấy?</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info border-0 rounded-4 mb-3">
                    Chỉ xác nhận khi shop đã đóng gói xong và có thể bàn giao cho đơn vị vận chuyển.
                </div>
                <div class="p-3 rounded-4 bg-light border">
                    <div class="d-flex justify-content-between gap-3 mb-2">
                        <span class="text-muted">Mã đơn</span>
                        <strong id="confirmReadyHandoffOrderLabel">Chưa chọn</strong>
                    </div>
                    <div class="d-flex justify-content-between gap-3 mb-2">
                        <span class="text-muted">Người nhận</span>
                        <strong id="confirmReadyHandoffRecipient" class="text-end">Chưa có</strong>
                    </div>
                    <div class="small text-muted">Địa chỉ giao</div>
                    <div id="confirmReadyHandoffAddress" class="fw-medium mt-1">Chưa có địa chỉ giao hàng</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success rounded-pill px-4" id="btnConfirmReadyHandoff">
                    <i class="bi bi-check2-circle me-2"></i>Xác nhận sẵn sàng bàn giao
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ghnTrackingDetailModal" tabindex="-1" aria-labelledby="ghnTrackingDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0">
                <div>
                    <div class="text-uppercase small fw-bold text-white-50 mb-1">GHN sandbox</div>
                    <h5 class="modal-title fw-bold text-white" id="ghnTrackingDetailTitle">Chi tiết vận đơn GHN</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="alert alert-primary border-0 rounded-4 mb-3">
                    Dữ liệu lấy từ môi trường sandbox để seller kiểm tra trạng thái, kho và log vận đơn. Nếu địa chỉ khách hàng sai, trang chỉ báo để kiểm tra lại ở đúng luồng quản lý đơn hàng.
                </div>
                <div id="ghnTrackingDetailBody">
                    <div class="d-flex align-items-center gap-3 p-4 rounded-4 bg-white border">
                        <span class="spinner-border spinner-border-sm text-primary"></span>
                        <span class="fw-semibold text-primary-blue">Đang tải chi tiết vận đơn...</span>
                    </div>
                </div>
                <div class="visually-hidden">
                    Kho hiện tại
                    Khối lượng
                    Dài / rộng / cao
                    Log trạng thái GHN
                </div>
            </div>
        </div>
    </div>
</div>

<div class="visually-hidden" aria-hidden="true">
    <input type="hidden" id="ghnSelectedOrderId" />
    <input type="hidden" id="ghnToName" />
    <input type="hidden" id="ghnToPhone" />
    <input type="hidden" id="ghnToAddress" />
    <select id="ghnProvinceId"></select>
    <select id="ghnDistrictId"></select>
    <select id="ghnWardCode"></select>
    <span id="ghnRecipientLocationStatus"></span>
</div>

@section scripts {
    <script>
        function showNotification(message, type = 'info') {
            const old = document.querySelector('.dynamic-alert'); if (old) old.remove();
            const iconMap = { 'success': 'check-circle-fill', 'danger': 'exclamation-triangle-fill', 'info': 'info-circle-fill', 'warning': 'exclamation-circle-fill' };
            const div = document.createElement('div');
            div.className = `alert alert-${type} alert-dismissible fade show dynamic-alert`;
            div.style.cssText = 'position:fixed;top:80px;right:20px;z-index:9999;min-width:320px;max-width:500px;box-shadow:0 15px 50px rgba(0,0,0,.25);border-radius:1.25rem;animation:slideIn .4s ease-out';
            div.innerHTML = `<div class="d-flex align-items-center gap-3"><i class="bi bi-${iconMap[type]} fs-4"></i><span class="flex-grow-1">${message}</span><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
            document.body.appendChild(div);
            setTimeout(() => { div.style.animation = 'slideOut .3s ease-out'; setTimeout(() => div.remove(), 300); }, 5000);
        }
        function getToken() { const t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
        function formatCurrency(value) {
            const amount = Number(value);
            if (!Number.isFinite(amount)) return 'Chưa có';
            return `${amount.toLocaleString('vi-VN')} đ`;
        }
        function formatDateTime(value) {
            if (!value) return 'Chưa có';
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return String(value);
            return date.toLocaleString('vi-VN');
        }
        function formatResult(data) {
            if (typeof data === 'string') return data;
            if (!data || typeof data !== 'object') return 'Chưa có dữ liệu.';

            if (Object.prototype.hasOwnProperty.call(data, 'pickupAddress') || Object.prototype.hasOwnProperty.call(data, 'hasGhnOrigin')) {
                return [
                    `Trạng thái: ${data.hasGhnOrigin ? 'Đã lưu địa chỉ lấy hàng' : 'Chưa lưu địa chỉ lấy hàng'}`,
                    `Cửa hàng: ${data.storeName || 'Chưa có'}`,
                    `Người liên hệ: ${data.pickupName || 'Chưa có'}`,
                    `Số điện thoại: ${data.pickupPhone || 'Chưa có'}`,
                    `Địa chỉ: ${[data.pickupAddress, data.wardName, data.districtName, data.provinceName].filter(Boolean).join(', ') || 'Chưa có'}`
                ].join('\n');
            }

            if (Object.prototype.hasOwnProperty.call(data, 'totalFee') || Object.prototype.hasOwnProperty.call(data, 'leadTime')) {
                return [
                    `Phí giao hàng dự kiến: ${formatCurrency(data.totalFee)}`,
                    `Phí dịch vụ chính: ${formatCurrency(data.mainServiceFee)}`,
                    `Bảo hiểm: ${formatCurrency(data.insuranceFee)}`,
                    `Loại dịch vụ: ${data.serviceName || 'Chưa có'}`,
                    `Thời gian giao dự kiến: ${formatDateTime(data.leadTime)}`,
                    `Thông báo: ${data.message || 'Không có'}`
                ].join('\n');
            }

            if (Object.prototype.hasOwnProperty.call(data, 'orderCode') || Object.prototype.hasOwnProperty.call(data, 'clientOrderCode')) {
                return [
                    `Tạo vận đơn: ${data.success ? 'Thành công' : 'Chưa thành công'}`,
                    `Mã vận đơn: ${data.orderCode || 'Chưa có'}`,
                    `Mã theo dõi nội bộ: ${data.clientOrderCode || 'Chưa có'}`,
                    `Loại dịch vụ: ${data.serviceName || 'Chưa có'}`,
                    `Phí giao hàng: ${formatCurrency(data.totalFee)}`,
                    `Thời gian giao dự kiến: ${formatDateTime(data.expectedDeliveryTime)}`,
                    `Thông báo: ${data.message || 'Không có'}`
                ].join('\n');
            }

            if (Object.prototype.hasOwnProperty.call(data, 'status') || Object.prototype.hasOwnProperty.call(data, 'statusLabel')) {
                return [
                    `Mã vận đơn: ${data.orderCode || 'Chưa có'}`,
                    `Mã theo dõi nội bộ: ${data.clientOrderCode || 'Chưa có'}`,
                    `Trạng thái: ${data.statusLabel || data.status || 'Chưa có'}`,
                    `Người nhận: ${data.toName || 'Chưa có'}`,
                    `Số điện thoại: ${data.toPhone || 'Chưa có'}`,
                    `Địa chỉ giao: ${data.toAddress || 'Chưa có'}`,
                    `Thu hộ COD: ${formatCurrency(data.codAmount)}`,
                    `Ngày tạo: ${formatDateTime(data.createdDate)}`,
                    `Dự kiến giao: ${formatDateTime(data.leadTime)}`,
                    `Thông báo: ${data.message || 'Không có'}`
                ].join('\n');
            }

            return JSON.stringify(data, null, 2);
        }
        function setResult(id, data) {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = formatResult(data);
        }
        function buildUrl(base, params) {
            const url = new URL(base, window.location.origin);
            Object.entries(params || {}).forEach(([key, value]) => {
                if (value !== null && value !== undefined && value !== '') {
                    url.searchParams.set(key, value);
                }
            });
            return url.toString();
        }
        function setShippingHelpOpen(isOpen) {
            const panel = document.getElementById('shippingHelpPanel');
            const button = document.getElementById('shippingHelpButton');
            if (!panel || !button) return;
            panel.hidden = !isOpen;
            button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            document.querySelector('.shipping-help-widget')?.classList.toggle('is-open', isOpen);
        }
        let pendingReadyHandoffButton = null;
        function getRowCellText(row, index) {
            return row?.children?.[index]?.innerText?.replace(/\s+/g, ' ').trim() || '';
        }
        function openReadyHandoffModal(button) {
            const row = button.closest('tr');
            if (!row) {
                showNotification('Không xác định được đơn hàng cần xác nhận.', 'danger');
                return;
            }

            pendingReadyHandoffButton = button;
            const orderLabel = row.dataset.ghnOrderLabel || row.querySelector('.order-code')?.innerText?.trim() || `#${button.dataset.orderid || ''}`;
            const recipient = row.dataset.ghnName || getRowCellText(row, 2) || 'Chưa có';
            const address = row.dataset.ghnAddress || getRowCellText(row, 4) || 'Chưa có địa chỉ giao hàng';
            document.getElementById('confirmReadyHandoffOrderLabel').textContent = orderLabel;
            document.getElementById('confirmReadyHandoffRecipient').textContent = recipient;
            document.getElementById('confirmReadyHandoffAddress').textContent = address;

            const modalElement = document.getElementById('confirmReadyHandoffModal');
            if (window.bootstrap?.Modal && modalElement) {
                window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
                return;
            }

            if (modalElement) {
                modalElement.classList.add('show');
                modalElement.style.display = 'block';
                modalElement.removeAttribute('aria-hidden');
                modalElement.setAttribute('aria-modal', 'true');
                document.body.classList.add('modal-open');
            }
        }
        function trackingText(value, fallback = 'Chưa có') {
            if (value === null || value === undefined) return fallback;
            const text = String(value).trim();
            return text ? text : fallback;
        }
        function trackingHtml(value, fallback = 'Chưa có') {
            const div = document.createElement('div');
            div.textContent = trackingText(value, fallback);
            return div.innerHTML;
        }
        function formatTrackingNumber(value, unit) {
            const number = Number(value);
            if (!Number.isFinite(number) || number <= 0) return 'Chưa có';
            return `${number.toLocaleString('vi-VN')} ${unit}`;
        }
        function formatTrackingDimensions(data) {
            const length = Number(data?.length);
            const width = Number(data?.width);
            const height = Number(data?.height);
            if (![length, width, height].every(value => Number.isFinite(value) && value > 0)) {
                return 'Chưa có';
            }
            return `${length.toLocaleString('vi-VN')} x ${width.toLocaleString('vi-VN')} x ${height.toLocaleString('vi-VN')} cm`;
        }
        function renderTrackingWarehouse(name, id) {
            const parts = [];
            if (trackingText(name, '') !== '') parts.push(trackingText(name));
            if (trackingText(id, '') !== '') parts.push(`ID ${trackingText(id)}`);
            return parts.length ? parts.join(' - ') : 'Chưa có';
        }
        function renderTrackingTimeline(logs) {
            if (!Array.isArray(logs) || logs.length === 0) {
                return `
                    <ul class="tracking-timeline">
                        <li class="tracking-timeline-item">
                            <span class="tracking-timeline-dot"><i class="bi bi-info"></i></span>
                            <div class="tracking-timeline-content text-muted">Chưa có log trạng thái GHN.</div>
                        </li>
                    </ul>`;
            }

            return `
                <ul class="tracking-timeline">
                    ${logs.map(function (log) {
                        const status = trackingHtml(log?.statusLabel || log?.status);
                        const time = trackingHtml(formatDateTime(log?.updatedAt));
                        const warehouse = trackingHtml(renderTrackingWarehouse(log?.warehouseName, log?.warehouseId));
                        return `
                            <li class="tracking-timeline-item">
                                <span class="tracking-timeline-dot"><i class="bi bi-check2"></i></span>
                                <div class="tracking-timeline-content">
                                    <div class="d-flex flex-column flex-md-row justify-content-between gap-1 mb-1">
                                        <strong class="text-primary-blue">${status}</strong>
                                        <span class="small text-muted">${time}</span>
                                    </div>
                                    <div class="small text-muted">Kho: ${warehouse}</div>
                                </div>
                            </li>`;
                    }).join('')}
                </ul>`;
        }
        function renderGhnTrackingDetail(data, row) {
            const body = document.getElementById('ghnTrackingDetailBody');
            if (!body) return;

            const orderLabel = row?.dataset.ghnOrderLabel || 'Chưa có';
            const orderCode = data?.orderCode || row?.dataset.ghnOrderCode || '';
            const clientOrderCode = data?.clientOrderCode || row?.dataset.ghnClientOrderCode || '';
            const status = data?.statusLabel || data?.status || row?.dataset.ghnStatusLabel || row?.dataset.ghnStatus || 'Chưa có';
            const warehouse = renderTrackingWarehouse(data?.currentWarehouseName, data?.currentWarehouseId);
            const expectedTime = data?.leadTime || row?.dataset.ghnExpectedDeliveryAt || '';
            const totalFee = data?.totalFee || row?.dataset.ghnTotalFee || '';
            const toAddress = data?.toAddress || row?.dataset.ghnAddress || '';
            const toName = data?.toName || row?.dataset.ghnName || '';
            const toPhone = data?.toPhone || row?.dataset.ghnPhone || '';

            body.innerHTML = `
                <div class="tracking-summary-grid mb-3">
                    <div class="tracking-summary-card">
                        <div class="label">Mã vận đơn</div>
                        <div class="value font-monospace">${trackingHtml(orderCode || clientOrderCode || orderLabel)}</div>
                    </div>
                    <div class="tracking-summary-card">
                        <div class="label">Trạng thái</div>
                        <div class="value">${trackingHtml(status)}</div>
                    </div>
                    <div class="tracking-summary-card">
                        <div class="label">Kho hiện tại</div>
                        <div class="value">${trackingHtml(warehouse)}</div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-lg-6">
                        <div class="tracking-detail-section h-100">
                            <h6 class="fw-bold text-primary-blue mb-3"><i class="bi bi-person-lines-fill me-2"></i>Người nhận</h6>
                            <div class="tracking-info-line mb-2">
                                <div class="label">Họ tên</div>
                                <div class="fw-semibold">${trackingHtml(toName)}</div>
                            </div>
                            <div class="tracking-info-line mb-2">
                                <div class="label">Số điện thoại</div>
                                <div class="fw-semibold font-monospace">${trackingHtml(toPhone)}</div>
                            </div>
                            <div class="tracking-info-line">
                                <div class="label">Địa chỉ giao</div>
                                <div class="fw-semibold">${trackingHtml(toAddress)}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="tracking-detail-section h-100">
                            <h6 class="fw-bold text-primary-blue mb-3"><i class="bi bi-box2-heart me-2"></i>Thông tin kiện hàng</h6>
                            <div class="tracking-package-grid">
                                <div class="tracking-info-line">
                                    <div class="label">Khối lượng</div>
                                    <div class="fw-semibold">${trackingHtml(formatTrackingNumber(data?.weight, 'gram'))}</div>
                                </div>
                                <div class="tracking-info-line">
                                    <div class="label">Dài / rộng / cao</div>
                                    <div class="fw-semibold">${trackingHtml(formatTrackingDimensions(data))}</div>
                                </div>
                                <div class="tracking-info-line">
                                    <div class="label">Phí vận chuyển</div>
                                    <div class="fw-semibold">${trackingHtml(formatCurrency(totalFee))}</div>
                                </div>
                                <div class="tracking-info-line">
                                    <div class="label">Dự kiến giao</div>
                                    <div class="fw-semibold">${trackingHtml(formatDateTime(expectedTime))}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tracking-detail-section">
                    <h6 class="fw-bold text-primary-blue mb-3"><i class="bi bi-list-check me-2"></i>Log trạng thái GHN</h6>
                    ${renderTrackingTimeline(data?.logs)}
                </div>`;
        }
        function renderGhnTrackingError(message) {
            const body = document.getElementById('ghnTrackingDetailBody');
            if (!body) return;
            body.innerHTML = `
                <div class="alert alert-warning border-0 rounded-4 mb-0">
                    <div class="fw-bold mb-1">Chưa lấy được chi tiết vận đơn</div>
                    <div>${trackingHtml(message || 'Vui lòng kiểm tra mã vận đơn sandbox hoặc đồng bộ lại dữ liệu GHN.')}</div>
                </div>`;
        }
        async function openGhnTrackingDetail(button) {
            const row = button.closest('tr');
            if (!row) {
                showNotification('Không xác định được dòng vận đơn.', 'danger');
                return;
            }

            const orderCode = (row.dataset.ghnOrderCode || '').trim();
            const clientOrderCode = (row.dataset.ghnClientOrderCode || '').trim();
            const orderId = (row.dataset.ghnOrderId || button.dataset.orderid || '').trim();
            if (!orderCode && !clientOrderCode) {
                showNotification('Đơn này chưa có mã GHN sandbox để xem chi tiết.', 'warning');
                return;
            }

            const body = document.getElementById('ghnTrackingDetailBody');
            if (body) {
                body.innerHTML = `
                    <div class="d-flex align-items-center gap-3 p-4 rounded-4 bg-white border">
                        <span class="spinner-border spinner-border-sm text-primary"></span>
                        <span class="fw-semibold text-primary-blue">Đang tải chi tiết vận đơn...</span>
                    </div>`;
            }

            const modalElement = document.getElementById('ghnTrackingDetailModal');
            if (window.bootstrap?.Modal && modalElement) {
                window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
            } else if (modalElement) {
                modalElement.classList.add('show');
                modalElement.style.display = 'block';
                modalElement.removeAttribute('aria-hidden');
                modalElement.setAttribute('aria-modal', 'true');
                document.body.classList.add('modal-open');
            }

            const oldHtml = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            try {
                const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Seller" })', {
                    orderCode,
                    clientOrderCode,
                    orderId
                }));
                if (!payload?.success) {
                    renderGhnTrackingError(payload?.message);
                    return;
                }
                renderGhnTrackingDetail(payload, row);
            } catch {
                renderGhnTrackingError('Không gọi được API GHN sandbox ở thời điểm hiện tại.');
            } finally {
                button.disabled = false;
                button.innerHTML = oldHtml;
            }
        }
        function setHiddenHandoffRecipient(row) {
            const setValue = (id, value) => {
                const node = document.getElementById(id);
                if (node) node.value = value || '';
            };
            setValue('ghnSelectedOrderId', row?.dataset.ghnOrderId);
            setValue('ghnToName', row?.dataset.ghnName);
            setValue('ghnToPhone', row?.dataset.ghnPhone);
            setValue('ghnToAddress', row?.dataset.ghnAddress);

            const provinceSelect = document.getElementById('ghnProvinceId');
            const districtSelect = document.getElementById('ghnDistrictId');
            const wardSelect = document.getElementById('ghnWardCode');
            if (provinceSelect) provinceSelect.value = '';
            if (districtSelect) districtSelect.innerHTML = '<option value="">Chọn quận/huyện</option>';
            if (wardSelect) wardSelect.innerHTML = '<option value="">Chọn phường/xã</option>';
        }

        function getPositiveDatasetNumber(row, key) {
            const parsed = Number(row?.dataset?.[key] || '0');
            return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
        }

        function buildReadyHandoffPackage(row) {
            let weight = getPositiveDatasetNumber(row, 'ghnPackageWeight');
            let length = getPositiveDatasetNumber(row, 'ghnPackageLength');
            let width = getPositiveDatasetNumber(row, 'ghnPackageWidth');
            let height = getPositiveDatasetNumber(row, 'ghnPackageHeight');

            if (weight > 0 && length > 0 && width > 0 && height > 0) {
                return { weight, length, width, height };
            }

            const totalQuantity = Math.max(1, getPositiveDatasetNumber(row, 'ghnTotalQuantity') || 1);
            weight = Math.min(30000, Math.max(200, totalQuantity * 500));
            length = Math.min(60, Math.max(20, 20 + ((totalQuantity - 1) * 2)));
            width = Math.min(35, Math.max(18, 18 + (Math.min(totalQuantity, 5) * 2)));
            height = Math.min(40, Math.max(10, 10 + totalQuantity));
            return { weight, length, width, height };
        }

        async function buildReadyHandoffPayload(row, orderId, currentStatus) {
            const payload = { orderId, currentStatus };
            const hasGhnCode = Boolean((row?.dataset.ghnOrderCode || '').trim() || (row?.dataset.ghnClientOrderCode || '').trim());
            if (hasGhnCode) {
                return payload;
            }

            setHiddenHandoffRecipient(row);
            const recipient = await ensureGhnRecipient();
            if (!recipient) {
                return null;
            }

            const packageInfo = buildReadyHandoffPackage(row);
            if (!packageInfo || packageInfo.weight <= 0 || packageInfo.length <= 0 || packageInfo.width <= 0 || packageInfo.height <= 0) {
                showNotification('Thiếu cân nặng hoặc kích thước kiện hàng để tạo vận đơn GHN. Vui lòng kiểm tra lại dữ liệu kiện hàng.', 'warning');
                return null;
            }

            return {
                ...payload,
                toDistrictId: Number(recipient.districtId),
                toWardCode: recipient.wardCode,
                weight: packageInfo.weight,
                length: packageInfo.length,
                width: packageInfo.width,
                height: packageInfo.height
            };
        }

        async function markReadyForPickup(button) {
            const row = button.closest('tr');
            const orderId = Number(button.dataset.orderid || row?.dataset.ghnOrderId || 0);
            const currentStatus = (row?.dataset.orderStatus || '').trim();
            if (!orderId) {
                showNotification('Không xác định được đơn hàng cần cập nhật.', 'danger');
                return;
            }

            const oldHtml = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            try {
                const requestBody = await buildReadyHandoffPayload(row, orderId, currentStatus);
                if (!requestBody) {
                    return;
                }

                const response = await fetch('@Url.Action("MarkReadyForPickup", "Shipping", new { area = "Seller" })', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': getToken()
                    },
                    body: JSON.stringify(requestBody)
                });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload?.success) {
                    showNotification(payload?.message || 'Không thể chuyển đơn sang trạng thái chờ shipper lấy.', 'danger');
                    return;
                }

                showNotification(payload.message || 'Shop đã chuẩn bị hàng xong, đang chờ shipper đến lấy.', 'success');
                setTimeout(() => window.location.reload(), 800);
            } catch {
                showNotification('Có lỗi khi cập nhật trạng thái chuẩn bị hàng.', 'danger');
            } finally {
                button.disabled = false;
                button.innerHTML = oldHtml;
            }
        }
        function getNumericValue(id, fallback = 0) {
            const raw = document.getElementById(id)?.value;
            const parsed = Number(raw);
            return Number.isFinite(parsed) ? parsed : fallback;
        }
        function getTextValue(id) {
            return document.getElementById(id)?.value?.trim() || '';
        }
        function collectVisibleGhnRowsForSync() {
            return Array.from(document.querySelectorAll('tr[data-ghn-order-id]'))
                .map(function (row) {
                    return {
                        orderId: (row.dataset.ghnOrderId || '').trim(),
                        orderCode: (row.dataset.ghnOrderCode || '').trim(),
                        orderLabel: (row.dataset.ghnOrderLabel || '').trim(),
                        lastSyncedAt: (row.dataset.ghnLastSyncedAt || '').trim()
                    };
                })
                .filter(function (item) {
                    return item.orderId && item.orderCode;
                });
        }
        function collectAutoSyncCandidates(maxAgeMinutes = 20, maxItems = 3) {
            const now = Date.now();
            const maxAgeMs = maxAgeMinutes * 60 * 1000;
            return collectVisibleGhnRowsForSync()
                .filter(function (item) {
                    if (!item.lastSyncedAt) {
                        return true;
                    }
                    const parsed = Date.parse(item.lastSyncedAt);
                    if (!Number.isFinite(parsed)) {
                        return true;
                    }
                    return (now - parsed) >= maxAgeMs;
                })
                .slice(0, maxItems);
        }
        function setButtonBusy(button, busy, busyHtml) {
            if (!button) return;
            if (busy) {
                button.dataset.originalHtml = button.innerHTML;
                button.disabled = true;
                button.innerHTML = busyHtml;
                return;
            }
            button.disabled = false;
            if (button.dataset.originalHtml) {
                button.innerHTML = button.dataset.originalHtml;
            }
        }
        function setGhnRecipientLocationStatus(message, tone = 'info') {
            const node = document.getElementById('ghnRecipientLocationStatus');
            if (!node) return;
            const icon = tone === 'success'
                ? 'bi-check-circle-fill'
                : tone === 'warning'
                    ? 'bi-exclamation-triangle-fill'
                    : tone === 'danger'
                        ? 'bi-x-circle-fill'
                        : 'bi-magic';
            node.innerHTML = `<i class="bi ${icon}"></i> ${message}`;
        }
        function normalizeText(value) {
            return (value || '')
                .toString()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/Đ/g, 'd')
                .toLowerCase()
                .replace(/[^\w\s]/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }
        function normalizeAdministrativeName(value) {
            return normalizeText(value || '')
                .replace(/\b(tinh|thanh pho|tp|quan|huyen|thi xa|thi tran|phuong|xa)\b/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }
        function getAddressSegments(addressText) {
            return (addressText || '')
                .split(',')
                .map(part => part.trim())
                .filter(Boolean);
        }
        function findAdministrativeOptionMatch(select, addressText, preferredSegments) {
            if (!select) return null;
            const normalizedAddress = normalizeAdministrativeName(addressText);
            if (!normalizedAddress) return null;
            const normalizedSegments = (preferredSegments || [])
                .map(segment => normalizeAdministrativeName(segment))
                .filter(Boolean);

            const options = Array.from(select.options || []).filter(option => option.value);
            let best = null;
            let bestScore = -1;

            options.forEach(option => {
                const normalizedName = normalizeAdministrativeName(option.textContent || '');
                if (!normalizedName) return;

                let score = -1;
                if (normalizedSegments.some(segment => segment === normalizedName)) {
                    score = normalizedName.length + 300;
                } else if (normalizedSegments.some(segment => segment.includes(normalizedName) || normalizedName.includes(segment))) {
                    score = normalizedName.length + 200;
                } else if (normalizedAddress.includes(normalizedName)) {
                    score = normalizedName.length + 100;
                } else if (normalizedName.includes(normalizedAddress)) {
                    score = normalizedAddress.length + 50;
                }

                if (score > bestScore) {
                    best = option;
                    bestScore = score;
                }
            });

            return best;
        }
        async function autoResolveGhnRecipientLocation(addressText) {
            const provinceSelect = document.getElementById('ghnProvinceId');
            const districtSelect = document.getElementById('ghnDistrictId');
            const wardSelect = document.getElementById('ghnWardCode');
            if (!provinceSelect || !districtSelect || !wardSelect) return false;

            const normalizedAddress = (addressText || '').trim();
            if (!normalizedAddress) {
                setGhnRecipientLocationStatus('Chưa có địa chỉ chi tiết để tự nhận diện địa bàn GHN.', 'warning');
                return false;
            }

            try {
                setGhnRecipientLocationStatus('Đang kiểm tra địa chỉ người nhận với danh mục GHN...', 'info');
                await loadGhnProvinces();

                const segments = getAddressSegments(normalizedAddress);
                const provinceSegments = segments.slice(-2);
                const districtSegments = segments.length >= 3 ? segments.slice(-3, -1) : segments;
                const wardSegments = segments.length >= 4 ? segments.slice(-4, -2) : segments;

                const matchedProvince = findAdministrativeOptionMatch(provinceSelect, normalizedAddress, provinceSegments);
                if (!matchedProvince) {
                    setGhnRecipientLocationStatus('Địa chỉ giao hàng chưa khớp danh mục GHN ở cấp tỉnh/thành. Cần cập nhật lại địa chỉ đơn hàng, hệ thống không tự sửa địa chỉ khách.', 'warning');
                    return false;
                }

                provinceSelect.value = matchedProvince.value;
                await loadGhnDistricts(matchedProvince.value);

                const matchedDistrict = findAdministrativeOptionMatch(districtSelect, normalizedAddress, districtSegments);
                if (!matchedDistrict) {
                    setGhnRecipientLocationStatus('Địa chỉ giao hàng chưa khớp danh mục GHN ở cấp quận/huyện. Cần cập nhật lại địa chỉ đơn hàng, hệ thống không tự sửa địa chỉ khách.', 'warning');
                    return false;
                }

                districtSelect.value = matchedDistrict.value;
                await loadGhnWards(matchedDistrict.value);

                const matchedWard = findAdministrativeOptionMatch(wardSelect, normalizedAddress, wardSegments);
                if (!matchedWard) {
                    setGhnRecipientLocationStatus('Địa chỉ giao hàng chưa khớp danh mục GHN ở cấp phường/xã. Cần cập nhật lại địa chỉ đơn hàng, hệ thống không tự sửa địa chỉ khách.', 'warning');
                    return false;
                }

                wardSelect.value = matchedWard.value;
                setGhnRecipientLocationStatus(`Địa chỉ hợp lệ theo GHN: ${matchedProvince.textContent} / ${matchedDistrict.textContent} / ${matchedWard.textContent}.`, 'success');
                return true;
            } catch {
                setGhnRecipientLocationStatus('Không kiểm tra được địa chỉ với GHN lúc này. Chưa tạo vận đơn để tránh sai địa chỉ giao hàng.', 'danger');
                return false;
            }
        }
        async function ensureGhnRecipient() {
            const orderId = getTextValue('ghnSelectedOrderId');
            const toName = getTextValue('ghnToName');
            const toPhone = getTextValue('ghnToPhone');
            const toAddress = getTextValue('ghnToAddress');
            if (!orderId) {
                showNotification('Bạn cần chọn một đơn hàng trong danh sách trước khi tạo vận đơn.', 'warning');
                return null;
            }
            if (!toName || !toPhone || !toAddress) {
                showNotification('Đơn đã chọn chưa có đủ thông tin người nhận để tạo vận đơn.', 'warning');
                return null;
            }

            let districtId = getTextValue('ghnDistrictId');
            let wardCode = getTextValue('ghnWardCode');
            if (!districtId || !wardCode) {
                const resolved = await autoResolveGhnRecipientLocation(toAddress);
                if (!resolved) {
                    showNotification('Địa chỉ giao hàng chưa hợp lệ theo GHN. Vui lòng kiểm tra/cập nhật địa chỉ đơn hàng, hệ thống không tự sửa địa chỉ khách.', 'warning');
                    return null;
                }
                districtId = getTextValue('ghnDistrictId');
                wardCode = getTextValue('ghnWardCode');
            }

            return { orderId, toName, toPhone, toAddress, districtId, wardCode };
        }
        function ensurePackageDetails() {
            const weight = getNumericValue('ghnWeight', 0);
            const length = getNumericValue('ghnLength', 0);
            const width = getNumericValue('ghnWidth', 0);
            const height = getNumericValue('ghnHeight', 0);
            const itemName = getTextValue('ghnItemName');
            const itemQuantity = getNumericValue('ghnItemQuantity', 0);

            if (weight <= 0 || length <= 0 || width <= 0 || height <= 0) {
                showNotification('Bạn cần nhập đủ cân nặng và kích thước gói hàng.', 'warning');
                return null;
            }

            if (!itemName) {
                showNotification('Không đọc được tên mặt hàng từ đơn đã chọn.', 'warning');
                return null;
            }

            if (itemQuantity <= 0) {
                showNotification('Không đọc được số lượng mặt hàng hợp lệ từ đơn đã chọn.', 'warning');
                return null;
            }

            return { weight, length, width, height, itemName, itemQuantity };
        }
        async function fetchJson(url, options) {
            const response = await fetch(url, { credentials: 'same-origin', ...(options || {}) });
            const payload = await response.json();
            return payload;
        }
        async function loadGhnProvinces() {
            const select = document.getElementById('ghnProvinceId');
            if (!select || select.dataset.loaded === 'true') return;
            const payload = await fetchJson('@Url.Action("GetGhnProvinces", "Shipping", new { area = "Seller" })');
            const items = Array.isArray(payload?.items) ? payload.items : [];
            select.innerHTML = '<option value="">Chọn tỉnh/thành phố</option>';
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name;
                select.appendChild(option);
            });
            select.dataset.loaded = 'true';
        }
        async function loadGhnDistricts(provinceId) {
            const districtSelect = document.getElementById('ghnDistrictId');
            const wardSelect = document.getElementById('ghnWardCode');
            if (!districtSelect || !wardSelect) return;
            districtSelect.innerHTML = '<option value="">Chọn quận/huyện</option>';
            wardSelect.innerHTML = '<option value="">Chọn phường/xã</option>';
            if (!provinceId) return;
            const payload = await fetchJson(buildUrl('@Url.Action("GetGhnDistricts", "Shipping", new { area = "Seller" })', { provinceId }));
            const items = Array.isArray(payload?.items) ? payload.items : [];
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name;
                districtSelect.appendChild(option);
            });
        }
        async function loadGhnWards(districtId) {
            const wardSelect = document.getElementById('ghnWardCode');
            if (!wardSelect) return;
            wardSelect.innerHTML = '<option value="">Chọn phường/xã</option>';
            if (!districtId) return;
            const payload = await fetchJson(buildUrl('@Url.Action("GetGhnWards", "Shipping", new { area = "Seller" })', { districtId }));
            const items = Array.isArray(payload?.items) ? payload.items : [];
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.code || item.id;
                option.textContent = item.name;
                wardSelect.appendChild(option);
            });
        }
        async function buildPreviewParams() {
            const recipient = await ensureGhnRecipient();
            if (!recipient) return null;
            const packageInfo = ensurePackageDetails();
            if (!packageInfo) return null;
            return {
                ToDistrictId: recipient.districtId,
                ToWardCode: recipient.wardCode,
                Weight: packageInfo.weight,
                Length: packageInfo.length,
                Width: packageInfo.width,
                Height: packageInfo.height,
                InsuranceValue: getNumericValue('ghnInsuranceValue', 0),
                ItemName: packageInfo.itemName,
                ItemQuantity: packageInfo.itemQuantity
            };
        }
        async function loadSellerGhnOrigin(silent = false) {
            const button = document.getElementById('btnGhnLoadSellerOrigin');
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tải...');
                const payload = await fetchJson('@Url.Action("GetGhnSellerOrigin", "Shipping", new { area = "Seller" })');
                setResult('ghnShopProfileResult', payload);
                if (!silent) {
                    showNotification(payload?.hasGhnOrigin ? 'Đã tải địa chỉ lấy hàng của shop.' : 'Shop của bạn chưa lưu địa chỉ lấy hàng.', payload?.hasGhnOrigin ? 'success' : 'warning');
                }
            } catch {
                setResult('ghnShopProfileResult', 'Không tải được địa chỉ lấy hàng.');
                if (!silent) {
                    showNotification('Không tải được địa chỉ lấy hàng.', 'danger');
                }
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function previewGhnFee() {
            const button = document.getElementById('btnGhnPreviewFee');
            const params = await buildPreviewParams();
            if (!params) return;
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang tính...');
                const payload = await fetchJson(buildUrl('@Url.Action("PreviewGhnFee", "Shipping", new { area = "Seller" })', params));
                setResult('ghnPreviewResult', payload);
                showNotification(payload?.message || 'Đã tính phí giao hàng dự kiến.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không tính được phí giao hàng dự kiến.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function previewGhnLeadTime() {
            const button = document.getElementById('btnGhnPreviewLeadTime');
            const recipient = await ensureGhnRecipient();
            if (!recipient) return;
            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang lấy...');
                const payload = await fetchJson(buildUrl('@Url.Action("PreviewGhnLeadTime", "Shipping", new { area = "Seller" })', {
                    ToDistrictId: recipient.districtId,
                    ToWardCode: recipient.wardCode
                }));
                setResult('ghnPreviewResult', payload);
                showNotification(payload?.message || 'Đã lấy thời gian giao dự kiến.', payload?.success ? 'success' : 'warning');
            } catch {
                showNotification('Không lấy được thời gian giao dự kiến.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function trackGhnOrder(options) {
            const shouldPersist = options?.persist ?? false;
            const shouldReload = options?.reloadOnSuccess ?? false;
            const button = document.getElementById(shouldPersist ? 'btnGhnSyncMetadata' : 'btnGhnTrackOrder');
            const orderCode = getTextValue('ghnTrackingOrderCode');
            if (!orderCode) {
                showNotification(`Cần nhập mã vận đơn để ${shouldPersist ? 'đồng bộ' : 'tra cứu'}.`, 'warning');
                return;
            }
            const orderId = getTextValue('ghnSelectedOrderId');
            if (shouldPersist && !orderId) {
                showNotification('Cần chọn đơn hàng trong bảng trước khi đồng bộ GHN.', 'warning');
                return;
            }
            try {
                setButtonBusy(button, true, shouldPersist
                    ? '<span class="spinner-border spinner-border-sm me-2"></span>Đang đồng bộ...'
                    : '<span class="spinner-border spinner-border-sm me-2"></span>Đang tra...');
                const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Seller" })', {
                    orderCode,
                    orderId
                }));
                setResult('ghnTrackingResult', payload);
                showNotification(
                    payload?.message || (shouldPersist ? 'Đã đồng bộ metadata GHN.' : 'Đã tra cứu vận đơn.'),
                    payload?.success ? 'success' : 'warning');
                if (payload?.success && shouldReload) {
                    window.setTimeout(function () {
                        window.location.reload();
                    }, 700);
                }
            } catch {
                showNotification(shouldPersist ? 'Không đồng bộ được metadata GHN.' : 'Không tra cứu được vận đơn.', 'danger');
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function syncVisibleGhnRows() {
            const button = document.getElementById('btnGhnSyncVisibleRows');
            const candidates = collectVisibleGhnRowsForSync();
            if (!candidates.length) {
                showNotification('Trang này chưa có đơn nào có mã GHN để đồng bộ.', 'warning');
                return;
            }

            const summary = {
                total: candidates.length,
                synced: 0,
                failed: 0,
                items: []
            };

            try {
                setButtonBusy(button, true, '<span class="spinner-border spinner-border-sm me-2"></span>Đang đồng bộ trang...');
                for (let index = 0; index < candidates.length; index += 1) {
                    const candidate = candidates[index];
                    setResult('ghnTrackingResult', {
                        message: `Đang đồng bộ ${index + 1}/${candidates.length}`,
                        current: candidate.orderLabel || `Đơn #${candidate.orderId}`,
                        orderCode: candidate.orderCode,
                        progress: `${index + 1}/${candidates.length}`
                    });

                    try {
                        const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Seller" })', {
                            orderCode: candidate.orderCode,
                            orderId: candidate.orderId
                        }));

                        if (payload?.success) {
                            summary.synced += 1;
                        } else {
                            summary.failed += 1;
                        }

                        summary.items.push({
                            orderId: candidate.orderId,
                            orderLabel: candidate.orderLabel,
                            orderCode: candidate.orderCode,
                            success: !!payload?.success,
                            statusLabel: payload?.statusLabel || payload?.status || '',
                            message: payload?.message || ''
                        });
                    } catch (error) {
                        summary.failed += 1;
                        summary.items.push({
                            orderId: candidate.orderId,
                            orderLabel: candidate.orderLabel,
                            orderCode: candidate.orderCode,
                            success: false,
                            message: error?.message || 'Không đồng bộ được đơn GHN này.'
                        });
                    }
                }

                setResult('ghnTrackingResult', {
                    message: `Đã đồng bộ ${summary.synced}/${summary.total} đơn GHN trên trang.`,
                    total: summary.total,
                    synced: summary.synced,
                    failed: summary.failed,
                    items: summary.items
                });

                showNotification(
                    summary.failed
                        ? `Đã đồng bộ ${summary.synced}/${summary.total} đơn GHN. Có ${summary.failed} đơn cần kiểm tra lại.`
                        : `Đã đồng bộ ${summary.synced} đơn GHN trên trang.`,
                    summary.failed ? 'warning' : 'success');

                if (summary.synced > 0) {
                    window.setTimeout(function () {
                        window.location.reload();
                    }, 900);
                }
            } finally {
                setButtonBusy(button, false);
            }
        }
        async function autoSyncStaleGhnRows() {
            const candidates = collectAutoSyncCandidates();
            if (!candidates.length) {
                return;
            }

            const summary = {
                total: candidates.length,
                synced: 0,
                failed: 0
            };

            setResult('ghnTrackingResult', {
                message: `Đang tự đồng bộ ${candidates.length} đơn GHN cũ trên trang...`,
                auto: true,
                total: candidates.length
            });

            for (let index = 0; index < candidates.length; index += 1) {
                const candidate = candidates[index];
                try {
                    const payload = await fetchJson(buildUrl('@Url.Action("GetGhnSandboxOrder", "Shipping", new { area = "Seller" })', {
                        orderCode: candidate.orderCode,
                        orderId: candidate.orderId
                    }));
                    if (payload?.success) {
                        summary.synced += 1;
                    } else {
                        summary.failed += 1;
                    }
                } catch {
                    summary.failed += 1;
                }
            }

            if (summary.synced > 0) {
                setResult('ghnTrackingResult', {
                    message: `Đã tự đồng bộ ${summary.synced}/${summary.total} đơn GHN cũ trên trang.`,
                    auto: true,
                    total: summary.total,
                    synced: summary.synced,
                    failed: summary.failed
                });
                showNotification(`Đã tự đồng bộ ${summary.synced}/${summary.total} đơn GHN cũ trên trang.`, summary.failed ? 'warning' : 'info');
                window.setTimeout(function () {
                    window.location.reload();
                }, 900);
            }
        }

        // Load danh sách xã/phường theo tỉnh được chọn
        function loadCommunes(provinceSelectId, communeSelectId, callback) {
            const provinceSelect = document.getElementById(provinceSelectId);
            const communeSelect = document.getElementById(communeSelectId);
            if (!provinceSelect || !communeSelect) return;

            const pid = provinceSelect.value;
            communeSelect.innerHTML = '<option value=\"\">-- Chọn Xã/Phường --</option>';

            if (!pid) {
                if (callback) callback();
                return;
            }

            fetch('@Url.Action("GetCommunes","Shipping", new { area = "Seller" })?provinceId=' + pid, { credentials: 'same-origin' })
                .then(r => r.json())
                .then(d => {
                    console.log('GetCommunes response for province', pid, d);
                    const list = Array.isArray(d)
                        ? d
                        : (Array.isArray(d?.data) ? d.data : (Array.isArray(d?.communes) ? d.communes : []));
                    list.forEach(x => {
                        const o = document.createElement('option');
                        o.value = x.value;
                        o.textContent = x.text;
                        communeSelect.appendChild(o);
                    });
                    if (callback) callback();
                })
                .catch(() => {
                    showNotification('Không tải được danh sách Xã/Phường','danger');
                    if (callback) callback();
                });
        }

        const editProvinceSelect = document.getElementById('EditProvinceId');
        if (editProvinceSelect) {
            editProvinceSelect.addEventListener('change', function () {
                loadCommunes('EditProvinceId', 'EditCommuneId');
            });
        }

        document.getElementById('ghnProvinceId')?.addEventListener('change', function () {
            loadGhnDistricts(this.value).catch(() => {
                showNotification('Không tải được quận/huyện.', 'danger');
            });
        });

        document.getElementById('ghnDistrictId')?.addEventListener('change', function () {
            loadGhnWards(this.value).catch(() => {
                showNotification('Không tải được phường/xã.', 'danger');
            });
        });

        document.getElementById('btnGhnLoadSellerOrigin')?.addEventListener('click', function () {
            loadSellerGhnOrigin();
        });

        document.getElementById('btnGhnPreviewFee')?.addEventListener('click', function () {
            previewGhnFee();
        });

        document.getElementById('btnGhnPreviewLeadTime')?.addEventListener('click', function () {
            previewGhnLeadTime();
        });

        document.getElementById('btnGhnTrackOrder')?.addEventListener('click', function () {
            trackGhnOrder();
        });
        document.getElementById('btnGhnSyncMetadata')?.addEventListener('click', function () {
            trackGhnOrder({ persist: true, reloadOnSuccess: true });
        });
        document.getElementById('btnGhnSyncVisibleRows')?.addEventListener('click', function () {
            syncVisibleGhnRows();
        });
        document.querySelectorAll('.btn-mark-ready-row').forEach(button => button.addEventListener('click', function () {
            openReadyHandoffModal(this);
        }));
        document.querySelectorAll('.btn-ghn-tracking-row').forEach(button => button.addEventListener('click', function () {
            void openGhnTrackingDetail(this);
        }));

        document.getElementById('shippingHelpButton')?.addEventListener('click', function () {
            const panel = document.getElementById('shippingHelpPanel');
            setShippingHelpOpen(panel?.hidden !== false);
        });

        document.getElementById('shippingHelpClose')?.addEventListener('click', function () {
            setShippingHelpOpen(false);
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                setShippingHelpOpen(false);
            }
        });

        document.addEventListener('click', function (event) {
            const panel = document.getElementById('shippingHelpPanel');
            const widget = document.querySelector('.shipping-help-widget');
            if (!panel || panel.hidden) return;
            if (panel.contains(event.target) || widget?.contains(event.target)) return;
            setShippingHelpOpen(false);
        });

        document.getElementById('btnConfirmReadyHandoff')?.addEventListener('click', function () {
            const button = pendingReadyHandoffButton;
            const modalElement = document.getElementById('confirmReadyHandoffModal');
            if (window.bootstrap?.Modal && modalElement) {
                window.bootstrap.Modal.getOrCreateInstance(modalElement).hide();
            } else if (modalElement) {
                modalElement.classList.remove('show');
                modalElement.style.display = 'none';
                modalElement.setAttribute('aria-hidden', 'true');
                modalElement.removeAttribute('aria-modal');
                document.body.classList.remove('modal-open');
            }
            if (button) {
                void markReadyForPickup(button);
            }
        });

        document.getElementById('status').addEventListener('change', function () {
          const wrap = document.getElementById('deliveredStateWrap');
          if (this.value === 'Delivered') {
            wrap.style.display = 'block';
          } else {
            wrap.style.display = 'none';
            const d = document.getElementById('deliveredState');
            if(d) d.value = '';
          }
        });

        if (typeof bootstrap !== 'undefined') {
          [...document.querySelectorAll('[title]')].forEach(el=>{
            el.setAttribute('data-bs-toggle','tooltip'); el.setAttribute('data-bs-placement','top');
          });
          const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
          tooltipTriggerList.map(el => new bootstrap.Tooltip(el));
        }
    </script>

