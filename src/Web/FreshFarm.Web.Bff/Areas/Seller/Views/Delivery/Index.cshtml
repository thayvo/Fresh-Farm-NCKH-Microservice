@{
    ViewBag.Title = "Giao Hàng - Nhân Viên";
    //Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
}

<main class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">Giao Hàng</h2>
        <div class="d-flex gap-2">
            <select id="statusFilter" class="form-select">
                <option value="Processing">Chờ xử lý</option>
                <option value="Shipped">Đang giao</option>
                <option value="Delivered">Đã giao</option>
                <option value="Canceled">Đã hủy</option>
                <option value="All">Tất cả</option>
            </select>
            <button class="btn btn-primary" id="btnReload"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Liên hệ</th>
                            <th>Địa chỉ</th>
                            <th>Ngày đặt</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="delivery-table-body">
                        <tr><td colspan="7" class="text-center py-4">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted small" id="pagination-info"></span>
            <nav>
                <ul class="pagination mb-0" id="pagination-wrapper"></ul>
            </nav>
        </div>
    </div>
</main>

<!-- Modal chỉ định nhân viên -->
<div class="modal fade" id="assignModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Chỉ định nhân viên giao</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="assignOrderId" />
        <div class="mb-3">
            <label class="form-label">Nhân viên</label>
            <select id="assignStaff" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label class="form-label">Dự kiến lấy hàng</label>
            <input type="datetime-local" id="assignPickupAt" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Dự kiến giao</label>
            <input type="datetime-local" id="assignDeliveryAt" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Ghi chú</label>
            <textarea id="assignNotes" class="form-control" rows="3"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <form id="assignForm" method="post" action="@Url.Action("Assign","Delivery", new { area = "Seller" })">
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-primary">Lưu</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
    const PAGE_SIZE = 10;
    let currentPage = 1;

    document.getElementById('btnReload').addEventListener('click', () => loadList(1));
    document.getElementById('statusFilter').addEventListener('change', () => loadList(1));

    function loadList(page){
        currentPage = (typeof page === 'number' && page > 0) ? page : (currentPage || 1);
        const status = document.getElementById('statusFilter').value;
        fetch(`@Url.Action("List", "Delivery", new { area = "Seller" })?status=${encodeURIComponent(status)}&page=${currentPage}&pageSize=${PAGE_SIZE}`)
            .then(r => r.json())
            .then(res => {
                if (!res.success) throw new Error(res.message || 'Load failed');
                renderTable(res.data || []);
                renderPagination(res.total || 0, res.page || currentPage, res.pageSize || PAGE_SIZE);
                updateInfo(res.total || 0, res.page || currentPage, res.pageSize || PAGE_SIZE);
            })
            .catch(err => {
                console.error(err);
                const body = document.getElementById('delivery-table-body');
                body.innerHTML = `<tr><td colspan="7" class="text-danger text-center py-4">${err.message}</td></tr>`;
            });
    }

    function renderTable(items){
        const body = document.getElementById('delivery-table-body');
        if (!items.length){
            body.innerHTML = '<tr><td colspan="7" class="text-center py-4">Không có dữ liệu</td></tr>';
            return;
        }
        let html = '';
        items.forEach(it => {
            html += `
                <tr>
                    <td><strong>${it.orderCode}</strong></td>
                    <td>${it.customerName || ''}</td>
                    <td>${it.customerPhone || ''}</td>
                    <td style="max-width:320px">${it.address || ''}</td>
                    <td>${it.orderDate}</td>
                    <td>${statusBadge(it.status)}</td>
                    <td class="text-end">
                        ${it.canAccept ? `<button class="btn btn-sm btn-warning me-1" onclick="updateStatus(${it.orderID}, 'Shipped')"><i class='bi bi-truck'></i> Nhận giao</button>` : ''}
                        ${it.canDeliver ? `<button class="btn btn-sm btn-success me-1" onclick="updateStatus(${it.orderID}, 'Delivered')"><i class='bi bi-check-circle'></i> Đã giao</button>` : ''}
                        ${it.canCancel ? `<button class="btn btn-sm btn-outline-danger" onclick="updateStatus(${it.orderID}, 'Canceled')"><i class='bi bi-x-circle'></i> Hủy</button>` : ''}
                    </td>
                </tr>`;
        });
        body.innerHTML = html;
    }

    function statusBadge(s){
        const map = { Pending:'bg-secondary', Processing:'bg-warning text-dark', Shipped:'bg-info', Delivered:'bg-success', Canceled:'bg-danger' };
        const text = { Pending:'Chờ xử lý', Processing:'Đang xử lý', Shipped:'Đang giao', Delivered:'Đã giao hàng', Canceled:'Đã hủy' };
        const cls = map[s] || 'bg-secondary';
        return `<span class="badge ${cls}">${text[s] || s}</span>`;
    }

    function renderPagination(total, page, pageSize){
        const wrap = document.getElementById('pagination-wrapper');
        wrap.innerHTML = '';
        const totalPages = Math.max(1, Math.ceil((total||0)/(pageSize||PAGE_SIZE)));
        const cur = Math.min(Math.max(1, page||1), totalPages);
        const mk = (t,p,dis,act)=>{ const li=document.createElement('li'); li.className='page-item'+(dis?' disabled':'')+(act?' active':''); const a=document.createElement('a'); a.className='page-link'; a.href='#'; a.textContent=t; if(!dis){ a.onclick=e=>{e.preventDefault(); loadList(p);} } li.appendChild(a); return li; };
        wrap.appendChild(mk('«', cur-1, cur<=1, false));
        let s=Math.max(1, cur-2), e=Math.min(totalPages, cur+2);
        if (s>1) wrap.appendChild(mk('1',1,false,cur===1));
        if (s>2){ const d=document.createElement('li'); d.className='page-item disabled'; d.innerHTML='<span class="page-link">…</span>'; wrap.appendChild(d); }
        for (let i=s;i<=e;i++) wrap.appendChild(mk(String(i), i, false, i===cur));
        if (e<totalPages-1){ const d2=document.createElement('li'); d2.className='page-item disabled'; d2.innerHTML='<span class="page-link">…</span>'; wrap.appendChild(d2); }
        if (e<totalPages) wrap.appendChild(mk(String(totalPages), totalPages, false, cur===totalPages));
        wrap.appendChild(mk('»', cur+1, cur>=totalPages, false));
    }

    function updateInfo(total, page, pageSize){
        const info = document.getElementById('pagination-info');
        const totalPages = Math.max(1, Math.ceil((total||0)/(pageSize||PAGE_SIZE)));
        const cur = Math.min(Math.max(1, page||1), totalPages);
        const from = total===0?0:((cur-1)*(pageSize||PAGE_SIZE))+1;
        const to = Math.min(total||0, cur*(pageSize||PAGE_SIZE));
        info.textContent = `Hiển thị ${from}-${to} / ${total}`;
    }

    function updateStatus(orderId, newStatus){
        // Reuse Admin/Order/UpdateOrderStatus
        fetch('@Url.Action("UpdateOrderStatus", "Order", new { area = "Seller" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: orderId, newStatus: newStatus })
        })
        .then(r => r.json())
        .then(res => {
            if (!res.success) throw new Error(res.message || 'Cập nhật thất bại');
            loadList(currentPage);
        })
        .catch(err => alert(err.message));
    }

    document.addEventListener('DOMContentLoaded', () => loadList(1));
</script>

