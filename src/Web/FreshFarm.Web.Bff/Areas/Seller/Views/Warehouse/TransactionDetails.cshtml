@model FreshFarm.Web.Bff.Areas.Seller.Models.WarehouseTransactionViewModel
@{
    ViewBag.Title = "Chi tiet phieu kho";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Chi tiet phieu @Model.TransactionCode</h4>
        <a class="btn btn-outline-secondary" href="@Url.Action("TransactionHistory", "Warehouse", new { area = "Seller" })">Quay lai</a>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3"><strong>Loai:</strong> @Model.TransactionType</div>
            <div class="col-md-3"><strong>Ngay:</strong> @Model.TransactionDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="col-md-3"><strong>Tong SL:</strong> @Model.TotalQuantity</div>
            <div class="col-md-3"><strong>Tong tien:</strong> @Model.TotalAmount.ToString("N0") ₫</div>
            <div class="col-md-6"><strong>Nguoi tao:</strong> @(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "-" : Model.CreatedByName)</div>
            <div class="col-md-6"><strong>Ghi chu:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>San pham</th>
                        <th>SKU</th>
                        <th>So luong</th>
                        <th>Don gia</th>
                        <th>Thanh tien</th>
                        <th>Batch</th>
                        <th>HSD</th>
                        <th>Ghi chu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Details == null || Model.Details.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Khong co dong chi tiet.</td></tr>
                    }
                    else
                    {
                        foreach (var d in Model.Details)
                        {
                            <tr>
                                <td>@d.ProductName</td>
                                <td>@d.SKU</td>
                                <td>@d.Quantity</td>
                                <td>@d.UnitPrice.ToString("N0") ₫</td>
                                <td>@d.Amount.ToString("N0") ₫</td>
                                <td>@(string.IsNullOrWhiteSpace(d.BatchCode) ? "-" : d.BatchCode)</td>
                                <td>@(d.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(d.Notes) ? "-" : d.Notes)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
