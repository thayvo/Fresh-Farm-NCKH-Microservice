@using System.Collections.Generic
@using System.Linq
@model FreshFarm.Web.Bff.Areas.Seller.Models.WarehouseTransactionViewModel
@{
    ViewBag.Title = "Chi tiết giao dịch kho";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    var details = Model?.Details ?? new List<FreshFarm.Web.Bff.Areas.Seller.Models.WarehouseTransactionDetailViewModel>();
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 fw-bold text-primary">
            <i class="bi bi-receipt"></i> Chi tiết phiếu kho
        </h4>
        <a class="btn btn-outline-secondary" href="@Url.Action("TransactionHistory", "Warehouse", new { area = "Seller" })">
            <i class="bi bi-arrow-left"></i> Quay lại lịch sử
        </a>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning">Không tìm thấy thông tin giao dịch.</div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><strong>Mã phiếu:</strong> @Model.TransactionCode</div>
                    <div class="col-md-4"><strong>Loại:</strong> @Model.TransactionType</div>
                    <div class="col-md-4"><strong>Ngày:</strong> @Model.TransactionDate.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-4"><strong>Tổng số lượng:</strong> @Model.TotalQuantity</div>
                    <div class="col-md-4"><strong>Tổng giá trị:</strong> @Model.TotalAmount.ToString("N0") VNĐ</div>
                    <div class="col-md-4"><strong>Người tạo:</strong> @Model.CreatedByName</div>
                    <div class="col-12"><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>SKU</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th>Lô hàng</th>
                                <th>Hạn dùng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (details.Any())
                            {
                                foreach (var item in details)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.SKU</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.UnitPrice.ToString("N0")</td>
                                        <td>@item.Amount.ToString("N0")</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.BatchCode) ? "-" : item.BatchCode)</td>
                                        <td>@(item.ExpiryDate.HasValue ? item.ExpiryDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Không có chi tiết giao dịch.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
