@model IEnumerable<FreshFarm.Web.Bff.Areas.Seller.Models.Category>
@{
    ViewBag.Title = "Quản Lý Danh Mục";
    Layout = (string?)ViewData["LayoutPath"] ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;

    Func<string, string> catImg = f =>
    {
        var name = string.IsNullOrWhiteSpace(f) ? "no-image.png" : f;
        // Ảnh danh mục nằm trong ~/Images/Categories, fallback no-image.png ở ~/Images
        return Url.Content(name == "no-image.png" ? "~/Images/no-image.png"
                                                  : "~/Images/" + name);
    };
}

<main class="container-fluid py-4 min-vh-100">
    <!-- HEADER GRADIENT + HIỆU ỨNG QUÉT ÁNH SÁNG -->
    <div class="grad-header p-4 p-md-5 mb-4 position-relative">
        <div class="position-relative" style="z-index:1;">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="p-3 rounded-4 icon-gradient d-flex align-items-center justify-content-center">
                            <i class="bi bi-collection text-white" style="font-size:2.5rem;"></i>
                        </div>
                        <div>
                            <h1 class="fw-bold mb-1 text-white" style="font-size:2.3rem; text-shadow:0 4px 12px rgba(0,0,0,0.3);">
                                Quản lý danh mục
                            </h1>
                            <p class="mb-0 text-white opacity-90" style="font-size:1.05rem; text-shadow:0 2px 8px rgba(0,0,0,0.2);">
                                Tổ chức và quản lý hệ thống danh mục sản phẩm một cách trực quan
                            </p>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Create", "Category")"
                   class="btn btn-success btn-pill shadow-lg d-flex align-items-center gap-2 hover-scale"
                   style="font-size:1.05rem; white-space:nowrap;">
                    <i class="bi bi-plus-circle" style="font-size:1.4rem;"></i>
                    <span>Thêm danh mục mới</span>
                </a>
            </div>
        </div>
    </div>

    @* Thông báo thành công *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Thông báo lỗi *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Thanh tìm kiếm - FILTER CARD *@
    <div class="filter-card p-4 mb-4">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: linear-gradient(135deg,#1e40af 0%,#3b82f6 100%);">
                <i class="bi bi-search text-white" style="font-size:1.25rem;"></i>
            </div>
            <h5 class="mb-0 fw-bold text-primary-blue">Tìm kiếm danh mục</h5>
        </div>
        <form method="get" action="@Url.Action("ManageCategories")" class="row g-3">
            <div class="col-md-10">
                <div class="search-icon-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Tìm theo tên danh mục, mô tả, slug..."
                           value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary btn-pill d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-funnel-fill"></i>
                    <span>Tìm kiếm</span>
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
        {
            <div class="mt-2 d-flex align-items-center flex-wrap gap-2">
                <span class="badge rounded-pill px-3 py-2" style="background:linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%); color:#1e3a8a;">
                    Đang tìm: "<strong>@ViewBag.CurrentSearch</strong>"
                </span>
                <a href="@Url.Action("ManageCategories")" class="btn btn-sm btn-outline-secondary btn-pill">
                    <i class="bi bi-x"></i> Xóa bộ lọc
                </a>
            </div>
        }
    </div>

    <!-- BẢNG DANH MỤC - GLASS CARD + TABLE-MODERN -->
    <div class="card-glass overflow-hidden">
        <div class="px-4 pt-4 pb-2 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-1 text-primary-blue d-flex align-items-center gap-2">
                    <i class="bi bi-grid"></i> Danh sách danh mục
                </h5>
                <small class="text-muted">
                    @if (Model != null && Model.Any())
                    {
                        <text>Hiển thị <strong>@Model.Count()</strong> trong tổng số <strong>@totalRecords</strong> danh mục
                        (Trang <strong>@currentPage</strong>/<strong>@totalPages</strong>)</text>
                    }
                    else
                    {
                        <text>Không có danh mục nào</text>
                    }
                </small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-modern">
                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th style="width:90px;">Ảnh</th>
                        <th>Tên danh mục</th>
                        <th>Slug</th>
                        <th>Mô tả</th>
                        <th class="text-center" style="width:120px;">Trạng thái</th>
                        <th class="text-center" style="width:150px;">Ngày tạo</th>
                        <th class="text-end" style="width:160px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <span class="badge bg-primary-blue text-white border">@item.CategoryID</span>
                                </td>
                                <td class="px-4">
                                    <img src="@catImg(item.ImageCategoriesName ?? string.Empty)"
                                         alt="@item.CategoryName"
                                         class="rounded-3"
                                         style="width:56px;height:56px;object-fit:cover;box-shadow:0 8px 18px rgba(15,23,42,0.25);" />
                                </td>
                                <td class="fw-bold px-4 text-primary-blue">@item.CategoryName</td>
                                <td class="px-4">
                                    @if (!string.IsNullOrEmpty(item.Slug))
                                    {
                                        <code class="small px-2 py-1 rounded-3" style="background:#f3f4f6;">@item.Slug</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có</span>
                                    }
                                </td>
                                <td class="px-4">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        if (item.Description.Length > 60)
                                        {
                                            <span title="@item.Description">@item.Description.Substring(0, 60)...</span>
                                        }
                                        else
                                        {
                                            @item.Description
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có mô tả</span>
                                    }
                                </td>
                                <td class="text-center px-4">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge rounded-pill px-3 py-2" style="background:linear-gradient(135deg,#22c55e 0%,#16a34a 100%);">
                                            Kích hoạt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-2 bg-secondary">Ẩn</span>
                                    }
                                </td>
                                <td class="text-center small text-muted px-4">
                                    @item.CreatedDate.ToString("dd/MM/yyyy")
                                    @if (item.UpdatedDate.HasValue)
                                    {
                                        <br />
                                        <span class="badge bg-info mt-1" title="Cập nhật lần cuối">
                                            <i class="bi bi-arrow-clockwise"></i> @item.UpdatedDate.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Edit", "Category", new { slug = item.Slug })"
                                           class="btn btn-sm btn-outline-primary btn-action"
                                           title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-action btn-delete"
                                                data-id="@item.CategoryID"
                                                data-name="@item.CategoryName"
                                                title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center gap-3">
                                    <div class="p-4 rounded-circle" style="background:linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%);">
                                        <i class="bi bi-inbox" style="font-size:2.5rem;color:#3b82f6;"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1 text-primary-blue">
                                            @(string.IsNullOrEmpty(ViewBag.CurrentSearch) ? "Không có danh mục nào." : "Không tìm thấy danh mục phù hợp.")
                                        </h5>
                                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                                        {
                                            <p class="text-muted mb-0">Thử thay đổi từ khóa tìm kiếm.</p>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Phân trang *@
        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-center px-4 py-3 border-top"
                 style="background:linear-gradient(90deg,#f0f9ff 0%,#dbeafe 100%);">
                <nav>
                    <ul class="pagination mb-0">
                        @* First Page *@
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageCategories", new { page = 1, search = ViewBag.CurrentSearch })">
                                ««
                            </a>
                        </li>

                        @* Previous Page *@
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageCategories", new { page = currentPage - 1, search = ViewBag.CurrentSearch })">
                                ‹
                            </a>
                        </li>

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ManageCategories", new { page = 1, search = ViewBag.CurrentSearch })">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ManageCategories", new { page = i, search = ViewBag.CurrentSearch })">@i</a>
                            </li>
                        }

                        @if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ManageCategories", new { page = totalPages, search = ViewBag.CurrentSearch })">@totalPages</a>
                            </li>
                        }

                        @* Next Page *@
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageCategories", new { page = currentPage + 1, search = ViewBag.CurrentSearch })">
                                ›
                            </a>
                        </li>

                        @* Last Page *@
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageCategories", new { page = totalPages, search = ViewBag.CurrentSearch })">
                                »»
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

    <!-- Modal xác nhận xóa -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-glass-danger">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Xác nhận xóa
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <div class="p-4 rounded-circle d-inline-flex"
                             style="background:linear-gradient(135deg,#fee2e2 0%,#fecaca 100%);">
                            <i class="bi bi-trash" style="font-size:3rem;color:#dc2626;"></i>
                        </div>
                    </div>
                    <h5 class="mt-2">Bạn có chắc muốn xóa danh mục</h5>
                    <p class="fw-bold fs-5 text-primary-blue mb-2" id="categoryNameDelete"></p>
                    <p class="text-muted mb-0">Hành động này không thể hoàn tác!</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Hủy
                    </button>
                    <button type="button" class="btn btn-danger btn-pill px-4" id="confirmDelete">
                        <i class="bi bi-trash me-1"></i> Xác nhận xóa
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Form ẩn để submit -->
    <form id="deleteForm" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            var deleteId = 0;

            // Tự động ẩn alert sau 5 giây
            setTimeout(function () {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Khi click nút xóa
            $('.btn-delete').click(function () {
                deleteId = $(this).data('id');
                var categoryName = $(this).data('name');

                $('#categoryNameDelete').text(categoryName);
                var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                modal.show();
            });

            // Khi xác nhận xóa
            $('#confirmDelete').click(function () {
                var form = $('#deleteForm');
                form.attr('action', '@Url.Action("Delete", "Category")?id=' + deleteId);
                form.submit();
            });
        });
    </script>

    <style>
        :root {
            --primary-blue: #1e40af;
            --primary-blue-light: #3b82f6;
            --primary-blue-dark: #1e3a8a;
            --accent-blue: #0ea5e9;
            --bg-blue-light: #eff6ff;
            --bg-blue-lighter: #dbeafe;
        }

        body {
            background: linear-gradient(135deg,#eff6ff 0%,#dbeafe 50%,#bfdbfe 100%);
            min-height: 100vh;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        @@keyframes rotate {
            from {
                transform: rotate(0);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .grad-header {
            background: linear-gradient(135deg,#1e40af 0%,#3b82f6 50%,#60a5fa 100%);
            border-radius: 1.5rem;
            box-shadow: 0 20px 50px rgba(30,64,175,0.4);
            animation: fadeInUp .5s ease-out;
            position: relative;
            overflow: hidden;
        }

            .grad-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle,rgba(255,255,255,0.18) 0%,transparent 70%);
                animation: rotate 25s linear infinite;
            }

            .grad-header::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 400px;
                height: 400px;
                background: radial-gradient(circle,rgba(255,255,255,0.12) 0%,transparent 70%);
                border-radius: 50%;
                animation: float 6s ease-in-out infinite;
            }

        .icon-gradient {
            background: linear-gradient(135deg,#1e40af 0%,#3b82f6 100%);
            box-shadow: 0 10px 30px rgba(30,64,175,0.6);
        }

        .card-glass {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(30,64,175,0.08);
            box-shadow: 0 18px 50px rgba(15,23,42,0.18);
            border-radius: 1.5rem;
            animation: fadeInUp .6s ease-out;
        }

        .filter-card {
            background: linear-gradient(135deg,#ffffff 0%,#f0f9ff 100%);
            border: 2px solid #bfdbfe;
            border-radius: 1.5rem;
            box-shadow: 0 15px 40px rgba(30,64,175,0.1);
            animation: fadeInUp .6s ease-out .05s backwards;
        }

        .search-icon-wrapper {
            position: relative;
        }

            .search-icon-wrapper i {
                position: absolute;
                left: 1.25rem;
                top: 50%;
                transform: translateY(-50%);
                color: #60a5fa;
                font-size: 1.1rem;
            }

            .search-icon-wrapper input {
                padding-left: 3.25rem;
                border-radius: 1rem;
                border: 2px solid #bfdbfe;
                transition: all .3s ease;
            }

                .search-icon-wrapper input:focus {
                    border-color: #3b82f6;
                    box-shadow: 0 0 0 5px rgba(59,130,246,0.15);
                }

        .table-modern {
            border-collapse: separate;
            border-spacing: 0;
        }

            .table-modern thead th {
                background: linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%);
                border-bottom: 3px solid #3b82f6;
                font-weight: 600;
                color: #1e3a8a;
                text-transform: uppercase;
                font-size: .75rem;
                letter-spacing: .5px;
                padding: 1.1rem 1rem;
                position: sticky;
                top: 0;
                z-index: 5;
            }

            .table-modern tbody tr {
                transition: all .3s cubic-bezier(.4,0,.2,1);
                border-bottom: 1px solid #e5e7eb;
            }

                .table-modern tbody tr:hover {
                    background: linear-gradient(90deg,rgba(59,130,246,0.06) 0%,rgba(147,197,253,0.06) 100%);
                    transform: translateY(-2px);
                    box-shadow: -5px 0 0 0 #3b82f6;
                }

            .table-modern tbody td {
                padding: 1rem 1rem;
                vertical-align: middle;
            }

        .btn-pill {
            border-radius: 999px;
            padding: .7rem 1.8rem;
            font-weight: 600;
            transition: all .3s cubic-bezier(.4,0,.2,1);
            box-shadow: 0 4px 12px rgba(15,23,42,.18);
            border: none;
        }

            .btn-pill.btn-sm {
                padding: .4rem 1.1rem;
            }

            .btn-pill:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 24px rgba(15,23,42,.25);
            }

        .btn-primary {
            background: linear-gradient(135deg,#1e40af 0%,#3b82f6 100%);
        }

            .btn-primary:hover {
                background: linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);
            }

        .btn-action {
            width: 38px;
            height: 38px;
            border-radius: .875rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all .3s ease;
            border: 2px solid;
        }

            .btn-action:hover {
                transform: scale(1.08);
            }

        .page-link {
            border-radius: .875rem;
            margin: 0 .25rem;
            border: 2px solid #bfdbfe;
            color: #1e40af;
            transition: all .3s ease;
            font-weight: 600;
        }

            .page-link:hover {
                background: linear-gradient(135deg,#3b82f6 0%,#60a5fa 100%);
                color: #fff;
                border-color: #3b82f6;
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(59,130,246,0.3);
            }

        .page-item.active .page-link {
            background: linear-gradient(135deg,#1e40af 0%,#3b82f6 100%);
            border-color: #1e40af;
            color: #fff;
        }

        .page-item.disabled .page-link {
            opacity: .6;
            cursor: not-allowed;
        }

        .alert {
            border-radius: 1.25rem;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
        }

        .text-primary-blue {
            color: #1e40af !important;
        }

        .modal-glass-danger {
            border-radius: 1.5rem;
            border: none;
            box-shadow: 0 25px 60px rgba(30,64,175,0.3);
        }

        .modal-header-danger {
            background: linear-gradient(135deg,#dc2626 0%,#b91c1c 50%,#7f1d1d 100%);
            color: #fff;
            border-radius: 1.5rem 1.5rem 0 0;
        }

        .hover-scale {
            transition: transform .3s ease;
        }

            .hover-scale:hover {
                transform: scale(1.03);
            }

        @@media (max-width:768px) {
            .grad-header {
                padding: 2rem 1.5rem !important;
            }

            .table-modern {
                font-size: .9rem;
            }
        }
    </style>
}
