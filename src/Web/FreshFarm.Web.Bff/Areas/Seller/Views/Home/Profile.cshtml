@model FreshFram.Areas.Admin.Models.ProfileViewModel
@{
    ViewBag.Title = "Hồ Sơ";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";

    // Helpers
    Func<string, string> safe = s => string.IsNullOrWhiteSpace(s) ? "—" : s;
    string roleName = ViewBag.RoleName as string ?? "—";
    string avatar = ViewBag.Avatar as string ?? "no-avatar.jpg";
    Func<string, string> avatarUrl = f => Url.Content("~/Images/" + (string.IsNullOrWhiteSpace(f) ? "no-avatar.jpg" : f));
}

<style>
    .profile-header {
        background: linear-gradient(135deg,#28a745,#218838);
        color: #fff;
        border-radius: 10px;
        padding: 30px;
        text-align: center
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 4px solid #fff;
        object-fit: cover;
        margin-top: -60px
    }

    .info-card, .sidebar-right {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        padding: 20px
    }

    .info-card {
        margin-bottom: 20px
    }

    .sidebar-right {
        position: sticky;
        top: 20px
    }
</style>

<main class="container-fluid mt-4">
    @if (TempData["SuccessMessage"] != null)
    {<div class="alert alert-success">@TempData["SuccessMessage"]</div>}

    @if (TempData["ErrorMessage"] != null)
    {<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="row">
        <!-- Main -->
        <div class="col-lg-9">
            <div class="profile-header mb-4">
                <h2 class="fw-bold">Hồ sơ quản trị viên</h2>
                <p class="mb-0">Quản lý thông tin cá nhân và bảo mật tài khoản</p>
            </div>

            <div class="text-center mb-4">
                <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png"
 class="profile-avatar" alt="Avatar" />
                <h4 class="mt-3">@safe(Model.FullName)</h4>
                <p class="text-muted">@safe(Model.UserName) • @safe(roleName)</p>
                <!-- Nếu có tính năng upload avatar, bật nút/đổi link -->
                @*<button type="button" class="btn btn-outline-success btn-sm" disabled>Thay đổi ảnh đại diện</button>*@
            </div>

            <!-- Thông tin cá nhân (khớp UserAdmin) -->
            <div class="info-card">
                <h5 class="fw-bold mb-3">Thông tin cá nhân</h5>
                @using (Html.BeginForm("Profile", "Home", FormMethod.Post, new { area = "Seller" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.UserID)

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Họ tên" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "Số điện thoại" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                        </div>

                        @* UserAdmin KHÔNG có Address -> bỏ trường này để tránh hiểu nhầm *@
                        @* <div class="col-md-6">
                        @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Địa chỉ (ghi chú)" })
                    </div> *@

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.CreatedDate, new { @class = "form-label" })
                            <input class="form-control" value="@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")" readonly />
                        </div>
                    </div>

                    <div class="text-end mt-4">
                        <button class="btn btn-success" type="submit">Cập nhật thông tin</button>
                    </div>
                }
            </div>

            <!-- Đổi mật khẩu -->
            <div class="info-card">
                <h5 class="fw-bold mb-3">Đổi mật khẩu</h5>
                @using (Html.BeginForm("ChangePassword", "Home", FormMethod.Post, new { area = "Seller" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input id="CurrentPassword" name="CurrentPassword" type="password"
                                   class="form-control" autocomplete="current-password" />
                        </div>
                        <div class="col-md-4">
                            <label for="NewPassword" class="form-label">Mật khẩu mới</label>
                            <input id="NewPassword" name="NewPassword" type="password"
                                   class="form-control" autocomplete="new-password" />
                        </div>
                        <div class="col-md-4">
                            <label for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                            <input id="ConfirmPassword" name="ConfirmPassword" type="password"
                                   class="form-control" autocomplete="new-password" />
                        </div>
                    </div>
                    <div class="text-end mt-4">
                        <button class="btn btn-outline-success" type="submit">Đổi mật khẩu</button>
                    </div>
                }
            </div>

        </div>

        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="sidebar-right">
                <h5 class="fw-bold mb-3">Tóm tắt tài khoản</h5>
                <ul class="list-unstyled small">
                    <li class="mb-2"><i class="bi bi-person-fill text-success me-2"></i>@safe(Model.UserName)</li>
                    <li class="mb-2"><i class="bi bi-envelope-fill text-success me-2"></i>@safe(Model.Email)</li>
                    <li class="mb-2"><i class="bi bi-telephone-fill text-success me-2"></i>@safe(Model.Phone)</li>
                    <li class="mb-2"><i class="bi bi-award-fill text-success me-2"></i>@safe(roleName)</li>
                    <li><i class="bi bi-calendar-check text-success me-2"></i>Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy")</li>
                </ul>
                <hr />
                <h6 class="fw-bold">Hoạt động gần đây</h6>
                <ul class="list-group small">
                    @*<li class="list-group-item">@safe(Model.LastActivity)</li>
        <li class="list-group-item">Đổi mật khẩu</li>
        <li class="list-group-item">Cập nhật hồ sơ</li>*@
                    @foreach (var item in (IEnumerable<string>)ViewBag.Activities)
                    {
                        <li class="list-group-item">@item</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</main>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
