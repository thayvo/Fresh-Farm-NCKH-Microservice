@model FreshFarm.Web.Bff.Areas.Seller.Models.EditCustomerViewModel

@{
    var areaName = ViewData["AreaName"] as string ?? "Seller";
    var layoutPath = ViewData["LayoutPath"] as string ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    var customerScopeLabel = ViewData["CustomerScopeLabel"] as string ?? "Theo seller";

    ViewBag.Title = "Sửa Khách Hàng";
    Layout = layoutPath;
}

<main class="container-fluid p-4">
    <div class="mb-4">
        <h2 class="fw-bold">Chỉnh sửa thông tin khách hàng</h2>
        <span class="badge bg-light text-primary mb-2">@customerScopeLabel</span>
        @{
            ViewBag.BreadcrumbParentTitle = "Quản lý khách hàng";
            ViewBag.BreadcrumbParentUrl = Url.Action("ManageCustomers", "Customer", new { area = areaName });
            ViewBag.BreadcrumbCurrentTitle = "Chỉnh sửa";
        }
        <partial name="_Breadcrumb" />
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Customer", new { area = areaName }, FormMethod.Post, true, new { @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UserID)
                @Html.HiddenFor(m => m.CreatedDate)

                @* Hiển thị thông báo lỗi chung *@
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="col-md-6">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text" class="form-control" value="@Model.UserName" disabled />
                    <small class="text-muted">Không thể thay đổi tên đăng nhập</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Họ và tên *</label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required", placeholder = "Nhập họ và tên" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email *</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required", placeholder = "example@email.com" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", type = "tel", placeholder = "0987654321" })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <label class="form-label">Địa chỉ</label>
                    @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "2", placeholder = "Nhập địa chỉ" })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <hr />
                    <h5 class="mb-3">Thay đổi mật khẩu (tuỳ chọn)</h5>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Mật khẩu mới</label>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Để trống nếu không đổi" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                    <small class="text-muted">Để trống nếu không muốn thay đổi mật khẩu</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Xác nhận mật khẩu mới</label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 mt-4">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Thông tin:</strong> Khách hàng được tạo ngày @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-12 text-end">
                    <a href="@Url.Action("ManageCustomers", "Customer", new { area = areaName })" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-1"></i> Hủy
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Cập nhật
                    </button>
                </div>
            }
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
