@model FreshFarm.Web.Bff.Areas.Seller.Models.SellerLoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập Nhà bán - FreshFarm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --seller-primary: #0f766e;
            --seller-primary-dark: #115e59;
        }

        body {
            font-family: "Be Vietnam Pro", "Segoe UI", sans-serif;
            background:
                radial-gradient(circle at top left, rgba(15, 118, 110, 0.14), transparent 30%),
                linear-gradient(180deg, #f4fbfb 0%, #edf7f5 100%);
        }

        .seller-login-card {
            border: 0;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 50px rgba(15, 23, 42, 0.12);
        }

        .seller-login-hero {
            background: linear-gradient(135deg, var(--seller-primary) 0%, #14b8a6 100%);
            color: #fff;
        }

        .btn-seller {
            background: var(--seller-primary);
            border-color: var(--seller-primary);
            color: #fff;
        }

        .btn-seller:hover {
            background: var(--seller-primary-dark);
            border-color: var(--seller-primary-dark);
            color: #fff;
        }
    </style>
</head>
<body class="bg-light d-flex align-items-center" style="min-height:100vh">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-11 col-md-8 col-lg-5">
                <div class="card seller-login-card">
                    <div class="seller-login-hero p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                                <i class="bi bi-shop fs-4"></i>
                            </span>
                            <div>
                                <div class="text-uppercase small fw-semibold opacity-75">FreshFarm Seller Center</div>
                                <h1 class="h4 mb-0 fw-bold">Đăng nhập Nhà bán</h1>
                            </div>
                        </div>
                        <p class="mb-0 opacity-75">
                            Quản lý gian hàng, đơn bán, vận hành giao hàng và theo dõi hiệu suất kinh doanh tại một nơi duy nhất.
                        </p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="mb-4">
                            <h2 class="h5 fw-bold mb-2">Cổng Nhà bán FreshFarm</h2>
                            <p class="text-muted mb-0">Chỉ tài khoản có quyền Nhà bán mới đăng nhập được tại màn hình này.</p>
                        </div>

                        @using (Html.BeginForm("Login", "SellerAccount", new { area = "Seller", returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, antiforgery: null, htmlAttributes: new { @class = "needs-validation", novalidate = "novalidate" }))
                        {
                            @Html.AntiForgeryToken()
                            @if (ViewBag.RateLimitErrorMessage is string rateLimitErrorMessage && !string.IsNullOrWhiteSpace(rateLimitErrorMessage))
                            {
                                <div class="alert alert-warning py-2 small mb-3">@rateLimitErrorMessage</div>
                            }
                            @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger py-2 small mb-3">@errorMessage</div>
                            }
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-2" })

                            <div class="mb-3">
                                @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Tên đăng nhập hoặc email nhà bán" })
                                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "••••••" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-check mb-3">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "remember" })
                                <label class="form-check-label" for="remember">Ghi nhớ tôi</label>
                            </div>

                            <button type="submit" class="btn btn-seller w-100">Đăng nhập Nhà bán</button>
                        }
                    </div>
                </div>
                <p class="text-center text-muted mt-3 mb-0">&copy; FreshFarm Seller Center</p>
            </div>
        </div>
    </div>
</body>
</html>
