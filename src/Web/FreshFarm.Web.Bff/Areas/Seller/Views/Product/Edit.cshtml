@model FreshFarm.Web.Bff.Areas.Seller.Models.Product
@{
    var areaName = ViewData["AreaName"] as string ?? "Seller";
    var layoutPath = ViewData["LayoutPath"] as string ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    var productScopeLabel = ViewData["ProductScopeLabel"] as string ?? "Theo seller";

    ViewBag.Title = "Chỉnh Sửa Sản Phẩm";
    Layout = layoutPath;
    ViewBag.BreadcrumbParentTitle = "Quản lý sản phẩm";
    ViewBag.BreadcrumbParentUrl = Url.Action("ManageProducts", "Product", new { area = areaName });
    ViewBag.BreadcrumbCurrentTitle = "Chỉnh sửa";
}

@* ========== THÔNG BÁO ========== *@
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
        <div class="d-flex align-items-start">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
            <div class="flex-grow-1">
                @Html.Raw(TempData["ErrorMessage"])
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
        <div class="d-flex align-items-start">
            <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
            <div class="flex-grow-1">
                @Html.Raw(TempData["SuccessMessage"])
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <h5 class="alert-heading">
            <i class="bi bi-exclamation-circle me-2"></i>Vui lòng kiểm tra lại các thông tin sau:
        </h5>
        <hr />
        <ul class="mb-0">
            @foreach (var key in ViewData.ModelState.Keys)
            {
                var state = ViewData.ModelState[key];
                if (state is not null && state.Errors.Count > 0)
                {
                    foreach (var error in state.Errors)
                    {
                        <li><strong>@key:</strong> @error.ErrorMessage</li>
                    }
                }
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<main class="container-fluid p-4">
    <div class="mb-4">
        <h2 class="fw-bold">Chỉnh sửa sản phẩm: @Model.ProductName</h2>
        <span class="badge bg-light text-primary mb-2">@productScopeLabel</span>
        @Html.Partial("_Breadcrumb")
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @using (Html.BeginForm("Edit", "Product", new { area = areaName }, FormMethod.Post, true, new { enctype = "multipart/form-data", @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.ProductID)
                @Html.HiddenFor(m => m.CreatedDate)
                @Html.HiddenFor(m => m.ImageFileName)

                <!-- Tên sản phẩm -->
                <div class="col-12">
                    <label class="form-label fw-bold">
                        <i class="bi bi-tag me-1"></i>Tên sản phẩm <span class="text-danger">*</span>
                    </label>
                    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Nhập tên sản phẩm", required = "required" })
                    @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
                </div>

                <!-- Mô tả ngắn -->
                <div class="col-12">
                    <label class="form-label fw-bold">
                        <i class="bi bi-pencil-square me-1"></i>Mô tả ngắn
                    </label>
                    @Html.TextAreaFor(m => m.ShortDescription, new { @class = "form-control", rows = "3", placeholder = "Mô tả ngắn gọn về sản phẩm (hiển thị trên danh sách)" })
                    @Html.ValidationMessageFor(m => m.ShortDescription, "", new { @class = "text-danger" })
                </div>

                <!-- Mô tả chi tiết -->
                <div class="col-12">
                    <label class="form-label fw-bold">
                        <i class="bi bi-file-text me-1"></i>Mô tả chi tiết
                    </label>
                    @Html.TextAreaFor(m => m.LongDescription, new { @class = "form-control", rows = "6", placeholder = "Mô tả chi tiết đầy đủ về sản phẩm, công dụng, cách sử dụng..." })
                    @Html.ValidationMessageFor(m => m.LongDescription, "", new { @class = "text-danger" })
                </div>

                <!-- Danh mục -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        <i class="bi bi-folder me-1"></i>Danh mục <span class="text-danger">*</span>
                    </label>
                    @Html.DropDownListFor(m => m.CategoryId,
                        (SelectList)ViewBag.Categories,
                        "-- Chọn danh mục --",
                        new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                </div>

                <!-- Mã SKU -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        <i class="bi bi-upc me-1"></i>Mã sản phẩm (SKU)
                    </label>
                    @Html.TextBoxFor(m => m.Sku, new { @class = "form-control", placeholder = "VD: PRD-001-0001", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.Sku, "", new { @class = "text-danger" })
                    <small class="text-muted">Mã SKU không thể thay đổi</small>
                </div>

                <!-- Giá -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        <i class="bi bi-currency-dollar me-1"></i>Giá (VNĐ) <span class="text-danger">*</span>
                    </label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "1000", min = "0", placeholder = "Nhập giá (VND)", required = "required" })
                    <small class="text-muted">Giá có thể chỉnh tại đây. Lưu ý: nếu cập nhật Kho, giá có thể tự đổi theo Giá bán ở Kho.</small>
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                </div>

                <!-- Số lượng tồn kho -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        <i class="bi bi-box-seam me-1"></i>Số lượng tồn kho <span class="text-danger">*</span>
                    </label>
                    @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control", type = "number", min = "0", placeholder = "Đồng bộ từ Kho", @readonly = "readonly", disabled = "disabled" })
                    <small class="text-muted">Số lượng tồn kho được quản lý ở module Kho</small>
                    @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-danger" })
                </div>

                <!-- Đơn vị tính -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        <i class="bi bi-rulers me-1"></i>Đơn vị tính <span class="text-danger">*</span>
                    </label>
                    @Html.DropDownListFor(m => m.UnitID,
                        new SelectList(new[] {
                            new { Value = 1, Text = "Kilogram (kg)" },
                            new { Value = 2, Text = "Gram (g)" },
                            new { Value = 3, Text = "Bó" },
                            new { Value = 4, Text = "Túi" },
                            new { Value = 5, Text = "Thùng" }
                        }, "Value", "Text", Model.UnitID),
                        new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.UnitID, "", new { @class = "text-danger" })
                </div>

                <!-- Trạng thái -->
                <div class="col-12">
                    <label class="form-label fw-bold">
                        <i class="bi bi-eye me-1"></i>Trạng thái
                    </label>
                    <div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.Status, true, new { @class = "form-check-input", id = "statusActive" })
                            <label class="form-check-label" for="statusActive">
                                <i class="bi bi-check-circle text-success me-1"></i>Đang bán
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.Status, false, new { @class = "form-check-input", id = "statusInactive" })
                            <label class="form-check-label" for="statusInactive">
                                <i class="bi bi-x-circle text-danger me-1"></i>Ẩn
                            </label>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-lightbulb me-1"></i>Lưu ý: Hạn sử dụng được quản lý ở module Kho
                    </small>
                </div>

                <!-- Ảnh sản phẩm -->
                <div class="col-12">
                    <label class="form-label fw-bold">
                        <i class="bi bi-image me-1"></i>Ảnh sản phẩm
                    </label>
                    <div class="text-center mb-3">
                        @{
                            var currentImage = !string.IsNullOrEmpty(Model.ImageFileName)
                                ? Url.Content("~/Images/" + Model.ImageFileName)
                                : Url.Content("~/Images/no-image.png");
                        }
                        <img alt="@Model.ProductName"
                             style="width: 200px; height: 200px; object-fit: cover; border: 2px solid #28a745; background: #f8f9fa; display: block; margin: 0 auto;"
                             class="rounded"
                             id="imagePreview"
                             src="@currentImage" />
                        @if (!string.IsNullOrEmpty(Model.ImageFileName))
                        {
                            <small class="text-muted d-block mt-2">Ảnh hiện tại: @Model.ImageFileName</small>
                        }
                    </div>
                    <input type="file" name="ImageFile" class="form-control" id="imageInput" accept="image/*" />
                    <small class="text-muted d-block mt-1">Chọn ảnh mới để thay đổi. Chỉ chấp nhận: JPG, PNG, GIF, WEBP (tối đa 5MB)</small>
                    <span class="text-danger d-block mt-1" id="imageError"></span>
                </div>

                <!-- Thông tin bổ sung -->
                <div class="col-12">
                    <div class="border-top pt-3 mt-2">
                        <p class="text-muted mb-2">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm") |
                            <strong>ID:</strong> #@Model.ProductID
                        </p>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="col-12 mt-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("ManageProducts", "Product", new { area = areaName })" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-2"></i>Quay lại
                        </a>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-warning px-4" id="resetBtn">
                                <i class="bi bi-arrow-counterclockwise me-2"></i>Hoàn tác
                            </button>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm" id="saveBtn" style="min-width: 200px;">
                                <i class="bi bi-save me-2"></i>
                                <span class="btn-text">Cập nhật sản phẩm</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        #saveBtn {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            #saveBtn:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4) !important;
            }

            #saveBtn:active:not(:disabled) {
                transform: translateY(0);
            }

            #saveBtn:disabled {
                cursor: not-allowed;
                opacity: 0.7;
            }

        .btn-outline-warning:hover {
            transform: translateY(-2px);
            transition: all 0.3s ease;
        }

        .btn-outline-secondary:hover {
            transform: translateX(-3px);
            transition: all 0.3s ease;
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
        }

        textarea.form-control {
            resize: vertical;
            min-height: 60px;
        }

            textarea.form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

        .alert {
            border-left: 4px solid;
            font-size: 14px;
            line-height: 1.6;
        }

        .alert-danger {
            border-left-color: #dc3545;
            background-color: #f8d7da;
        }

        .alert-success {
            border-left-color: #28a745;
            background-color: #d4edda;
        }

        .alert-warning {
            border-left-color: #ffc107;
            background-color: #fff3cd;
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .text-danger {
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }
    </style>

    <script>
        let isSubmitting = false;
        const originalData = {
            productName: '@Html.Raw(Model.ProductName)',
            shortDescription: '@Html.Raw(Model.ShortDescription)',
            longDescription: '@Html.Raw(Model.LongDescription)',
            categoryId: '@Model.CategoryId',
            price: '@Model.Price',
            stockQuantity: '@Model.StockQuantity',
            unitId: '@Model.UnitID',
            status: '@Model.Status'
        };

        // Image preview với validation
        const imageInput = document.getElementById("imageInput");
        const imagePreview = document.getElementById("imagePreview");
        const imageError = document.getElementById("imageError");

        imageInput.addEventListener("change", function () {
            imageError.textContent = '';
            const file = this.files[0];

            if (file) {
                const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    imageError.textContent = 'Chỉ chấp nhận file ảnh JPG, PNG, GIF, WEBP!';
                    this.value = '';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    imageError.textContent = 'Kích thước file không được vượt quá 5MB!';
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = (e) => {
                    imagePreview.src = e.target.result;
                    imagePreview.style.border = '2px solid #0d6efd';
                };
                reader.readAsDataURL(file);
            }
        });

        // Xử lý submit form
        $('form').on('submit', function (e) {
            if (isSubmitting) {
                return true;
            }

            e.preventDefault();

            imageError.textContent = '';

            // Validation
            var productName = $.trim($('#ProductName').val());
            if (productName === '') {
                alert('Vui lòng nhập tên sản phẩm!');
                $('#ProductName').focus();
                return false;
            }

            var categoryId = $('#CategoryId').val();
            if (categoryId === '' || categoryId === null) {
                alert('Vui lòng chọn danh mục!');
                $('#CategoryId').focus();
                return false;
            }

            var price = parseFloat($('#Price').val());
            if (isNaN(price) || price < 0) {
                alert('Giá sản phẩm không hợp lệ!');
                $('#Price').focus();
                return false;
            }

            isSubmitting = true;

            const saveBtn = $('#saveBtn');
            const btnText = saveBtn.find('.btn-text');
            const btnIcon = saveBtn.find('i');

            saveBtn.prop('disabled', true);
            $('#resetBtn').prop('disabled', true);

            btnIcon.removeClass('bi-save').addClass('spinner-border spinner-border-sm');
            btnText.text('Đang cập nhật...');
            saveBtn.removeClass('btn-primary').addClass('btn-secondary');

            this.submit();
        });

        // Nút Reset - Hoàn tác về dữ liệu ban đầu
        $('#resetBtn').on('click', function() {
            if (confirm('Bạn có chắc muốn hoàn tác tất cả thay đổi về dữ liệu ban đầu?')) {
                $('#ProductName').val(originalData.productName);
                $('#ShortDescription').val(originalData.shortDescription);
                $('#LongDescription').val(originalData.longDescription);
                $('#CategoryId').val(originalData.categoryId);
                $('#Price').val(originalData.price);
                $('#StockQuantity').val(originalData.stockQuantity);
                $('#UnitID').val(originalData.unitId);

                if (originalData.status.toLowerCase() === 'true') {
                    $('#statusActive').prop('checked', true);
                } else {
                    $('#statusInactive').prop('checked', true);
                }

                $('#imageInput').val('');
                imageError.textContent = '';

                var originalImage = '@(!string.IsNullOrEmpty(Model.ImageFileName) ? Url.Content("~/Images/" + Model.ImageFileName) : Url.Content("~/Images/no-image.png"))';
                imagePreview.src = originalImage;
                imagePreview.style.border = '2px solid #28a745';

                alert('Đã hoàn tác tất cả thay đổi!');
            }
        });

        // Trim whitespace khi blur
        $('#ProductName, #ShortDescription, #LongDescription').on('blur', function() {
            $(this).val($.trim($(this).val()));
        });

        // Format giá khi nhập
        $('#Price').on('blur', function() {
            var val = parseFloat($(this).val());
            if (!isNaN(val)) {
                val = Math.round(val / 1000) * 1000;
                $(this).val(val);
            }
        });

        // Tự động ẩn thông báo sau 10 giây
        $(document).ready(function () {
            setTimeout(function () {
                $('.alert').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 10000);

            if ($('.alert-danger').length > 0) {
                $('html, body').animate({
                    scrollTop: $('.alert-danger').offset().top - 100
                }, 500);
            }
        });

        // Cảnh báo khi rời trang có thay đổi chưa lưu
        let formChanged = false;
        $('form :input').on('change input', function() {
            formChanged = true;
        });

        $(window).on('beforeunload', function() {
            if (formChanged && !isSubmitting) {
                return 'Bạn có thay đổi chưa được lưu. Bạn có chắc muốn rời khỏi trang?';
            }
        });

        $('form').on('submit', function() {
            formChanged = false;
        });
    </script>
}
