@model List<FreshFarm.Web.Bff.Areas.Seller.Models.Product>
@{
    var areaName = ViewData["AreaName"] as string ?? "Seller";
    var layoutPath = ViewData["LayoutPath"] as string ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    var productScopeLabel = ViewData["ProductScopeLabel"] as string ?? "Theo seller";

    ViewBag.Title = "Quản Lý Sản Phẩm";
    Layout = layoutPath;
}

<style>
    :root {
        --primary-blue: #1e40af;
        --primary-blue-light: #3b82f6;
        --primary-blue-dark: #1e3a8a;
        --accent-blue: #0ea5e9;
        --bg-blue-light: #eff6ff;
        --bg-blue-lighter: #dbeafe;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes rotate {
        from {
            transform: rotate(0);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .6;
        }
    }

    @@keyframes pulse-number {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    @@keyframes pulse-btn {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(220,53,69,.7);
        }

        50% {
            box-shadow: 0 0 0 10px rgba(220,53,69,0);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    body {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 50%, #bfdbfe 100%);
        min-height: 100vh;
    }

    /* THEME CHUNG (giống Shipping / Customer) */
    .card-glass {
        background: rgba(255,255,255,.98);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(30,64,175,.1);
        box-shadow: 0 20px 60px rgba(30,64,175,.15);
        border-radius: 1.5rem;
        animation: fadeInUp .6s ease-out;
    }

    .grad-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #60a5fa 100%);
        border-radius: 1.5rem;
        box-shadow: 0 20px 50px rgba(30,64,175,.4);
        animation: fadeInUp .5s ease-out;
        position: relative;
        overflow: hidden;
    }

        .grad-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,.15) 0%, transparent 70%);
            animation: rotate 25s linear infinite;
        }

        .grad-header::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,.1) 0%, transparent 70%);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }

    .icon-gradient {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        box-shadow: 0 10px 30px rgba(30,64,175,.5);
    }

    .filter-card {
        background: linear-gradient(135deg, #fff 0%, #f0f9ff 100%);
        border: 2px solid #bfdbfe;
        border-radius: 1.5rem;
        box-shadow: 0 15px 40px rgba(30,64,175,.1);
        animation: fadeInUp .6s ease-out .1s backwards;
    }

    .table-modern {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-modern thead th {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-bottom: 3px solid #3b82f6;
            font-weight: 600;
            color: #1e3a8a;
            text-transform: uppercase;
            font-size: .75rem;
            letter-spacing: .5px;
            padding: 1.1rem .9rem;
        }

        .table-modern tbody tr {
            transition: all .25s cubic-bezier(.4,0,.2,1);
            animation: slideIn .35s ease-out backwards;
            border-bottom: 1px solid #e5e7eb;
        }

            .table-modern tbody tr:hover {
                background: linear-gradient(90deg, rgba(59,130,246,.08) 0%, rgba(147,197,253,.08) 100%);
                transform: translateY(-2px);
                box-shadow: -5px 0 0 0 #3b82f6;
            }

        .table-modern tbody td {
            padding: 1rem .9rem;
            vertical-align: middle;
        }

    .btn-pill {
        border-radius: 2rem;
        padding: .7rem 1.9rem;
        font-weight: 600;
        transition: all .25s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
        border: none;
    }

        .btn-pill:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(0,0,0,.2);
        }

    .btn-primary,
    .btn-success {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%) !important;
        border-color: #1e40af !important;
    }

        .btn-primary:hover,
        .btn-success:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
        }

    .page-link {
        border-radius: .875rem;
        margin: 0 .25rem;
        border: 2px solid #bfdbfe;
        color: #1e40af;
        transition: all .25s ease;
        font-weight: 600;
    }

        .page-link:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
            color: #fff;
            border-color: #3b82f6;
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(59,130,246,.3);
        }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-color: #1e40af;
        color: #fff;
    }

    .alert {
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .modal-content {
        border-radius: 1.5rem;
        border: none;
        box-shadow: 0 25px 60px rgba(30,64,175,.3);
    }

    .modal-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        color: #fff;
        border-radius: 1.5rem 1.5rem 0 0;
    }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

    .text-primary-blue {
        color: #1e40af !important;
    }

    .hover-scale {
        transition: transform .3s ease;
    }

        .hover-scale:hover {
            transform: scale(1.05);
        }

    /* PRODUCT SPECIFIC */

    .product-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: .75rem;
        border: 2px solid #e5e7eb;
        transition: all .3s ease;
    }

        .product-thumb:hover {
            transform: scale(1.08);
            border-color: #3b82f6;
            box-shadow: 0 4px 8px rgba(59,130,246,.35);
            cursor: pointer;
        }

    #modalProductImage {
        max-height: 400px;
        width: 100%;
        object-fit: contain;
        border-radius: 10px;
    }

    .stats-card {
        border-left: 4px solid;
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 12px 30px rgba(15,23,42,.1);
        transition: all .3s ease;
        cursor: pointer;
        background: #fff;
    }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 40px rgba(15,23,42,.18) !important;
        }

        .stats-card[style*="border-left-color: #dc3545"] h3,
        .stats-card[style*="border-left-color: #fd7e14"] h3 {
            animation: pulse-number 2s ease-in-out infinite;
        }

    .table-hover tbody tr {
        transition: all .2s ease;
    }

    .badge {
        font-size: .85rem;
        padding: .35em .75em;
        font-weight: 500;
    }

    .action-buttons .btn {
        transition: all .2s ease;
    }

        .action-buttons .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,.18);
        }

    .page-link {
        border-radius: .75rem;
    }

    .checkbox-cell {
        width: 40px;
        text-align: center;
    }

    .bulk-actions {
        display: none;
        animation: fadeInUp .3s ease;
    }

        .bulk-actions.show {
            display: block;
        }

    .loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

        .loading-overlay.show {
            display: flex;
        }

    .expiry-warning {
        background-color: #fff3cd !important;
        border-left: 4px solid #ffc107;
    }

    .expiry-expired {
        background-color: #f8d7da !important;
        border-left: 4px solid #dc3545;
        opacity: .8;
    }

    .expiry-date-warning {
        color: #ff6b6b;
        font-weight: 700;
        animation: pulse 2s infinite;
    }

    .expiry-date-expired {
        color: #dc3545;
        font-weight: 700;
        text-decoration: line-through;
    }

    .text-orange {
        color: #fd7e14 !important;
    }

    .btn-group .btn {
        padding: .5rem 1rem;
        font-weight: 500;
        transition: all .3s ease;
    }

        .btn-group .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,.15);
        }

    .btn-group .btn-danger.active,
    .btn-group .btn-warning.active {
        animation: pulse-btn 2s ease-in-out infinite;
    }

    .badge.fs-6 {
        padding: .45rem 1rem;
        animation: slideInRight .5s ease;
    }

    .empty-state {
        animation: fadeInUp .6s ease;
    }

        .empty-state i.display-1 {
            animation: bounce 2s ease-in-out infinite;
        }

    @@media (max-width:1199.98px) {
        .stats-card .card-body {
            padding: .75rem;
        }

        .stats-card h6 {
            font-size: .8rem;
        }

        .stats-card h3 {
            font-size: 1.5rem;
        }

        .stats-card .fs-1 {
            font-size: 2rem !important;
        }
    }

    @@media (max-width:767.98px) {
        .stats-card {
            margin-bottom: 1rem;
        }
    }
</style>

<main class="min-vh-100">
    <div class="container-fluid py-4">

        <!-- HEADER: dùng grad-header giống trang Shipping -->
        <div class="grad-header p-4 p-md-5 mb-4 position-relative">
            <div class="position-relative" style="z-index:1;">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="p-3 rounded-4 icon-gradient">
                                <i class="bi bi-box-seam text-white" style="font-size:2.5rem;"></i>
                            </div>
                            <div>
                                <h1 class="fw-bold mb-1 text-white" style="font-size:2.5rem; text-shadow:0 4px 12px rgba(0,0,0,.3);">
                                    Quản lý sản phẩm
                                </h1>
                                <span class="badge bg-light text-primary mb-2">@productScopeLabel</span>
                                <p class="mb-0 text-white opacity-90" style="text-shadow:0 2px 8px rgba(0,0,0,.2);">
                                    Quản lý tồn kho, giá bán và hạn sử dụng của toàn bộ sản phẩm
                                </p>
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("Create", "Product", new { area = areaName })"
                       class="btn btn-primary btn-pill shadow-lg d-flex align-items-center gap-2 hover-scale">
                        <i class="bi bi-plus-circle" style="font-size:1.4rem;"></i>
                        <span>Thêm sản phẩm mới</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- THÔNG BÁO -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- STAT CARDS -->
        <div class="row mb-4 g-3">
            <div class="col-md-3 col-lg-2">
                <div class="card stats-card shadow-sm" style="border-left-color:#0d6efd;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small">Tổng sản phẩm</h6>
                                <h3 class="fw-bold mb-0">@ViewBag.TotalProductsInDB</h3>
                            </div>
                            <div class="fs-1 text-primary opacity-75">
                                <i class="bi bi-box-seam"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-lg-2">
                <div class="card stats-card shadow-sm" style="border-left-color:#198754;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small">Đang bán</h6>
                                <h3 class="fw-bold mb-0 text-success">@ViewBag.ActiveProductsInDB</h3>
                            </div>
                            <div class="fs-1 text-success opacity-75">
                                <i class="bi bi-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-lg-2">
                <div class="card stats-card shadow-sm" style="border-left-color:#6c757d;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small">Đã ẩn</h6>
                                <h3 class="fw-bold mb-0 text-secondary">@ViewBag.InactiveProductsInDB</h3>
                            </div>
                            <div class="fs-1 text-secondary opacity-75">
                                <i class="bi bi-x-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-lg-2">
                <div class="card stats-card shadow-sm" style="border-left-color:#ffc107;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small">Sắp hết hàng</h6>
                                <h3 class="fw-bold mb-0 text-warning">@ViewBag.LowStockProductsInDB <small class="text-muted">&lt; (10)</small></h3>
                                
                            </div>
                            <div class="fs-1 text-warning opacity-75">
                                <i class="bi bi-exclamation-triangle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-lg-2">
                <div class="card stats-card shadow-sm" style="border-left-color:#dc3545;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small">Đã hết hạn</h6>
                                <h3 class="fw-bold mb-0 text-danger">@ViewBag.ExpiredProductsInDB</h3>
                            </div>
                            <div class="fs-1 text-danger opacity-75">
                                <i class="bi bi-calendar-x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-lg-2">
                <div class="card stats-card shadow-sm" style="border-left-color:#fd7e14;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small">Sắp hết hạn</h6>
                                <h3 class="fw-bold mb-0 text-orange">@ViewBag.ExpiringSoonProductsInDB</h3>
                                
                            </div>
                            <div class="fs-1 opacity-75" style="color:#fd7e14;">
                                <i class="bi bi-clock-history"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @{
            var qExpired = Context.Request.Query["expired"].ToString().Equals("true", StringComparison.OrdinalIgnoreCase);
            var qExpSoon = Context.Request.Query["expiringSoon"].ToString().Equals("true", StringComparison.OrdinalIgnoreCase);
        }

        <!-- FILTER + RESULT CONTAINER -->
        <div id="productsContainer">

            <!-- FILTER CARD: dùng filter-card giống Shipping -->
            <div class="filter-card mb-4">
                <form method="get" action="@Url.Action("ManageProducts")" id="filterForm">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold text-primary-blue">
                                <i class="bi bi-search me-1"></i>Tìm kiếm
                            </label>
                            <input type="text"
                                   name="searchTerm"
                                   class="form-control"
                                   placeholder="Tên, SKU, mô tả..."
                                   value="@ViewBag.SearchTerm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold text-primary-blue">
                                <i class="bi bi-folder me-1"></i>Danh mục
                            </label>
                            <select name="categoryId" class="form-select">
                                <option value="">Tất cả</option>
                                @foreach (var cat in (ViewBag.Categories as List<FreshFarm.Web.Bff.Areas.Seller.Models.Category>) ?? new List<FreshFarm.Web.Bff.Areas.Seller.Models.Category>())
                                {
                                    <option value="@cat.CategoryID" selected="@(ViewBag.SelectedCategory == cat.CategoryID  ? "selected" : null)">
                                        @cat.CategoryName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold text-primary-blue">
                                <i class="bi bi-rulers me-1"></i>Đơn vị
                            </label>
                            <select name="unitId" class="form-select">
                                <option value="">Tất cả</option>
                                @foreach (var unit in (ViewBag.Units as List<FreshFarm.Web.Bff.Areas.Seller.Models.Unit>) ?? new List<FreshFarm.Web.Bff.Areas.Seller.Models.Unit>())
                                {
                                    <option value="@unit.UnitID" selected="@(ViewBag.SelectedUnit == unit.UnitID  ? "selected" : null)">
                                        @unit.UnitName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold text-primary-blue">
                                <i class="bi bi-eye me-1"></i>Trạng thái
                            </label>
                            <select name="status" class="form-select">
                                <option value="">Tất cả</option>
                                <option value="true" selected="@(ViewBag.SelectedStatus == true  ? "selected" : null)">Đang bán</option>
                                <option value="false" selected="@(ViewBag.SelectedStatus == false  ? "selected" : null)">Đã ẩn</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold text-primary-blue">
                                <i class="bi bi-sort-down me-1"></i>Sắp xếp
                            </label>
                            <select name="sortBy" class="form-select">
                                <option value="">Mới nhất</option>
                                <option value="oldest" selected="@(ViewBag.CurrentSort == "oldest"  ? "selected" : null)">Cũ nhất</option>
                                <option value="name_asc" selected="@(ViewBag.CurrentSort == "name_asc"  ? "selected" : null)">Tên A-Z</option>
                                <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc"  ? "selected" : null)">Tên Z-A</option>
                                <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc"  ? "selected" : null)">Giá thấp → cao</option>
                                <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc"  ? "selected" : null)">Giá cao → thấp</option>
                                <option value="stock_asc" selected="@(ViewBag.CurrentSort == "stock_asc"  ? "selected" : null)">Tồn kho thấp</option>
                                <option value="stock_desc" selected="@(ViewBag.CurrentSort == "stock_desc"  ? "selected" : null)">Tồn kho cao</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label fw-semibold text-primary-blue d-none d-md-block">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary w-100" title="Lọc">
                                    <i class="bi bi-funnel-fill"></i>
                                </button>
                                <a href="@Url.Action("ManageProducts")"
                                   class="btn btn-light js-ajax-filter"
                                   title="Xóa bộ lọc">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- group nút hết hạn / sắp hết hạn -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="btn-group filter-tabs" role="group">
                                @* Tất cả *@
                                @if (!qExpired && !qExpSoon)
                                {
                                    <button type="button" class="btn btn-primary active" style="margin:2px;">
                                        <i class="bi bi-grid-3x3-gap me-1"></i>Tất cả sản phẩm
                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action("ManageProducts")"
                                       style="margin:2px;"
                                       class="btn btn-outline-primary js-ajax-filter">
                                        <i class="bi bi-grid-3x3-gap me-1"></i>Tất cả sản phẩm
                                    </a>
                                }

                                @* Đã hết hạn *@
                                @if (qExpired)
                                {
                                    <button type="button" class="btn btn-danger active" style="margin:2px;margin:2px;">
                                        <i class="bi bi-calendar-x me-1"></i>
                                        Đã hết hạn (@ViewBag.ExpiredProductsInDB)
                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action("ManageProducts", new { expired = true }) " style="margin:2px;"
                                       class="btn btn-outline-danger js-ajax-filter">
                                        <i class="bi bi-calendar-x me-1"></i>
                                        Đã hết hạn (@ViewBag.ExpiredProductsInDB)
                                    </a>
                                }

                                @* Sắp hết hạn *@
                                @if (qExpSoon)
                                {
                                    <button type="button" class="btn btn-warning active" style="color:black;  margin:2px;">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Sắp hết hạn (@ViewBag.ExpiringSoonProductsInDB)
                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action("ManageProducts", new { expiringSoon = true }) " style="margin:2px; color: black;"
                                       class="btn btn-outline-warning js-ajax-filter">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Sắp hết hạn (@ViewBag.ExpiringSoonProductsInDB)
                                    </a>
                                }
                            </div>

                            @if (qExpired)
                            {
                                <span class="badge bg-danger ms-3 fs-6">
                                    <i class="bi bi-funnel-fill me-1"></i>Đang lọc: Sản phẩm đã hết hạn
                                </span>
                            }
                            else if (qExpSoon)
                            {
                                <span class="badge bg-warning text-dark ms-3 fs-6">
                                    <i class="bi bi-funnel-fill me-1"></i>Đang lọc: Sản phẩm sắp hết hạn (≤ 7 ngày)
                                </span>
                            }
                        </div>
                    </div>
                </form>
            </div>

            <!-- BULK ACTION BAR -->
            <div class="bulk-actions mb-3" id="bulkActionsBar">
                <div class="card border-0 shadow-sm">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                <i class="bi bi-check-square me-2"></i>
                                Đã chọn: <span id="selectedCount">0</span> sản phẩm
                            </span>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-success" onclick="bulkUpdateStatus(true)">
                                    <i class="bi bi-check-circle me-1"></i>Bật
                                </button>
                                <button type="button" class="btn btn-sm btn-warning" onclick="bulkUpdateStatus(false)">
                                    <i class="bi bi-x-circle me-1"></i>Ẩn
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="bulkDelete()">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary" onclick="clearSelection()">
                                    <i class="bi bi-x me-1"></i>Hủy
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLE ĐƯỢC BỌC TRONG card-glass -->
            <div class="card-glass">
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 table-modern">
                                <thead>
                                    <tr>
                                        <th class="checkbox-cell">
                                            <input type="checkbox" class="form-check-input" id="selectAll" />
                                        </th>
                                        <th style="width:80px;">Ảnh</th>
                                        <th>Sản phẩm</th>
                                        <th>Danh mục</th>
                                        <th>Giá</th>
                                        <th>Tồn kho</th>
                                        <th>Đơn vị</th>
                                        <th>Trạng thái</th>
                                        <th>Hạn sử dụng</th>
                                        <th style="width:200px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var expiryMap = ViewBag.ProductExpiryMap as Dictionary<int, DateTime?>;
                                    }

                                    @foreach (var product in Model)
                                    {
                                        var rowClass = "";
                                        var expiryClass = "";
                                        var daysToExpiry = 0;
                                        DateTime? expiryDate = null;

                                        if (expiryMap != null && expiryMap.ContainsKey(product.ProductID))
                                        {
                                            expiryDate = expiryMap[product.ProductID];

                                            if (expiryDate.HasValue)
                                            {
                                                daysToExpiry = (int)(expiryDate.Value.Date - DateTime.Now.Date).TotalDays;

                                                if (daysToExpiry < 0)
                                                {
                                                    rowClass = "expiry-expired";
                                                    expiryClass = "expiry-date-expired";
                                                }
                                                else if (daysToExpiry <= 7)
                                                {
                                                    rowClass = "expiry-warning";
                                                    expiryClass = "expiry-date-warning";
                                                }
                                            }
                                        }

                                        <tr data-product-id="@product.ProductID" class="@rowClass">
                                            <td class="checkbox-cell">
                                                <input type="checkbox" class="form-check-input product-checkbox" value="@product.ProductID" />
                                            </td>
                                            <td>
                                        <img src="@ProductImagePaths.ResolveRequestPath(product.ImageFileName)"
                                                     alt="@product.ProductName"
                                                     class="product-thumb"
                                                     loading="lazy"
                                                     decoding="async"
                                             onclick="showImageModal('@ProductImagePaths.ResolveRequestPath(product.ImageFileName)', '@product.ProductName')" />
                                            </td>
                                            <td>
                                                <div>
                                                    <strong class="text-primary-blue">@product.ProductName</strong><br />
                                                    <small class="text-muted">
                                                        <i class="bi bi-upc me-1"></i>@product.Sku
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @product.Category.CategoryName
                                                </span>
                                            </td>
                                            <td>
                                                <strong class="text-primary">@product.Price.ToString("N0") đ</strong>
                                            </td>
                                            <td>
                                                @if (product.StockQuantity < 10)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>@product.StockQuantity
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">@product.StockQuantity</span>
                                                }
                                            </td>
                                            <td>@product.Unit.UnitName</td>
                                            <td>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input status-toggle"
                                                           type="checkbox"
                                                           @(product.Status ? "checked" : "")
                                                           data-id="@product.ProductID"
                                                           title="@(product.Status ? "Đang bán" : "Đã ẩn")" />
                                                </div>
                                            </td>
                                            <td>
                                                @if (expiryDate.HasValue)
                                                {
                                                    <span class="@expiryClass">
                                                        @expiryDate.Value.ToString("dd/MM/yyyy")
                                                        @if (daysToExpiry >= 0 && daysToExpiry <= 7)
                                                        {
                                                            <br />
                                                            <small class="badge bg-warning text-dark">
                                                                <i class="bi bi-clock me-1"></i>Còn @daysToExpiry ngày
                                                            </small>
                                                        }
                                                        @if (daysToExpiry < 0)
                                                        {
                                                            <br />
                                                            <small class="badge bg-danger">
                                                                <i class="bi bi-x-circle me-1"></i>Đã hết hạn
                                                            </small>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <em class="text-muted">Không có</em>
                                                }
                                            </td>
                                            <td>
                                                <div class="action-buttons btn-group btn-group-sm">
                                                    <a href="@Url.Action("Edit", "Product", new { id = product.ProductID })"
                                                       class="btn btn-warning" title="Sửa">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-info"
                                                            onclick="showProductDetails(@product.ProductID)" title="Chi tiết">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-danger"
                                                            onclick="deleteProduct(@product.ProductID, '@product.ProductName')" title="Xóa">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        if (ViewBag.TotalPages > 1)
                        {
                            <div class="px-4 py-3 border-top d-flex flex-column flex-md-row align-items-center justify-content-between" style="background:linear-gradient(90deg,#f0f9ff 0%,#dbeafe 100%);">
                                <div class="text-muted small">
                                    Hiển thị @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)
                                    đến @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalCount))
                                    trong tổng số @ViewBag.TotalCount sản phẩm
                                    @if (qExpired)
                                    {
                                        <span class="badge bg-danger ms-2">Đã hết hạn</span>
                                    }
                                    else if (qExpSoon)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Sắp hết hạn</span>
                                    }
                                </div>
                                <nav class="mt-2 mt-md-0">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("ManageProducts", new {
                                                page = ViewBag.CurrentPage - 1,
                                                searchTerm = ViewBag.SearchTerm,
                                                categoryId = ViewBag.SelectedCategory,
                                                unitId = ViewBag.SelectedUnit,
                                                status = ViewBag.SelectedStatus,
                                                sortBy = ViewBag.CurrentSort,
                                                expired = Context.Request.Query["expired"],
                                                expiringSoon = Context.Request.Query["expiringSoon"]
                                            })"><i class="bi bi-chevron-left"></i></a>
                                        </li>
                                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("ManageProducts", new {
                                                    page = i,
                                                    searchTerm = ViewBag.SearchTerm,
                                                    categoryId = ViewBag.SelectedCategory,
                                                    unitId = ViewBag.SelectedUnit,
                                                    status = ViewBag.SelectedStatus,
                                                    sortBy = ViewBag.CurrentSort,
                                                    expired = Context.Request.Query["expired"],
                                                    expiringSoon = Context.Request.Query["expiringSoon"]
                                                })">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("ManageProducts", new {
                                                page = ViewBag.CurrentPage + 1,
                                                searchTerm = ViewBag.SearchTerm,
                                                categoryId = ViewBag.SelectedCategory,
                                                unitId = ViewBag.SelectedUnit,
                                                status = ViewBag.SelectedStatus,
                                                sortBy = ViewBag.CurrentSort,
                                                expired = Context.Request.Query["expired"],
                                                expiringSoon = Context.Request.Query["expiringSoon"]
                                            })"><i class="bi bi-chevron-right"></i></a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 empty-state">
                            @if (qExpired)
                            {
                                <i class="bi bi-calendar-check display-1 text-success"></i>
                                <h4 class="mt-3 text-success">
                                    <i class="bi bi-check-circle me-2"></i>Tuyệt vời!
                                </h4>
                                <p class="text-muted">
                                    Không có sản phẩm nào đã hết hạn.<br />
                                    Tất cả sản phẩm đều còn trong thời hạn sử dụng.
                                </p>
                                <a href="@Url.Action("ManageProducts")" class="btn btn-primary mt-3">
                                    <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                                </a>
                            }
                            else if (qExpSoon)
                            {
                                <i class="bi bi-emoji-smile display-1 text-info"></i>
                                <h4 class="mt-3 text-info">
                                    <i class="bi bi-check-circle me-2"></i>An tâm!
                                </h4>
                                <p class="text-muted">
                                    Không có sản phẩm nào sắp hết hạn trong 7 ngày tới.<br />
                                    Hệ thống sẽ tự động cảnh báo khi có sản phẩm sắp hết hạn.
                                </p>
                                <a href="@Url.Action("ManageProducts")" class="btn btn-primary mt-3">
                                    <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) ||
                                     ViewBag.SelectedCategory != null ||
                                     ViewBag.SelectedUnit != null ||
                                     ViewBag.SelectedStatus != null)
                            {
                                <i class="bi bi-search display-1 text-warning"></i>
                                <h4 class="mt-3">Không tìm thấy kết quả</h4>
                                <p class="text-muted">
                                    Không có sản phẩm nào phù hợp với bộ lọc hiện tại.<br />
                                    Hãy thử thay đổi điều kiện tìm kiếm.
                                </p>
                                <a href="@Url.Action("ManageProducts")" class="btn btn-warning mt-3">
                                    <i class="bi bi-x-lg me-2"></i>Xóa bộ lọc
                                </a>
                            }
                            else
                            {
                                <i class="bi bi-inbox display-1 text-muted"></i>
                                <h4 class="mt-3">Chưa có sản phẩm nào</h4>
                                <p class="text-muted">
                                    Hãy thêm sản phẩm đầu tiên của bạn để bắt đầu.
                                </p>
                                <a href="@Url.Action("Create", "Product")" class="btn btn-primary mt-3">
                                    <i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

        </div> <!-- /#productsContainer -->
    </div>
</main>

<!-- IMAGE MODAL -->
<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Ảnh sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalProductImage" src="" alt="" class="img-fluid" />
            </div>
        </div>
    </div>
</div>

<!-- PRODUCT DETAILS MODAL -->
<div class="modal fade" id="productDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle me-2"></i>Chi tiết sản phẩm
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="productDetailsContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Đang tải thông tin...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
                <a href="#" id="editProductLink" class="btn btn-warning btn-pill px-4">
                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>

<!-- LOADING OVERLAY -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="text-center text-white">
        <div class="spinner-border" style="width:3rem;height:3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="mt-3">Đang xử lý...</div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () { $('.alert').fadeOut('slow'); }, 5000);
            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').first().val();

            // direct bindings (sẽ được override bằng delegated bên dưới, nhưng giữ cho lần load đầu)
            $('#selectAll').on('change', function () {
                $('.product-checkbox').prop('checked', this.checked);
                updateBulkActionsBar();
            });

            $('.product-checkbox').on('change', function () {
                updateBulkActionsBar();
                $('#selectAll').prop('checked', $('.product-checkbox:checked').length === $('.product-checkbox').length);
            });

            $('.status-toggle').on('change', function () {
                const id = $(this).data('id');
                const $switch = $(this);
                $.ajax({
                    url: '@Url.Action("ToggleStatus", "Product")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: antiForgeryToken
                    },
                    success: function (response) {
                        if (response.success) {
                            showToast('success', response.message);
                        } else {
                            $switch.prop('checked', !$switch.prop('checked'));
                            showToast('error', response.message);
                        }
                    },
                    error: function () {
                        $switch.prop('checked', !$switch.prop('checked'));
                        showToast('error', 'Lỗi kết nối');
                    }
                });
            });
        });

        function updateBulkActionsBar() {
            const selectedCount = $('.product-checkbox:checked').length;
            $('#selectedCount').text(selectedCount);
            if (selectedCount > 0) $('#bulkActionsBar').addClass('show');
            else $('#bulkActionsBar').removeClass('show');
        }

        function clearSelection() {
            $('.product-checkbox, #selectAll').prop('checked', false);
            updateBulkActionsBar();
        }

        function showImageModal(src, title) {
            $('#modalProductImage').attr('src', src).attr('alt', title);
            $('#imageModalLabel').text(title);
            new bootstrap.Modal(document.getElementById('imageModal')).show();
        }

        function showProductDetails(id) {
            const modal = new bootstrap.Modal(document.getElementById('productDetailsModal'));
            modal.show();

            $('#productDetailsContent').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Đang tải thông tin...</div>
                </div>
            `);

            $.ajax({
                url: '@Url.Action("GetProductDetails", "Product")',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: antiForgeryToken
                },
                success: function (response) {
                    if (response.success) {
                        const p = response.product;
                        const rawImage = (p.ImageFileName || '').toString().trim();
                        const imagePath = !rawImage || rawImage.toLowerCase() === 'no-image.png'
                            ? '@ProductImagePaths.FallbackImageRequestPath'
                            : (/^(https?:)?\/\//i.test(rawImage) || rawImage.startsWith('/')
                                ? rawImage
                                : '@ProductImagePaths.UploadFolderRequestPath' + rawImage);

                        const statusBadge = p.Status
                            ? '<span class="badge bg-success">Đang bán</span>'
                            : '<span class="badge bg-danger">Đã ẩn</span>';

                        const stockBadge = p.StockQuantity < 10
                            ? `<span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>${p.StockQuantity}</span>`
                            : `<span class="badge bg-success">${p.StockQuantity}</span>`;

                        const html = `
                            <div class="row">
                                <div class="col-md-5 mb-3 mb-md-0">
                                    <img src="${imagePath}" alt="${p.ProductName}"
                                         class="img-fluid rounded shadow-sm"
                                         loading="lazy"
                                         decoding="async"
                                         style="max-height: 400px; object-fit: cover; width: 100%;">
                                </div>
                                <div class="col-md-7">
                                    <h4 class="fw-bold mb-3">${p.ProductName}</h4>
                                    <table class="table table-borderless">
                                        <tr><th style="width:140px;">Mã SKU:</th><td><code>${p.Sku}</code></td></tr>
                                        <tr><th>Danh mục:</th><td><span class="badge bg-info">${p.CategoryName}</span></td></tr>
                                        <tr><th>Giá bán:</th><td><strong class="text-primary fs-5">${Number(p.Price).toLocaleString('vi-VN')} đ</strong></td></tr>
                                        <tr><th>Đơn vị:</th><td>${p.UnitName}</td></tr>
                                        <tr><th>Tồn kho:</th><td>${stockBadge}</td></tr>
                                        <tr><th>Trạng thái:</th><td>${statusBadge}</td></tr>
                                        <tr><th>Ngày tạo:</th><td><i class="bi bi-calendar me-1"></i>${p.CreatedDate}</td></tr>
                                    </table>
                                    ${p.ShortDescription ? `
                                        <div class="alert alert-info">
                                            <strong><i class="bi bi-info-circle me-1"></i>Mô tả ngắn:</strong><br>
                                            ${p.ShortDescription}
                                        </div>` : ''}
                                </div>
                            </div>
                            ${p.LongDescription ? `
                                <hr class="my-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-file-text me-2"></i>Mô tả chi tiết:</h6>
                                <div class="text-muted">${p.LongDescription}</div>` : ''}
                            ${(p.Weight || p.Origin || p.Standard || p.Preservation) ? `
                                <hr class="my-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-card-list me-2"></i>Thông tin bổ sung:</h6>
                                <div class="row g-3">
                                    ${p.Weight ? `<div class="col-md-6"><div class="card border-0 bg-light"><div class="card-body"><strong>Trọng lượng:</strong><br>${p.Weight}</div></div></div>` : ''}
                                    ${p.Origin ? `<div class="col-md-6"><div class="card border-0 bg-light"><div class="card-body"><strong>Xuất xứ:</strong><br>${p.Origin}</div></div></div>` : ''}
                                    ${p.Standard ? `<div class="col-md-6"><div class="card border-0 bg-light"><div class="card-body"><strong>Tiêu chuẩn:</strong><br>${p.Standard}</div></div></div>` : ''}
                                    ${p.Preservation ? `<div class="col-md-6"><div class="card border-0 bg-light"><div class="card-body"><strong>Bảo quản:</strong><br>${p.Preservation}</div></div></div>` : ''}
                                </div>` : ''}
                        `;
                        $('#productDetailsContent').html(html);
                        $('#editProductLink').attr('href', '@Url.Action("Edit", "Product")/' + p.ProductID);
                    } else {
                        $('#productDetailsContent').html(`
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>${response.message}
                            </div>`);
                    }
                },
                error: function () {
                    $('#productDetailsContent').html(`
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>Lỗi kết nối
                        </div>`);
                }
            });
        }

        function deleteProduct(id, name) {
            if (!confirm(`Bạn có chắc muốn xóa sản phẩm "${name}"?\n\nHành động này không thể hoàn tác!`)) return;
            showLoading();

            const form = $('<form>', {
                method: 'POST',
                action: '@Url.Action("Delete", "Product")'
            }).append($('<input>', { type: 'hidden', name: 'id', value: id }))
              .append($('<input>', {
                  type: 'hidden',
                  name: '__RequestVerificationToken',
                  value: $('input[name="__RequestVerificationToken"]').val()
              }));

            $('body').append(form);
            form.submit();
        }

        function showLoading() { $('#loadingOverlay').addClass('show'); }
        function hideLoading() { $('#loadingOverlay').removeClass('show'); }

        function showToast(type, message) {
            const bgColor = type === 'success' ? 'bg-success'
                : type === 'error' ? 'bg-danger'
                : type === 'warning' ? 'bg-warning'
                : 'bg-info';

            const toast = `
                <div class="toast align-items-center text-white ${bgColor} border-0"
                     role="alert"
                     style="position:fixed;top:20px;right:20px;z-index:9999;">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;

            $('body').append(toast);
            const $toast = $('.toast').last();
            new bootstrap.Toast($toast[0]).show();
            setTimeout(() => $toast.remove(), 5000);
        }

        // xoá binding cũ để tránh nhân đôi khi load AJAX
        $(function () {
            $('#selectAll').off('change');
            $('.product-checkbox').off('change');
            $('.status-toggle').off('change');
        });

        // delegated: select all
        $(document).on('change', '#selectAll', function () {
            $('.product-checkbox').prop('checked', this.checked);
            updateBulkActionsBar();
        });

        // delegated: từng checkbox
        $(document).on('change', '.product-checkbox', function () {
            updateBulkActionsBar();
            $('#selectAll').prop('checked', $('.product-checkbox:checked').length === $('.product-checkbox').length);
        });

        // delegated: status toggle
        $(document).on('change', '.status-toggle', function () {
            const id = $(this).data('id');
            const $switch = $(this);

            $.ajax({
                url: '@Url.Action("ToggleStatus", "Product")',
                type: 'POST',
                data: { id: id },
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message);
                    } else {
                        $switch.prop('checked', !$switch.prop('checked'));
                        showToast('error', response.message);
                    }
                },
                error: function () {
                    $switch.prop('checked', !$switch.prop('checked'));
                    showToast('error', 'Lỗi kết nối');
                }
            });
        });

        // AJAX filter form
        $(document).on('submit', '#filterForm', function (e) {
            e.preventDefault();
            const url = $(this).attr('action') + '?' + $(this).serialize();
            loadProducts(url);
            try { history.pushState(null, '', url); } catch { }
        });

        // click các link filter / manageProducts
        $(document).on('click', '.js-ajax-filter, #productsContainer a[href*="ManageProducts"]', function (e) {
            if (e.ctrlKey || e.metaKey || e.shiftKey) return;
            e.preventDefault();
            const url = $(this).attr('href');
            if (!url) return;
            loadProducts(url);
            try { history.pushState(null, '', url); } catch { }
        });

        // pagination trong container
        $(document).on('click', '#productsContainer .pagination a', function (e) {
            if (e.ctrlKey || e.metaKey || e.shiftKey) return;
            e.preventDefault();
            const url = $(this).attr('href');
            loadProducts(url);
            try { history.pushState(null, '', url); } catch { }
        });

        // back/forward
        window.addEventListener('popstate', function () {
            loadProducts(location.href);
        });

        function loadProducts(url) {
            showLoading();
            $('#productsContainer').load(url + ' #productsContainer > *', function (response, status) {
                hideLoading();
                if (status !== 'success') {
                    showToast('error', 'Lỗi kết nối');
                    return;
                }
                $('#selectedCount').text('0');
                $('#bulkActionsBar').removeClass('show');
                $('#selectAll').prop('checked', false);
            });
        }
    </script>
    @Html.AntiForgeryToken()
}
