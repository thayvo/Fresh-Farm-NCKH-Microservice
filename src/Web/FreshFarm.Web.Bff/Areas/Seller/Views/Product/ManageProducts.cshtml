@model List<FreshFarm.Web.Bff.Areas.Seller.Models.Product>
@{
    ViewBag.Title = "Quản Lý Sản Phẩm";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .product-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .product-thumb:hover {
            transform: scale(1.1);
            border-color: #007bff;
            box-shadow: 0 4px 8px rgba(0,123,255,0.3);
            cursor: pointer;
        }

    #modalProductImage {
        max-height: 400px;
        width: 100%;
        object-fit: contain;
        border-radius: 10px;
    }

    .filter-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

        .filter-section .form-control,
        .filter-section .form-select {
            border-radius: 8px;
            border: 2px solid rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.95);
        }

            .filter-section .form-control:focus,
            .filter-section .form-select:focus {
                border-color: #fff;
                box-shadow: 0 0 0 0.25rem rgba(255,255,255,0.25);
            }

    .table-hover tbody tr {
        transition: all 0.2s ease;
    }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

    .badge {
        font-size: 0.85rem;
        padding: 0.4em 0.8em;
        font-weight: 500;
    }

    .action-buttons .btn {
        transition: all 0.2s ease;
    }

        .action-buttons .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    .stats-card {
        border-left: 4px solid;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important;
        }

    .page-link {
        border-radius: 6px;
        margin: 0 3px;
    }

    .checkbox-cell {
        width: 40px;
        text-align: center;
    }

    .bulk-actions {
        display: none;
        animation: slideDown 0.3s ease;
    }

        .bulk-actions.show {
            display: block;
        }

    keyframes slideDown {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

        .loading-overlay.show {
            display: flex;
        }

    /* Styles cho sản phẩm hết hạn */
    .expiry-warning {
        background-color: #fff3cd !important;
        border-left: 4px solid #ffc107;
    }

    .expiry-expired {
        background-color: #f8d7da !important;
        border-left: 4px solid #dc3545;
        opacity: 0.7;
    }

    .expiry-date-warning {
        color: #ff6b6b;
        font-weight: bold;
        animation: pulse 2s infinite;
    }

    .expiry-date-expired {
        color: #dc3545;
        font-weight: bold;
        text-decoration: line-through;
    }

    keyframes pulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.6;
    }

    }

    /* Thêm màu orange cho text */
    .text-orange {
        color: #fd7e14 !important;
    }

    /* Responsive cho stats cards */
    media (max-width: 1199.98px) {
        .stats-card .card-body

    {
        padding: 0.75rem;
    }

    .stats-card h6 {
        font-size: 0.75rem;
    }

    .stats-card h3 {
        font-size: 1.5rem;
    }

    .stats-card .fs-1 {
        font-size: 2rem !important;
    }

    }

    media (max-width: 767.98px) {
        .col-md-3

    {
        margin-bottom: 1rem;
    }

    }

    /* Pulse animation cho số liệu cảnh báo */
    .stats-card[style*="border-left-color: #dc3545"] h3,
    .stats-card[style*="border-left-color: #fd7e14"] h3 {
        animation: pulse-number 2s ease-in-out infinite;
    }

    keyframes pulse-number {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }

    }

    /* Style cho button group */
    .btn-group .btn {
        padding: 0.5rem 1rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-group .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

        .btn-group .btn.active {
            position: relative;
            z-index: 1;
        }

    .btn-group .btn-danger.active,
    .btn-group .btn-warning.active {
        animation: pulse-btn 2s ease-in-out infinite;
    }

    keyframes pulse-btn {
        0%, 100%

    {
        box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
    }

    50% {
        box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
    }

    }

    /* Badge lọc */
    .badge.fs-6 {
        padding: 0.5rem 1rem;
        animation: slideInRight 0.5s ease;
    }

    keyframes slideInRight {
        from

    {
        opacity: 0;
        transform: translateX(-20px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    /* Animation cho empty state */
    .empty-state {
        animation: fadeInUp 0.6s ease;
    }

    keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Icon animation */
    .empty-state i.display-1 {
        animation: bounce 2s ease-in-out infinite;
    }

    keyframes bounce {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
    }
</style>

<main class="container-fluid p-4">
    <!-- Header with Stats -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-box-seam me-2"></i>Quản lý sản phẩm
                    </h2>
                    <p class="text-muted mb-0">Quản lý toàn bộ sản phẩm trong hệ thống</p>
                </div>
                <a href="@Url.Action("Create", "Product")" class="btn btn-primary btn-lg shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <!-- Card 1: Tổng sản phẩm -->
        <div class="col-md-3 col-lg-2">
            <div class="card stats-card border-0 shadow-sm" style="border-left-color: #0d6efd;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1 small">Tổng sản phẩm</h6>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalProductsInDB</h3>
                        </div>
                        <div class="fs-1 text-primary opacity-75">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Đang bán -->
        <div class="col-md-3 col-lg-2">
            <div class="card stats-card border-0 shadow-sm" style="border-left-color: #198754;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1 small">Đang bán</h6>
                            <h3 class="fw-bold mb-0 text-success">@ViewBag.ActiveProductsInDB</h3>
                        </div>
                        <div class="fs-1 text-success opacity-75">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Đã ẩn -->
        <div class="col-md-3 col-lg-2">
            <div class="card stats-card border-0 shadow-sm" style="border-left-color: #6c757d;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1 small">Đã ẩn</h6>
                            <h3 class="fw-bold mb-0 text-secondary">@ViewBag.InactiveProductsInDB</h3>
                        </div>
                        <div class="fs-1 text-secondary opacity-75">
                            <i class="bi bi-x-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Sắp hết hàng -->
        <div class="col-md-3 col-lg-2">
            <div class="card stats-card border-0 shadow-sm" style="border-left-color: #ffc107;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1 small">Sắp hết hàng</h6>
                            <h3 class="fw-bold mb-0 text-warning">@ViewBag.LowStockProductsInDB</h3>
                            <small class="text-muted">&lt; 10</small>
                        </div>
                        <div class="fs-1 text-warning opacity-75">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Đã hết hạn -->
        <div class="col-md-3 col-lg-2">
            <div class="card stats-card border-0 shadow-sm" style="border-left-color: #dc3545;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1 small">Đã hết hạn</h6>
                            <h3 class="fw-bold mb-0 text-danger">@ViewBag.ExpiredProductsInDB</h3>
                        </div>
                        <div class="fs-1 text-danger opacity-75">
                            <i class="bi bi-calendar-x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 6: Sắp hết hạn -->
        <div class="col-md-3 col-lg-2">
            <div class="card stats-card border-0 shadow-sm" style="border-left-color: #fd7e14;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1 small">Sắp hết hạn</h6>
                            <h3 class="fw-bold mb-0 text-orange">@ViewBag.ExpiringSoonProductsInDB</h3>
                            <small class="text-muted">≤ 7 ngày</small>
                        </div>
                        <div class="fs-1 opacity-75" style="color: #fd7e14;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter + Results (AJAX container) -->
    <div id="productsContainer">
        <!-- Filter Section -->
        <div class="filter-section mb-4">
            <form method="get" action="@Url.Action("ManageProducts")" id="filterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-search me-1"></i>Tìm kiếm
                        </label>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="Tên, SKU, mô tả..." value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">
                            <i class="bi bi-folder me-1"></i>Danh mục
                        </label>
                        <select name="categoryId" class="form-select">
                            <option value="">Tất cả</option>
                            @foreach (var cat in ViewBag.Categories as List<FreshFarm.Web.Bff.Areas.Seller.Models.Category>)
                            {
                                <option value="@cat.CategoryID" @(ViewBag.SelectedCategory == cat.CategoryID ? "selected" : "")>
                                    @cat.CategoryName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">
                            <i class="bi bi-rulers me-1"></i>Đơn vị
                        </label>
                        <select name="unitId" class="form-select">
                            <option value="">Tất cả</option>
                            @foreach (var unit in ViewBag.Units as List<FreshFarm.Web.Bff.Areas.Seller.Models.Unit>)
                            {
                                <option value="@unit.UnitID" @(ViewBag.SelectedUnit == unit.UnitID ? "selected" : "")>
                                    @unit.UnitName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">
                            <i class="bi bi-eye me-1"></i>Trạng thái
                        </label>
                        <select name="status" class="form-select">
                            <option value="">Tất cả</option>
                            <option value="true" @(ViewBag.SelectedStatus == true ? "selected" : "")>Đang bán</option>
                            <option value="false" @(ViewBag.SelectedStatus == false ? "selected" : "")>Đã ẩn</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">
                            <i class="bi bi-sort-down me-1"></i>Sắp xếp
                        </label>
                        <select name="sortBy" class="form-select">
                            <option value="">Mới nhất</option>
                            <option value="oldest" @(ViewBag.CurrentSort == "oldest" ? "selected" : "")>Cũ nhất</option>
                            <option value="name_asc" @(ViewBag.CurrentSort == "name_asc" ? "selected" : "")>Tên A-Z</option>
                            <option value="name_desc" @(ViewBag.CurrentSort == "name_desc" ? "selected" : "")>Tên Z-A</option>
                            <option value="price_asc" @(ViewBag.CurrentSort == "price_asc" ? "selected" : "")>Giá thấp → cao</option>
                            <option value="price_desc" @(ViewBag.CurrentSort == "price_desc" ? "selected" : "")>Giá cao → thấp</option>
                            <option value="stock_asc" @(ViewBag.CurrentSort == "stock_asc" ? "selected" : "")>Tồn kho thấp</option>
                            <option value="stock_desc" @(ViewBag.CurrentSort == "stock_desc" ? "selected" : "")>Tồn kho cao</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-light w-100" title="Lọc">
                                <i class="bi bi-funnel-fill"></i>
                            </button>
                            <a href="@Url.Action("ManageProducts")" class="btn btn-light js-ajax-filter" title="Xóa bộ lọc">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Nút lọc hết hạn và sắp hết hạn -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="btn-group" role="group">
                            <!-- Nút xem tất cả (mặc định) -->
                            @{ var qExpired = (Request.Query["expired"].ToString() ?? "").Equals("true", StringComparison.OrdinalIgnoreCase); var qExpSoon = (Request.Query["expiringSoon"].ToString() ?? "").Equals("true", StringComparison.OrdinalIgnoreCase); }
                            @if (!qExpired && !qExpSoon)
                            {
                                <button type="button" class="btn btn-primary active">
                                    <i class="bi bi-grid-3x3-gap me-1"></i>Tất cả sản phẩm
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("ManageProducts")" class="btn btn-outline-primary js-ajax-filter">
                                    <i class="bi bi-grid-3x3-gap me-1"></i>Tất cả sản phẩm
                                </a>
                            }

                            <!-- Nút xem sản phẩm đã hết hạn -->
                            @if (qExpired)
                            {
                                <button type="button" class="btn btn-danger active">
                                    <i class="bi bi-calendar-x me-1"></i>
                                    Đã hết hạn (@ViewBag.ExpiredProductsInDB)
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("ManageProducts", new { expired = true })" class="btn btn-outline-danger js-ajax-filter">
                                    <i class="bi bi-calendar-x me-1"></i>
                                    Đã hết hạn (@ViewBag.ExpiredProductsInDB)
                                </a>
                            }

                            <!-- Nút xem sản phẩm sắp hết hạn -->
                            @if (qExpSoon)
                            {
                                <button type="button" class="btn btn-warning active">
                                    <i class="bi bi-clock-history me-1"></i>
                                    Sắp hết hạn (@ViewBag.ExpiringSoonProductsInDB)
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("ManageProducts", new { expiringSoon = true })" class="btn btn-outline-warning js-ajax-filter">
                                    <i class="bi bi-clock-history me-1"></i>
                                    Sắp hết hạn (@ViewBag.ExpiringSoonProductsInDB)
                                </a>
                            }
                        </div>

                        <!-- Badge hiển thị trạng thái lọc hiện tại -->
                        @if (qExpired)
                        {
                            <span class="badge bg-danger ms-3 fs-6">
                                <i class="bi bi-funnel-fill me-1"></i>Đang lọc: Sản phẩm đã hết hạn
                            </span>
                        }
                        else if (qExpSoon)
                        {
                            <span class="badge bg-warning text-dark ms-3 fs-6">
                                <i class="bi bi-funnel-fill me-1"></i>Đang lọc: Sản phẩm sắp hết hạn (≤ 7 ngày)
                            </span>
                        }
                    </div>
                </div>
            </form>
        </div>

        <!-- Bulk Actions -->
        <div class="bulk-actions mb-3" id="bulkActionsBar">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">
                            <i class="bi bi-check-square me-2"></i>
                            Đã chọn: <span id="selectedCount">0</span> sản phẩm
                        </span>
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-success" onclick="bulkUpdateStatus(true)">
                                <i class="bi bi-check-circle me-1"></i>Bật
                            </button>
                            <button type="button" class="btn btn-sm btn-warning" onclick="bulkUpdateStatus(false)">
                                <i class="bi bi-x-circle me-1"></i>Ẩn
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="bulkDelete()">
                                <i class="bi bi-trash me-1"></i>Xóa
                            </button>
                            <button type="button" class="btn btn-sm btn-secondary" onclick="clearSelection()">
                                <i class="bi bi-x me-1"></i>Hủy
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Table -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="checkbox-cell">
                                        <input type="checkbox" class="form-check-input" id="selectAll" />
                                    </th>
                                    <th style="width: 80px;">Ảnh</th>
                                    <th>Sản phẩm</th>
                                    <th>Danh mục</th>
                                    <th>Giá</th>
                                    <th>Tồn kho</th>
                                    <th>Đơn vị</th>
                                    <th>Trạng thái</th>
                                    <th>Hạn sử dụng</th>
                                    <th style="width: 200px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var expiryMap = ViewBag.ProductExpiryMap as Dictionary<int, DateTime?>;
                                }

                                @foreach (var product in Model)
                                {
                                    var rowClass = "";
                                    var expiryClass = "";
                                    var daysToExpiry = 0;
                                    DateTime? expiryDate = null;

                                    if (expiryMap != null && expiryMap.ContainsKey(product.ProductID))
                                    {
                                        expiryDate = expiryMap[product.ProductID];

                                        if (expiryDate.HasValue)
                                        {
                                            daysToExpiry = (int)(expiryDate.Value.Date - DateTime.Now.Date).TotalDays;

                                            if (daysToExpiry < 0)
                                            {
                                                rowClass = "expiry-expired";
                                                expiryClass = "expiry-date-expired";
                                            }
                                            else if (daysToExpiry <= 7)
                                            {
                                                rowClass = "expiry-warning";
                                                expiryClass = "expiry-date-warning";
                                            }
                                        }
                                    }

                                    <tr data-product-id="@product.ProductID" class="@rowClass">
                                        <td class="checkbox-cell">
                                            <input type="checkbox" class="form-check-input product-checkbox"
                                                   value="@product.ProductID" />
                                        </td>
                                        <td>
                                            <img src="@Url.Content("~/Images/" + (product.ImageFileName ?? "no-image.png"))"
                                                 alt="@product.ProductName"
                                                 class="product-thumb"
                                                 onclick="showImageModal('@Url.Content("~/Images/" + (product.ImageFileName ?? "no-image.png"))', '@product.ProductName')" />
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@product.ProductName</strong>
                                                <br />
                                                <small class="text-muted">
                                                    <i class="bi bi-upc me-1"></i>@product.Sku
                                                </small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">
                                                @product.Category.CategoryName
                                            </span>
                                        </td>
                                        <td>
                                            <strong class="text-primary">@product.Price.ToString("N0") đ</strong>
                                        </td>
                                        <td>
                                            @if (product.StockQuantity < 10)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>@product.StockQuantity
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@product.StockQuantity</span>
                                            }
                                        </td>
                                        <td>@product.Unit.UnitName</td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input status-toggle"
                                                       type="checkbox"
                                                       @(product.Status ? "checked" : "")
                                                       data-id="@product.ProductID"
                                                       title="@(product.Status ? "Đang bán" : "Đã ẩn")" />
                                            </div>
                                        </td>
                                        <td>
                                            @if (expiryDate.HasValue)
                                            {
                                                <span class="@expiryClass">
                                                    @expiryDate.Value.ToString("dd/MM/yyyy")
                                                    @if (daysToExpiry >= 0 && daysToExpiry <= 7)
                                                    {
                                                        <br />
                                                        <small class="badge bg-warning text-dark">
                                                            <i class="bi bi-clock me-1"></i>Còn @daysToExpiry ngày
                                                        </small>
                                                    }
                                                    @if (daysToExpiry < 0)
                                                    {
                                                        <br />
                                                        <small class="badge bg-danger">
                                                            <i class="bi bi-x-circle me-1"></i>Đã hết hạn
                                                        </small>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <em class="text-muted">Không có</em>
                                            }
                                        </td>

                                        <td>
                                            <div class="action-buttons btn-group btn-group-sm">
                                                <a href="@Url.Action("Edit", "Product", new { id = product.ProductID })"
                                                   class="btn btn-warning" title="Sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-info"
                                                        onclick="showProductDetails(@product.ProductID)" title="Chi tiết">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-danger"
                                                        onclick="deleteProduct(@product.ProductID, '@product.ProductName')" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    if (ViewBag.TotalPages > 1)
                    {
                        <div class="card-footer bg-white border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="text-muted">
                                    Hiển thị @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)
                                    đến @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalCount))
                                    trong tổng số @ViewBag.TotalCount sản phẩm

                                    @* Hiển thị thông báo đang lọc *@
                                    @if (qExpired)
                                    {
                                        <span class="badge bg-danger ms-2">Đã hết hạn</span>
                                    }
                                    else if (qExpSoon)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Sắp hết hạn</span>
                                    }
                                </div>
                                <nav>
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("ManageProducts", new {
                                            page = ViewBag.CurrentPage - 1,
                                            searchTerm = ViewBag.SearchTerm,
                                            categoryId = ViewBag.SelectedCategory,
                                            unitId = ViewBag.SelectedUnit,
                                            status = ViewBag.SelectedStatus,
                                            sortBy = ViewBag.CurrentSort,
                                            expired = Request.Query["expired"].ToString(),
                                            expiringSoon = Request.Query["expiringSoon"].ToString()
                                        })">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>

                                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("ManageProducts", new {
                                                page = i,
                                                searchTerm = ViewBag.SearchTerm,
                                                categoryId = ViewBag.SelectedCategory,
                                                unitId = ViewBag.SelectedUnit,
                                                status = ViewBag.SelectedStatus,
                                                sortBy = ViewBag.CurrentSort,
                                                expired = Request.Query["expired"].ToString(),
                                                expiringSoon = Request.Query["expiringSoon"].ToString()
                                            })">@i</a>
                                        </li>
                                    }

                                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("ManageProducts", new {
                                            page = ViewBag.CurrentPage + 1,
                                            searchTerm = ViewBag.SearchTerm,
                                            categoryId = ViewBag.SelectedCategory,
                                            unitId = ViewBag.SelectedUnit,
                                            status = ViewBag.SelectedStatus,
                                            sortBy = ViewBag.CurrentSort,
                                            expired = Request.Query["expired"].ToString(),
                                            expiringSoon = Request.Query["expiringSoon"].ToString()
                                        })">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Empty State - Cập nhật cho các trường hợp lọc -->
                    <div class="text-center py-5 empty-state">
                        @if (qExpired)
                        {
                            <i class="bi bi-calendar-check display-1 text-success"></i>
                            <h4 class="mt-3 text-success">
                                <i class="bi bi-check-circle me-2"></i>Tuyệt vời!
                            </h4>
                            <p class="text-muted">
                                Không có sản phẩm nào đã hết hạn.<br />
                                Tất cả sản phẩm đều còn trong thời hạn sử dụng.
                            </p>
                            <a href="@Url.Action("ManageProducts")" class="btn btn-primary mt-3">
                                <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                            </a>
                        }
                        else if (qExpSoon)
                        {
                            <i class="bi bi-emoji-smile display-1 text-info"></i>
                            <h4 class="mt-3 text-info">
                                <i class="bi bi-check-circle me-2"></i>An tâm!
                            </h4>
                            <p class="text-muted">
                                Không có sản phẩm nào sắp hết hạn trong 7 ngày tới.<br />
                                Hệ thống sẽ tự động cảnh báo khi có sản phẩm sắp hết hạn.
                            </p>
                            <a href="@Url.Action("ManageProducts")" class="btn btn-primary mt-3">
                                <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                            </a>
                        }
                        else if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) ||
                                 ViewBag.SelectedCategory != null ||
                                 ViewBag.SelectedUnit != null ||
                                 ViewBag.SelectedStatus != null)
                        {
                            <i class="bi bi-search display-1 text-warning"></i>
                            <h4 class="mt-3">Không tìm thấy kết quả</h4>
                            <p class="text-muted">
                                Không có sản phẩm nào phù hợp với bộ lọc hiện tại.<br />
                                Hãy thử thay đổi điều kiện tìm kiếm.
                            </p>
                            <a href="@Url.Action("ManageProducts")" class="btn btn-warning mt-3">
                                <i class="bi bi-x-lg me-2"></i>Xóa bộ lọc
                            </a>
                        }
                        else
                        {
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <h4 class="mt-3">Chưa có sản phẩm nào</h4>
                            <p class="text-muted">
                                Hãy thêm sản phẩm đầu tiên của bạn để bắt đầu.
                            </p>
                            <a href="@Url.Action("Create", "Product")" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div> <!-- /#productsContainer -->
</main>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Ảnh sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalProductImage" src="" alt="" class="img-fluid" />
            </div>
        </div>
    </div>
</div>

<!-- Product Details Modal -->
<div class="modal fade" id="productDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle me-2"></i>Chi tiết sản phẩm
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="productDetailsContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Đang tải thông tin...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
                <a href="#" id="editProductLink" class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="text-center text-white">
        <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="mt-3">Đang xử lý...</div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto dismiss alerts
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Select all checkbox
            $('#selectAll').on('change', function() {
                $('.product-checkbox').prop('checked', this.checked);
                updateBulkActionsBar();
            });

            // Individual checkbox
            $('.product-checkbox').on('change', function() {
                updateBulkActionsBar();
                $('#selectAll').prop('checked', $('.product-checkbox:checked').length === $('.product-checkbox').length);
            });

            // Status toggle
            $('.status-toggle').on('change', function() {
                const id = $(this).data('id');
                const $switch = $(this);

                $.ajax({
                    url: '@Url.Action("ToggleStatus", "Product")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            showToast('success', response.message);
                        } else {
                            $switch.prop('checked', !$switch.prop('checked'));
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        $switch.prop('checked', !$switch.prop('checked'));
                        showToast('error', 'Lỗi kết nối');
                    }
                });
            });
        });

        function updateBulkActionsBar() {
            const selectedCount = $('.product-checkbox:checked').length;
            $('#selectedCount').text(selectedCount);

            if (selectedCount > 0) {
                $('#bulkActionsBar').addClass('show');
            } else {
                $('#bulkActionsBar').removeClass('show');
            }
        }

        function clearSelection() {
            $('.product-checkbox, #selectAll').prop('checked', false);
            updateBulkActionsBar();
        }

        function showImageModal(src, title) {
            $('#modalProductImage').attr('src', src).attr('alt', title);
            $('#imageModalLabel').text(title);
            new bootstrap.Modal(document.getElementById('imageModal')).show();
        }

        function showProductDetails(id) {
            const modal = new bootstrap.Modal(document.getElementById('productDetailsModal'));
            modal.show();

            $('#productDetailsContent').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Đang tải thông tin...</div>
                </div>
            `);

            $.ajax({
                url: '@Url.Action("GetProductDetails", "Product")',
                type: 'POST',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        const p = response.product;
                        const imagePath = p.ImageFileName
                            ? '@Url.Content("~/Images/")' + p.ImageFileName
                            : '@Url.Content("~/Images/no-image.png")';

                        const statusBadge = p.Status
                            ? '<span class="badge bg-success">Đang bán</span>'
                            : '<span class="badge bg-danger">Đã ẩn</span>';

                        const stockBadge = p.StockQuantity < 10
                            ? `<span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>${p.StockQuantity}</span>`
                            : `<span class="badge bg-success">${p.StockQuantity}</span>`;

                        const html = `
                            <div class="row">
                                <div class="col-md-5">
                                    <img src="${imagePath}" alt="${p.ProductName}"
                                         class="img-fluid rounded shadow-sm"
                                         style="max-height: 400px; object-fit: cover; width: 100%;">
                                </div>
                                <div class="col-md-7">
                                    <h4 class="fw-bold mb-3">${p.ProductName}</h4>

                                    <table class="table table-borderless">
                                        <tr>
                                            <th style="width: 140px;">Mã SKU:</th>
                                            <td><code>${p.Sku}</code></td>
                                        </tr>
                                        <tr>
                                            <th>Danh mục:</th>
                                            <td><span class="badge bg-info">${p.CategoryName}</span></td>
                                        </tr>
                                        <tr>
                                            <th>Giá bán:</th>
                                            <td><strong class="text-primary fs-5">${Number(p.Price).toLocaleString('vi-VN')} đ</strong></td>
                                        </tr>
                                        <tr>
                                            <th>Đơn vị:</th>
                                            <td>${p.UnitName}</td>
                                        </tr>
                                        <tr>
                                            <th>Tồn kho:</th>
                                            <td>${stockBadge}</td>
                                        </tr>
                                        <tr>
                                            <th>Trạng thái:</th>
                                            <td>${statusBadge}</td>
                                        </tr>
                                        <tr>
                                            <th>Ngày tạo:</th>
                                            <td><i class="bi bi-calendar me-1"></i>${p.CreatedDate}</td>
                                        </tr>
                                    </table>

                                    ${p.ShortDescription ? `
                                        <div class="alert alert-info">
                                            <strong><i class="bi bi-info-circle me-1"></i>Mô tả ngắn:</strong><br>
                                            ${p.ShortDescription}
                                        </div>
                                    ` : ''}
                                </div>
                            </div>

                            ${p.LongDescription ? `
                                <hr class="my-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-file-text me-2"></i>Mô tả chi tiết:</h6>
                                <div class="text-muted">${p.LongDescription}</div>
                            ` : ''}

                            ${(p.Weight || p.Origin || p.Standard || p.Preservation) ? `
                                <hr class="my-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-card-list me-2"></i>Thông tin bổ sung:</h6>
                                <div class="row g-3">
                                    ${p.Weight ? `
                                        <div class="col-md-6">
                                            <div class="card border-0 bg-light">
                                                <div class="card-body">
                                                    <strong>Trọng lượng:</strong><br>${p.Weight}
                                                </div>
                                            </div>
                                        </div>
                                    ` : ''}
                                    ${p.Origin ? `
                                        <div class="col-md-6">
                                            <div class="card border-0 bg-light">
                                                <div class="card-body">
                                                    <strong>Xuất xứ:</strong><br>${p.Origin}
                                                </div>
                                            </div>
                                        </div>
                                    ` : ''}
                                    ${p.Standard ? `
                                        <div class="col-md-6">
                                            <div class="card border-0 bg-light">
                                                <div class="card-body">
                                                    <strong>Tiêu chuẩn:</strong><br>${p.Standard}
                                                </div>
                                            </div>
                                        </div>
                                    ` : ''}
                                    ${p.Preservation ? `
                                        <div class="col-md-6">
                                            <div class="card border-0 bg-light">
                                                <div class="card-body">
                                                    <strong>Bảo quản:</strong><br>${p.Preservation}
                                                </div>
                                            </div>
                                        </div>
                                    ` : ''}
                                </div>
                            ` : ''}
                        `;

                        $('#productDetailsContent').html(html);
                        $('#editProductLink').attr('href', '@Url.Action("Edit", "Product")/' + p.ProductID);
                    } else {
                        $('#productDetailsContent').html(`
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>${response.message}
                            </div>
                        `);
                    }
                },
                error: function() {
                    $('#productDetailsContent').html(`
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>Lỗi kết nối
                        </div>
                    `);
                }
            });
        }

        function deleteProduct(id, name) {
            if (!confirm(`Bạn có chắc muốn xóa sản phẩm "${name}"?\n\nHành động này không thể hoàn tác!`)) {
                return;
            }

            showLoading();

            const form = $('<form>', {
                'method': 'POST',
                'action': '@Url.Action("Delete", "Product")'
            }).append(
                $('<input>', {
                    'type': 'hidden',
                    'name': 'id',
                    'value': id
                })
            ).append(
                $('<input>', {
                    'type': 'hidden',
                    'name': '__RequestVerificationToken',
                    'value': $('input[name="__RequestVerificationToken"]').val()
                })
            );

            $('body').append(form);
            form.submit();
        }

        function showLoading() {
            $('#loadingOverlay').addClass('show');
        }

        function hideLoading() {
            $('#loadingOverlay').removeClass('show');
        }

        function showToast(type, message) {
            const bgColor = type === 'success' ? 'bg-success' :
                           type === 'error' ? 'bg-danger' :
                           type === 'warning' ? 'bg-warning' : 'bg-info';

            const toast = `
                <div class="toast align-items-center text-white ${bgColor} border-0" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            $('body').append(toast);
            const $toast = $('.toast').last();
            new bootstrap.Toast($toast[0]).show();

            setTimeout(() => $toast.remove(), 5000);
        }

        // --- Dynamic filtering and delegated bindings ---
        // Remove old direct bindings from initial render to prevent duplicate handlers
        $(function () {
            $('#selectAll').off('change');
            $('.product-checkbox').off('change');
            $('.status-toggle').off('change');
        });

        // Delegated: Select all checkbox
        $(document).on('change', '#selectAll', function () {
            $('.product-checkbox').prop('checked', this.checked);
            updateBulkActionsBar();
        });

        // Delegated: Individual checkbox
        $(document).on('change', '.product-checkbox', function () {
            updateBulkActionsBar();
            $('#selectAll').prop('checked', $('.product-checkbox:checked').length === $('.product-checkbox').length);
        });

        // Delegated: Status toggle
        $(document).on('change', '.status-toggle', function () {
            const id = $(this).data('id');
            const $switch = $(this);

            $.ajax({
                url: '@Url.Action("ToggleStatus", "Product")',
                type: 'POST',
                data: { id: id },
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message);
                    } else {
                        $switch.prop('checked', !$switch.prop('checked'));
                        showToast('error', response.message);
                    }
                },
                error: function () {
                    $switch.prop('checked', !$switch.prop('checked'));
                    showToast('error', 'Lỗi kết nối');
                }
            });
        });

        // AJAX: Filter form submit
        $(document).on('submit', '#filterForm', function (e) {
            e.preventDefault();
            const url = $(this).attr('action') + '?' + $(this).serialize();
            loadProducts(url);
            try { history.pushState(null, '', url); } catch { }
        });

        // AJAX: Click on filter links and any ManageProducts link inside container
        $(document).on('click', '.js-ajax-filter, #productsContainer a[href*="ManageProducts"]', function (e) {
            if (e.ctrlKey || e.metaKey || e.shiftKey) return; // allow open in new tab
            e.preventDefault();
            const url = $(this).attr('href');
            if (!url) return;
            loadProducts(url);
            try { history.pushState(null, '', url); } catch { }
        });

        // AJAX: Pagination inside container
        $(document).on('click', '#productsContainer .pagination a', function (e) {
            if (e.ctrlKey || e.metaKey || e.shiftKey) return;
            e.preventDefault();
            const url = $(this).attr('href');
            loadProducts(url);
            try { history.pushState(null, '', url); } catch { }
        });

        // Support browser back/forward
        window.addEventListener('popstate', function () {
            loadProducts(location.href);
        });

        function loadProducts(url) {
            showLoading();
            $('#productsContainer').load(url + ' #productsContainer > *', function (response, status) {
                hideLoading();
                if (status !== 'success') {
                    showToast('error', 'Lỗi kết nối');
                    return;
                }
                // Reset selection state after reload
                $('#selectedCount').text('0');
                $('#bulkActionsBar').removeClass('show');
                $('#selectAll').prop('checked', false);
            });
        }
    </script>
}
