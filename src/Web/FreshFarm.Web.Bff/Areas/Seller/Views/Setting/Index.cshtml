@model FreshFarm.Web.Bff.Areas.Seller.Models.SellerSettingViewModel

@{
    var areaName = ViewData["AreaName"] as string ?? "Seller";
    var layoutPath = ViewData["LayoutPath"] as string ?? "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
    var settingsTitle = ViewData["SettingsTitle"] as string ?? "Cài Đặt Cửa Hàng";
    var settingsScopeLabel = ViewData["SettingsScopeLabel"] as string ?? "Theo seller";
    bool showSellerGhnSettings = ViewData["ShowSellerGhnSettings"] is bool showGhn && showGhn;
    bool ghnSandboxConfigured = ViewData["GhnSandboxConfigured"] is bool ghnConfigured && ghnConfigured;
    var ghnSandboxShopId = ViewData["GhnSandboxShopId"] as string ?? "Chưa có";

    ViewBag.Title = settingsTitle;
    Layout = layoutPath;
}

<style type="text/css">
    .settings-nav .nav-link {
        color: #343a40;
        font-weight: 500;
    }

        .settings-nav .nav-link.active {
            color: var(--primary-green);
            background-color: #e6f4ed;
            border-left: 3px solid var(--primary-green);
        }

        .settings-nav .nav-link:hover {
            background-color: #f1f3f5;
        }

    .form-control:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 0.2rem rgba(52, 168, 83, 0.25);
    }

    .ghn-origin-card {
        border: 1px solid rgba(13, 110, 253, 0.18);
        border-radius: 1.25rem;
        background: linear-gradient(135deg, rgba(239, 246, 255, 0.92) 0%, rgba(255, 255, 255, 1) 100%);
    }

    .ghn-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .8rem;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
    }

    .ghn-note {
        font-size: .85rem;
        color: #64748b;
    }
</style>

<main class="container-fluid p-4">
    <h2 class="fw-bold mb-4">
        <i class="bi bi-gear-fill me-2"></i>@settingsTitle
    </h2>
    <div class="mb-3">
        <span class="badge bg-light text-primary">@settingsScopeLabel</span>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form id="settingForm" method="post" action="@Url.Action("Save", "Setting", new { area = areaName })">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- MENU CÀI ĐẶT -->
            <div class="col-lg-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-2">
                        <div class="nav flex-column nav-pills settings-nav" role="tablist" aria-orientation="vertical">
                            <button class="nav-link text-start active" data-bs-toggle="pill"
                                    data-bs-target="#settings-general" type="button">
                                <i class="bi bi-shop me-2"></i> Cài đặt chung
                            </button>
                            <button class="nav-link text-start" data-bs-toggle="pill"
                                    data-bs-target="#settings-payment" type="button">
                                <i class="bi bi-credit-card-fill me-2"></i> Thanh toán
                            </button>
                            <button class="nav-link text-start" data-bs-toggle="pill"
                                    data-bs-target="#settings-shipping" type="button">
                                <i class="bi bi-truck me-2"></i> Vận chuyển
                            </button>
                            <button class="nav-link text-start" data-bs-toggle="pill"
                                    data-bs-target="#settings-notifications" type="button">
                                <i class="bi bi-bell-fill me-2"></i> Thông báo
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NỘI DUNG CÀI ĐẶT -->
            <div class="col-lg-9">
                <div class="tab-content">
                    <!-- CÀI ĐẶT CHUNG -->
                    <div class="tab-pane fade show active" id="settings-general">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0">
                                    <i class="bi bi-info-circle me-2"></i>Thông tin cửa hàng
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label class="form-label fw-bold">Tên cửa hàng</label>
                                        @Html.TextBoxFor(m => m.StoreName, new { @class = "form-control", required = "required" })
                                        <div class="ghn-note mt-1">Tên shop sẽ hiển thị cho người mua trên marketplace và không được trùng với shop khác.</div>
                                        @Html.ValidationMessageFor(m => m.StoreName, "", new { @class = "text-danger small" })
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-bold">Địa chỉ</label>
                                        @Html.TextBoxFor(m => m.StoreAddress, new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(m => m.StoreAddress, "", new { @class = "text-danger small" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Email hỗ trợ</label>
                                        @Html.TextBoxFor(m => m.StoreEmail, new { @type = "email", @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(m => m.StoreEmail, "", new { @class = "text-danger small" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Số điện thoại</label>
                                        @Html.TextBoxFor(m => m.StorePhone, new { @type = "tel", @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(m => m.StorePhone, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CÀI ĐẶT THANH TOÁN -->
                    <div class="tab-pane fade" id="settings-payment">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0">
                                    <i class="bi bi-wallet2 me-2"></i>Cổng thanh toán
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="form-check form-switch fs-5 mb-3">
                                    @Html.CheckBoxFor(m => m.IsCODEnabled, new { @class = "form-check-input", id = "codSwitch" })
                                    <label class="form-check-label" for="IsCODEnabled">
                                        Thanh toán khi nhận hàng (COD)
                                    </label>
                                </div>
                                <hr />
                                <h6 class="fw-bold">
                                    <i class="bi bi-bank me-2"></i>Chuyển khoản ngân hàng
                                </h6>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Hướng dẫn chuyển khoản</label>
                                    @Html.TextAreaFor(m => m.BankTransferInstructions, new { @rows = "3", @class = "form-control" })
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Thông tin tài khoản</label>
                                    @Html.TextAreaFor(m => m.BankAccountInfo, new { @rows = "3", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CÀI ĐẶT VẬN CHUYỂN -->
                    <div class="tab-pane fade" id="settings-shipping">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0">
                                    <i class="bi bi-box-seam me-2"></i>Cài đặt vận chuyển
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Các cài đặt chi tiết về khu vực và phương thức vận chuyển được quản lý tại
                                    <a href="@Url.Action("ManageShipping", "Shipping", new { area = areaName })" class="alert-link">trang quản lý vận chuyển</a>.
                                </div>
                                @Html.HiddenFor(m => m.DefaultShippingFee)
                                @Html.HiddenFor(m => m.FreeShippingThreshold)

                                @if (showSellerGhnSettings)
                                {
                                    <div class="ghn-origin-card p-4 mt-4"
                                         id="ghnOriginSection"
                                         data-selected-province-id="@Model.GhnProvinceId"
                                         data-selected-district-id="@Model.GhnDistrictId"
                                         data-selected-ward-code="@Model.GhnWardCode">
                                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
                                            <div>
                                                <h6 class="fw-bold mb-1 text-primary">
                                                    <i class="bi bi-truck me-2"></i>Địa chỉ lấy hàng
                                                </h6>
                                                <p class="mb-0 ghn-note">Lưu sẵn địa chỉ lấy hàng của shop để tạo vận đơn nhanh hơn. Các chương trình ưu đãi phí vận chuyển sẽ được quản lý theo mã giảm giá và chính sách thực tế.</p>
                                            </div>
                                            <div class="d-flex flex-wrap gap-2">
                                                <span class="ghn-chip @(ghnSandboxConfigured ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                                                    <i class="bi @(ghnSandboxConfigured ? "bi-check2-circle" : "bi-exclamation-triangle")"></i>
                                                    @(ghnSandboxConfigured ? "Đã sẵn sàng kết nối vận chuyển" : "Chưa sẵn sàng kết nối vận chuyển")
                                                </span>
                                            </div>
                                        </div>

                                        @Html.HiddenFor(m => m.GhnProvinceName, new { id = "GhnProvinceName" })
                                        @Html.HiddenFor(m => m.GhnDistrictName, new { id = "GhnDistrictName" })
                                        @Html.HiddenFor(m => m.GhnWardName, new { id = "GhnWardName" })

                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Họ tên người liên hệ</label>
                                                @Html.TextBoxFor(m => m.GhnPickupName, new { @class = "form-control", placeholder = "Ví dụ: Bùi Khắc Vinh" })
                                                @Html.ValidationMessageFor(m => m.GhnPickupName, "", new { @class = "text-danger small" })
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Số điện thoại liên hệ</label>
                                                @Html.TextBoxFor(m => m.GhnPickupPhone, new { @class = "form-control", placeholder = "Ví dụ: 0858863900" })
                                                @Html.ValidationMessageFor(m => m.GhnPickupPhone, "", new { @class = "text-danger small" })
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label fw-bold">Địa chỉ lấy hàng chi tiết</label>
                                                @Html.TextBoxFor(m => m.GhnPickupAddress, new { @class = "form-control", placeholder = "Số 06 Trần Văn Ơn, Phú Hòa..." })
                                                <div class="ghn-note mt-1">Số nhà, tên đường...</div>
                                                @Html.ValidationMessageFor(m => m.GhnPickupAddress, "", new { @class = "text-danger small" })
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Tỉnh/Thành phố</label>
                                                <select class="form-select" id="GhnProvinceId" name="GhnProvinceId">
                                                    <option value="">Chọn tỉnh/thành phố</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Quận/Huyện</label>
                                                <select class="form-select" id="GhnDistrictId" name="GhnDistrictId">
                                                    <option value="">Chọn quận/huyện</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Phường/Xã</label>
                                                <select class="form-select" id="GhnWardCode" name="GhnWardCode">
                                                    <option value="">Chọn phường/xã</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mt-3">
                                            @if (Model.HasGhnOrigin)
                                            {
                                                <span class="ghn-chip bg-success-subtle text-success-emphasis">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                    Đã lưu địa chỉ lấy hàng: @Model.GhnDistrictName, @Model.GhnWardName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="ghn-chip bg-warning-subtle text-warning-emphasis">
                                                    <i class="bi bi-exclamation-circle"></i>
                                                    Bạn chưa lưu địa chỉ lấy hàng.
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CÀI ĐẶT THÔNG BÁO -->
                    <div class="tab-pane fade" id="settings-notifications">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0">
                                    <i class="bi bi-envelope me-2"></i>Thông báo qua Email
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <p class="text-muted">Cấu hình email gửi đến khách hàng và quản trị viên.</p>
                                <h6 class="fw-bold mb-3">Tự động gửi email khi:</h6>
                                <div class="form-check form-switch mb-2">
                                    @Html.CheckBoxFor(m => m.IsEmailNewOrderEnabled, new { @class = "form-check-input" })
                                    <label class="form-check-label" for="IsEmailNewOrderEnabled">
                                        Có đơn hàng mới
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    @Html.CheckBoxFor(m => m.IsEmailDeliveredEnabled, new { @class = "form-check-input" })
                                    <label class="form-check-label" for="IsEmailDeliveredEnabled">
                                        Đơn hàng được giao thành công
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    @Html.CheckBoxFor(m => m.IsEmailCancelledEnabled, new { @class = "form-check-input" })
                                    <label class="form-check-label" for="IsEmailCancelledEnabled">
                                        Đơn hàng bị hủy
                                    </label>
                                </div>
                                <hr />
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email admin nhận thông báo</label>
                                    @Html.TextBoxFor(m => m.AdminNotificationEmail, new { @type = "email", @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.AdminNotificationEmail, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- NÚT LƯỚI -->
        <div class="text-end mt-4">
            <button type="submit" class="btn btn-success btn-lg" id="saveBtn">
                <i class="bi bi-check-circle me-2"></i>Lưu tất cả thay đổi
            </button>
        </div>
    </form>

    <!-- THÔNG BÁO THÀNH CÔNG -->
    <div id="successMessage" class="alert alert-success alert-dismissible fade show position-fixed bottom-0 end-0 m-4"
         role="alert" style="display: none; z-index: 9999; min-width: 300px;">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>Thành công!</strong> <span id="successText">Cài đặt đã được lưu.</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <!-- THÔNG BÁO LỖI -->
    <div id="errorMessage" class="alert alert-danger alert-dismissible fade show position-fixed bottom-0 end-0 m-4"
         role="alert" style="display: none; z-index: 9999; min-width: 300px;">
        <i class="bi bi-exclamation-circle-fill me-2"></i>
        <strong>Lỗi!</strong> <span id="errorText">Có lỗi xảy ra.</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
</main>

@section scripts {
    <script>
        $(document).ready(function () {
            const searchParams = new URLSearchParams(window.location.search);
            const requestedTab = (searchParams.get('tab') || '').toLowerCase();
            const tabMap = {
                general: '#settings-general',
                payment: '#settings-payment',
                shipping: '#settings-shipping',
                notifications: '#settings-notifications'
            };
            const requestedTabSelector = tabMap[requestedTab];
            if (requestedTabSelector) {
                const triggerButton = document.querySelector('[data-bs-target="' + requestedTabSelector + '"]');
                if (triggerButton) {
                    bootstrap.Tab.getOrCreateInstance(triggerButton).show();
                }
            }

            const showSellerGhnSettings = @(showSellerGhnSettings ? "true" : "false");

            if (showSellerGhnSettings) {
                const ghnOriginSection = document.getElementById('ghnOriginSection');
                const provinceSelect = document.getElementById('GhnProvinceId');
                const districtSelect = document.getElementById('GhnDistrictId');
                const wardSelect = document.getElementById('GhnWardCode');
                const provinceNameInput = document.getElementById('GhnProvinceName');
                const districtNameInput = document.getElementById('GhnDistrictName');
                const wardNameInput = document.getElementById('GhnWardName');

                const selectedProvinceId = ghnOriginSection?.dataset.selectedProvinceId || '';
                const selectedDistrictId = ghnOriginSection?.dataset.selectedDistrictId || '';
                const selectedWardCode = ghnOriginSection?.dataset.selectedWardCode || '';

                const renderOptions = function (select, items, placeholder, selectedValue, valueKey) {
                    if (!select) return;
                    select.innerHTML = '';
                    const placeholderOption = document.createElement('option');
                    placeholderOption.value = '';
                    placeholderOption.textContent = placeholder;
                    select.appendChild(placeholderOption);

                    (items || []).forEach(function (item) {
                        const option = document.createElement('option');
                        option.value = valueKey === 'code' ? (item.code || '') : String(item.id || '');
                        option.textContent = item.name || '';
                        if (String(option.value) === String(selectedValue || '')) {
                            option.selected = true;
                        }
                        select.appendChild(option);
                    });
                };

                const syncSelectedText = function (select, hiddenInput) {
                    if (!select || !hiddenInput) return;
                    const option = select.options[select.selectedIndex];
                    hiddenInput.value = option && option.value ? option.text : '';
                };

                const loadDistricts = function (provinceId, selectedValue, selectedWardValue) {
                    if (!districtSelect || !wardSelect) return;

                    if (!provinceId) {
                        renderOptions(districtSelect, [], 'Chọn quận/huyện', '');
                        renderOptions(wardSelect, [], 'Chọn phường/xã', '');
                        if (districtNameInput) districtNameInput.value = '';
                        if (wardNameInput) wardNameInput.value = '';
                        return;
                    }

                    fetch('@Url.Action("GetGhnDistricts", "Setting", new { area = areaName })?provinceId=' + provinceId, { credentials: 'same-origin' })
                        .then(response => response.json())
                        .then(payload => {
                            const items = Array.isArray(payload?.items) ? payload.items : [];
                            renderOptions(districtSelect, items, 'Chọn quận/huyện', selectedValue || '');
                            syncSelectedText(districtSelect, districtNameInput);

                            if (districtSelect.value) {
                                loadWards(districtSelect.value, selectedWardValue || '');
                            } else {
                                renderOptions(wardSelect, [], 'Chọn phường/xã', '');
                                if (wardNameInput) wardNameInput.value = '';
                            }
                        })
                        .catch(() => {
                            renderOptions(districtSelect, [], 'Không tải được quận/huyện', '');
                            renderOptions(wardSelect, [], 'Không tải được phường/xã', '');
                        });
                };

                const loadWards = function (districtId, selectedValue) {
                    if (!wardSelect) return;

                    if (!districtId) {
                        renderOptions(wardSelect, [], 'Chọn phường/xã', '');
                        if (wardNameInput) wardNameInput.value = '';
                        return;
                    }

                    fetch('@Url.Action("GetGhnWards", "Setting", new { area = areaName })?districtId=' + districtId, { credentials: 'same-origin' })
                        .then(response => response.json())
                        .then(payload => {
                            const items = Array.isArray(payload?.items) ? payload.items : [];
                            renderOptions(wardSelect, items, 'Chọn phường/xã', selectedValue || '', 'code');
                            syncSelectedText(wardSelect, wardNameInput);
                        })
                        .catch(() => {
                            renderOptions(wardSelect, [], 'Không tải được phường/xã', '');
                        });
                };

                const loadProvinces = function () {
                    if (!provinceSelect) return;

                    fetch('@Url.Action("GetGhnProvinces", "Setting", new { area = areaName })', { credentials: 'same-origin' })
                        .then(response => response.json())
                        .then(payload => {
                            const items = Array.isArray(payload?.items) ? payload.items : [];
                            renderOptions(provinceSelect, items, 'Chọn tỉnh/thành phố', selectedProvinceId || '');
                            syncSelectedText(provinceSelect, provinceNameInput);

                            if (provinceSelect.value) {
                                loadDistricts(provinceSelect.value, selectedDistrictId || '', selectedWardCode || '');
                            }
                        })
                        .catch(() => {
                            renderOptions(provinceSelect, [], 'Không tải được tỉnh/thành phố', '');
                        });
                };

                provinceSelect?.addEventListener('change', function () {
                    syncSelectedText(provinceSelect, provinceNameInput);
                    loadDistricts(provinceSelect.value, '', '');
                });

                districtSelect?.addEventListener('change', function () {
                    syncSelectedText(districtSelect, districtNameInput);
                    loadWards(districtSelect.value, '');
                });

                wardSelect?.addEventListener('change', function () {
                    syncSelectedText(wardSelect, wardNameInput);
                });

                loadProvinces();
            }

            $('#settingForm').on('submit', function (e) {
                e.preventDefault();

                // Vô hiệu hóa nút
                var $saveBtn = $('#saveBtn');
                var originalBtnText = $saveBtn.html();
                $saveBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...');

                // Serialize dữ liệu form
                var formData = $(this).serialize();

                $.ajax({
                    url: '@Url.Action("Save", "Setting", new { area = areaName })',
                    type: 'POST',
                    data: formData,
                    dataType: 'json',
                    success: function (response) {
                        if (response.success) {
                            // Hiển thị thông báo thành công
                            $('#successText').text(response.message);
                            var successMsg = $('#successMessage');
                            successMsg.fadeIn();

                            // Ẩn thông báo sau 4 giây
                            setTimeout(function () {
                                successMsg.fadeOut();
                            }, 4000);
                        } else {
                            // Hiển thị thông báo lỗi
                            $('#errorText').text(response.message);
                            $('#errorMessage').fadeIn();

                            setTimeout(function () {
                                $('#errorMessage').fadeOut();
                            }, 4000);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error:', error);
                        const fallbackMessage = xhr?.responseJSON?.message
                            || xhr?.responseText
                            || ('Lỗi khi lưu cài đặt: ' + error);
                        $('#errorText').text(fallbackMessage);
                        $('#errorMessage').fadeIn();

                        setTimeout(function () {
                            $('#errorMessage').fadeOut();
                        }, 4000);
                    },
                    complete: function () {
                        // Khôi phục nút
                        $saveBtn.prop('disabled', false).html(originalBtnText);
                    }
                });

                return false;
            });
        });
    </script>
