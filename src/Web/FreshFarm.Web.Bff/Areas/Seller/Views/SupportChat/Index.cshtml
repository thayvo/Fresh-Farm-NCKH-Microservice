@{
    ViewBag.Title = "Hỗ trợ khách hàng";
    Layout = "~/Areas/Seller/Views/Shared/_LayoutAdmin.cshtml";
}

<main class="container-fluid p-3" id="supportChatRoot">
    <style>
        :root {
            /* Palette dịu hơn, ít “chói” hơn nhưng vẫn cùng tông xanh */
            --primary-blue: #1e40af;
            --primary-blue-dark: #1e3a8a;
            --primary-blue-light: #3b82f6;
            --bg-page: #eff6ff; /* nền tổng */
            --bg-card: #ffffff; /* nền card */
            --bg-chat: #f9fafb; /* nền khung chat */
            --bg-chip: #e5f0ff; /* chip nhỏ */

            --border-subtle: #e5e7eb;
            --border-blue: #bfdbfe;
            --text-main: #0f172a;
            --text-muted: #6b7280;
            --text-blue: #1d4ed8;
        }

        /* ===== ANIMATION DÙNG CHUNG (giống màn Vận Chuyển) ===== */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        @@keyframes rotate {
            from {
                transform: rotate(0);
            }

            to {
                transform: rotate(360deg);
            }
        }

        #supportChatRoot {
            height: calc(100vh - 70px);
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 50%, #bfdbfe 100%);
        }

        /* Header với gradient + ÁNH SÁNG QUÉT */
        .page-header-support {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-light) 50%, #60a5fa 100%);
            color: white;
            padding: 1.75rem 2rem;
            border-radius: 1.5rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 20px 40px rgba(30, 64, 175, 0.45);
            position: relative;
            overflow: hidden;
            animation: fadeInUp .6s ease-out;
        }

            /* HIỆU ỨNG ÁNH SÁNG QUÉT giữ y chang Shipping */
            .page-header-support::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
                animation: rotate 25s linear infinite;
            }

            .page-header-support::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 320px;
                height: 320px;
                background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
                border-radius: 50%;
                animation: float 6s ease-in-out infinite;
            }

            .page-header-support > * {
                position: relative;
                z-index: 1;
            }

            .page-header-support h2 {
                margin: 0;
                font-weight: 700;
                font-size: 1.6rem;
                display: flex;
                align-items: center;
                gap: 0.9rem;
                text-shadow: 0 4px 12px rgba(0,0,0,0.35);
            }

                .page-header-support h2::before {
                    content: "💬";
                    font-size: 1.9rem;
                }

        #supportChatShell {
            flex: 1;
            display: flex;
            gap: 0.9rem;
            overflow: hidden;
            animation: fadeInUp .6s ease-out .05s backwards;
        }

        .support-chat-col {
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }

        /* Card kiểu glass nhẹ */
        .card {
            border: 1px solid rgba(30, 64, 175, 0.08);
            border-radius: 1.25rem;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(14px);
            animation: fadeInUp .5s ease-out;
        }

        .card-header {
            background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%);
            color: var(--text-main);
            border-radius: 1.25rem 1.25rem 0 0 !important;
            padding: 0.9rem 1.15rem;
            border-bottom: 1px solid var(--border-subtle);
        }

            .card-header.d-flex {
                background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
                color: #e5f0ff;
            }

        #supportChatTitle {
            font-size: 1.05rem;
            font-weight: 700;
        }

        #supportChatSubTitle {
            font-size: 0.85rem;
            opacity: 0.9;
        }

        /* Search input */
        .input-group-text {
            background: #ffffff;
            border: 1px solid var(--border-subtle);
            border-right: none;
            color: var(--text-muted);
        }

        .input-group .form-control {
            border: 1px solid var(--border-subtle);
            border-left: none;
            font-size: 0.85rem;
        }

            .input-group .form-control:focus {
                border-color: var(--primary-blue);
                box-shadow: none;
            }

                .input-group .form-control:focus + .input-group-text,
                .input-group-text:has(+ .form-control:focus) {
                    border-color: var(--primary-blue);
                    color: var(--primary-blue);
                }

        /* Button group filter */
        .btn-group .btn-outline-secondary {
            border-color: transparent;
            color: var(--text-muted);
            background: transparent;
            font-weight: 600;
            transition: all 0.18s;
            font-size: 0.78rem;
        }

            .btn-group .btn-outline-secondary:hover {
                background: #e5f0ff;
                border-color: transparent;
                color: var(--text-blue);
            }

            .btn-group .btn-outline-secondary.active {
                background: #e0edff;
                border-color: transparent;
                color: var(--text-blue);
                box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            }

        /* Conversation list */
        #supportConvListWrapper,
        #supportAdminMessages,
        #supportChatRightBody {
            flex: 1;
            overflow-y: auto;
        }

        .list-group-item {
            border: none;
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            transition: all 0.16s;
            cursor: pointer;
            background: transparent;
        }

            .list-group-item:hover {
                background: #eff6ff;
                transform: translateX(3px);
            }

            .list-group-item.active {
                background: #dbeafe;
                border-left: 3px solid var(--primary-blue);
                color: var(--text-blue);
            }

                .list-group-item.active .fw-semibold {
                    color: var(--primary-blue);
                }

        /* Badges */
        .badge {
            padding: 0.3rem 0.7rem;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.72rem;
        }

            .badge.bg-danger {
                background: #fee2e2 !important;
                color: #b91c1c;
            }

            .badge.bg-success {
                background: #dcfce7 !important;
                color: #15803d;
            }

            .badge.bg-secondary {
                background: #e5e7eb !important;
                color: #374151;
            }

            .badge.bg-primary {
                background: #dbeafe !important;
                color: var(--text-blue);
            }

            .badge.bg-info {
                background: #e0f2fe !important;
                color: #0369a1;
            }

            .badge.bg-warning {
                background: #fef9c3 !important;
                color: #92400e;
            }

        /* Close button */
        #supportChatCloseBtn {
            border: 1px solid rgba(248, 250, 252, 0.8);
            color: #fee2e2;
            background: rgba(248, 250, 252, 0.05);
            font-weight: 500;
            transition: all 0.18s;
            font-size: 0.8rem;
            border-radius: 999px;
        }

            #supportChatCloseBtn:hover:not(:disabled) {
                background: #fee2e2;
                color: #b91c1c;
                transform: translateY(-1px);
            }

            #supportChatCloseBtn:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        /* Messages area */
        #supportAdminMessages {
            background: var(--bg-chat);
            padding: 1.1rem 1rem;
        }

        .support-chat-message {
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            width: 100%;
            margin-bottom: 0.65rem;
            animation: slideIn 0.25s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Avatar */
        .support-chat-message .support-msg-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            border: 2px solid #e5e7eb;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
        }

        .support-chat-message-wrapper {
            position: relative;
            max-width: 70%;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .support-chat-message.other {
            justify-content: flex-start;
        }

        .support-chat-message.me {
            justify-content: flex-end;
        }

        .support-chat-message .bubble {
            display: inline-block;
            padding: 0.6rem 0.85rem;
            border-radius: 16px;
            word-wrap: break-word;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
            transition: all 0.15s;
            position: relative;
            font-size: 0.85rem;
        }

            .support-chat-message .bubble:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(15, 23, 42, 0.1);
            }

        .support-chat-message.me .bubble {
            border-bottom-right-radius: 4px;
        }

        .support-chat-message.other .bubble {
            border-bottom-left-radius: 4px;
            border: 1px solid #e5e7eb;
        }

        .support-chat-message.system {
            justify-content: center;
        }

            .support-chat-message.system .bubble {
                background: transparent;
                color: var(--text-muted);
                font-size: 0.78rem;
                box-shadow: none;
            }

        /* Message actions */
        .support-msg-actions {
            opacity: 0;
            transition: opacity 0.16s ease-out;
            color: #94a3b8;
            font-size: 10px;
            pointer-events: none;
            background: rgba(255,255,255,0.98);
            border-radius: 999px;
            padding: 5px 9px;
            box-shadow: 0 3px 10px rgba(15,23,42,0.16);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            align-self: center;
            white-space: nowrap;
        }

        .support-chat-message.me .bubble {
            order: 2;
        }

        .support-chat-message.me .support-msg-actions {
            order: 1;
        }

        .support-chat-message.other .bubble {
            order: 1;
        }

        .support-chat-message.other .support-msg-actions {
            order: 2;
        }

        .support-chat-message:hover .support-msg-actions {
            opacity: 1;
            pointer-events: auto;
        }

        .support-msg-actions a {
            border: none;
            background: transparent;
            padding: 2px;
            margin: 0;
            color: var(--primary-blue);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            transition: all 0.18s;
        }

            .support-msg-actions a:hover {
                background: rgba(148, 163, 184, 0.12);
                color: var(--primary-blue-dark);
            }

            .support-msg-actions a.text-danger {
                color: #dc2626;
            }

                .support-msg-actions a.text-danger:hover {
                    color: #dc2626 !important;
                    background: rgba(248, 113, 113, 0.15);
                }

        /* Message meta (time, seen) */
        .support-msg-meta {
            font-size: 9px;
            color: #9ca3af;
        }

        /* Date separator */
        .support-chat-date-separator {
            text-align: center;
            margin: 14px 0 10px;
            position: relative;
            clear: both;
        }

            .support-chat-date-separator span {
                display: inline-block;
                background: rgba(15, 23, 42, 0.06);
                color: #6b7280;
                font-size: 0.75rem;
                font-weight: 500;
                padding: 4px 12px;
                border-radius: 12px;
                letter-spacing: 0.3px;
                box-shadow: 0 1px 2px rgba(15,23,42,0.08);
            }

        /* Reply Quote */
        .support-chat-reply-quote {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.06) 0%, rgba(37, 99, 235, 0.03) 100%);
            border-left: 3px solid var(--primary-blue);
            padding: 6px 10px;
            margin-bottom: 6px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.18s ease-out;
            position: relative;
            overflow: hidden;
        }

            .support-chat-reply-quote:hover {
                background: linear-gradient(135deg, rgba(59, 130, 246, 0.11) 0%, rgba(37, 99, 235, 0.06) 100%);
                transform: translateX(2px);
            }

        .support-chat-reply-quote-from {
            font-weight: 600;
            font-size: 0.75rem;
            margin-bottom: 3px;
            color: var(--text-blue);
            text-transform: uppercase;
            letter-spacing: 0.3px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .support-chat-reply-quote-from::before {
                content: '↩';
                font-size: 0.9rem;
                opacity: 0.7;
            }

        .support-chat-reply-quote-content {
            font-size: 0.83rem;
            color: rgba(15, 23, 42, 0.7);
            line-height: 1.4;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-style: italic;
            padding-left: 2px;
        }

        .support-chat-message.me .support-chat-reply-quote {
            background: rgba(15, 23, 42, 0.08);
            border-left-color: rgba(248, 250, 252, 0.9);
        }

        .support-chat-message.me .support-chat-reply-quote-from {
            color: #e5f0ff;
        }

        .support-chat-message.me .support-chat-reply-quote-content {
            color: #e5f0ff;
        }

        /* Footer input */
        .card-footer {
            background: #f9fafb;
            border-top: 1px solid var(--border-subtle);
            padding: 0.9rem 1rem;
            border-radius: 0 0 1.25rem 1.25rem !important;
        }

        #supportAdminInput {
            border: 1px solid var(--border-subtle);
            border-radius: 0.8rem;
            transition: all 0.18s;
            font-size: 0.85rem;
            background: #ffffff;
        }

            #supportAdminInput:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.18);
            }

        /* Typing indicator */
        #supportAdminTyping {
            color: var(--text-blue);
            font-style: italic;
            animation: pulse 1.5s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        #supportReplyPreview {
            background: #e5f0ff;
            border-left: 3px solid var(--primary-blue);
            padding: 0.45rem 0.7rem;
            border-radius: 6px;
            color: var(--text-blue);
        }

        /* Buttons */
        .btn-outline-secondary.btn-sm {
            border: 1px solid var(--border-subtle);
            color: var(--text-muted);
            background: #ffffff;
            transition: all 0.16s;
            border-radius: 0.8rem;
        }

            .btn-outline-secondary.btn-sm:hover {
                background: #eff6ff;
                border-color: var(--primary-blue);
                color: var(--text-blue);
                transform: translateY(-1px);
            }

        .btn-primary.btn-sm {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-light) 100%);
            border: none;
            box-shadow: 0 3px 10px rgba(37, 99, 235, 0.35);
            transition: all 0.16s;
            border-radius: 999px;
        }

            .btn-primary.btn-sm:hover {
                transform: translateY(-1px);
                box-shadow: 0 5px 14px rgba(37, 99, 235, 0.45);
            }

        /* Tabs */
        .nav-tabs {
            border: none;
        }

            .nav-tabs .nav-link {
                color: var(--text-muted);
                border: none;
                background: transparent;
                font-weight: 600;
                transition: all 0.16s;
                opacity: 0.9;
                font-size: 0.82rem;
            }

                .nav-tabs .nav-link:hover {
                    opacity: 1;
                    border: none;
                    background: #eff6ff;
                }

                .nav-tabs .nav-link.active {
                    background: #dbeafe;
                    color: var(--text-blue);
                    border: none;
                    border-radius: 999px;
                    opacity: 1;
                }

        #supportChatRightBody {
            padding: 1rem 0.9rem;
        }

        .tab-content .card {
            border: 1px solid var(--border-blue);
            background: white;
        }

        .rounded-circle {
            border: 3px solid #e5e7eb;
        }

        .text-center .rounded-circle {
            border: 3px solid var(--primary-blue-light);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.22);
        }

        /* Order cards */
        #pane-orders .card {
            transition: all 0.18s;
            border: 1px solid var(--border-subtle) !important;
        }

            #pane-orders .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.18) !important;
                border-color: var(--primary-blue) !important;
            }

        #pane-orders a {
            color: var(--text-blue);
            font-weight: 700;
            transition: all 0.16s;
        }

            #pane-orders a:hover {
                color: var(--primary-blue-dark);
                transform: translateY(-1px);
            }

        /* Scrollbars */
        #supportConvListWrapper::-webkit-scrollbar,
        #supportAdminMessages::-webkit-scrollbar,
        #supportChatRightBody::-webkit-scrollbar {
            width: 6px;
        }

        #supportConvListWrapper::-webkit-scrollbar-track,
        #supportAdminMessages::-webkit-scrollbar-track,
        #supportChatRightBody::-webkit-scrollbar-track {
            background: transparent;
        }

        #supportConvListWrapper::-webkit-scrollbar-thumb,
        #supportAdminMessages::-webkit-scrollbar-thumb,
        #supportChatRightBody::-webkit-scrollbar-thumb {
            background: #c7d2fe;
            border-radius: 999px;
        }

            #supportConvListWrapper::-webkit-scrollbar-thumb:hover,
            #supportAdminMessages::-webkit-scrollbar-thumb:hover,
            #supportChatRightBody::-webkit-scrollbar-thumb:hover {
                background: #a5b4fc;
            }

        .text-muted {
            color: var(--text-muted) !important;
        }

        .spinner-border {
            color: var(--primary-blue);
        }

        /* Responsive */
        @@media (max-width: 992px) {
            #supportChatShell {
                flex-direction: column;
            }

            .support-chat-col {
                width: 100% !important;
                max-height: 420px;
            }
        }

        .btn-close {
            filter: brightness(0.3);
        }

        #pane-profile .fw-semibold,
        #pane-orders .fw-semibold {
            color: var(--text-blue);
        }

        /* Reaction badge + picker */
        .support-msg-reaction-badge {
            border: 1px solid rgba(148, 163, 184, 0.4);
            background: #fff;
            border-radius: 999px;
            width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);
            position: absolute;
            bottom: -10px;
            right: -10px;
            z-index: 10;
        }

        .support-msg-reaction-picker {
            position: absolute;
            right: 0;
            bottom: 100%;
            margin-bottom: 6px;
            background: #fff;
            border: 1px solid rgba(148, 163, 184, 0.45);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.22);
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 6px;
            z-index: 1050;
        }

        .support-msg-reaction-option {
            border: none;
            background: transparent;
            padding: 2px;
            border-radius: 999px;
            cursor: pointer;
            line-height: 1;
            font-size: 18px;
        }

            .support-msg-reaction-option:hover {
                background: #f3f4f6;
            }

        .support-msg-reaction-indicator {
            display: none;
        }

        .msg-avatar-seen {
            border: 2px solid white;
            box-shadow: 0 2px 4px rgba(15, 23, 42, 0.16);
        }
    </style>

    <div class="page-header-support">
        <h2>Hỗ trợ khách hàng trực tuyến</h2>
    </div>

    <div id="supportChatShell">
        <!-- Cột trái: Danh sách hội thoại -->
        <div class="support-chat-col" style="width:25%;">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="supportConvSearch" placeholder="Tìm tên / SĐT..." />
                    </div>
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <button type="button" class="btn btn-outline-secondary active" data-filter="all">Tất cả</button>
                        <button type="button" class="btn btn-outline-secondary" data-filter="unread">Chưa đọc</button>
                        <button type="button" class="btn btn-outline-secondary" data-filter="open">Chưa giải quyết</button>
                    </div>
                </div>
                <div class="list-group list-group-flush" id="supportConvListWrapper">
                    <div class="p-3 text-muted small">Đang tải danh sách...</div>
                </div>
            </div>
        </div>

        <!-- Cột giữa: Khung chat -->
        <div class="support-chat-col" style="width:50%;">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold" id="supportChatTitle">Chọn một cuộc trò chuyện</div>
                        <small id="supportChatSubTitle" class="text-white"></small>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="supportChatCloseBtn" disabled>
                        <i class="bi bi-x-circle me-1"></i> Kết thúc
                    </button>
                </div>
                <div class="card-body small" id="supportAdminMessages">
                    <p class="text-muted">Chưa chọn cuộc trò chuyện nào.</p>
                </div>
                <div class="card-footer">
                    <div id="supportReplyPreview" class="small mb-2 d-none">
                        <i class="bi bi-reply-fill me-1"></i>Đang trả lời: <span id="supportReplyPreviewText"></span>
                        <button type="button" class="btn-close btn-sm ms-2" id="supportReplyCancel"></button>
                    </div>
                    <div id="supportAdminTyping" class="small mb-2 d-none">
                        <i class="bi bi-chat-dots me-1"></i>Khách đang soạn tin...
                    </div>
                    <div class="d-flex gap-2">
                        <textarea id="supportAdminInput" class="form-control form-control-sm" rows="1"
                                  style="resize:none; max-height:120px;" placeholder="Nhập câu trả lời..."
                                  autocomplete="off"></textarea>
                        <button class="btn btn-outline-secondary btn-sm" type="button" title="Gửi ảnh (chưa hỗ trợ)">
                            <i class="bi bi-paperclip"></i>
                        </button>
                        <button class="btn btn-primary btn-sm" type="button" id="supportAdminSend">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin khách -->
        <div class="support-chat-col" style="width:25%;">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" id="supportRightTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-profile" data-bs-toggle="tab" data-bs-target="#pane-profile" type="button" role="tab">
                                <i class="bi bi-person-circle me-1"></i>Thông tin
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-orders" data-bs-toggle="tab" data-bs-target="#pane-orders" type="button" role="tab">
                                <i class="bi bi-bag-check me-1"></i>Đơn gần đây
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body tab-content" id="supportChatRightBody">
                    <div class="tab-pane fade show active" id="pane-profile" role="tabpanel">
                        <p class="text-muted small text-center">Chưa chọn khách hàng.</p>
                    </div>
                    <div class="tab-pane fade" id="pane-orders" role="tabpanel">
                        <p class="text-muted small text-center">Chưa chọn khách hàng.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    /* ===== MÀU BONG BÓNG TIN NHẮN THEO YÊU CẦU ===== */

    /* Bong bóng của cả admin (me) và khách (other) */
    .support-chat-message.me .bubble,
    .support-chat-message.other .bubble {
        background: #e5f1ff; /* nền bên trong */
        border: 1px solid #66a6ff; /* viền */
        color: #000000; /* chữ màu đen */
    }

    /* Bo đều bốn góc */
    .support-chat-message.me .bubble,
    .support-chat-message.other .bubble {
        border-radius: 16px;
        border-bottom-right-radius: 16px;
        border-bottom-left-radius: 16px;
    }
</style>

@section scripts {
    <script src="~/Scripts/support-chat-admin.js"></script>
}
