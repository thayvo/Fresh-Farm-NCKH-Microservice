@if (isAdminFinance && Model.SellerBreakdown.Count > 0)
{
    <script>
        (() => {
            const pageSize = 20;
            let currentPage = 1;
            const rows = Array.from(document.querySelectorAll('.seller-finance-row'));
            const searchInput = document.getElementById('sellerFinanceSearch');
            const minInput = document.getElementById('sellerFinanceMin');
            const maxInput = document.getElementById('sellerFinanceMax');
            const paymentFilter = document.getElementById('sellerFinancePaymentFilter');
            const resetButton = document.getElementById('sellerFinanceReset');
            const prevButton = document.getElementById('sellerFinancePrev');
            const nextButton = document.getElementById('sellerFinanceNext');
            const pageInfo = document.getElementById('sellerFinancePageInfo');

            const getFilteredRows = () => {
                const term = (searchInput?.value || '').trim().toLowerCase();
                const min = Number(minInput?.value || 0);
                const max = Number(maxInput?.value || 0);
                const payState = paymentFilter?.value || 'all';

                return rows.filter((row) => {
                    const sellerText = `${row.dataset.sellerLabel || ''} ${row.dataset.sellerId || ''}`;
                    const net = Number(row.dataset.net || 0);
                    const unpaid = Number(row.dataset.unpaid || 0);
                    const matchesShop = !term || sellerText.includes(term);
                    const matchesMin = !min || net >= min;
                    const matchesMax = !max || net <= max;
                    const matchesPayState = payState === 'all'
                        || (payState === 'unpaid' && unpaid > 0)
                        || (payState === 'paid' && unpaid <= 0);
                    return matchesShop && matchesMin && matchesMax && matchesPayState;
                });
            };

            const render = () => {
                const filtered = getFilteredRows();
                const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
                currentPage = Math.min(Math.max(1, currentPage), totalPages);
                const start = (currentPage - 1) * pageSize;
                const visible = new Set(filtered.slice(start, start + pageSize));

                rows.forEach((row) => {
                    row.hidden = !visible.has(row);
                });

                if (pageInfo) {
                    const from = filtered.length === 0 ? 0 : start + 1;
                    const to = Math.min(start + pageSize, filtered.length);
                    pageInfo.textContent = `Hiển thị ${from}-${to} / ${filtered.length} shop`;
                }
                if (prevButton) {
                    prevButton.disabled = currentPage <= 1;
                }
                if (nextButton) {
                    nextButton.disabled = currentPage >= totalPages;
                }
            };

            [searchInput, minInput, maxInput, paymentFilter].forEach((control) => {
                control?.addEventListener('input', () => {
                    currentPage = 1;
                    render();
                });
                control?.addEventListener('change', () => {
                    currentPage = 1;
                    render();
                });
            });
            resetButton?.addEventListener('click', () => {
                if (searchInput) searchInput.value = '';
                if (minInput) minInput.value = '';
                if (maxInput) maxInput.value = '';
                if (paymentFilter) paymentFilter.value = 'all';
                currentPage = 1;
                render();
            });
            prevButton?.addEventListener('click', () => {
                currentPage -= 1;
                render();
            });
            nextButton?.addEventListener('click', () => {
                currentPage += 1;
                render();
            });

            render();
        })();
    </script>
}

@if (isAdminFinance && Model.Rows.Count > 0)
{
    <script>
        (() => {
            const selectAll = document.getElementById('finance-select-all');
            const rowCheckboxes = Array.from(document.querySelectorAll('.finance-row-checkbox'));
            if (!selectAll || rowCheckboxes.length === 0) {
                return;
            }

            selectAll.addEventListener('change', () => {
                rowCheckboxes.forEach((checkbox) => checkbox.checked = selectAll.checked);
            });
        })();
    </script>
}

