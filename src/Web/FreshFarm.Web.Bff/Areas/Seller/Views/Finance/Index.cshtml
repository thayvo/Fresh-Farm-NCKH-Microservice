@model FreshFarm.Web.Bff.Areas.Admin.Models.FinanceConsolePageViewModel
@{
    ViewBag.Title = "Tài chính & đối soát";
    var areaName = "Seller";
    var isAdminFinance = false;
    var scopeLabel = ViewData["FinanceScopeLabel"]?.ToString() ?? "Cửa hàng của tôi";
    var controllerName = "Finance";

    string BuildSectionLink(string section, int? page = null)
    {
        return Url.Action("Index", controllerName, new
        {
            area = areaName,
            section,
            q = Model.Query,
            status = Model.Status,
            followUpBucket = Model.FollowUpBucket,
            sellerId = Model.ShowSellerFilter ? Model.SellerId : null,
            page = page ?? 1
        }) ?? "#";
    }

    string FormatMoney(decimal? value) => string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:#,0} đ", value ?? 0m);
    string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-";
    bool IsOverdue(DateTime? value) => value.HasValue && value.Value < DateTime.UtcNow;
    bool CanReleasePayout(FreshFarm.Web.Bff.Areas.Admin.Models.FinanceConsoleRowViewModel row)
    {
        var normalized = (row.Status ?? string.Empty).Trim().ToLowerInvariant();
        var amountNet = row.AmountNet ?? ((row.AmountGross ?? 0m) - (row.FeeAmount ?? 0m));
        return Model.Section == "payouts"
            && amountNet > 0m
            && (normalized == "pending"
                || normalized == "queued"
                || normalized == "scheduled"
                || normalized == "processing"
                || normalized == "waiting");
    }
}

<style>
    .finance-shell {
        min-height: 100vh;
        padding: 1.5rem;
        background:
            radial-gradient(circle at top right, rgba(96, 165, 250, .25), transparent 32%),
            linear-gradient(180deg, #eef5ff 0%, #f8fbff 100%);
    }

    .finance-hero {
        position: relative;
        overflow: hidden;
        border-radius: 1.75rem;
        padding: 2rem;
        color: #fff;
        background: linear-gradient(135deg, #1d4ed8 0%, #38bdf8 100%);
        box-shadow: 0 24px 50px rgba(29, 78, 216, .2);
    }

    .finance-hero::after {
        content: "";
        position: absolute;
        inset: -40% auto auto -10%;
        width: 50%;
        height: 220%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .22), transparent);
        transform: rotate(18deg);
        pointer-events: none;
    }

    .finance-card,
    .finance-filter-card,
    .finance-table-card,
    .finance-section-card {
        border: 0;
        border-radius: 1.5rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, .08);
    }

    .finance-stat-label {
        color: #64748b;
        font-size: .86rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .finance-stat-hint {
        color: #64748b;
        font-size: .78rem;
        margin-top: .35rem;
        line-height: 1.35;
    }

    .finance-section-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .finance-section-link.active .finance-section-card {
        border: 1px solid rgba(29, 78, 216, .24);
        background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
    }

    .finance-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .35rem .8rem;
        background: #dbeafe;
        color: #1d4ed8;
        font-weight: 700;
        font-size: .8rem;
    }

    .finance-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .35rem .8rem;
        font-weight: 700;
        font-size: .78rem;
        background: #e2e8f0;
        color: #0f172a;
    }

    .finance-status.pending {
        background: #fef3c7;
        color: #92400e;
    }

    .finance-status.done {
        background: #dcfce7;
        color: #166534;
    }

    .finance-status.failed {
        background: #fee2e2;
        color: #b91c1c;
    }

    .finance-table-card table td,
    .finance-table-card table th {
        vertical-align: middle;
    }

    .finance-recon {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .3rem .75rem;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .78rem;
        font-weight: 700;
    }

    .finance-ops-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        padding: .28rem .7rem;
        background: #f8fafc;
        color: #334155;
        font-size: .76rem;
        font-weight: 700;
    }
</style>

<main class="finance-shell">
    <div class="finance-hero mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-4 align-items-lg-center">
            <div>
                <div class="badge rounded-pill text-bg-light text-primary mb-3 px-3 py-2">@scopeLabel</div>
                <h1 class="fw-bold mb-2">Tài chính & đối soát</h1>
                <p class="mb-0 opacity-75">Theo dõi chi trả, hoàn tiền và đổi trả trong cùng một luồng để chốt vận hành sàn trước khi mở rộng nghiệp vụ đối soát.</p>
            </div>
            <div class="text-lg-end">
                <div class="small opacity-75">Phạm vi hiện tại</div>
                <div class="display-6 fw-bold">@Model.Scope</div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">@TempData["ErrorMessage"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">@ViewBag.Error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card h-100">
                <div class="card-body">
                    <div class="finance-stat-label">Tổng tiền hàng</div>
                    <div class="fs-3 fw-bold">@FormatMoney(Model.Stats.GrossMerchandiseValue)</div>
                    <div class="finance-stat-hint">Không tính phí ship; chỉ tính các đơn chưa hủy, chưa hết hạn và chưa phát sinh hoàn/đổi trả.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card h-100">
                <div class="card-body">
                    <div class="finance-stat-label">Hoa hồng nền tảng</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.PlatformCommission)</div>
                    <div class="finance-stat-hint">Tính theo tỷ lệ hoa hồng đang lưu trên từng đơn của người bán.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card h-100">
                <div class="card-body">
                    <div class="finance-stat-label">Hoàn tiền cho khách</div>
                    <div class="fs-3 fw-bold text-danger">@FormatMoney(Model.Stats.RefundedAmount)</div>
                    <div class="finance-stat-hint">Các khoản cần hoàn tiền cho khách sau khi đối chiếu đơn hàng và thanh toán.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card h-100">
                <div class="card-body">
                    <div class="finance-stat-label">Tiền thực nhận</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.PaidPayoutAmount)</div>
                    <div class="finance-stat-hint">Số tiền admin đã chi trả, seller có thể nhận/rút.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card h-100">
                <div class="card-body">
                    <div class="finance-stat-label">Tiền chờ chi trả</div>
                    <div class="fs-3 fw-bold text-warning">@FormatMoney(Model.Stats.PendingSellerPayoutAmount)</div>
                    <div class="finance-stat-hint">Đơn đã đủ điều kiện nhưng admin chưa ghi nhận chi trả.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card h-100">
                <div class="card-body">
                    <div class="finance-stat-label">Tiền đã nhận</div>
                    <div class="fs-3 fw-bold text-primary">@FormatMoney(Model.Stats.WithdrawnAmount)</div>
                    <div class="finance-stat-hint">Tổng số tiền seller đã bấm nhận/rút và được lưu lại.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="finance-stat-label">Số tiền còn lại</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.RemainingWithdrawableAmount)</div>
                    <div class="finance-stat-hint">Tiền thực nhận trừ tiền đã nhận.</div>
                    @if (!isAdminFinance)
                    {
                        if (Model.Stats.RemainingWithdrawableAmount > 0m)
                        {
                            <button type="button"
                                    class="btn btn-primary rounded-pill mt-auto"
                                    data-bs-toggle="modal"
                                    data-bs-target="#sellerWithdrawModal">
                                Nhận tiền
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary rounded-pill mt-auto" disabled>
                                Chưa có tiền nhận
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!isAdminFinance)
    {
        <div class="modal fade" id="sellerWithdrawModal" tabindex="-1" aria-labelledby="sellerWithdrawModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4">
                    <form method="post" action="@Url.Action("Withdraw", controllerName, new { area = areaName })">
                        @Html.AntiForgeryToken()
                        <div class="modal-header border-0">
                            <h5 class="modal-title" id="sellerWithdrawModalLabel">Thông tin nhận tiền</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body pt-0">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Ngân hàng</label>
                                <input type="text" class="form-control" name="bankName" value="@Model.BankName" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Tên tài khoản</label>
                                <input type="text" class="form-control" name="bankAccountName" value="@Model.BankAccountName" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Số tài khoản</label>
                                <input type="text" class="form-control" name="bankAccountNumber" value="@Model.BankAccountNumber" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Số tiền muốn nhận</label>
                                <input type="number"
                                       class="form-control"
                                       name="amount"
                                       min="1000"
                                       step="1000"
                                       max="@Model.Stats.RemainingWithdrawableAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       value="@Model.Stats.RemainingWithdrawableAmount.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"
                                       required />
                                <div class="form-text">Có thể nhận tối đa @FormatMoney(Model.Stats.RemainingWithdrawableAmount).</div>
                            </div>
                            <div>
                                <label class="form-label fw-semibold">Ghi chú</label>
                                <textarea class="form-control" name="note" rows="2" placeholder="Ví dụ: rút tiền đợt này..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-primary rounded-pill">Xác nhận nhận tiền</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (isAdminFinance && Model.SellerBreakdown.Count > 0)
    {
        <div class="card finance-table-card mb-4">
            <div class="card-body">
                <div class="finance-stat-label mb-3">Theo người bán</div>
                <div class="row g-3 align-items-end mb-3" id="seller-finance-filters">
                    <div class="col-md-6 col-xl-3">
                        <label class="form-label fw-semibold">Shop</label>
                        <input type="text" class="form-control" id="sellerFinanceSearch" placeholder="Tên hoặc ID seller" />
                    </div>
                    <div class="col-md-6 col-xl-2">
                        <label class="form-label fw-semibold">Từ tiền</label>
                        <input type="number" min="0" step="1000" class="form-control" id="sellerFinanceMin" placeholder="0" />
                    </div>
                    <div class="col-md-6 col-xl-2">
                        <label class="form-label fw-semibold">Đến tiền</label>
                        <input type="number" min="0" step="1000" class="form-control" id="sellerFinanceMax" placeholder="Không giới hạn" />
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <label class="form-label fw-semibold">Chi trả</label>
                        <select class="form-select" id="sellerFinancePaymentFilter">
                            <option value="all">Tất cả</option>
                            <option value="unpaid">Còn chưa chi trả</option>
                            <option value="paid">Đã chi trả hết</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-xl-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill w-100" id="sellerFinanceReset">Đặt lại</button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="sellerFinanceTable">
                        <thead class="table-light">
                            <tr>
                                <th>Người bán</th>
                                <th class="text-end">Số đơn</th>
                                <th class="text-end">Tổng tiền hàng</th>
                                <th class="text-end">Hoa hồng nền tảng</th>
                                <th class="text-end">Tiền thực nhận</th>
                                <th class="text-end">Đã chi trả</th>
                                <th class="text-end">Chưa chi trả</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var seller in Model.SellerBreakdown)
                            {
                                <tr class="seller-finance-row"
                                    data-seller-id="@seller.SellerId"
                                    data-seller-label="@seller.SellerLabel.ToLowerInvariant()"
                                    data-net="@seller.SellerEarning.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-unpaid="@seller.UnpaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <td>
                                        <div class="fw-semibold">@seller.SellerLabel</div>
                                        <div class="small text-muted">ID @seller.SellerId</div>
                                    </td>
                                    <td class="text-end">@seller.OrderCount</td>
                                    <td class="text-end">@FormatMoney(seller.GrossMerchandiseValue)</td>
                                    <td class="text-end text-success">@FormatMoney(seller.PlatformCommission)</td>
                                    <td class="text-end fw-bold text-success">@FormatMoney(seller.SellerEarning)</td>
                                    <td class="text-end">@FormatMoney(seller.PaidAmount)</td>
                                    <td class="text-end fw-bold @(seller.UnpaidAmount > 0m ? "text-warning" : "text-success")">@FormatMoney(seller.UnpaidAmount)</td>
                                    <td class="text-end">
                                        @if (seller.UnpaidAmount <= 0m)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" disabled>Đã chi trả</button>
                                        }
                                        else
                                        {
                                            <form method="post" action="@Url.Action("GeneratePayouts", controllerName, new { area = areaName })" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="sellerId" value="@seller.SellerId" />
                                                <input type="hidden" name="releaseNow" value="true" />
                                                <button type="submit" class="btn btn-sm btn-primary rounded-pill">Chi trả</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
                    <div class="small text-muted" id="sellerFinancePageInfo"></div>
                    <div class="btn-group" role="group" aria-label="Phân trang shop">
                        <button type="button" class="btn btn-outline-secondary rounded-pill" id="sellerFinancePrev">Trước</button>
                        <button type="button" class="btn btn-outline-secondary rounded-pill" id="sellerFinanceNext">Sau</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!isAdminFinance)
    {
    <div class="card finance-filter-card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="section" value="@Model.Section" />
                <div class="col-lg-4">
                    <label class="form-label fw-semibold">Tìm kiếm</label>
                    <input type="text" class="form-control" name="q" value="@Model.Query" placeholder="Mã bản ghi, mã đơn, mã tham chiếu, lý do..." />
                </div>
                <div class="col-md-4 col-lg-3">
                    <label class="form-label fw-semibold">Trạng thái</label>
                    <select class="form-select" name="status">
                        @foreach (var option in Model.StatusOptions)
                        {
                            if (string.Equals(option.Value, Model.Status, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@option.Value" selected>@option.Text</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4 col-lg-3">
                    <label class="form-label fw-semibold">Trạng thái xử lý</label>
                    <select class="form-select" name="followUpBucket">
                        @if (Model.FollowUpBucket == "all")
                        {
                            <option value="all" selected>Tất cả trạng thái xử lý</option>
                        }
                        else
                        {
                            <option value="all">Tất cả trạng thái xử lý</option>
                        }
                        @if (Model.FollowUpBucket == "overdue")
                        {
                            <option value="overdue" selected>Cần xử lý quá hạn</option>
                        }
                        else
                        {
                            <option value="overdue">Cần xử lý quá hạn</option>
                        }
                        @if (Model.FollowUpBucket == "due-soon")
                        {
                            <option value="due-soon" selected>Sắp đến hạn xử lý</option>
                        }
                        else
                        {
                            <option value="due-soon">Sắp đến hạn xử lý</option>
                        }
                        @if (Model.FollowUpBucket == "no-follow-up")
                        {
                            <option value="no-follow-up" selected>Chưa đặt lịch xử lý</option>
                        }
                        else
                        {
                            <option value="no-follow-up">Chưa đặt lịch xử lý</option>
                        }
                        @if (Model.FollowUpBucket == "scheduled")
                        {
                            <option value="scheduled" selected>Đã có lịch xử lý</option>
                        }
                        else
                        {
                            <option value="scheduled">Đã có lịch xử lý</option>
                        }
                    </select>
                </div>
                @if (Model.ShowSellerFilter)
                {
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-semibold">Người bán</label>
                        <select class="form-select" name="sellerId">
                            @if (!Model.SellerId.HasValue)
                            {
                                <option value="" selected>Tất cả người bán</option>
                            }
                            else
                            {
                                <option value="">Tất cả người bán</option>
                            }

                            @foreach (var option in Model.SellerOptions)
                            {
                                if (int.TryParse(option.Value, out var sellerValue) && Model.SellerId == sellerValue)
                                {
                                    <option value="@option.Value" selected>@option.Text</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            }
                        </select>
                    </div>
                }
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-funnel me-2"></i>Lọc dữ liệu
                    </button>
                    <a class="btn btn-outline-secondary rounded-pill px-4" href="@Url.Action("Index", controllerName, new { area = areaName, section = Model.Section })">
                        <i class="bi bi-arrow-clockwise me-2"></i>Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (isAdminFinance && Model.OwnerSummary.Count > 0)
    {
        <div class="card finance-card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="finance-stat-label">Bảng theo dõi phụ trách</div>
                        <div class="h5 mb-0">Phân bổ hàng chờ theo người phụ trách trong phạm vi lọc hiện tại</div>
                    </div>
                    <div class="small text-muted">Top 6 người phụ trách theo mức độ trễ xử lý</div>
                </div>
                <div class="row g-3">
                    @foreach (var owner in Model.OwnerSummary)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card finance-section-card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                        <div class="fw-semibold">@owner.OwnerLabel</div>
                                        <span class="finance-pill">@owner.ItemCount việc</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="finance-ops-chip text-danger"><i class="bi bi-exclamation-triangle"></i>@owner.OverdueCount quá hạn xử lý</span>
                                        <span class="finance-ops-chip text-warning"><i class="bi bi-hourglass-split"></i>@owner.DueSoonCount sắp đến hạn</span>
                                        <span class="finance-ops-chip"><i class="bi bi-calendar-x"></i>@owner.NoFollowUpCount chưa đặt lịch</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card finance-table-card">
        <div class="card-body">
