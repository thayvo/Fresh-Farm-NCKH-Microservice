@model FreshFarm.Web.Bff.Areas.Admin.Models.FinanceConsolePageViewModel
@{
    ViewBag.Title = "Tài chính & đối soát";
    var areaName = (ViewData["AreaName"]?.ToString() ?? "Seller").Trim();
    var scopeLabel = ViewData["FinanceScopeLabel"]?.ToString() ?? (areaName == "Admin" ? "Toàn sàn" : "Cửa hàng của tôi");
    var controllerName = "Finance";

    string BuildSectionLink(string section, int? page = null)
    {
        return Url.Action("Index", controllerName, new
        {
            area = areaName,
            section,
            q = Model.Query,
            status = Model.Status,
            followUpBucket = Model.FollowUpBucket,
            sellerId = Model.ShowSellerFilter ? Model.SellerId : null,
            page = page ?? 1
        }) ?? "#";
    }

    string FormatMoney(decimal? value) => string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:#,0} đ", value ?? 0m);
    string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-";
    bool IsOverdue(DateTime? value) => value.HasValue && value.Value < DateTime.UtcNow;
    bool CanReleasePayout(FreshFarm.Web.Bff.Areas.Admin.Models.FinanceConsoleRowViewModel row)
    {
        var normalized = (row.Status ?? string.Empty).Trim().ToLowerInvariant();
        var amountNet = row.AmountNet ?? ((row.AmountGross ?? 0m) - (row.FeeAmount ?? 0m));
        return Model.Section == "payouts"
            && amountNet > 0m
            && (normalized == "pending"
                || normalized == "queued"
                || normalized == "scheduled"
                || normalized == "processing"
                || normalized == "waiting");
    }
}

<style>
    .finance-shell {
        min-height: 100vh;
        padding: 1.5rem;
        background:
            radial-gradient(circle at top right, rgba(96, 165, 250, .25), transparent 32%),
            linear-gradient(180deg, #eef5ff 0%, #f8fbff 100%);
    }

    .finance-hero {
        position: relative;
        overflow: hidden;
        border-radius: 1.75rem;
        padding: 2rem;
        color: #fff;
        background: linear-gradient(135deg, #1d4ed8 0%, #38bdf8 100%);
        box-shadow: 0 24px 50px rgba(29, 78, 216, .2);
    }

    .finance-hero::after {
        content: "";
        position: absolute;
        inset: -40% auto auto -10%;
        width: 50%;
        height: 220%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .22), transparent);
        transform: rotate(18deg);
        pointer-events: none;
    }

    .finance-card,
    .finance-filter-card,
    .finance-table-card,
    .finance-section-card {
        border: 0;
        border-radius: 1.5rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, .08);
    }

    .finance-stat-label {
        color: #64748b;
        font-size: .86rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .finance-stat-hint {
        color: #64748b;
        font-size: .78rem;
        margin-top: .35rem;
        line-height: 1.35;
    }

    .finance-section-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .finance-section-link.active .finance-section-card {
        border: 1px solid rgba(29, 78, 216, .24);
        background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
    }

    .finance-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .35rem .8rem;
        background: #dbeafe;
        color: #1d4ed8;
        font-weight: 700;
        font-size: .8rem;
    }

    .finance-status {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .35rem .8rem;
        font-weight: 700;
        font-size: .78rem;
        background: #e2e8f0;
        color: #0f172a;
    }

    .finance-status.pending {
        background: #fef3c7;
        color: #92400e;
    }

    .finance-status.done {
        background: #dcfce7;
        color: #166534;
    }

    .finance-status.failed {
        background: #fee2e2;
        color: #b91c1c;
    }

    .finance-table-card table td,
    .finance-table-card table th {
        vertical-align: middle;
    }

    .finance-recon {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .3rem .75rem;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .78rem;
        font-weight: 700;
    }

    .finance-ops-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        padding: .28rem .7rem;
        background: #f8fafc;
        color: #334155;
        font-size: .76rem;
        font-weight: 700;
    }
</style>

<main class="finance-shell">
    <div class="finance-hero mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-4 align-items-lg-center">
            <div>
                <div class="badge rounded-pill text-bg-light text-primary mb-3 px-3 py-2">@scopeLabel</div>
                <h1 class="fw-bold mb-2">Tài chính & đối soát</h1>
                <p class="mb-0 opacity-75">Theo dõi chi trả, hoàn tiền và đổi trả trong cùng một luồng để chốt vận hành sàn trước khi mở rộng nghiệp vụ đối soát.</p>
            </div>
            <div class="text-lg-end">
                <div class="small opacity-75">Phạm vi hiện tại</div>
                <div class="display-6 fw-bold">@Model.Scope</div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">@TempData["ErrorMessage"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">@ViewBag.Error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">GMV toàn bộ đơn</div>
                    <div class="fs-3 fw-bold">@FormatMoney(Model.Stats.GrossMerchandiseValue)</div>
                    <div class="finance-stat-hint">Gồm cả đơn chờ xử lý, đã hủy hoặc chưa đủ điều kiện đối soát.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">GMV đủ điều kiện đối soát</div>
                    <div class="fs-3 fw-bold text-primary">@FormatMoney(Model.Stats.ReconciliationGrossMerchandiseValue)</div>
                    <div class="finance-stat-hint">Chỉ tính đơn hoàn tất, đã ghi nhận thanh toán online và không bị hoàn/hủy.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Giá trị thanh toán thành công</div>
                    <div class="fs-3 fw-bold text-primary">@FormatMoney(Model.Stats.CapturedPayments)</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Phí nền tảng tạm tính</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.PlatformCommission)</div>
                    <div class="finance-stat-hint">Phí nền tảng tạm tính trên toàn bộ đơn của người bán.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Phí nền tảng đủ điều kiện đối soát</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.ReconciliationPlatformCommission)</div>
                    <div class="finance-stat-hint">Phí nền tảng từ các đơn đủ điều kiện chốt kỳ tài chính.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Số tiền người bán tạm tính</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.SellerEarning)</div>
                    <div class="finance-stat-hint">Tổng tiền hàng tạm tính sau khi trừ phí nền tảng trên toàn bộ đơn.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Số tiền đủ điều kiện đối soát</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.ReconciliationSellerEarning)</div>
                    <div class="finance-stat-hint">Khoản có thể đưa vào quy trình chi trả/đối soát.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Số tiền có thể rút</div>
                    <div class="fs-3 fw-bold text-success">@FormatMoney(Model.Stats.WithdrawableAmount)</div>
                    <div class="finance-stat-hint">Phần đủ điều kiện đối soát chưa nằm trong lệnh chi trả.</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Chờ chi trả</div>
                    <div class="fs-3 fw-bold text-warning">@FormatMoney(Model.Stats.PendingPayoutAmount)</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Giá trị hoàn tiền</div>
                    <div class="fs-3 fw-bold text-danger">@FormatMoney(Model.Stats.RefundedAmount)</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Yêu cầu đổi trả đang mở</div>
                    <div class="fs-3 fw-bold">@Model.Stats.OpenReturns</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Yêu cầu hoàn tiền đang mở</div>
                    <div class="fs-3 fw-bold">@Model.Stats.OpenRefunds</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card finance-card">
                <div class="card-body">
                    <div class="finance-stat-label">Người bán trong phạm vi</div>
                    <div class="fs-3 fw-bold">@Model.Stats.SellerCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card finance-filter-card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="section" value="@Model.Section" />
                <div class="col-lg-4">
                    <label class="form-label fw-semibold">Tìm kiếm</label>
                    <input type="text" class="form-control" name="q" value="@Model.Query" placeholder="Mã bản ghi, mã đơn, mã tham chiếu, lý do..." />
                </div>
                <div class="col-md-4 col-lg-3">
                    <label class="form-label fw-semibold">Trạng thái</label>
                    <select class="form-select" name="status">
                        @foreach (var option in Model.StatusOptions)
                        {
                            if (string.Equals(option.Value, Model.Status, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@option.Value" selected>@option.Text</option>
                            }
                            else
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4 col-lg-3">
                    <label class="form-label fw-semibold">Trạng thái xử lý</label>
                    <select class="form-select" name="followUpBucket">
                        @if (Model.FollowUpBucket == "all")
                        {
                            <option value="all" selected>Tất cả trạng thái xử lý</option>
                        }
                        else
                        {
                            <option value="all">Tất cả trạng thái xử lý</option>
                        }
                        @if (Model.FollowUpBucket == "overdue")
                        {
                            <option value="overdue" selected>Cần xử lý quá hạn</option>
                        }
                        else
                        {
                            <option value="overdue">Cần xử lý quá hạn</option>
                        }
                        @if (Model.FollowUpBucket == "due-soon")
                        {
                            <option value="due-soon" selected>Sắp đến hạn xử lý</option>
                        }
                        else
                        {
                            <option value="due-soon">Sắp đến hạn xử lý</option>
                        }
                        @if (Model.FollowUpBucket == "no-follow-up")
                        {
                            <option value="no-follow-up" selected>Chưa đặt lịch xử lý</option>
                        }
                        else
                        {
                            <option value="no-follow-up">Chưa đặt lịch xử lý</option>
                        }
                        @if (Model.FollowUpBucket == "scheduled")
                        {
                            <option value="scheduled" selected>Đã có lịch xử lý</option>
                        }
                        else
                        {
                            <option value="scheduled">Đã có lịch xử lý</option>
                        }
                    </select>
                </div>
                @if (Model.ShowSellerFilter)
                {
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-semibold">Người bán</label>
                        <select class="form-select" name="sellerId">
                            @if (!Model.SellerId.HasValue)
                            {
                                <option value="" selected>Tất cả người bán</option>
                            }
                            else
                            {
                                <option value="">Tất cả người bán</option>
                            }

                            @foreach (var option in Model.SellerOptions)
                            {
                                if (int.TryParse(option.Value, out var sellerValue) && Model.SellerId == sellerValue)
                                {
                                    <option value="@option.Value" selected>@option.Text</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            }
                        </select>
                    </div>
                }
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-funnel me-2"></i>Lọc dữ liệu
                    </button>
                    <a class="btn btn-outline-secondary rounded-pill px-4" href="@Url.Action("Index", controllerName, new { area = areaName, section = Model.Section })">
                        <i class="bi bi-arrow-clockwise me-2"></i>Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a class="finance-section-link @(Model.Section == "payouts" ? "active" : string.Empty)" href="@BuildSectionLink("payouts")">
                <div class="card finance-section-card h-100">
                    <div class="card-body">
                        <div class="finance-pill mb-3">Chi trả cho người bán</div>
                        <div class="display-6 fw-bold">@Model.SectionCounts.Payouts</div>
                        <div class="text-muted">Các khoản sàn cần chi trả cho người bán sau khi đủ điều kiện đối soát</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="finance-section-link @(Model.Section == "refunds" ? "active" : string.Empty)" href="@BuildSectionLink("refunds")">
                <div class="card finance-section-card h-100">
                    <div class="card-body">
                        <div class="finance-pill mb-3">Hoàn tiền cho khách</div>
                        <div class="display-6 fw-bold">@Model.SectionCounts.Refunds</div>
                        <div class="text-muted">Các khoản cần hoàn tiền cho khách sau khi đối chiếu đơn hàng và thanh toán</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="finance-section-link @(Model.Section == "returns" ? "active" : string.Empty)" href="@BuildSectionLink("returns")">
                <div class="card finance-section-card h-100">
                    <div class="card-body">
                        <div class="finance-pill mb-3">Đổi trả ảnh hưởng đối soát</div>
                        <div class="display-6 fw-bold">@Model.SectionCounts.Returns</div>
                        <div class="text-muted">Các yêu cầu đổi/trả có thể làm giữ hoặc điều chỉnh tiền đối soát</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a class="finance-section-link @(Model.FollowUpBucket == "overdue" ? "active" : string.Empty)" href="@Url.Action("Index", controllerName, new { area = areaName, section = Model.Section, q = Model.Query, status = Model.Status, followUpBucket = "overdue", sellerId = Model.ShowSellerFilter ? Model.SellerId : null })">
                <div class="card finance-section-card h-100">
                    <div class="card-body">
                        <div class="finance-pill mb-3">Cần xử lý quá hạn</div>
                        <div class="display-6 fw-bold text-danger">@Model.Stats.OverdueFollowUps</div>
                        <div class="text-muted">Các bản ghi đã quá hạn xử lý, nên ưu tiên kiểm tra ngay.</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="finance-section-link @(Model.FollowUpBucket == "due-soon" ? "active" : string.Empty)" href="@Url.Action("Index", controllerName, new { area = areaName, section = Model.Section, q = Model.Query, status = Model.Status, followUpBucket = "due-soon", sellerId = Model.ShowSellerFilter ? Model.SellerId : null })">
                <div class="card finance-section-card h-100">
                    <div class="card-body">
                        <div class="finance-pill mb-3">Sắp đến hạn xử lý</div>
                        <div class="display-6 fw-bold text-warning">@Model.Stats.DueSoonFollowUps</div>
                        <div class="text-muted">Các trường hợp sắp tới hạn, phù hợp để chủ động chốt đối soát.</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="finance-section-link @(Model.FollowUpBucket == "no-follow-up" ? "active" : string.Empty)" href="@Url.Action("Index", controllerName, new { area = areaName, section = Model.Section, q = Model.Query, status = Model.Status, followUpBucket = "no-follow-up", sellerId = Model.ShowSellerFilter ? Model.SellerId : null })">
                <div class="card finance-section-card h-100">
                    <div class="card-body">
                        <div class="finance-pill mb-3">Chưa đặt lịch xử lý</div>
                        <div class="display-6 fw-bold">@Model.Stats.NoFollowUpCount</div>
                        <div class="text-muted">Các bản ghi chưa có lịch xử lý để phụ trách viên lên kế hoạch đối soát tiếp theo.</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @if (areaName == "Admin" && Model.OwnerSummary.Count > 0)
    {
        <div class="card finance-card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="finance-stat-label">Bảng theo dõi phụ trách</div>
                        <div class="h5 mb-0">Phân bổ hàng chờ theo người phụ trách trong phạm vi lọc hiện tại</div>
                    </div>
                    <div class="small text-muted">Top 6 người phụ trách theo mức độ trễ xử lý</div>
                </div>
                <div class="row g-3">
                    @foreach (var owner in Model.OwnerSummary)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card finance-section-card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                        <div class="fw-semibold">@owner.OwnerLabel</div>
                                        <span class="finance-pill">@owner.ItemCount việc</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="finance-ops-chip text-danger"><i class="bi bi-exclamation-triangle"></i>@owner.OverdueCount quá hạn xử lý</span>
                                        <span class="finance-ops-chip text-warning"><i class="bi bi-hourglass-split"></i>@owner.DueSoonCount sắp đến hạn</span>
                                        <span class="finance-ops-chip"><i class="bi bi-calendar-x"></i>@owner.NoFollowUpCount chưa đặt lịch</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card finance-table-card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-1">
                        @if (Model.Section == "refunds")
                        {
                            <span>Danh sách hoàn tiền cho khách</span>
                        }
                        else if (Model.Section == "returns")
                        {
                            <span>Danh sách đổi trả ảnh hưởng đối soát</span>
                        }
                        else
                        {
                            <span>Danh sách chi trả cho người bán</span>
                        }
                    </h5>
                    <div class="text-muted small">Hiển thị @Model.Rows.Count / @Model.Total bản ghi theo phạm vi hiện tại</div>
                </div>
                @if (areaName == "Admin")
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @if (Model.Section == "payouts")
                        {
                            <form method="post" action="@Url.Action("GeneratePayouts", controllerName, new { area = areaName })" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="q" value="@Model.Query" />
                                <input type="hidden" name="status" value="@Model.Status" />
                                <input type="hidden" name="followUpBucket" value="@Model.FollowUpBucket" />
                                <input type="hidden" name="sellerId" value="@Model.SellerId" />
                                <input type="hidden" name="page" value="@Model.Page" />
                                <button type="submit" class="btn btn-primary rounded-pill px-3">
                                    <i class="bi bi-plus-circle me-2"></i>Tạo lệnh chi trả chờ xử lý
                                </button>
                            </form>
                        }
                        <a class="btn btn-outline-primary rounded-pill px-3" href="@Url.Action("Export", controllerName, new { area = areaName, section = Model.Section, q = Model.Query, status = Model.Status, followUpBucket = Model.FollowUpBucket, sellerId = Model.SellerId })">
                            <i class="bi bi-download me-2"></i>Xuất CSV
                        </a>
                        <div class="small text-muted">Quản trị viên có thể xử lý chi trả cho người bán, hoàn tiền cho khách và đổi trả ảnh hưởng đối soát ngay tại đây.</div>
                    </div>
                }
            </div>

            @if (areaName == "Admin" && Model.Rows.Count > 0)
            {
                <form id="bulk-finance-form" method="post" action="@Url.Action("TakeBulkAction", "Finance", new { area = areaName })" class="card border-0 bg-light mb-3">
                    <div class="card-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="section" value="@Model.Section" />
                        <input type="hidden" name="q" value="@Model.Query" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="followUpBucket" value="@Model.FollowUpBucket" />
                        <input type="hidden" name="sellerId" value="@Model.SellerId" />
                        <input type="hidden" name="page" value="@Model.Page" />
                        <div class="row g-3 align-items-end">
                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Thao tác hàng loạt</label>
                                <select class="form-select" name="actionName">
                                    <option value="">Chọn thao tác hàng loạt</option>
                                    @if (Model.Section == "payouts")
                                    {
                                          <option value="assign">Gán người phụ trách</option>
                                          <option value="set-follow-up">Đặt mốc theo dõi</option>
                                          <option value="send-reminder">Nhắc người phụ trách</option>
                                          <option value="mark-exported">Đánh dấu đã xuất</option>
                                          <option value="acknowledge">Nhận xử lý</option>
                                        <option value="release">Chi trả</option>
                                        <option value="hold">Giữ lại</option>
                                        <option value="reject">Đánh dấu lỗi</option>
                                    }
                                    else
                                    {
                                          <option value="assign">Gán người phụ trách</option>
                                          <option value="set-follow-up">Đặt mốc theo dõi</option>
                                          <option value="send-reminder">Nhắc người phụ trách</option>
                                          <option value="mark-exported">Đánh dấu đã xuất</option>
                                          <option value="acknowledge">Nhận xử lý</option>
                                        <option value="approve">Phê duyệt</option>
                                        <option value="resolve">Đóng</option>
                                        <option value="reject">Từ chối</option>
                                    }
                                </select>
                            </div>
                            <div class="col-lg-2">
                                <label class="form-label fw-semibold">Người phụ trách</label>
                                <input type="text" class="form-control" name="assigneeLabel" placeholder="Ví dụ: Điều phối tài chính - Mai" />
                            </div>
                            <div class="col-lg-2">
                                <label class="form-label fw-semibold">Mốc theo dõi</label>
                                <input type="datetime-local" class="form-control" name="followUpAt" />
                            </div>
                            <div class="col-lg-2">
                                <label class="form-label fw-semibold">Ghi chú chung</label>
                                <input type="text" class="form-control" name="note" placeholder="Ghi chú cho lo xử lý hoặc đối soát..." />
                            </div>
                            <div class="col-lg-2">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 w-100">Xử lý bản ghi đã chọn</button>
                            </div>
                        </div>
                        <div class="small text-muted mt-2">Chọn các bản ghi ở cột đầu để xử lý hàng loạt hoặc xuất ra tệp đối soát.</div>
                    </div>
                </form>
            }

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            @if (areaName == "Admin")
                            {
                                <th>
                                    <input class="form-check-input" type="checkbox" id="finance-select-all" />
                                </th>
                            }
                            <th>Mã</th>
                            <th>Người bán</th>
                            <th>Order</th>
                            @if (Model.Section == "payouts")
                            {
                                <th>Số đơn</th>
                                <th>Tổng tiền</th>
                                <th>Phí</th>
                                <th>Thực nhận</th>
                                <th>Đơn vị xử lý</th>
                                <th>Thời gian</th>
                            }
                            else if (Model.Section == "refunds")
                            {
                                <th>Tiền hoàn</th>
                                <th>Đơn vị xử lý / phương thức</th>
                                <th>Mã tham chiếu</th>
                                <th>Lý do lỗi cũ</th>
                                <th>Thời gian</th>
                            }
                            else
                            {
                                <th>Sản phẩm</th>
                                <th>Tiền hoàn dự kiến</th>
                                <th>Lý do</th>
                                <th>Hướng xử lý</th>
                                <th>Thời gian</th>
                            }
                            <th>Đối soát</th>
                            <th>Vận hành</th>
                            <th>Trạng thái</th>
                            @if (areaName == "Admin")
                            {
                                <th>Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="14" class="text-center text-muted py-5">Chưa có dữ liệu trong phạm vi lọc hiện tại.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Model.Rows)
                            {
                                var normalizedStatus = (row.Status ?? string.Empty).Trim().ToLowerInvariant();
                                var statusClass = normalizedStatus.Contains("fail") || normalizedStatus.Contains("reject") || normalizedStatus.Contains("cancel")
                                    ? "failed"
                                    : normalizedStatus.Contains("paid") || normalizedStatus.Contains("complete") || normalizedStatus.Contains("success") || normalizedStatus.Contains("approved") || normalizedStatus.Contains("resolve")
                                        ? "done"
                                        : "pending";
                                var isFollowUpOverdue = IsOverdue(row.FollowUpAt);
                                var canReleasePayout = CanReleasePayout(row);

                                <tr>
                                    @if (areaName == "Admin")
                                    {
                                        <td>
                                            <input class="form-check-input finance-row-checkbox" type="checkbox" name="recordIds" value="@row.RecordId" />
                                        </td>
                                    }
                                    <td class="fw-semibold">#@row.RecordId</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.SellerLabel))
                                        {
                                            <span>@row.SellerLabel</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.OrderId.HasValue && row.OrderId.Value > 0)
                                        {
                                            <span>#@row.OrderId</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    @if (Model.Section == "payouts")
                                    {
                                        <td>@(row.OrderCount?.ToString() ?? "-")</td>
                                        <td>@FormatMoney(row.AmountGross)</td>
                                        <td>@FormatMoney(row.FeeAmount)</td>
                                        <td class="fw-semibold text-success">@FormatMoney(row.AmountNet)</td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(row.Provider) ? "-" : row.Provider)</div>
                                            <div class="small text-muted">@(!string.IsNullOrWhiteSpace(row.Method) ? row.Method : row.ReferenceCode)</div>
                                        </td>
                                        <td>
                                            <div>Tạo: @FormatDate(row.CreatedAt)</div>
                                            <div class="small text-muted">Lịch: @FormatDate(row.ScheduledAt)</div>
                                            <div class="small text-muted">Chi trả: @FormatDate(row.PaidAt)</div>
                                        </td>
                                    }
                                    else if (Model.Section == "refunds")
                                    {
                                        <td class="fw-semibold text-danger">@FormatMoney(row.RefundAmount)</td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(row.Provider) ? "-" : row.Provider)</div>
                                            <div class="small text-muted">@(!string.IsNullOrWhiteSpace(row.Method) ? row.Method : "-")</div>
                                        </td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(row.ReferenceCode) ? "-" : row.ReferenceCode)</div>
                                            <div class="small text-muted">Đã thanh toán: @FormatDate(row.PaidAt)</div>
                                        </td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(row.ReasonCode) ? "-" : row.ReasonCode)</div>
                                            <div class="small text-muted text-truncate" style="max-width: 220px;">@(string.IsNullOrWhiteSpace(row.Resolution) ? "-" : row.Resolution)</div>
                                        </td>
                                        <td>
                                            <div>Tạo: @FormatDate(row.CreatedAt)</div>
                                            <div class="small text-muted">Xử lý: @FormatDate(row.ProcessedAt)</div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(row.ItemName) ? "-" : row.ItemName)</div>
                                            <div class="small text-muted">Giá trị hàng: @FormatMoney(row.AmountGross)</div>
                                        </td>
                                        <td class="fw-semibold text-danger">@FormatMoney(row.RefundAmount)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.ReasonCode) ? "-" : row.ReasonCode)</td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(row.Resolution) ? "-" : row.Resolution)</div>
                                            <div class="small text-muted">Duyệt: @FormatDate(row.ScheduledAt)</div>
                                        </td>
                                        <td>
                                            <div>Gửi: @FormatDate(row.CreatedAt)</div>
                                            <div class="small text-muted">Hoàn tất: @FormatDate(row.ProcessedAt)</div>
                                        </td>
                                    }
                                    <td>
                                        <div><span class="finance-recon">@row.ReconciliationStatus</span></div>
                                        <div class="small text-muted mt-1">@row.NextStep</div>
                                    </td>
                                    <td>
                                        <div class="d-grid gap-1">
                                            @if (!string.IsNullOrWhiteSpace(row.AssignedOwner))
                                            {
                                                <span class="finance-ops-chip"><i class="bi bi-person-workspace"></i>@row.AssignedOwner</span>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">Chưa gán người phụ trách</span>
                                            }
                                            @if (row.ExportedAt.HasValue)
                                            {
                                                <span class="finance-ops-chip"><i class="bi bi-download"></i>@FormatDate(row.ExportedAt)</span>
                                            }
                                            @if (row.FollowUpAt.HasValue)
                                            {
                                                <span class="finance-ops-chip"><i class="bi bi-alarm"></i>@FormatDate(row.FollowUpAt)</span>
                                                @if (isFollowUpOverdue)
                                                {
                                                    <span class="finance-ops-chip text-danger"><i class="bi bi-exclamation-triangle"></i>Quá hạn</span>
                                                }
                                            }
                                            @if (!string.IsNullOrWhiteSpace(row.FollowUpNote))
                                            {
                                                <div class="small text-muted">Theo dõi: @row.FollowUpNote</div>
                                            }
                                            @if (row.ReminderSentAt.HasValue)
                                            {
                                                <span class="finance-ops-chip"><i class="bi bi-bell"></i>@FormatDate(row.ReminderSentAt)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(row.ReminderNote))
                                            {
                                                <div class="small text-muted">Nhắc phụ trách: @row.ReminderNote</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(row.PriorityLabel))
                                            {
                                                <span class="finance-ops-chip @(row.PriorityKey == "critical" ? "text-danger" : row.PriorityKey == "today" ? "text-warning" : row.PriorityKey == "watch" ? "text-primary" : string.Empty)"><i class="bi bi-flag"></i>@row.PriorityLabel</span>
                                                <div class="small text-muted">@row.PriorityReason</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(row.LastActionSummary))
                                            {
                                                <div class="small text-muted">@row.LastActionSummary</div>
                                            }
                                        </div>
                                    </td>
                                    <td><span class="finance-status @statusClass">@row.Status</span></td>
                                    @if (areaName == "Admin")
                                    {
                                        <td>
                                            <form method="post" action="@Url.Action("TakeAction", "Finance", new { area = areaName })" class="d-grid gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="section" value="@Model.Section" />
                                                <input type="hidden" name="recordId" value="@row.RecordId" />
                                                <input type="hidden" name="q" value="@Model.Query" />
                                                <input type="hidden" name="status" value="@Model.Status" />
                                                <input type="hidden" name="followUpBucket" value="@Model.FollowUpBucket" />
                                                <input type="hidden" name="sellerId" value="@Model.SellerId" />
                                                <input type="hidden" name="page" value="@Model.Page" />
                                                <input type="text" class="form-control form-control-sm" name="assigneeLabel" value="@row.AssignedOwner" placeholder="Người phụ trách..." />
                                                <input type="datetime-local" class="form-control form-control-sm" name="followUpAt" value="@(row.FollowUpAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" />
                                                <input type="text" class="form-control form-control-sm" name="note" placeholder="Ghi chú nội bộ..." />
                                                <div class="d-flex flex-wrap gap-1">
                                                    @if (Model.Section == "payouts")
                                                    {
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="assign">Gán</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="set-follow-up">Theo dõi</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="send-reminder">Nhắc phụ trách</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="mark-exported">Xuất</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill" name="actionName" value="acknowledge">Nhận</button>
                                                        @if (canReleasePayout)
                                                        {
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill" name="actionName" value="release">Chi trả</button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" disabled title="Chỉ chi trả payout đang chờ xử lý và có AmountNet > 0">Chi trả</button>
                                                        }
                                                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill" name="actionName" value="hold">Giữ</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" name="actionName" value="reject">Lỗi</button>
                                                    }
                                                    else if (Model.Section == "refunds")
                                                    {
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="assign">Gán</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="set-follow-up">Theo dõi</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="send-reminder">Nhắc phụ trách</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="mark-exported">Xuất</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill" name="actionName" value="acknowledge">Nhận</button>
                                                        <button type="submit" class="btn btn-sm btn-success rounded-pill" name="actionName" value="approve">Duyệt</button>
                                                        <button type="submit" class="btn btn-sm btn-primary rounded-pill" name="actionName" value="resolve">Đóng</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" name="actionName" value="reject">Từ chối</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="assign">Gán</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="set-follow-up">Theo dõi</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="send-reminder">Nhắc phụ trách</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" name="actionName" value="mark-exported">Xuất</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill" name="actionName" value="acknowledge">Nhận</button>
                                                        <button type="submit" class="btn btn-sm btn-success rounded-pill" name="actionName" value="approve">Duyệt</button>
                                                        <button type="submit" class="btn btn-sm btn-primary rounded-pill" name="actionName" value="resolve">Đóng</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" name="actionName" value="reject">Từ chối</button>
                                                    }
                                                </div>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                            <a class="page-link" href="@BuildSectionLink(Model.Section, Model.Page - 1)">Trước</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : string.Empty)">
                                <a class="page-link" href="@BuildSectionLink(Model.Section, p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)">
                            <a class="page-link" href="@BuildSectionLink(Model.Section, Model.Page + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</main>

@if (areaName == "Admin" && Model.Rows.Count > 0)
{
    <script>
        (() => {
            const selectAll = document.getElementById('finance-select-all');
            const rowCheckboxes = Array.from(document.querySelectorAll('.finance-row-checkbox'));
            if (!selectAll || rowCheckboxes.length === 0) {
                return;
            }

            selectAll.addEventListener('change', () => {
                rowCheckboxes.forEach((checkbox) => checkbox.checked = selectAll.checked);
            });
        })();
    </script>
}

